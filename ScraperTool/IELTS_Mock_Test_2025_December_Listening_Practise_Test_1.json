          "GroupHtml": "\r\n                                            \u003Cp\u003E\u003Cem\u003EWhich theorist makes each of the following points?\u003C/em\u003E\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cem\u003EChoose the correct letter, \u003Cstrong\u003EA, B or C\u003C/strong\u003E, next to\r\n                                                    questions \u003Cstrong\u003E34-40.\u003C/strong\u003E\u003C/em\u003E\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cstrong\u003EPoints made\u003C/strong\u003E\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E34.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002234\u0022 id=\u0022q-34\u0022\u003E\u003Coption value=\u0022\u0022\u003E\u003C/option\u003E\u003Coption value=\u0022A\u0022\u003EA\u003C/option\u003E\u003Coption value=\u0022B\u0022\u003EB\u003C/option\u003E\u003Coption value=\u0022C\u0022\u003EC\u003C/option\u003E\u003C/select\u003E Current teaching methods don\u0027t work.\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E35.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002235\u0022 id=\u0022q-35\u0022\u003E\u003Coption value=\u0022\u0022\u003E\u003C/option\u003E\u003Coption value=\u0022A\u0022\u003EA\u003C/option\u003E\u003Coption value=\u0022B\u0022\u003EB\u003C/option\u003E\u003Coption value=\u0022C\u0022\u003EC\u003C/option\u003E\u003C/select\u003E Many students don\u0027t understand computers.\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E36.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002236\u0022 id=\u0022q-36\u0022\u003E\u003Coption value=\u0022\u0022\u003E\u003C/option\u003E\u003Coption value=\u0022A\u0022\u003EA\u003C/option\u003E\u003Coption value=\u0022B\u0022\u003EB\u003C/option\u003E\u003Coption value=\u0022C\u0022\u003EC\u003C/option\u003E\u003C/select\u003E Computer technology doesn\u0027t interest all students.\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E37.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002237\u0022 id=\u0022q-37\u0022\u003E\u003Coption value=\u0022\u0022\u003E\u003C/option\u003E\u003Coption value=\u0022A\u0022\u003EA\u003C/option\u003E\u003Coption value=\u0022B\u0022\u003EB\u003C/option\u003E\u003Coption value=\u0022C\u0022\u003EC\u003C/option\u003E\u003C/select\u003E Students can still learn the traditional way.\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E38.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002238\u0022 id=\u0022q-38\u0022\u003E\u003Coption value=\u0022\u0022\u003E\u003C/option\u003E\u003Coption value=\u0022A\u0022\u003EA\u003C/option\u003E\u003Coption value=\u0022B\u0022\u003EB\u003C/option\u003E\u003Coption value=\u0022C\u0022\u003EC\u003C/option\u003E\u003C/select\u003E Students still need to learn research skills.\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E39.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002239\u0022 id=\u0022q-39\u0022\u003E\u003Coption value=\u0022\u0022\u003E\u003C/option\u003E\u003Coption value=\u0022A\u0022\u003EA\u003C/option\u003E\u003Coption value=\u0022B\u0022\u003EB\u003C/option\u003E\u003Coption value=\u0022C\u0022\u003EC\u003C/option\u003E\u003C/select\u003E We should use computer games to teach.\u003C/p\u003E\r\n                                            \u003Cp\u003E\u003Cb class=\u0022iot-question-number\u0022\u003E40.\u003C/b\u003E\u003Cselect class=\u0022ielts-input\u0022 data-q=\u002240\u0022 id=\u0022q-40\u0022\u003E\u003Coption valu