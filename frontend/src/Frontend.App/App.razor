@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @{
                        var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                        var isAdmin = rel.StartsWith("portal-hub", StringComparison.OrdinalIgnoreCase) ||
                                      rel.StartsWith("admin", StringComparison.OrdinalIgnoreCase);
                    }
                    @if (isAdmin)
                    {
                        <Frontend.App.Components.AdminNotAuthorized />
                    }
                    else
                    {
                        <div style="text-align: center; padding: 100px 20px; color: white;">
                            <h2 style="color: #ff3333; margin-bottom: 15px;">Yêu cầu đăng nhập</h2>
                            <p style="margin-bottom: 25px;">Bạn cần đăng nhập để truy cập trang.</p>
                            <a href="/" class="btn-action" style="display: inline-block; padding: 10px 20px; background-color: #ff3333; color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">Về trang chủ để đăng nhập</a>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                @{
                    var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                    var isAdmin = rel.StartsWith("portal-hub", StringComparison.OrdinalIgnoreCase) ||
                                  rel.StartsWith("admin", StringComparison.OrdinalIgnoreCase);
                }
                @if (isAdmin)
                {
                    <div style="text-align: center; padding: 80px 20px; color: white;">
                        <h2 style="color: #f87171; margin-bottom: 12px; font-weight: 800;">Đường dẫn Quản trị không tồn tại</h2>
                        <p style="color: #94a3b8; margin-bottom: 20px;">Trang quản trị bạn đang tìm kiếm không tồn tại hoặc đã được cập nhật đường dẫn.</p>
                        <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                            <a href="/portal-hub" class="btn-action" style="display: inline-block; padding: 10px 20px; background-color: #dc2626; color: white; text-decoration: none; border-radius: 6px; font-weight: 700;">Vào Admin Hub</a>
                            <a href="/portal-hub/login" style="display: inline-block; padding: 10px 20px; background-color: #334155; color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">Đăng nhập Quản trị</a>
                        </div>
                    </div>
                }
                else
                {
                    <p role="alert">Sorry, there's nothing at this address.</p>
                }
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
