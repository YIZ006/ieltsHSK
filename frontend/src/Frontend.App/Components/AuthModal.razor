@using Frontend.App.Services
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IConfiguration Configuration

@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="btn-close" @onclick="Close">
                <i class="bi bi-x-lg"></i>
            </button>
            
            <div class="modal-header">
                <h2>@(IsLogin ? "Sign In" : "Register")</h2>
                <p>@(IsLogin ? "Welcome back! Please login to continue." : "Create a new account to join us.")</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="@(ErrorMessage.Contains("successful") ? "alert-success" : "alert-error")">@ErrorMessage</div>
            }

            @if (IsLogin)
            {
                <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label>Tên đăng nhập hoặc Email</label>
                        <InputText class="form-control" @bind-Value="loginModel.UsernameOrEmail" placeholder="Nhập tên đăng nhập hoặc email của bạn" />
                        <ValidationMessage For="@(() => loginModel.UsernameOrEmail)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <div style="position: relative;">
                            <InputText type="@(showLoginPassword ? "text" : "password")" class="form-control" style="padding-right: 42px;" @bind-Value="loginModel.Password" placeholder="Nhập mật khẩu" />
                            <button type="button" @onclick="() => showLoginPassword = !showLoginPassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; color: #64748b; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; padding: 4px; z-index: 5;" title="@(showLoginPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                <i class="bi @(showLoginPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                    </div>
                    <button type="submit" class="btn-primary" disabled="@IsLoading">
                        @(IsLoading ? "Processing..." : "Login")
                    </button>
                </EditForm>
                <div class="modal-footer">
                    Don't have an account? <a href="javascript:void(0)" @onclick="() => SwitchMode(false)">Register here</a>
                </div>
            }
            else
            {
                <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label>Họ và tên</label>
                        <InputText class="form-control" @bind-Value="registerModel.FullName" placeholder="Nhập họ và tên của bạn" />
                        <ValidationMessage For="@(() => registerModel.FullName)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                    </div>
                    <div class="form-group">
                        <label>Tên đăng nhập (Username)</label>
                        <InputText class="form-control" @bind-Value="registerModel.Username" placeholder="Nhập tên đăng nhập" @onblur="OnUsernameBlur" />
                        <ValidationMessage For="@(() => registerModel.Username)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                        @if (!string.IsNullOrEmpty(usernameStatusMessage))
                        {
                            <div style="font-size: 0.8rem; margin-top: 5px; font-weight: 600; color: @(isUsernameTaken ? "var(--ig-danger)" : "#16a34a");">
                                @usernameStatusMessage
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <InputText type="email" class="form-control" @bind-Value="registerModel.Email" placeholder="Enter your email" />
                        <ValidationMessage For="@(() => registerModel.Email)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                    </div>
                    <div class="form-group">
                        <label>Mật khẩu (Password)</label>
                        <div style="position: relative;">
                            <InputText type="@(showPassword ? "text" : "password")" class="form-control" style="padding-right: 42px;" @bind-Value="registerModel.Password" @oninput="OnPasswordInput" placeholder="Nhập mật khẩu" />
                            <button type="button" @onclick="() => showPassword = !showPassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; color: #64748b; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; padding: 4px; z-index: 5;" title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.Password)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                        
                        @if (!string.IsNullOrEmpty(registerModel.Password))
                        {
                            <div class="pw-strength-container" style="margin-top: 8px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 0.78rem; font-weight: 600;">
                                    <span style="color: #64748b;">Độ mạnh mật khẩu:</span>
                                    <span style="color: @GetPasswordStrengthColor(); font-weight: 700;">@GetPasswordStrengthLabel()</span>
                                </div>
                                <div style="height: 6px; background: #e2e8f0; border-radius: 10px; overflow: hidden; display: flex;">
                                    <div style="width: @(GetPasswordStrengthPercent())%; background: @GetPasswordStrengthColor(); transition: all 0.3s ease; height: 100%; border-radius: 10px;"></div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label>Xác nhận mật khẩu (Confirm Password)</label>
                        <div style="position: relative;">
                            <InputText type="@(showConfirmPassword ? "text" : "password")" class="form-control" style="padding-right: 42px;" @bind-Value="registerModel.ConfirmPassword" placeholder="Nhập lại mật khẩu để xác nhận" />
                            <button type="button" @onclick="() => showConfirmPassword = !showConfirmPassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; color: #64748b; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; padding: 4px; z-index: 5;" title="@(showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                <i class="bi @(showConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" style="color: var(--ig-danger); font-size: 0.8rem; margin-top: 5px; display: block;" />
                    </div>
                    <button type="submit" class="btn-primary" disabled="@IsLoading">
                        @(IsLoading ? "Processing..." : "Register")
                    </button>
                </EditForm>
                <div class="modal-footer">
                    Already have an account? <a href="javascript:void(0)" @onclick="() => SwitchMode(true)">Login here</a>
                </div>
            }

            <div class="divider">
                <span>OR</span>
            </div>
            
            <div class="google-auth-container">
                <div id="google-signin-btn"></div>
            </div>
        </div>
    </div>
}

@code {
    public bool IsVisible { get; private set; }
    private bool IsLogin = true;
    private bool IsLoading = false;
    private string ErrorMessage = string.Empty;
    private string usernameStatusMessage = string.Empty;
    private bool isUsernameTaken = false;

    private bool showLoginPassword = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;

    private LoginRequest loginModel = new();
    private RegisterRequest registerModel = new();
    private DotNetObjectReference<AuthModal>? objRef;

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible)
        {
            var clientId = "161879464750-2ssdrim1ltgg2nh7nr5agvrbk52bevih.apps.googleusercontent.com";
            await JS.InvokeVoidAsync("initializeGoogleAuth", objRef, clientId);
        }
    }

    public void Show(bool isLogin)
    {
        IsLogin = isLogin;
        ErrorMessage = string.Empty;
        usernameStatusMessage = string.Empty;
        isUsernameTaken = false;
        showLoginPassword = false;
        showPassword = false;
        showConfirmPassword = false;
        IsVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private void SwitchMode(bool isLogin)
    {
        IsLogin = isLogin;
        ErrorMessage = string.Empty;
        usernameStatusMessage = string.Empty;
        isUsernameTaken = false;
        showLoginPassword = false;
        showPassword = false;
        showConfirmPassword = false;
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        registerModel.Password = e.Value?.ToString() ?? string.Empty;
    }

    private int GetPasswordStrengthScore()
    {
        var pwd = registerModel.Password;
        if (string.IsNullOrEmpty(pwd)) return 0;

        int score = 0;
        if (pwd.Length >= 6) score++;
        if (pwd.Length >= 10) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(pwd, @"[a-z]") && System.Text.RegularExpressions.Regex.IsMatch(pwd, @"[A-Z]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(pwd, @"[0-9]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(pwd, @"[^a-zA-Z0-9]")) score++;

        return score;
    }

    private string GetPasswordStrengthLabel()
    {
        var score = GetPasswordStrengthScore();
        return score switch
        {
            1 or 2 => "Yếu",
            3 => "Trung bình",
            4 => "Mạnh",
            5 => "Rất mạnh",
            _ => ""
        };
    }

    private string GetPasswordStrengthColor()
    {
        var score = GetPasswordStrengthScore();
        return score switch
        {
            1 or 2 => "#ef4444",
            3 => "#f59e0b",
            4 => "#10b981",
            5 => "#059669",
            _ => "#e2e8f0"
        };
    }

    private int GetPasswordStrengthPercent()
    {
        var score = GetPasswordStrengthScore();
        return score switch
        {
            1 => 20,
            2 => 40,
            3 => 65,
            4 => 85,
            5 => 100,
            _ => 0
        };
    }

    private async Task OnUsernameBlur()
    {
        if (string.IsNullOrWhiteSpace(registerModel.Username) || registerModel.Username.Trim().Length < 3)
        {
            usernameStatusMessage = string.Empty;
            isUsernameTaken = false;
            return;
        }

        var username = registerModel.Username.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(username, @"^[a-zA-Z0-9]+$"))
        {
            usernameStatusMessage = string.Empty;
            isUsernameTaken = false;
            StateHasChanged();
            return;
        }

        isUsernameTaken = await AuthService.CheckUsernameExistsAsync(username);
        if (isUsernameTaken)
        {
            usernameStatusMessage = "Tên đăng nhập này đã tồn tại. Vui lòng chọn tên khác.";
        }
        else
        {
            usernameStatusMessage = "Tên đăng nhập khả dụng!";
        }
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        try
        {
            var success = await AuthService.LoginAsync(loginModel);
            if (success)
            {
                Close();
                NavigationManager.NavigateTo("/ielts", forceLoad: false);
            }
            else
            {
                ErrorMessage = "Tên đăng nhập / Email hoặc mật khẩu không chính xác.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi đăng nhập: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleRegister()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        usernameStatusMessage = string.Empty;

        try
        {
            // Check username existence before submitting
            isUsernameTaken = await AuthService.CheckUsernameExistsAsync(registerModel.Username.Trim());
            if (isUsernameTaken)
            {
                ErrorMessage = "Tên đăng nhập này đã tồn tại. Vui lòng chọn tên đăng nhập khác.";
                usernameStatusMessage = "Tên đăng nhập này đã tồn tại.";
                return;
            }

            var (success, error) = await AuthService.RegisterAsync(registerModel);
            if (success)
            {
                IsLogin = true; // Switch to login after successful registration
                ErrorMessage = "Đăng ký thành công! Vui lòng đăng nhập.";
                registerModel = new();
            }
            else
            {
                ErrorMessage = !string.IsNullOrEmpty(error) ? error : "Đăng ký thất bại. Email hoặc Tên đăng nhập có thể đã được sử dụng.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi đăng ký: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    [JSInvokable]
    public async Task HandleGoogleLogin(string idToken)
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        StateHasChanged();

        var (success, error) = await AuthService.LoginWithGoogleAsync(idToken);
        if (success)
        {
            Close();
            NavigationManager.NavigateTo("/ielts", forceLoad: false);
        }
        else
        {
            if (error.Contains("UserNotRegistered|"))
            {
                var emailParts = error.Split("UserNotRegistered|");
                if (emailParts.Length > 1) 
                {
                    var email = emailParts[1].Trim('"', '\r', '\n');
                    SwitchMode(false); // Switch to register mode
                    registerModel.Email = email;
                    ErrorMessage = "Tài khoản chưa được đăng ký. Vui lòng tạo tài khoản mới.";
                }
            }
            else
            {
                ErrorMessage = "Đăng nhập Google thất bại: " + error;
            }
        }
        
        IsLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
