    private string FormattedSentenceHtml
    {
        get
        {
            if (currentWord == null || string.IsNullOrWhiteSpace(currentWord.Example)) return "";
            var ex = currentWord.Example;
            var w = currentWord.Word.Trim();
            if (string.IsNullOrWhiteSpace(w)) return ex;

            var replacement = $"<span class='blank-target'>[ {new string('_', Math.Min(w.Length, 8))} ]</span>";

            // 1. Khớp từ chính xác và các biến thể đuôi s, es, ed, ing, d, 's
            var pattern = $@"\b{System.Text.RegularExpressions.Regex.Escape(w)}(?:s|es|ed|ing|d|'s)?\b";
            var regex = new System.Text.RegularExpressions.Regex(pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(ex))
            {
                return regex.Replace(ex, replacement);
            }

            // 2. Khớp từ gốc bỏ 'e' hoặc đổi 'y' -> 'i' (ví dụ: create -> creating, rely -> relied)
            string stem = w;
            if (w.EndsWith("e", StringComparison.OrdinalIgnoreCase) && w.Length > 2)
            {
                stem = w[..^1];
            }
            else if (w.EndsWith("y", StringComparison.OrdinalIgnoreCase) && w.Length > 2)
            {
                stem = w[..^1] + "(?:y|i|ie)";
            }

            var flexPattern = $@"\b{stem}(?:s|es|ed|ing|d|'s)?\b";
            var flexRegex = new System.Text.RegularExpressions.Regex(flexPattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (flexRegex.IsMatch(ex))
            {
                return flexRegex.Replace(ex, replacement);
            }

            // 3. Quét từng token để tìm từ biến thể/gần giống nhất trong câu và ẩn đi (tránh tuyệt đối lộ đáp án)
            var wordsInSent = System.Text.RegularExpressions.Regex.Matches(ex, @"\b[a-zA-Z']+\b");
            foreach (System.Text.RegularExpressions.Match match in wordsInSent)
            {
                var token = match.Value.Trim('\'').ToLowerInvariant();
                if (token.Length >= 3 && Math.Abs(token.Length - w.Length) <= 3)
                {
                    if (token.StartsWith(w[..Math.Min(3, w.Length)].ToLowerInvariant()) ||
                        LevenshteinDistance(token, w.ToLowerInvariant()) <= 2)
                    {
                        var exactTokenRegex = new System.Text.RegularExpressions.Regex($@"\b{System.Text.RegularExpressions.Regex.Escape(match.Value)}\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                        return exactTokenRegex.Replace(ex, replacement);
                    }
                }
            }

            // 4. Nếu câu ví dụ không chứa từ mục tiêu: chèn chỗ trống ở cuối một cách tự nhiên
            return $"{ex} {replacement}";
        }
    }

    private static string CleanMeaningForDisplay(string? meaning, string? word)
    {
        if (string.IsNullOrWhiteSpace(meaning)) return "";
        if (string.IsNullOrWhiteSpace(word)) return meaning;

        // Loại bỏ tên từ tiếng Anh nếu vô tình xuất hiện ở đầu nghĩa (vd: "alien: người ngoài hành tinh")
        var w = word.Trim();
        var cleaned = System.Text.RegularExpressions.Regex.Replace(meaning, $@"\b{System.Text.RegularExpressions.Regex.Escape(w)}\b[\s:–-]*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return string.IsNullOrWhiteSpace(cleaned) ? meaning : cleaned.Trim();
    }

    private static int LevenshteinDistance(string s, string t)
    {
        if (string.IsNullOrEmpty(s)) return t?.Length ?? 0;
        if (string.IsNullOrEmpty(t)) return s.Length;

        int n = s.Length;
        int m = t.Length;
        int[] d = new int[m + 1];

        for (int j = 0; j <= m; j++) d[j] = j;

        for (int i = 1; i <= n; i++)
        {
            int prev = d[0];
            d[0] = i;
            for (int j = 1; j <= m; j++)
            {
                int temp = d[j];
                int cost = (s[i - 1] == t[j - 1]) ? 0 : 1;
                d[j] = Math.Min(Math.Min(d[j] + 1, d[j - 1] + 1), prev + cost);
                prev = temp;
            }
        }
        return d[m];
    }


