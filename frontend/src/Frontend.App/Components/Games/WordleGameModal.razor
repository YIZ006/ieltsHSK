    private async Task LoadVocabularyFromApiAsync()
    {
        try
        {
            var all = await IeltsService.GetVocabularyAsync();
            if (all != null && all.Count > 0)
            {
                var allowedCefr = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "A2", "B1", "B2", "C1" };
                var clean = all
                    .Where(v => v.IsActive && !string.IsNullOrWhiteSpace(v.Word))
                    .Where(v => v.Word.Trim().All(c => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')))
                    .Where(v => v.Word.Trim().Length >= 4 && v.Word.Trim().Length <= 8)
                    .Where(v => string.IsNullOrEmpty(v.CefrLevel) || allowedCefr.Contains(v.CefrLevel.Trim()))
                    .Where(v => !ExcludedTechnicalAcronyms.Contains(v.Word.Trim()))
                    .Where(v => string.IsNullOrEmpty(v.Topic) || !ExcludedJargonTopicKeywords.Any(k => v.Topic.Contains(k, StringComparison.OrdinalIgnoreCase)))
                    .Where(v => string.IsNullOrEmpty(v.Meaning) || (!v.Meaning.Contains("bán dẫn", StringComparison.OrdinalIgnoreCase) && !v.Meaning.Contains("vi mạch", StringComparison.OrdinalIgnoreCase) && !v.Meaning.Contains("hệ thống scada", StringComparison.OrdinalIgnoreCase)))
                    .ToList();

                if (clean.Count > 0)
                {
                    vocabPool = clean;
                    ApplyDifficultyFilter();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GameHub] Background vocab load: {ex.Message}");
        }
    }

    private void ApplyDifficultyFilter()
    {
        var source = vocabPool.Count > 0 ? vocabPool : FallbackVocab;
        var query = source.AsEnumerable();

        // 1. Lọc theo cấp độ CEFR từ kho đã import (A2 - C1)
        if (selectedCefr != "all")
        {
            query = query.Where(v => string.Equals(v.CefrLevel?.Trim(), selectedCefr, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            var allowedCefr = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "A2", "B1", "B2", "C1" };
            query = query.Where(v => string.IsNullOrEmpty(v.CefrLevel) || allowedCefr.Contains(v.CefrLevel.Trim()));
        }

        // 2. Chỉ được phép các từ đủ số lượng chữ trong từ (độ dài chính xác)
        if (int.TryParse(selectedWordLength, out var exactLen) && exactLen >= 4 && exactLen <= 8)
        {
            query = query.Where(v => v.Word.Trim().Length == exactLen);
        }
        else
        {
            query = query.Where(v => v.Word.Trim().Length >= 4 && v.Word.Trim().Length <= 7);
        }

        // Đảm bảo từ tiếng Anh hợp lệ, chỉ gồm chữ cái A-Z
        query = query.Where(v => v.Word.Trim().All(c => (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')));

        filteredPool = query.ToList();

        if (filteredPool.Count == 0)
        {
            filteredPool = source.Where(v => v.Word.Trim().Length >= 4 && v.Word.Trim().Length <= 7).ToList();
        }
    }

    private void StartNewRound()
    {
        if (filteredPool.Count == 0) ApplyDifficultyFilter();
        if (filteredPool.Count == 0) return;

        var rng = new Random();

        // KHÔNG ĐƯỢC ĐỂ CÁC TỪ TRÙNG LẶP LẠI (chọn từ chưa từng chơi trong phiên này)
        var unplayed = filteredPool.Where(v =>
            (v.Id <= 0 || !playedIeltsVocabIds.Contains(v.Id)) &&
            !playedIeltsWords.Contains(v.Word.Trim().ToUpperInvariant())
        ).ToList();

        if (unplayed.Count == 0)
        {
            // Đã chơi hết toàn bộ từ trong kho theo bộ lọc hiện tại -> reset để bắt đầu vòng mới
            playedIeltsVocabIds.Clear();
            playedIeltsWords.Clear();
            unplayed = filteredPool.ToList();
            ShowToast("Bạn đã giải mã hết tất cả từ vựng trong cấp độ này! Bắt đầu vòng quay mới.");
        }

        currentWord = unplayed[rng.Next(unplayed.Count)];
        if (currentWord.Id > 0) playedIeltsVocabIds.Add(currentWord.Id);
        playedIeltsWords.Add(currentWord.Word.Trim().ToUpperInvariant());

        guesses.Clear();
        guessEvaluations.Clear();
        keyStatuses.Clear();
        currentInput = "";
        isGameOver = false;
        isGameWon = false;
        showResultModal = false;
        shakeCurrentRow = false;
        toastMessage = "";
        showSentenceTranslation = false;
        hintLetterIndices.Clear();
        hasUsedHintThisRound = false;
        wordleTimerSeconds = 120;
        if (!showWordleTutorialPrompt && !isWordleTutorialActive)
        {
            StartWordleTimer(resetTime: true);
        }
        _ = JS.InvokeVoidAsync("initQuantumBriefcase");
    }

    private void NextWord()
    {
        StartNewRound();
        StateHasChanged();
        _ = FocusWordle();
    }

    private void UseLetterHint()
    {
        if (isGameOver || currentWord == null) return;

        if (hasUsedHintThisRound)
        {
            ShowToast("Bạn đã dùng gợi ý cho từ vựng này rồi!");
            return;
        }

        var target = currentWord.Word.Trim().ToUpperInvariant();

        // 1. Tập hợp các vị trí đã được đoán ĐÚNG (correct) trong các lượt trước
        var alreadyCorrectIndices = new HashSet<int>();
        for (int r = 0; r < guessEvaluations.Count; r++)
        {
            var evals = guessEvaluations[r];
            for (int c = 0; c < evals.Count; c++)
            {
                if (evals[c] == "correct")
                {
                    alreadyCorrectIndices.Add(c);
                }
            }
        }

        // 2. Chỉ tìm các vị trí CHƯA được mở gợi ý VÀ CHƯA TỪNG ĐOÁN ĐÚNG
        var candidates = new List<int>();
        for (int i = 0; i < target.Length; i++)
        {
            if (!hintLetterIndices.ContainsKey(i) && !alreadyCorrectIndices.Contains(i))
            {
                candidates.Add(i);
            }
        }

        if (candidates.Count == 0)
        {
            ShowToast("Tất cả các chữ cái đã được đoán đúng rồi!");
            return;
        }

        // 3. Mở đúng 1 chữ cái đầu tiên chưa giải
        var chosenIndex = candidates[0];
        hintLetterIndices[chosenIndex] = target[chosenIndex];
        hasUsedHintThisRound = true;
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.keyEnterOk()");
        ShowToast($"ĐÃ MỞ CHỮ ĐẦU: Ô số {chosenIndex + 1} là '{target[chosenIndex]}'!");
        StateHasChanged();
    }

    private async Task PronounceWord()
    {
        if (currentWord == null) return;
        try
        {
            var word = currentWord.Word.Trim().Replace("'", "\\'");
            await JS.InvokeVoidAsync("eval", $"if ('speechSynthesis' in window) {{ var u = new SpeechSynthesisUtterance('{word}'); u.lang = 'en-US'; window.speechSynthesis.speak(u); }}");
        }
        catch { }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (!isPlayingWordle || isWordleTutorialActive || showWordleTutorialPrompt) return;

        var key = e.Key.ToUpperInvariant();

        // Nếu bảng kết quả đang hiện hoặc ván đã kết thúc -> bấm ENTER hoặc SPACE để sang màn/từ tiếp theo ngay!
        if (showResultModal || isGameOver)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                NextWord();
            }
            else if (key == "ESCAPE")
            {
                _ = CloseWordleGame();
            }
            return;
        }

        // Phím tắt 1: Gợi ý chữ cái chưa đoán đúng
        if (key == "1" || e.Code == "Digit1" || e.Code == "Numpad1")
        {
            UseLetterHint();
            return;
        }

        // Phím tắt 2: Phát âm tiếng Anh của từ vựng
        if (key == "2" || e.Code == "Digit2" || e.Code == "Numpad2")
        {
            _ = PronounceWord();
            return;
        }

        if (key == "ENTER") SubmitGuess();
        else if (key == "BACKSPACE") DeleteChar();
        else if (key.Length == 1 && char.IsLetter(key[0])) AddChar(key[0]);
    }

    private void OnVirtualKeyPress(string key)
    {
        if (!isPlayingWordle || isWordleTutorialActive || showWordleTutorialPrompt) return;

        if (showResultModal || isGameOver)
        {
            if (key == "ENTER") NextWord();
            return;
        }

        if (isGameOver) return;

        if (key == "ENTER") SubmitGuess();
        else if (key == "BACKSPACE") DeleteChar();
        else if (key.Length == 1 && char.IsLetter(key[0])) AddChar(key[0]);
    }

    private void AddChar(char c)
    {
        if (currentInput.Length < WordLength)
        {
            currentInput += char.ToUpperInvariant(c);
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.keyClick()");
            StateHasChanged();
        }
    }

    private void DeleteChar()
    {
        if (currentInput.Length > 0)
        {
            currentInput = currentInput.Substring(0, currentInput.Length - 1);
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.keyDelete()");
            StateHasChanged();
        }
    }

    private void SubmitGuess()
    {
        if (currentWord == null || isGameOver) return;

        if (currentInput.Length < WordLength)
        {
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.keyEnterError()");
            TriggerShake();
            ShowToast($"Cần nhập đủ {WordLength} chữ cái!");
            return;
        }

        var guess = currentInput.ToUpperInvariant();
        var target = currentWord.Word.Trim().ToUpperInvariant();

        var evals = EvaluateGuess(guess, target);

        guesses.Add(guess);
        guessEvaluations.Add(evals);

        for (int i = 0; i < guess.Length; i++)
        {
            char letter = guess[i];
            string status = evals[i];

            if (!keyStatuses.TryGetValue(letter, out var oldStatus) || oldStatus != "correct")
            {
                if (status == "correct" || (status == "present" && oldStatus != "present"))
                {
                    keyStatuses[letter] = status;
                }
                else if (oldStatus == null)
                {
                    keyStatuses[letter] = status;
                }
            }
        }

        currentInput = "";

        if (guess == target)
        {
            StopWordleTimer();
            isGameOver = true;
            isGameWon = true;
            wordleScore += 30;
            wordleStreak++;
            _ = SaveWordleProgressAsync();
            _ = JS.InvokeVoidAsync("MascotManager.gameSay", "win", "Đoán chuẩn xác rồi! 🌟", "+30 điểm!");
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.win()");
            _ = Task.Delay(300).ContinueWith(_ => InvokeAsync(PronounceWord));
            _ = Task.Delay(500).ContinueWith(_ => InvokeAsync(async () =>
            {
                showResultModal = true;
                StateHasChanged();
                await FocusWordle();
            }));
            return;
        }

        if (guesses.Count >= MaxGuesses)
        {
            StopWordleTimer();
            isGameOver = true;
            isGameWon = false;
            wordleStreak = 0;
            _ = SaveWordleProgressAsync();
            _ = JS.InvokeVoidAsync("MascotManager.gameSay", "game_over", "Hết lượt đoán rồi! Đừng nản nhé! 💪", "Thử lại nào!");
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.lose()");
            _ = Task.Delay(300).ContinueWith(_ => InvokeAsync(PronounceWord));
            _ = Task.Delay(500).ContinueWith(_ => InvokeAsync(async () =>
            {
                showResultModal = true;
                StateHasChanged();
                await FocusWordle();
            }));
            return;
        }
        // Nộp hợp lệ nhưng chưa đúng: âm nổ pin điện giật & tia sét
        _ = JS.InvokeVoidAsync("triggerBatteryZap", guesses.Count - 1);

        StateHasChanged();
    }

    private static List<string> EvaluateGuess(string guess, string target)
    {
        var result = new List<string>(new string[guess.Length]);
        var targetCounts = new Dictionary<char, int>();

        foreach (var c in target) targetCounts[c] = targetCounts.GetValueOrDefault(c, 0) + 1;

        for (int i = 0; i < guess.Length; i++)
        {
            if (guess[i] == target[i])
            {
                result[i] = "correct";
                targetCounts[guess[i]]--;
            }
        }

        for (int i = 0; i < guess.Length; i++)
        {
            if (result[i] != null) continue;
            char c = guess[i];
            if (targetCounts.GetValueOrDefault(c, 0) > 0)
            {
                result[i] = "present";
                targetCounts[c]--;
            }
            else
            {
                result[i] = "absent";
            }
        }

        return result;
    }

    private void TriggerShake()
    {
        shakeCurrentRow = true;
        StateHasChanged();
        _ = Task.Delay(400).ContinueWith(_ => InvokeAsync(() =>
        {
            shakeCurrentRow = false;
            StateHasChanged();
        }));
    }

    private void ShowToast(string msg)
    {
        toastMessage = msg;
        StateHasChanged();
        _ = Task.Delay(2400).ContinueWith(_ => InvokeAsync(() =>
        {
            toastMessage = "";
            StateHasChanged();
        }));
    }

    private string GetKeyClass(string key)
    {
        if (key.Length == 1 && keyStatuses.TryGetValue(key[0], out var status)) return status;
        return "";
    }



    public void Dispose()
    {
        wordleTimer?.Dispose();
        _ = JS.InvokeVoidAsync("window.QuantumCipherKeyboard.destroy");
        _ = JS.InvokeVoidAsync("MascotManager.setGameMode", false);
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm(); if ('speechSynthesis' in window) window.speechSynthesis.cancel();");
    }
}
