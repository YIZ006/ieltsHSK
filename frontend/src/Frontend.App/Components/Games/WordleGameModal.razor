@using Frontend.App.Models
@using Frontend.App.Services
@inject IeltsService IeltsService
@inject IJSRuntime JS
@inject UserGameProgressService GameProgressService
@implements IDisposable

    <div class="fullscreen-game-overlay quantum-game-overlay" @ref="wordleOverlayRef" @onkeydown="HandleKeyDown" tabindex="0" @onclick="FocusWordle">
        <!-- Topbar -->
        <header class="fullscreen-topbar quantum-topbar">
            <div class="topbar-left">
                <div class="fs-game-badge quantum-badge">
                    <i class="bi bi-shield-lock-fill"></i> BẺ KHÓA BOM LƯỢNG TỬ
                </div>
                <span class="mode-tag">DEFUSAL ACTIVE</span>
            </div>

            <!-- Length Mode Selector (4, 5, 6, 7, 8 ký tự) -->
            <div class="quantum-mode-selector">
                <span class="mode-lbl">CHẾ ĐỘ:</span>
                @foreach (var len in new[] { "4", "5", "6", "7", "8" })
                {
                    <button type="button" class="btn-mode @(selectedWordLength == len ? "active" : "")" @onclick="() => SetWordLengthMode(len)">
                        @(len) KÝ TỰ
                    </button>
                }
            </div>

            <div class="topbar-center">
                <span class="fs-stat-pill text-warning"><i class="bi bi-star-fill"></i> Điểm: <b>@wordleScore</b></span>
                <span class="fs-stat-pill text-danger"><i class="bi bi-fire"></i> Chuỗi: <b>@wordleStreak</b> 🔥</span>
                <span class="fs-stat-pill text-info"><i class="bi bi-battery-charging"></i> Pin: <b>@(MaxGuesses - guesses.Count)/@MaxGuesses</b></span>
            </div>

            <div class="topbar-right">
                <button type="button" class="btn-fs-tool btn-fs-tut" @onclick="OpenQuantumTutorial" title="Hướng dẫn từng phần">
                    <i class="bi bi-question-circle"></i> Hướng dẫn
                </button>
                <button type="button" class="btn-fs-tool" @onclick="NextWord" title="Đổi từ vựng khác">
                    <i class="bi bi-arrow-clockwise"></i> Đổi từ
                </button>
                <button type="button" class="btn-fs-exit" @onclick="CloseWordleGame" title="Thoát trò chơi">
                    <i class="bi bi-x-lg me-1"></i> Thoát
                </button>
            </div>
        </header>

        <!-- Main Body: Quantum Briefcase Stage -->
        <main class="fullscreen-game-body quantum-body">
            @if (currentWord == null)
            {
                <div class="fs-loading-box">
                    <div class="spinner"></div>
                    <p>Đang chuẩn bị mật thư...</p>
                </div>
            }
            else
            {
                <div class="stage-box" id="quantumStageBox">
                    <!-- 1. Background Image -->
                    <img class="briefcase-bg" src="images/games/quantum-cipher/kipbom_base.png" alt="Quantum Briefcase">

                    <!-- 2. Interactive Layer -->
                    <div class="interactive-layer">

                        <!-- LEFT DOOR: TACTICAL PHONE HUD -->
                        <div class="phone-dock-left">
                            <div class="phone-casing">
                                <div class="phone-screen">
                                    <div class="screen-topbar">
                                        <div class="screen-title">
                                            <span class="dot"></span>
                                            <span>DOSSIER // @(string.IsNullOrWhiteSpace(currentWord.CefrLevel) ? "IELTS" : $"CEFR {currentWord.CefrLevel}")</span>
                                        </div>
                                        <div class="screen-stat">📶 99%</div>
                                    </div>

                                    <!-- Tags Row -->
                                    <div class="clue-tags-row">
                                        <span class="badge-pos">@(string.IsNullOrWhiteSpace(currentWord.PartOfSpeech) ? "NOUN" : currentWord.PartOfSpeech.ToUpperInvariant())</span>
                                        @if (!string.IsNullOrWhiteSpace(currentWord.Topic))
                                        {
                                            <span class="badge-topic"><i class="bi bi-tag-fill"></i> @currentWord.Topic</span>
                                        }
                                        <span class="badge-len"><i class="bi bi-fonts"></i> @WordLength chữ</span>
                                    </div>

                                    <!-- Vietnamese Definition -->
                                    <div class="clue-viet-box">
                                        <div class="clue-viet-label">Nghĩa tiếng Việt:</div>
                                        <div class="clue-viet-text">@CleanMeaningForDisplay(currentWord.Meaning, currentWord.Word)</div>
                                    </div>

                                    <!-- Context Sentence with Blank -->
                                    @if (!string.IsNullOrWhiteSpace(ContextSentence))
                                    {
                                        <div class="clue-sentence-box">
                                            <div class="clue-sentence-label">Ngữ cảnh câu ví dụ:</div>
                                            <div class="clue-sentence-text">
                                                @((MarkupString)FormattedSentenceHtml)
                                            </div>
                                            @if (showSentenceTranslation && !string.IsNullOrWhiteSpace(currentWord.ExampleMeaning))
                                            {
                                                <div class="sent-vi-trans">
                                                    <i class="bi bi-arrow-return-right me-1 text-muted"></i> @currentWord.ExampleMeaning
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(currentWord.ExampleMeaning))
                                            {
                                                <button type="button" class="btn-toggle-trans" @onclick="() => showSentenceTranslation = true">
                                                    <i class="bi bi-eye"></i> Xem bản dịch câu
                                                </button>
                                            }
                                        </div>
                                    }

                                    <!-- Action Buttons -->
                                    <div class="phone-tools">
                                        <button type="button" class="btn-screen-act btn-hint-first" @onclick="UseLetterHint" disabled="@(isGameOver || hasUsedHintThisRound)" style="@(hasUsedHintThisRound ? "opacity: 0.45; cursor: not-allowed;" : "")" title="@(hasUsedHintThisRound ? "Đã dùng gợi ý cho từ này" : "Gợi ý chữ cái đầu tiên (Phím 1)")">
                                            <span>⚡ MỞ CHỮ ĐẦU</span>
                                            <span style="font-size: 0.65rem;">[GỢI Ý]</span>
                                        </button>
                                        <button type="button" class="btn-screen-act" @onclick="PronounceWord" title="Nghe phát âm tiếng Anh">
                                            <span>🔊 PHÁT ÂM</span>
                                            <span style="font-size: 0.65rem;">[AUDIO]</span>
                                        </button>
                                        <button type="button" class="btn-screen-act" @onclick="NextWord" title="Đổi từ vựng khác">
                                            <span>🔄 ĐỔI TỪ MỚI</span>
                                            <span style="font-size: 0.65rem;">[TIẾP]</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CENTER: DIGITAL TIMER + PLASMA CORE + 2-ROW TILES -->
                        <div class="center-hud-timer @GetTimerUrgentClass()" id="hudTimer">
                            <div class="timer-val">@FormatWordleTimer()</div>
                        </div>

                        <!-- Plasma Core Spark Emitter -->
                        <div class="plasma-reactor-spark">
                            <img id="quantumCoreSpark" src="images/games/quantum-cipher/set/set1_trans.png" alt="Plasma Spark">
                        </div>

                        <!-- Row 1: Locked Green Cipher Slots (Upper Brushed Titanium Plate) -->
                        <div class="plate-row1-lock" id="rowLockedSlots">
                            <div class="row-deck-badge badge-lock">
                                <span class="led-dot"></span> CHỐT
                            </div>
                            @for (int i = 0; i < WordLength; i++)
                            {
                                var colIndex = i;
                                var lockedChar = GetLockedLetterAt(colIndex);
                                <div class="tile-socket">
                                    <div class="tile-button locked-slot @(lockedChar.HasValue ? "locked-green" : "")" style="@GetDynamicTileStyle()">
                                        @(lockedChar.HasValue ? lockedChar.Value.ToString() : "·")
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Row 2: Active Input Cipher Slots (Lower Brushed Titanium Plate) -->
                        <div class="plate-row2-input @(shakeCurrentRow ? "shake-deck" : "")" id="plateRow2">
                            <div class="row-deck-badge badge-input">
                                <span class="led-dot"></span> NHẬP
                            </div>
                            <div style="display: flex; align-items: center; justify-content: center; gap: inherit; width: 100%;">
                                @for (int i = 0; i < WordLength; i++)
                                {
                                    var colIndex = i;
                                    var hasChar = colIndex < currentInput.Length;
                                    var charVal = hasChar ? currentInput[colIndex].ToString() : "";
                                    var isCursor = !isGameOver && colIndex == currentInput.Length && currentInput.Length < WordLength;

                                    <div class="tile-socket">
                                        <div class="tile-button input-slot @(hasChar ? "has-char" : "") @(isCursor ? "cursor-active" : "")" style="@GetDynamicTileStyle()">
                                            @charVal
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- RIGHT DOOR: 6 SLIM PIN & KEYBOARD -->
                        <div class="right-door-pin-tray" id="quantumBatteryTray">
                            @for (int b = 0; b < MaxGuesses; b++)
                            {
                                var isBlown = b < guesses.Count;
                                <div class="power-rod @(isBlown ? "blown" : "")" data-pin="@b">
                                    <span class="rod-bolt">⚡</span>
                                </div>
                            }
                        </div>

                        <!-- Spark burst on blown battery rod -->
                        <div class="spark-rod-burst" id="quantumSparkBurst">
                            <img id="quantumSparkBurstImg" src="images/games/quantum-cipher/setgiat/setgiat1_trans.png" alt="Spark">
                        </div>

                        <!-- Virtual Mechanical Keyboard -->
                        <div class="right-door-keyboard" id="keyboardContainer">
                            <div class="kb-row">
                                @foreach (var key in KeyRow1)
                                {
                                    <button type="button" class="kb-key @GetQuantumKeyClass(key)" @onclick="() => OnVirtualKeyPress(key)">@key</button>
                                }
                            </div>
                            <div class="kb-row">
                                @foreach (var key in KeyRow2)
                                {
                                    <button type="button" class="kb-key @GetQuantumKeyClass(key)" @onclick="() => OnVirtualKeyPress(key)">@key</button>
                                }
                            </div>
                            <div class="kb-row">
                                @foreach (var key in KeyRow3)
                                {
                                    <button type="button" class="kb-key @GetQuantumKeyClass(key)" @onclick="() => OnVirtualKeyPress(key)">@key</button>
                                }
                            </div>
                            <div class="kb-row">
                                <button type="button" class="kb-key action-key del-key" @onclick='() => OnVirtualKeyPress("BACKSPACE")'>⌫ XÓA</button>
                                <button type="button" class="kb-key action-key enter-key" @onclick='() => OnVirtualKeyPress("ENTER")'>⏎ XÁC NHẬN</button>
                            </div>
                        </div>

                        <!-- Toast alert -->
                        @if (!string.IsNullOrEmpty(toastMessage))
                        {
                            <div class="hud-toast">
                                @toastMessage
                            </div>
                        }

                        <!-- ====================================================
                             INTERACTIVE SPOTLIGHT TUTORIAL & PROMPT MODAL
                             ==================================================== -->

                        <!-- 1. Initial Prompt Modal (Trước khi bắt đầu chơi) -->
                        @if (showWordleTutorialPrompt)
                        {
                            <div class="tutorial-prompt-modal" id="tutorialPromptModal">
                                <div class="prompt-card">
                                    <div class="prompt-title">NHIỆM VỤ BẺ KHÓA BOM</div>
                                    <div class="prompt-desc">
                                        Hệ thống điều khiển vũ khí vali lượng tử đã sẵn sàng. Bạn có muốn xem hướng dẫn chi tiết từng bộ phận và chức năng trước khi bắt đầu không?
                                    </div>
                                    <div class="prompt-actions">
                                        <button type="button" class="btn-prompt-guide" @onclick="StartQuantumTutorial">🚀 XEM HƯỚNG DẪN</button>
                                        <button type="button" class="btn-prompt-play" @onclick="SkipWordleTutorialAndPlay">⚡ VÀO CHƠI LUÔN</button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- 2. Spotlight Tour Overlay -->
                        @if (isWordleTutorialActive)
                        {
                            <div class="tutorial-overlay show" id="tutorialOverlay">
                            <!-- Glowing Cutout Box -->
                            <div class="tutorial-spotlight-box" id="tutorialSpotlightBox"></div>

                            <!-- Briefing Dialog Card -->
                            <div class="tutorial-card" id="tutorialCard">
                                <div class="tut-header">
                                    <div class="tut-step-tag">
                                        <span id="tutStepText">BƯỚC 1/5</span>
                                    </div>
                                    <div class="tut-step-dots" id="tutStepDots">
                                        <span class="tut-dot active"></span>
                                        <span class="tut-dot"></span>
                                        <span class="tut-dot"></span>
                                        <span class="tut-dot"></span>
                                        <span class="tut-dot"></span>
                                    </div>
                                </div>

                                <div class="tut-title" id="tutTitle">1. MẬT THƯ TÌNH BÁO</div>
                                <div class="tut-body">
                                    <span id="tutBodyText"></span><span class="tut-cursor" id="tutCursor"></span>
                                </div>

                                <div class="tut-hint-click">
                                    <span>💡 Nhấn vào khung để hiện toàn bộ chữ • Phím Space hoặc Enter để tiếp tục</span>
                                </div>

                                <div class="tut-footer">
                                    <button type="button" class="btn-tut-skip" id="btnTutSkip" @onclick="OnTutorialSkipClick" @onclick:stopPropagation>Bỏ qua (Esc)</button>
                                    <button type="button" class="btn-tut-next" id="btnTutNext" @onclick="OnTutorialNextClick" @onclick:stopPropagation>
                                        <span id="tutNextBtnText">Tiếp theo</span> ➜
                                    </button>
                                </div>
                            </div>
                        </div>
                        }

                        <!-- Result Modal -->
                        @if (showResultModal && currentWord != null)
                        {
                            <div class="overlay-modal show" @onclick="() => showResultModal = false">
                                <div class="modal-card @(isGameWon ? "victory" : "defeat")" @onclick:stopPropagation="true">
                                    <div class="modal-title">@(isGameWon ? "GỠ BOM THÀNH CÔNG!" : "NHIỆM VỤ THẤT BẠI!")</div>
                                    <div class="modal-word">@currentWord.Word.ToUpperInvariant()</div>
                                    <div class="modal-desc">
                                        @if (isGameWon)
                                        {
                                            <span>@currentWord.Meaning</span>
                                        }
                                        else
                                        {
                                            <span>Mã giải mã đúng là: <b>@currentWord.Word.ToUpperInvariant()</b> (@currentWord.Meaning)</span>
                                        }
                                    </div>
                                    <div class="modal-stats">
                                        <div class="stat-item">
                                            <div class="stat-val">@FormatWordleTimer()</div>
                                            <div class="stat-lbl">Thời gian còn lại</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-val">@(guesses.Count)/@MaxGuesses</div>
                                            <div class="stat-lbl">Lượt đoán</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-val">@(isGameWon ? "+30 điểm" : "0 điểm")</div>
                                            <div class="stat-lbl">Điểm số</div>
                                        </div>
                                    </div>
                                    <button type="button" class="modal-btn @(isGameWon ? "" : "defeat-btn")" @onclick="NextWord">
                                        @(isGameWon ? "TỪ VỰNG TIẾP THEO ➜" : "THỬ LẠI NHIỆM VỤ 🔄")
                                    </button>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            }
        </main>
    </div>


@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnStatsChanged { get; set; }
    [Parameter] public List<IeltsVocabularyItem>? VocabPool { get; set; }
    [Parameter] public string InitialWordLength { get; set; } = "5";
    [Parameter] public string SelectedCefr { get; set; } = "all";

    private bool isPlayingWordle = true;
    private bool showWordleTutorialPrompt = false;
    private bool isWordleTutorialActive = false;
    private bool hasSeenWordleTutorial = false;

    private bool hasUsedHintThisRound = false;

    // === WORDLE GAME STATE ===
    private const int MaxGuesses = 6;
    private List<IeltsVocabularyItem> vocabPool = new();
    private List<IeltsVocabularyItem> filteredPool = new();
    private IeltsVocabularyItem? currentWord;

    private int WordLength => currentWord?.Word.Trim().Length ?? 5;
    private string ContextSentence => currentWord?.Example ?? "";

    private List<string> guesses = new();
    private List<List<string>> guessEvaluations = new();
    private string currentInput = "";
    private int currentGuessIndex => guesses.Count;
    private bool isGameOver;
    private bool isGameWon;
    private bool showResultModal;
    private bool shakeCurrentRow;
    private string toastMessage = "";
    private bool showSentenceTranslation;

    private int wordleScore = 0;
    private int wordleStreak = 0;
    private int wordleMaxStreak = 0;
    private Dictionary<int, char> hintLetterIndices = new();
    private string selectedCefr = "all";
    private string selectedWordLength = "5";
    private readonly HashSet<int> playedIeltsVocabIds = new();
    private readonly HashSet<string> playedIeltsWords = new();

    private Dictionary<char, string> keyStatuses = new();

    // === QUANTUM CIPHER STATE & HELPERS ===
    private int wordleTimerSeconds = 120;
    private Timer? wordleTimer;

    private void StartWordleTimer(bool resetTime = false)
    {
        wordleTimer?.Dispose();
        if (resetTime || wordleTimerSeconds <= 0)
        {
            wordleTimerSeconds = 120;
        }
        wordleTimer = new Timer(async _ =>
        {
            if (!isPlayingWordle || isGameOver || isWordleTutorialActive || showWordleTutorialPrompt) return;
            wordleTimerSeconds--;
            if (wordleTimerSeconds <= 0)
            {
                wordleTimerSeconds = 0;
                isGameOver = true;
                isGameWon = false;
                wordleStreak = 0;
                _ = SaveWordleProgressAsync();
                _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.lose()");
                _ = Task.Delay(300).ContinueWith(_ => InvokeAsync(PronounceWord));
                _ = Task.Delay(500).ContinueWith(_ => InvokeAsync(async () =>
                {
                    showResultModal = true;
                    StateHasChanged();
                    await FocusWordle();
                }));
                wordleTimer?.Dispose();
            }
            else
            {
                _ = JS.InvokeVoidAsync("eval", $"window.WordleSfx?.quantumTick({wordleTimerSeconds})");
            }
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void StopWordleTimer()
    {
        wordleTimer?.Dispose();
        wordleTimer = null;
    }

    private string FormatWordleTimer()
    {
        int m = wordleTimerSeconds / 60;
        int s = wordleTimerSeconds % 60;
        return $"{m:D2}:{s:D2}";
    }

    private string GetTimerUrgentClass()
    {
        if (wordleTimerSeconds <= 10 && wordleTimerSeconds > 0) return "urgent-10";
        if (wordleTimerSeconds <= 20 && wordleTimerSeconds > 0) return "urgent-20";
        if (wordleTimerSeconds <= 30 && wordleTimerSeconds > 0) return "urgent-30";
        return "";
    }

    private char? GetLockedLetterAt(int index)
    {
        if (hintLetterIndices.TryGetValue(index, out var hintChar))
            return hintChar;
        for (int r = 0; r < guessEvaluations.Count; r++)
        {
            var evals = guessEvaluations[r];
            if (index < evals.Count && evals[index] == "correct" && index < guesses[r].Length)
            {
                return guesses[r][index];
            }
        }
        return null;
    }

    private string GetQuantumKeyClass(string key)
    {
        if (key.Length == 1 && keyStatuses.TryGetValue(char.ToUpperInvariant(key[0]), out var status))
        {
            return status switch
            {
                "correct" => "state-green",
                "present" => "state-yellow",
                "absent" => "state-dark",
                _ => ""
            };
        }
        return "";
    }

    private string GetDynamicTileStyle()
    {
        if (WordLength >= 8)
            return "width: clamp(20px, 2.5vw, 34px); height: clamp(20px, 2.5vw, 34px); font-size: clamp(11px, 1.3vw, 18px);";
        if (WordLength == 7)
            return "width: clamp(22px, 2.8vw, 38px); height: clamp(22px, 2.8vw, 38px); font-size: clamp(12px, 1.5vw, 20px);";
        return "";
    }

    private void SetWordLengthMode(string len)
    {
        selectedWordLength = len;
        ApplyDifficultyFilter();
        NextWord();
    }


    private static readonly string[] KeyRow1 = { "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P" };
    private static readonly string[] KeyRow2 = { "A", "S", "D", "F", "G", "H", "J", "K", "L" };
    private static readonly string[] KeyRow3 = { "Z", "X", "C", "V", "B", "N", "M" };

    private ElementReference wordleOverlayRef;


    private static readonly List<IeltsVocabularyItem> FallbackVocab = new()
    {
        new IeltsVocabularyItem { Word = "pollution", Phonetic = "/pəˈluːʃn/", PartOfSpeech = "noun", Meaning = "Sự ô nhiễm", Example = "Air pollution is a severe environmental challenge in modern megacities.", ExampleMeaning = "Ô nhiễm không khí là một thách thức môi trường nghiêm trọng ở các siêu đô thị hiện đại.", Topic = "Environment", CefrLevel = "B1" },
        new IeltsVocabularyItem { Word = "climate", Phonetic = "/ˈklaɪmət/", PartOfSpeech = "noun", Meaning = "Khí hậu", Example = "Climate change poses existential threats to island nations globally.", ExampleMeaning = "Biến đổi khí hậu đặt ra các mối đe dọa sinh tồn cho các quốc đảo trên toàn cầu.", Topic = "Environment", CefrLevel = "B1" },
        new IeltsVocabularyItem { Word = "develop", Phonetic = "/dɪˈveləp/", PartOfSpeech = "verb", Meaning = "Phát triển", Example = "Children develop cognitive abilities rapidly in early childhood.", ExampleMeaning = "Trẻ em phát triển các khả năng nhận thức nhanh chóng trong thời thơ ấu.", Topic = "Education", CefrLevel = "B1" },
        new IeltsVocabularyItem { Word = "achieve", Phonetic = "/əˈtʃiːv/", PartOfSpeech = "verb", Meaning = "Đạt được", Example = "Hard work and dedication allow students to achieve high band scores.", ExampleMeaning = "Sự chăm chỉ và cống hiến giúp học sinh đạt được điểm số cao.", Topic = "Education", CefrLevel = "B2" },
        new IeltsVocabularyItem { Word = "economic", Phonetic = "/ˌekəˈnɒmɪk/", PartOfSpeech = "adj", Meaning = "Thuộc kinh tế", Example = "Rapid economic growth has transformed living standards nationwide.", ExampleMeaning = "Tăng trưởng kinh tế nhanh chóng đã thay đổi mức sống trên toàn quốc.", Topic = "Economy", CefrLevel = "B2" },
