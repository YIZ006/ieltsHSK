        var now = DateTime.UtcNow;
        for (int i = 0; i < minionCount; i++)
        {
            var vocab = GetNextOrRandomVocab();
            double x = 14.0 + (i * (72.0 / Math.Max(1, minionCount - 1))) + (hskRng.NextDouble() * 4.0 - 2.0);
