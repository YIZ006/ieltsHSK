@using Frontend.App.Models
@using Frontend.App.Services
@inject HskService HskSvc
@inject ProfileService ProfileSvc
@inject IJSRuntime JS
@inject UserGameProgressService GameProgressService
@implements IDisposable

    <div class="fullscreen-game-overlay hsk-game-overlay @(IsHskGamePaused ? "is-paused" : "")" @ref="hskOverlayRef" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick="FocusHskOnBackgroundClick">
        <!-- Topbar -->
        <header class="fullscreen-topbar hsk-topbar">
            <div class="topbar-left">
                <div class="fs-game-badge hsk-badge-pill">
                    <i class="bi bi-crosshair"></i> HSK SHOOTER
                </div>
                <span class="fs-game-title">Cấp độ: <b>@hskShooterSelectedLevel</b></span>
                @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
                {
                    <button type="button" class="hsk-stage-badge-btn @(_currentStageIndex == _totalStages - 1 ? "boss-stage" : "")" @onclick="OpenStageMap" title="Xem bản đồ tầng (Tạm dừng game)">
                        <span class="topbar-user-avt" style="background: @_userAvatarColor" title="@_userDisplayName">@_userAvatarEmoji</span>
                        <span>Tầng @(_currentStageIndex + 1)/@_totalStages</span>
                    </button>

                    @if (_isAllStagesUnlocked)
                    {
                        <div class="hsk-stage-quick-nav" title="Nhảy nhanh đến tầng bất kỳ (Chế độ Test)">
                            <i class="bi bi-compass-fill text-warning"></i>
                            <select class="hsk-stage-select-dropdown" value="@_currentStageIndex" @onchange="OnQuickStageSelectChanged">
                                @for (int s = 0; s < _totalStages; s++)
                                {
                                    var sIdx = s;
                                    <option value="@sIdx">
                                        @(sIdx == _totalStages - 1 ? $"👑 Tầng {sIdx + 1} (BOSS CUỐI)" : $"Tầng {sIdx + 1}")
                                    </option>
                                }
                            </select>
                        </div>
                    }
                }
            </div>

            <div class="topbar-center">
                <span class="fs-stat-pill text-warning"><i class="bi bi-star-fill"></i> Điểm: <b>@hskScore</b></span>
                <span class="fs-stat-pill text-danger"><i class="bi bi-heart-fill"></i> Mạng: <b>@Math.Max(0, hskLives) ❤</b></span>
                <span class="fs-stat-pill text-info"><i class="bi bi-bullseye"></i> Đã bắn: <b>@hskWordsShot</b></span>
                @if (hskCombo >= 2)
                {
                    <span class="fs-stat-pill hsk-combo-pill"><i class="bi bi-fire"></i> Combo <b>x@(hskCombo)</b></span>
                }
            </div>

            <div class="topbar-right">
                <button type="button" class="btn-unlock-toggle @(_isAllStagesUnlocked ? "active" : "")" @onclick="ToggleUnlockAllStages" title="Bật/Tắt chế độ mở khóa full bàn để test">
                    <i class="bi @(_isAllStagesUnlocked ? "bi-unlock-fill text-warning" : "bi-lock-fill")"></i>
                    @(_isAllStagesUnlocked ? "Full Bàn: BẬT" : "Full Bàn: TẮT")
                </button>
                <button class="btn-bgm @(_isBgmOn ? "active" : "")" @onclick="ToggleBgm" title="Bật/Tắt Nhạc Nền (Phím 1)">
                    <i class="bi @(_isBgmOn ? "bi-music-note-beamed" : "bi-volume-mute-fill")"></i>
                    @(_isBgmOn ? "Nhạc: BẬT" : "Nhạc: TẮT")
                    <span class="kbd-badge-sm">1</span>
                </button>
                @if (!IsCurrentStageCleared())
                {
                    <button type="button" class="btn-pinyin-toggle pinyin-locked" @onclick="TogglePinyin" title="Tầng này chưa vượt qua nên Pinyin bị khóa! (Phím 2)">
                        <i class="bi bi-lock-fill text-warning"></i>
                        <span>Khóa Pinyin</span>
                        <span class="kbd-badge-sm">2</span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn-pinyin-toggle @(!_showPinyin ? "pinyin-off" : "")" @onclick="TogglePinyin" title="Bật/Tắt hiển thị Pinyin gợi ý (Phím 2)">
                        <i class="bi @(_showPinyin ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                        @(_showPinyin ? "Ẩn Pinyin" : "Hiện Pinyin")
                        <span class="kbd-badge-sm">2</span>
                    </button>
                }
                <button class="btn-fs-tool" @onclick="ToggleHskPause" title="Tạm dừng / Tiếp tục (Phím 3)">
                    <i class="bi @(hskShooterState == HskGameState.Paused ? "bi-play-fill" : "bi-pause-fill")"></i>
                    @(hskShooterState == HskGameState.Paused ? "Tiếp tục" : "Tạm dừng")
                    <span class="kbd-badge-sm">3</span>
                </button>
                <button class="btn-fs-exit" @onclick="CloseHskShooterGame" title="Thoát trò chơi (Phím Esc)">
                    <i class="bi bi-x-lg me-1"></i> Thoát
                    <span class="kbd-badge-sm">Esc</span>
                </button>
            </div>
        </header>

        <!-- Shooter Battlefield -->
        <main class="hsk-battlefield @(IsHskGamePaused ? "is-paused" : "")" @onclick="FocusHskInput">
            <!-- Corner Floating Map Button in Battlefield -->
            @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
            {
                <button type="button" class="hsk-corner-map-fab" @onclick="OpenStageMap" @onclick:stopPropagation="true" title="Xem bản đồ tháp tầng (Tạm dừng game)">
                    <div class="fab-user-avatar" style="background: @_userAvatarColor" title="@_userDisplayName - Tầng @(_currentStageIndex + 1)">
                        <span>@_userAvatarEmoji</span>
                        <span class="fab-avatar-online"></span>
                    </div>
                    <span class="fab-text">
                        <span class="fab-title">BẢN ĐỒ TẦNG</span>
                        <span class="fab-stage">Tầng @(_currentStageIndex + 1)/@_totalStages</span>
                    </span>
                </button>
            }

            <!-- Damage Flash overlay -->
            @if (showDamageFlash)
            {
                <div class="hsk-damage-flash"></div>
            }

            <!-- Floating Flaming Combo Banner -->
            @if (hskCombo >= 2)
            {
                <div class="hsk-combo-banner">
                    <span class="combo-fire">🔥</span>
                    <span class="combo-count">@hskCombo</span>
                    <span class="combo-text">COMBO!</span>
                </div>
            }

            <!-- Stage Progress Bar (Standard or PvZ Boss Battle Style) -->
            @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
            {
                @if (_isBossStage && _bossPhase != BossPhase.None && _bossPhase != BossPhase.Warning && _bossPhase != BossPhase.Dialogue)
                {
                    <div class="boss-pvz-progress-bar-wrap">
                        <div class="boss-pvz-track">
                            <div class="boss-pvz-fill" style="width: @(BossProgressPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>

                            <!-- Flag 1: Đợt 1 (Triệu hồi tiểu quái) -->
                            <div class="pvz-flag @(BossProgressPercent >= 26.8 ? "flag-reached" : "")" style="left: 26.9%;" title="Đợt 1: Tiểu Quái">
                                <span class="flag-icon">🚩</span>
                                <span class="flag-label">Đợt 1</span>
                            </div>

                            <!-- Flag 2: Đợt 2 (Tụ lực quả cầu) -->
                            <div class="pvz-flag @(BossProgressPercent >= 64.1 ? "flag-reached" : "")" style="left: 64.2%;" title="Đợt 2: Tụ Lực">
                                <span class="flag-icon">⚡</span>
                                <span class="flag-label">Đợt 2</span>
                            </div>

                            <!-- Flag 3: Đợt 3 (Tổng Lực Tối Thượng - Cột mốc cuối cùng) -->
                            <div class="pvz-flag pvz-final-flag @(BossProgressPercent >= 98.0 ? "flag-reached" : "")" style="left: 98.5%;" title="Đợt 3: Tổng Lực Cuối">
                                <span class="flag-icon">👑</span>
                                <span class="flag-label">Tổng Lực</span>
                            </div>

                            <!-- Runner indicator (moving sword along track) -->
                            <div class="pvz-runner" style="left: @(BossProgressPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%">
                                <span class="runner-icon">⚔️</span>
                            </div>
                        </div>

                        <div class="boss-pvz-meta">
                            <span class="pvz-phase-title"><i class="bi bi-shield-shaded text-warning"></i> @GetBossPhaseName()</span>
                            <span class="pvz-percent-text">@((int)BossProgressPercent)% TIẾN ĐỘ TRẬN ĐẤU</span>
                        </div>
                    </div>
                }
                else if (!_isBossStage)
                {
                    <div class="hsk-stage-progress-bar">
                        <div class="hsk-stage-progress-fill" style="width: @((double)hskWordsShotInStage / Math.Max(1, _currentStageTotalWords) * 100)%"></div>
                    </div>
                }
            }

            <!-- Boss Warning Ribbon Overlay -->
            @if (_showBossWarning)
            {
                <div class="boss-warning-overlay">
                    <div class="hazard-ribbon hazard-top"></div>
                    <div class="boss-warning-card">
                        <div class="warning-alert-tag"><i class="bi bi-exclamation-triangle-fill"></i> CẢNH BÁO KHẨN CẤP <i class="bi bi-exclamation-triangle-fill"></i></div>
                        <h2 class="warning-boss-name">MA VƯƠNG HÁN TỰ GIÁNG LÂM</h2>
                        <div class="warning-stage-info">TRÙM CUỐI • TẦNG @_totalStages • @hskShooterSelectedLevel</div>
                    </div>
                    <div class="hazard-ribbon hazard-bottom"></div>
                </div>
            }

            <!-- Boss Dialogue Cutscene Modal -->
            @if (_showBossDialogue)
            {
                <div class="boss-dialogue-overlay" @onclick="AdvanceBossDialogue">
                    <div class="boss-dialogue-modal" @onclick:stopPropagation="true">
                        <div class="boss-dialogue-portrait-box">
                            <img src="images/games/hsk-boss-emperor.png" alt="Ma Vương Hán Tự" class="boss-dialogue-avatar" />
                            <div class="boss-dialogue-aura"></div>
                        </div>
                        <div class="boss-dialogue-content">
                            <div class="boss-dialogue-header">
                                <span class="boss-dialogue-crown">👑</span>
                                <span class="boss-dialogue-title">MA VƯƠNG HÁN TỰ (汉字魔王)</span>
                                <span class="boss-dialogue-badge">@hskShooterSelectedLevel</span>
                            </div>
                            <div class="boss-dialogue-speech">
                                @if (!string.IsNullOrEmpty(_displayedBossDialogueZh))
                                {
                                    <div class="boss-dialogue-chinese">@_displayedBossDialogueZh</div>
                                }
                                <p class="boss-speech-text">@_displayedBossDialogue<span class="typewriter-blink">|</span></p>
                            </div>
                            <div class="boss-dialogue-actions">
                                <span class="dialogue-shortcut-hint"><kbd>Space</kbd> hoặc <kbd>Enter</kbd></span>
                                <button type="button" class="btn-boss-dialogue-advance" @onclick="AdvanceBossDialogue">
                                    @(_bossDialogueFinished ? "BẮT ĐẦU CHIẾN ĐẤU ⚔️" : "Tiếp tục ⏭")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- In-game Boss Arena HUD & Floating Boss (During fight) -->
            @if (_isBossStage && _bossPhase != BossPhase.None && _bossPhase != BossPhase.Warning && _bossPhase != BossPhase.Dialogue)
            {
                <div class="boss-arena-hud @(_bossHitFlash ? "boss-damaged" : "")">
                    <div class="boss-floating-actor">
                        <div class="boss-actor-shadow-portal"></div>
                        <img src="images/games/hsk-boss-emperor.png" alt="Ma Vương Hán Tự" class="boss-actor-sprite" />
                        @if (_bossPhase == BossPhase.Wave2_Charging || _bossPhase == BossPhase.Wave3_FinalSurge)
                        {
                            <div class="boss-charging-energy-orb">
                                <img src="images/games/hsk-boss-orb-aura.png" alt="Aura" class="boss-orb-aura-bg" />
                                <img src="images/games/hsk-boss-orb.png" alt="Energy Core" class="boss-orb-core-img" />
                                <div class="energy-orb-sparks"></div>
                            </div>
                        }
                    </div>

                    <div class="boss-top-hud-bar">
                        <div class="boss-hud-header-row">
                            <span class="boss-hud-name">👑 MA VƯƠNG HÁN TỰ</span>
                            <span class="boss-hud-phase-tag">@GetBossPhaseName()</span>
                        </div>
                        @if (_bossPhase == BossPhase.Wave2_Charging || _bossPhase == BossPhase.Wave3_FinalSurge)
                        {
                            <div class="boss-charge-timer-container">
                                <div class="boss-charge-track">
                                    <div class="boss-charge-fill" style="width: @((BossChargeMaxTime - _bossChargeTimer) / BossChargeMaxTime * 100)%"></div>
                                </div>
                                <span class="boss-charge-timer-text"><i class="bi bi-lightning-charge-fill"></i> TỤ LỰC: @(_bossChargeTimer.ToString("0.0"))s (-2❤️ nếu nổ)</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Orbiting Words around Energy Orb (Wave 2 & Wave 3) -->
                @if ((_bossPhase == BossPhase.Wave2_Charging || _bossPhase == BossPhase.Wave3_FinalSurge) && _orbitingWords.Any())
                {
                    <div class="boss-orbit-track-area">
                        @foreach (var ow in _orbitingWords.Where(w => !w.IsDestroyed))
                        {
                            <div class="boss-orbit-word @(IsHskTargeted(ow) ? "targeted" : "") @(ow.HitFlash ? "hit-flash" : "")"
                                 style="left: calc(50% + @((Math.Cos(ow.AngleDeg * Math.PI / 180.0) * ow.RadiusPx).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))px); top: calc(23% + @((Math.Sin(ow.AngleDeg * Math.PI / 180.0) * (ow.RadiusPx * 0.55)).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))px);">
                                <div class="orbit-shield-ring"></div>
                                <span class="orbit-hanzi">@ow.Vocab.Hanzi</span>
                                @if (_showPinyin)
                                {
                                    <span class="orbit-pinyin">@ow.Vocab.Pinyin</span>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Giant Laser Blast when charge explodes -->
                @if (_showBossLaserBlast)
                {
                    <div class="boss-giant-laser-blast">
                        <div class="laser-screen-flash"></div>
                        <div class="laser-beam-wrapper">
                            <img src="images/games/hsk-boss-laser.png" alt="Laser Blast" class="boss-laser-sprite" />
                        </div>
                        <div class="laser-impact-crater"></div>
                    </div>
                }

                <!-- Boss Wave Announcement Toast -->
                @if (!string.IsNullOrEmpty(_bossWaveAnnouncement))
                {
                    <div class="boss-wave-announcement-banner">
                        <span>@_bossWaveAnnouncement</span>
                    </div>
                }

                <!-- Boss Skill Chant Shout Banner (Tung chiêu đọc tên tiếng Trung) -->
                @if (_showBossSkillBanner)
                {
                    <div class="boss-skill-chant-banner">
                        <div class="skill-chant-tag"><i class="bi bi-lightning-charge-fill"></i> TUYỆT KỸ MA VƯƠNG <i class="bi bi-lightning-charge-fill"></i></div>
                        <div class="skill-chant-chinese">@_bossSkillChinese</div>
                        <div class="skill-chant-vn">@_bossSkillVietnamese</div>
                    </div>
                }

                <!-- Boss Taunt / Reaction Speech Bubble (Nói sau khi vượt qua đợt) -->
                @if (_showBossTaunt)
                {
                    <div class="boss-taunt-speech-bubble">
                        <div class="taunt-avatar-thumb">
                            <img src="images/games/hsk-boss-emperor.png" alt="Boss" />
                        </div>
                        <div class="taunt-speech-body">
                            <div class="taunt-boss-title">👑 MA VƯƠNG HÁN TỰ</div>
                            <div class="taunt-chinese">@_bossTauntChinese</div>
                            <div class="taunt-vn">"@_bossTauntVietnamese"</div>
                        </div>
                    </div>
                }
            }

            <!-- Falling Words (Minions & standard words) -->
            @foreach (var word in hskActiveWords)
            {
                <div @key="word.Key" class="falling-word @(word.IsMinion ? "is-minion" : "") @(word.HitFlash ? "hit-flash" : "") @(word.IsDestroyed ? "destroyed" : "") @(IsHskTargeted(word) ? "targeted" : "") @(IsHskGamePaused ? "paused-anim" : "")"
                     style="--fall-duration: @(word.FallDurationCss)s; --x-pos: @(word.XPercentCss)%; @(IsHskGamePaused ? "animation-play-state: paused;" : "")">
                    @if (word.IsMinion)
                    {
                        <!-- Chữ hiện TRÊN ĐẦU LÍNH -->
                        <div class="minion-overhead-bubble">
                            <div class="minion-mini-badge">
                                <span>😈 TIỂU QUÁI</span>
                            </div>
                            <span class="word-hanzi">@word.Vocab.Hanzi</span>
                            @if (_showPinyin)
                            {
                                <span class="word-pinyin">@word.Vocab.Pinyin</span>
                            }
                            <div class="minion-bubble-pointer"></div>
                        </div>

                        <!-- Thân lính (Tiểu quái) ở DƯỚI CHỮ -->
                        <div class="minion-actor-unit">
                            <img src="images/games/hsk-minion.png" alt="Tiểu Quái" class="minion-sprite-img" />
                            <div class="minion-flight-aura"></div>
                        </div>
                    }
                    else
                    {
                        <span class="word-hanzi">@word.Vocab.Hanzi</span>
                        @if (_showPinyin)
                        {
                            <span class="word-pinyin">@word.Vocab.Pinyin</span>
                        }
                    }
                </div>
            }

            <!-- Laser Bullets (Đạn bắn vào từ vựng) -->
            @foreach (var bullet in hskBullets)
            {
                <div class="hsk-bullet @(IsHskGamePaused ? "paused-anim" : "")"
                     style="--start-x: @(bullet.StartXCss)%; --start-y: @(bullet.StartYCss)%; --target-x: @(bullet.TargetXCss)%; --target-y: @(bullet.TargetYCss)%; @(IsHskGamePaused ? "animation-play-state: paused;" : "")">
                    <div class="bullet-bolt"></div>
                </div>
            }

            <!-- Impact Explosions (Va chạm nổ từ vựng) -->
            @foreach (var impact in hskImpacts)
            {
                <div class="hsk-impact-burst @(IsHskGamePaused ? "paused-anim" : "")"
                     style="--target-x: @(impact.XCss)%; --target-y: @(impact.YCss)%; @(IsHskGamePaused ? "animation-play-state: paused;" : "")">
                    <div class="impact-ring"></div>
                    <span class="impact-flash">💥</span>
                </div>
            }

            <!-- Airplane -->
            @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
            {
                <div class="hsk-airplane"><i class="bi bi-airplane-fill"></i></div>
            }

            <!-- In-game Realtime Missed Alert Toast (Hiện đáp án từ vừa bỏ lỡ để cải thiện) -->
            @if (_showMissedBanner && _lastMissedVocab != null)
            {
                <div class="hsk-missed-alert-banner">
                    <span class="missed-tag">❌ BỎ LỠ</span>
                    <span class="missed-hanzi">@_lastMissedVocab.Hanzi</span>
                    <span class="missed-pinyin">[@_lastMissedVocab.Pinyin]</span>
                    <span class="missed-meaning">— @_lastMissedVocab.Meaning</span>
                </div>
            }

            <!-- Pinyin Input -->
            @if (hskShooterState == HskGameState.Playing && !_showStageComplete && !_showStageMap)
            {
                <div class="hsk-input-dock" @onclick:stopPropagation="true">
                    <input @ref="hskInputRef" type="text" @bind="hskInputValue" @bind:event="oninput"
                           @onkeydown="HandleInputKeyDown"
                           @onkeydown:stopPropagation="true"
                           placeholder="Gõ pinyin bắn từ vựng rơi..." autocomplete="off" spellcheck="false" autofocus />
                </div>
            }

            <!-- Paused Screen -->
            @if (hskShooterState == HskGameState.Paused && !_showStageMap)
            {
                <div class="hsk-dialog-card">
                    <h2><i class="bi bi-pause-circle-fill text-warning me-2"></i>TẠM DỪNG</h2>
                    <p>Trò chơi đang tạm dừng. Hãy bấm Tiếp tục khi bạn sẵn sàng!</p>
                    <div class="hsk-dialog-btns">
                        <button class="btn-hsk-resume" @onclick="ToggleHskPause">Tiếp tục chơi</button>
                        <button class="btn-hsk-quit" @onclick="CloseHskShooterGame">Thoát ra ngoài</button>
                    </div>
                </div>
            }

            <!-- Game Over Screen -->
            @if (hskShooterState == HskGameState.GameOver)
            {
                <div class="hsk-dialog-card gameover">
                    <h2><i class="bi bi-award-fill text-warning me-2"></i>KẾT THÚC!</h2>
                    <p>Bạn đã để lọt quá nhiều từ vựng.</p>
                    <div class="hsk-score-grid">
                        <div class="hsk-score-box">
                            <div class="val text-warning">@hskScore</div>
                            <div class="lbl">Tổng Điểm</div>
                        </div>
                        <div class="hsk-score-box">
                            <div class="val text-success">@hskWordsShot</div>
                            <div class="lbl">Từ Bắn Được</div>
                        </div>
                        <div class="hsk-score-box">
                            <div class="val text-info">@hskNewLearned</div>
                            <div class="lbl">Từ Thuộc Mới</div>
                        </div>
                    </div>

                    @if (_missedWordsInStage.Count > 0)
                    {
                        <div class="hsk-review-section">
                            <div class="review-header">
                                <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                                <b>Đáp án các từ đã bỏ lỡ (để ôn tập cải thiện):</b>
                            </div>
                            <div class="review-items-scroll">
                                @foreach (var m in _missedWordsInStage.DistinctBy(x => x.Id))
                                {
                                    <div class="review-item">
                                        <b class="review-hanzi">@m.Hanzi</b>
                                        <span class="review-pinyin">[@m.Pinyin]</span>
                                        <span class="review-meaning">— @m.Meaning</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="hsk-dialog-btns">
                        <button class="btn-hsk-resume" @onclick="() => LoadStage(_currentStageIndex)" autofocus>Chơi lại tầng @(_currentStageIndex + 1) <span class="kbd-badge">Enter ↵</span></button>
                        <button class="btn-hsk-quit" @onclick="CloseHskShooterGame">Thoát ra danh sách game</button>
                    </div>
                </div>
            }

            <!-- Stage Complete Overlay -->
            @if (_showStageComplete)
            {
                <div class="hsk-stage-complete-overlay" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick:stopPropagation="true">
                    <div class="hsk-stage-complete-card">
                        <div class="stage-complete-trophy">@(_currentStageIndex == _totalStages - 1 ? "🏆" : "⭐")</div>
                        <h2>🎉 XUẤT SẮC QUA MÀN! HOÀN THÀNH TẦNG @(_currentStageIndex + 1)!</h2>
                        <p>@(_currentStageIndex == _totalStages - 1 ? "Tuyệt vời! Bạn đã chinh phục toàn bộ cấp độ này." : "Chuẩn bị tiến vào tầng tiếp theo với độ khó tăng dần.")</p>
                        
                        <div class="stage-complete-stats">
                            <div class="stage-stat-pill">
                                <div class="val text-success">@hskWordsShotInStage</div>
                                <div class="lbl">Từ đã bắn</div>
                            </div>
                            <div class="stage-stat-pill">
                                <div class="val text-danger">@Math.Max(0, hskLives)</div>
                                <div class="lbl">Mạng còn</div>
                            </div>
                            <div class="stage-stat-pill">
                                <div class="val text-warning">@hskScore</div>
                                <div class="lbl">Tổng điểm</div>
                            </div>
                        </div>

                        @if (_missedWordsInStage.Count > 0)
                        {
                            <div class="hsk-review-section">
                                <div class="review-header">
                                    <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                                    <b>Đáp án các từ đã bỏ lỡ trong tầng này:</b>
                                </div>
                                <div class="review-items-scroll">
                                    @foreach (var m in _missedWordsInStage.DistinctBy(x => x.Id))
                                    {
                                        <div class="review-item">
                                            <b class="review-hanzi">@m.Hanzi</b>
                                            <span class="review-pinyin">[@m.Pinyin]</span>
                                            <span class="review-meaning">— @m.Meaning</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (_currentStageIndex < _totalStages - 1)
                        {
                            <div class="stage-countdown-box">
                                <div class="sc-label">Tự động tiến vào Tầng @(_currentStageIndex + 2) sau:</div>
                                <div class="sc-circle">
                                    <span class="sc-number">@_stageCountdown</span>
                                </div>
                                <div class="sc-sub">Nhấn <b>Enter</b> hoặc bấm nút bên dưới để vào ngay</div>
                            </div>

                            <button class="btn-hsk-resume w-100" @onclick="SkipCountdownAndNextStage" autofocus>
                                Tiến vào Tầng @(_currentStageIndex + 2) ngay <span class="kbd-badge">Enter ↵</span> <i class="bi bi-arrow-right"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn-hsk-resume w-100" @onclick="CloseHskShooterGame" autofocus>
                                Chiến thắng & Thoát <span class="kbd-badge">Enter ↵</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Resume Progress Dialog -->
            @if (_showResumeDialog)
            {
                <div class="hsk-resume-overlay" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick:stopPropagation="true">
                    <div class="hsk-resume-card">
                        <div class="resume-icon">💾</div>
                        <h3>Đã tìm thấy dữ liệu lưu</h3>
                        <p>Bạn đã từng chơi cấp độ <b>@hskShooterSelectedLevel</b> đến <b>Tầng @(_savedStageIndex + 1)</b>. Bạn có muốn tiếp tục hay chơi lại từ đầu?</p>
                        <div class="save-warning-box">
                            Lưu ý: Nếu chọn tiếp tục, các từ ở tầng trước sẽ không xuất hiện lại trong lần chơi này.
                        </div>
                        <div class="hsk-resume-btns">
                            <button class="btn-resume-continue" @onclick="ResumeFromSavedStage" autofocus>Tiếp tục từ Tầng @(_savedStageIndex + 1) <span class="kbd-badge">Enter ↵</span></button>
                            <button class="btn-resume-restart" @onclick="StartFreshFromStage0">Chơi lại từ đầu (Tầng 1)</button>
                        </div>
                    </div>
                </div>
            }

            <!-- Stage Map Modal (Bản đồ tháp tầng) -->
            @if (_showStageMap)
            {
                <div class="stage-map-overlay" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick:stopPropagation="true">
                    <header class="stage-map-header">
                        <div class="header-left">
                            <div class="header-title-group">
                                <h3><i class="bi bi-map-fill me-2"></i> BẢN ĐỒ THÁP TẦNG - @hskShooterSelectedLevel</h3>
                                <span class="header-sub">Dí chuột kéo lên/xuống để xem toàn bộ các tầng</span>
                            </div>
                            <div class="header-user-status" title="@_userDisplayName">
                                <div class="header-user-avt" style="background: @_userAvatarColor">@_userAvatarEmoji</div>
                                <div class="header-user-meta">
                                    <span class="user-meta-name">@_userDisplayName</span>
                                    <span class="user-meta-floor"><i class="bi bi-geo-alt-fill text-danger"></i> Đang ở Tầng @(_currentStageIndex + 1)/@_totalStages</span>
                                </div>
                            </div>
                        </div>
                        <div class="header-right">
                            <button type="button" class="btn-map-unlock-all @(_isAllStagesUnlocked ? "active" : "")" @onclick="ToggleUnlockAllStages" title="Bật/Tắt mở khóa toàn bộ các tầng trên bản đồ">
                                <i class="bi @(_isAllStagesUnlocked ? "bi-unlock-fill text-warning" : "bi-lock-fill")"></i>
                                @(_isAllStagesUnlocked ? "Đã Mở Khóa Full Bàn" : "Mở Khóa Full Bàn")
                            </button>
                            <button type="button" class="btn-resume-from-map" @onclick="ResumeAndCloseMap" title="Tiếp tục chơi">
                                <i class="bi bi-play-fill"></i> Tiếp tục chơi
                            </button>
                            <button type="button" class="btn-close-map" @onclick="CloseStageMap" title="Đóng bản đồ (Esc)"><i class="bi bi-x-lg"></i></button>
                        </div>
                    </header>
                    <div class="stage-map-scroll candy-crush-map" id="hskStageMapScroll">
                        <div class="cc-summit">
                            <div class="cc-summit-crown">👑</div>
                            <div class="cc-summit-title">TRÙM CUỐI - TẦNG @_totalStages</div>
                        </div>

                        <div class="cc-path-container">
                        @for (int i = _totalStages - 1; i >= 0; i--)
                        {
                            var stageIdx = i;
                            var isBoss = stageIdx == _totalStages - 1;
                            var isCurrent = stageIdx == _currentStageIndex;
                            var isActive = isCurrent && !_showStageComplete;
                            var isDone = _clearedStageIndices.Contains(stageIdx) || stageIdx < _highestClearedStageIndex;
                            var isUnlocked = _isAllStagesUnlocked || stageIdx <= _maxUnlockedStageIndex || isDone;
                            var isLocked = !isUnlocked;
                            var reverseIdx = _totalStages - 1 - stageIdx;
                            var isLeft = reverseIdx % 2 == 0;

                            var nodeClass = "cc-node";
                            if (isBoss) nodeClass += " cc-boss";
                            if (isDone && !isActive) nodeClass += " cc-done";
                            if (isActive) nodeClass += " cc-active";
                            if (isLocked) nodeClass += " cc-locked";

                            <div class="@nodeClass" style="align-self: @(isLeft ? "flex-start" : "flex-end")">
                                @if (stageIdx < _totalStages - 1)
                                {
                                    <div class="cc-connector @(isLeft ? "cc-conn-right" : "cc-conn-left")"></div>
                                }
                                <div class="cc-node-circle" @onclick="async () => { if (isUnlocked) { if (isActive) ResumeAndCloseMap(); else await ReplayStage(stageIdx); } }">
                                    @if (isCurrent)
                                    {
                                        <div class="player-map-avatar-circle" style="background: @_userAvatarColor">
                                            <span class="avatar-icon">@_userAvatarEmoji</span>
                                            <span class="floor-num-badge">T@(stageIdx + 1)</span>
                                            <div class="sonar-wave"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        @(isBoss ? "☠️" : (stageIdx + 1).ToString())
                                    }
                                </div>
                                <div class="cc-stars">
                                    @if (isDone) { <span>⭐⭐⭐</span> }
                                    else if (isLocked) { <span>🔒</span> }
                                    else { <span>☆☆☆</span> }
                                </div>
                            </div>
                        }
                        </div>

                        <div class="cc-base">
                            <div class="cc-base-flag">🚩</div>
                            <div class="cc-base-title">XUẤT PHÁT</div>
                        </div>
                    </div>
                </div>
            }
        </main>
    </div>


@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnStatsChanged { get; set; }
    [Parameter] public string SelectedLevel { get; set; } = "HSK1";
    [Parameter] public bool IsAllStagesUnlocked { get; set; } = false;

    private bool isPlayingHskShooter = true;
    private string toastMessage = "";
    private void ShowToast(string msg) { toastMessage = msg; StateHasChanged(); }
    private void CloseGameInfo() { }

    // === HSK SHOOTER GAME STATE ===
    private enum HskGameState { Menu, Playing, Paused, GameOver }
    private HskGameState hskShooterState = HskGameState.Menu;
    private string hskShooterSelectedLevel = "HSK1";
    private List<HskVocabularyItem> hskVocabPool = new();
    private List<FallingWord> hskActiveWords = new();
    private int hskSpawnIndex;
    private int hskScore;
    private const int HskMaxLives = 5;
    private int hskLives = HskMaxLives;
    private int hskWordsShot;
    private int hskNewLearned;
    private int hskCombo = 0;
    private bool showDamageFlash = false;
    private bool _showMissedBanner = false;
    private HskVocabularyItem? _lastMissedVocab;
    private readonly List<HskVocabularyItem> _missedWordsInStage = new();
    private CancellationTokenSource? _missedAlertCts;
    private string _hskInputValue = "";
    private string hskInputValue
    {
        get => _hskInputValue;
        set
        {
            _hskInputValue = value;
            TryMatchHskWord();
        }
    }
    private ElementReference hskInputRef;
    private ElementReference hskOverlayRef;
    private Timer? hskTimer;
    private readonly Random hskRng = new();

    private sealed class FallingWord
    {
        public string Key { get; init; } = Guid.NewGuid().ToString();
        public required HskVocabularyItem Vocab { get; init; }
        public DateTime SpawnTime { get; set; }
        public double FallDurationSec { get; init; }
        public double XPercent { get; init; }
        public bool IsDestroyed { get; set; }
        public bool IsMinion { get; set; }
        public bool HitFlash { get; set; }

        public string FallDurationCss => FallDurationSec.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        public string XPercentCss => XPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }

    private enum BossPhase
    {
        None,
        Warning,
        Dialogue,
        Warmup1,
        Wave1_Minions,
        Warmup2,
        Wave2_Charging,
        Warmup3,
        Wave3_FinalSurge,
        Defeated
    }

    private sealed class OrbitingWord
    {
        public int Id { get; set; }
        public required HskVocabularyItem Vocab { get; set; }
        public double AngleDeg { get; set; }
        public double RadiusPx { get; set; } = 130.0;
        public bool IsDestroyed { get; set; }
        public bool HitFlash { get; set; }
    }

    private sealed class ActiveBullet
    {
        public long Id { get; init; }
        public double StartX { get; init; } = 50.0;
        public double StartY { get; init; } = 86.0;
        public double TargetX { get; init; }
        public double TargetY { get; init; }
        public string StartXCss => StartX.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        public string StartYCss => StartY.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        public string TargetXCss => TargetX.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        public string TargetYCss => TargetY.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }

    private sealed class ActiveImpact
    {
        public long Id { get; init; }
        public double X { get; init; }
        public double Y { get; init; }
        public string XCss => X.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        public string YCss => Y.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }

    private readonly List<ActiveBullet> hskBullets = new();
    private readonly List<ActiveImpact> hskImpacts = new();
    private long _bulletCounter = 0;
    private long _impactCounter = 0;
    private bool _isBgmOn = false;
    private int _stageCountdown = 3;
    private Timer? _countdownTimer;
    private DateTime _lastHskSpawnTime = DateTime.MinValue;



    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(SelectedLevel))
        {
            hskShooterSelectedLevel = SelectedLevel;
        }
        if (IsAllStagesUnlocked)
        {
            _isAllStagesUnlocked = true;
        }
        await LoadUserProfileAsync();
        await StartHskShooterGame();
    }

    private async Task LoadUserProfileAsync()
    {
        try
        {
            var profile = await ProfileSvc.GetAsync();
            if (profile != null)
            {
                if (!string.IsNullOrWhiteSpace(profile.AvatarEmoji)) _userAvatarEmoji = profile.AvatarEmoji;
                if (!string.IsNullOrWhiteSpace(profile.AvatarColor)) _userAvatarColor = profile.AvatarColor;
                if (!string.IsNullOrWhiteSpace(profile.DisplayName)) _userDisplayName = profile.DisplayName;
                else if (!string.IsNullOrWhiteSpace(profile.FullName)) _userDisplayName = profile.FullName;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task CloseHskShooter()
    {
        await OnClose.InvokeAsync();
    }

    // === HSK SHOOTER ACTIONS & LOGIC ===
    private const int WordsPerStage = 20;
    private bool _showPinyin = false;
    private int _highestClearedStageIndex = 0;
    private HashSet<int> _clearedStageIndices = new();
    private int _currentStageIndex = 0;
    private int _totalStages = 1;
    private int _savedStageIndex = 0;
    private int _maxUnlockedStageIndex = 0;
    private bool _showStageMap = false;
    private bool _showResumeDialog = false;
    private bool _showStageComplete = false;
    private bool _isAllStagesUnlocked = true; // Mặc định mở khóa full bàn để test mọi bàn chơi theo yêu cầu

    private bool IsCurrentStageCleared() =>
        _clearedStageIndices.Contains(_currentStageIndex) || _currentStageIndex < _highestClearedStageIndex;

    // Boss Stage Variables (Tầng 25 / Tầng cuối)
    private bool _isBossStage => _totalStages > 0 && _currentStageIndex == _totalStages - 1;
    private bool _showBossWarning = false;
    private bool _showBossDialogue = false;
    private bool _bossDialogueFinished = false;
    private string _fullBossDialogue = "";
    private string _displayedBossDialogue = "";
    private CancellationTokenSource? _typewriterCts;

    private BossPhase _bossPhase = BossPhase.None;
    private bool _bossHitFlash = false;
    private const double BossChargeMaxTime = 11.0;
    private double _bossChargeTimer = 11.0;
    private int _bossChargeCycle = 1;
    private bool _isBossCycleTransitioning = false;
    private List<OrbitingWord> _orbitingWords = new();
    private bool _showBossLaserBlast = false;
    private string _bossWaveAnnouncement = "";
    private CancellationTokenSource? _announcementCts;

    // Boss Skills & Voice Taunts
    private string _bossSkillChinese = "";
    private string _bossSkillVietnamese = "";
    private bool _showBossSkillBanner = false;
    private CancellationTokenSource? _skillBannerCts;

    private string _bossTauntChinese = "";
    private string _bossTauntVietnamese = "";
    private bool _showBossTaunt = false;
    private CancellationTokenSource? _tauntCts;

    private string _displayedBossDialogueZh = "";

    // PvZ-style Boss Battle Progress Bar & Targets
    private const int BossWarmup1Target = 12; // Dạo đầu: 10-15 từ
    private const int BossWave1MinionsCount = 6; // Đợt 1: 6 quái
    private const int BossWarmup2Target = 16; // Dạo giữa 1: 15-20 từ
    private const int BossWave2Target = 9;   // Đợt 2: 3 chu kỳ x 3 từ = 9 từ
    private const int BossWarmup3Target = 16; // Dạo giữa 2: 15-20 từ
    private const int BossWave3Target = 6;   // Đợt 3: 3 quái + 3 từ tụ lực = 6 mục tiêu (giảm quái còn 3 theo yêu cầu)
    private const int BossTotalUnits = BossWarmup1Target + BossWave1MinionsCount + BossWarmup2Target + BossWave2Target + BossWarmup3Target + BossWave3Target; // 65 units
    
    private int _bossProgressUnits = 0;
    private double BossProgressPercent => Math.Clamp((double)_bossProgressUnits / Math.Max(1, BossTotalUnits) * 100.0, 0.0, 100.0);
    private int _bossWarmupWordsShotInPhase = 0;

    private void AdvanceStageProgressUnits()
    {
        _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);
        StateHasChanged();
    }
    
    private List<HskVocabularyItem> _currentStageWords = new();
    private readonly HashSet<string> _usedVocabHanziInStage = new();
    private int _currentStageTotalWords = 0;
    private int hskWordsShotInStage = 0;
    // User Profile for Map & Battlefield Presence
    private string _userAvatarEmoji = "🎓";
    private string _userAvatarColor = "#38bdf8";
    private string _userDisplayName = "Bạn";

    private DateTime? _hskPauseStartTime;
    private bool _wasPausedByMap = false;
    private bool IsHskGamePaused => hskShooterState == HskGameState.Paused || _showStageMap;

    private async Task TogglePinyin()
    {
        if (!IsCurrentStageCleared())
        {
            _showPinyin = false;
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.keyEnterError?.()");
            await JS.InvokeVoidAsync("MascotManager.gameSay", "pinyin_locked",
                $"Tầng {_currentStageIndex + 1} chưa vượt qua! 🔒",
                "Phải vượt qua tầng này trước mới mở được Pinyin trợ giúp nhé! 🦊",
                "surprised");
            StateHasChanged();
            if (isPlayingHskShooter && hskShooterState == HskGameState.Playing)
            {
                _ = FocusHskInput();
            }
            return;
        }

        _showPinyin = !_showPinyin;
        StateHasChanged();
        if (isPlayingHskShooter && hskShooterState == HskGameState.Playing)
        {
            _ = FocusHskInput();
        }
    }

    private void OpenStageMap()
    {
        if (hskShooterState == HskGameState.Playing)
        {
            _wasPausedByMap = true;
            ToggleHskPause();
        }
        _showStageMap = true;
        StateHasChanged();
        _ = ScrollStageMapToCurrentNode();
    }

    private void CloseStageMap()
    {
        _showStageMap = false;
        if (_wasPausedByMap)
        {
            _wasPausedByMap = false;
            if (hskShooterState == HskGameState.Paused)
            {
                ToggleHskPause();
                return;
            }
        }
        StateHasChanged();
        _ = FocusHskInput();
    }

    private void ResumeAndCloseMap()
    {
        CloseStageMap();
    }

    private async Task ScrollStageMapToCurrentNode()
    {
        try
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const scroll = document.getElementById('hskStageMapScroll');
                    const active = scroll?.querySelector('.cc-active, .player-map-avatar-circle');
                    if (scroll && active) {
                        const target = active.offsetTop - scroll.clientHeight / 2 + active.clientHeight / 2;
                        scroll.scrollTo({ top: target, behavior: 'smooth' });
                    }
                })();
            ");
        }
        catch { }
    }

    private async Task StartHskShooterGame()
    {
        _isBgmOn = true;
        var all = await HskSvc.GetVocabularyAsync(hskShooterSelectedLevel);
        hskVocabPool = all?.Where(v => v.IsActive && !string.IsNullOrWhiteSpace(v.Pinyin))
                          .DistinctBy(v => v.Hanzi.Trim())
                          .ToList() ?? new();
        if (hskVocabPool.Count == 0)
        {
            ShowToast($"Chưa có từ vựng cho cấp độ {hskShooterSelectedLevel}!");
            return;
        }

        CloseGameInfo();
        isPlayingHskShooter = true;
        hskShooterState = HskGameState.Playing;
        StateHasChanged();

        // Shuffle the entire pool once per level load
        for (int i = hskVocabPool.Count - 1; i > 0; i--)
        {
            int j = hskRng.Next(i + 1);
            (hskVocabPool[i], hskVocabPool[j]) = (hskVocabPool[j], hskVocabPool[i]);
        }

        _totalStages = (int)Math.Ceiling(hskVocabPool.Count / (double)WordsPerStage);
        if (_totalStages == 0) _totalStages = 1;

        // Check LocalStorage for unlock all setting and database / LocalStorage for saved progress and max unlocked stage
        try
        {
            var unlockAllPref = await JS.InvokeAsync<string>("localStorage.getItem", "hsk_unlock_all_stages");
            if (unlockAllPref == "false")
            {
                _isAllStagesUnlocked = false;
            }
            else
            {
                _isAllStagesUnlocked = true;
            }

            var (savedStage, maxUnlocked, _) = await GameProgressService.LoadProgressAsync("hsk_shooter", hskShooterSelectedLevel);

            _clearedStageIndices.Clear();
            _highestClearedStageIndex = Math.Max(0, maxUnlocked);
            for (int i = 0; i < _highestClearedStageIndex; i++)
            {
                _clearedStageIndices.Add(i);
            }

            try
            {
                var clearedStr = await JS.InvokeAsync<string>("localStorage.getItem", $"hsk_cleared_stages_{hskShooterSelectedLevel}");
                if (!string.IsNullOrWhiteSpace(clearedStr))
                {
                    var parts = clearedStr.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
                    foreach (var p in parts)
                    {
                        if (int.TryParse(p, out int sIdx))
                        {
                            _clearedStageIndices.Add(sIdx);
                            if (sIdx + 1 > _highestClearedStageIndex)
                            {
                                _highestClearedStageIndex = sIdx + 1;
                            }
                        }
                    }
                }
            }
            catch { }

            if (_isAllStagesUnlocked)
            {
                _maxUnlockedStageIndex = Math.Max(0, _totalStages - 1);
            }
            else if (maxUnlocked >= 0)
            {
                _maxUnlockedStageIndex = Math.Min(maxUnlocked, _totalStages - 1);
            }
            else
            {
                _maxUnlockedStageIndex = 0;
            }

            if (savedStage > 0 && savedStage < _totalStages)
            {
                _savedStageIndex = savedStage;
                _showResumeDialog = true;
                StateHasChanged();
                _ = FocusHskOverlay();
                return;
            }
        }
        catch { /* Ignore errors during prerendering/initialization */ }

        await StartFreshFromStage0();
    }

    private async Task StartFreshFromStage0()
    {
