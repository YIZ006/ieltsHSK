    private async Task ToggleUnlockAllStages()
    {
        _isAllStagesUnlocked = !_isAllStagesUnlocked;
        if (_isAllStagesUnlocked)
        {
            _maxUnlockedStageIndex = Math.Max(_maxUnlockedStageIndex, Math.Max(0, _totalStages - 1));
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "hsk_unlock_all_stages", "true");
            }
            catch { }
        }
        else
        {
            _maxUnlockedStageIndex = _clearedStageIndices.Count > 0 ? Math.Min(_totalStages - 1, _clearedStageIndices.Max() + 1) : 0;
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "hsk_unlock_all_stages", "false");
            }
            catch { }
        }
        StateHasChanged();
    }

    private async Task NextStage()
    {
        if (_currentStageIndex < _totalStages - 1)
        {
            await LoadStage(_currentStageIndex + 1);
        }
    }

    private async Task LoadStage(int stageIndex)
    {
        _countdownTimer?.Dispose();
        _showStageComplete = false;
        _hskPauseStartTime = null;
        _wasPausedByMap = false;
        _currentStageIndex = stageIndex;
        _maxUnlockedStageIndex = Math.Max(_maxUnlockedStageIndex, stageIndex);
        _lastHskSpawnTime = DateTime.MinValue;
        hskBullets.Clear();
        hskImpacts.Clear();

        // Tầng chưa vượt qua thì luôn khóa và ẩn Pinyin
        if (!IsCurrentStageCleared())
        {
            _showPinyin = false;
        }

        // Reset Boss State
        _showBossWarning = false;
        _showBossDialogue = false;
        _bossDialogueFinished = false;
        _typewriterCts?.Cancel();
        _announcementCts?.Cancel();
        _bossPhase = BossPhase.None;
        _bossHitFlash = false;
        _showBossLaserBlast = false;
        _bossWaveAnnouncement = "";
        _orbitingWords.Clear();
        _bossProgressUnits = 0;
        _bossWarmupWordsShotInPhase = 0;
        _isBossCycleTransitioning = false;
        _usedVocabHanziInStage.Clear();
        
        // Save progress & max unlocked to database & local cache
        _ = GameProgressService.SaveProgressAsync("hsk_shooter", hskShooterSelectedLevel, _currentStageIndex, _maxUnlockedStageIndex, hskScore);

        int normalStageWords = _totalStages > 1 
            ? Math.Max(10, (hskVocabPool.Count - 40) / (_totalStages - 1)) 
            : hskVocabPool.Count;

        int skip = stageIndex * normalStageWords;
        int take = (stageIndex == _totalStages - 1) ? Math.Max(0, hskVocabPool.Count - skip) : normalStageWords;
        
        _currentStageWords = hskVocabPool.Skip(skip).Take(take).ToList();
        _currentStageTotalWords = _currentStageWords.Count;
        
        hskSpawnIndex = 0;
        hskWordsShotInStage = 0;
        hskActiveWords.Clear();
        hskInputValue = "";
        hskCombo = 0;
        hskLives = HskMaxLives; // Qua mỗi màn luôn reset 5 tim đầy đủ
        _showMissedBanner = false;
        _lastMissedVocab = null;
        _missedWordsInStage.Clear();
        hskShooterState = HskGameState.Playing;

        hskTimer?.Dispose();
        hskTimer = new Timer(OnHskTick, null, 100, 100);

        if (_isBossStage)
        {
            _isBgmOn = true;
            _ = JS.InvokeVoidAsync("MascotManager.setGameMode", true, "hsk");
            _ = JS.InvokeVoidAsync("MascotManager.gameSay", "boss");
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.startBossBgm?.()");
            _ = StartBossIntro();
        }
        else
        {
            _ = JS.InvokeVoidAsync("MascotManager.setGameMode", true, "hsk");
            if (stageIndex == 0)
            {
                _ = JS.InvokeVoidAsync("MascotManager.gameSay", "start");
            }
            if (_isBgmOn)
            {
                _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.startBgm()");
            }
            _ = FocusHskInput();
        }
        StateHasChanged();
    }

