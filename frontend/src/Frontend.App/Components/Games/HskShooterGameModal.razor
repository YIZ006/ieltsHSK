    private void CastBossSkill(string chineseName, string vietnameseName, bool isUltimate = false)
    {
        _bossSkillChinese = chineseName;
        _bossSkillVietnamese = vietnameseName;
        _showBossSkillBanner = true;
        _skillBannerCts?.Cancel();
        _skillBannerCts = new CancellationTokenSource();
        var token = _skillBannerCts.Token;

        try
        {
            double pitch = isUltimate ? 0.92 : 0.95;
            double rate = isUltimate ? 0.94 : 0.96;
            _ = JS.InvokeVoidAsync("eval", $"window.WordleSfx?.bossSpeak?.('{chineseName.Replace("'", "\\'")}', {{ isSkill: true, pitch: {pitch.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}, rate: {rate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)} }})");
        }
        catch { }

        _ = Task.Delay(3800, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _showBossSkillBanner = false;
                InvokeAsync(StateHasChanged);
            }
        });
        StateHasChanged();
    }

