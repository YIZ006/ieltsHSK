    private void StartBossDialogue()
    {
        _bossPhase = BossPhase.Dialogue;
        _showBossDialogue = true;
        _bossDialogueFinished = false;
        var (zh, vn) = GetBossDialoguePair(hskShooterSelectedLevel);
        _displayedBossDialogueZh = zh;
        _fullBossDialogue = vn;
        _displayedBossDialogue = "";
        StateHasChanged();

        try 
        { 
            _ = JS.InvokeVoidAsync("eval", $"window.WordleSfx?.bossSpeak?.('{zh.Replace("'", "\\'")}', {{ isSkill: false, pitch: 0.95, rate: 0.96 }})"); 
        } 
        catch { }

        _typewriterCts?.Cancel();
        _typewriterCts = new CancellationTokenSource();
        var token = _typewriterCts.Token;

        _ = Task.Run(async () =>
        {
            foreach (char c in _fullBossDialogue)
            {
                if (token.IsCancellationRequested) break;
                _displayedBossDialogue += c;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(25, token);
            }
            _bossDialogueFinished = true;
            await InvokeAsync(StateHasChanged);
        }, token);
    }

    private void AdvanceBossDialogue()
    {
        if (!_bossDialogueFinished)
        {
            _typewriterCts?.Cancel();
            _displayedBossDialogue = _fullBossDialogue;
            _bossDialogueFinished = true;
            StateHasChanged();
        }
        else
        {
            _showBossDialogue = false;
            StartBossWarmup1();
        }
    }

