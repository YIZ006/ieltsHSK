                Vocab = vocab,
                SpawnTime = now.AddSeconds(i * 0.9),
                FallDurationSec = 13.0,
                XPercent = x,
                IsMinion = true
            });
        }
        _ = FocusHskInput();
        StateHasChanged();
    }

