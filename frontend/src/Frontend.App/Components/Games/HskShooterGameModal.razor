    private void HandleBossChargeFailed()
    {
        _isBossCycleTransitioning = true;
        _showBossLaserBlast = true;
        hskLives = Math.Max(0, hskLives - 2);
        hskCombo = 0;
        TriggerDamageFlash();
        CastBossSkill("极灭魔光炮！受死吧！", "CỰC DIỆT MA QUANG PHÁO! CHẾT ĐI!");
        _ = JS.InvokeVoidAsync("MascotManager.gameSay", "damage", "Boss tung chiêu trúng rồi! ⚡", $"Còn {hskLives} mạng ❤");
        try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.bossLaserBlast?.()"); } catch { }

        int remainingWords = _orbitingWords.Count(w => !w.IsDestroyed);
        _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + remainingWords);

        _ = Task.Run(async () =>
        {
            await Task.Delay(700);
            await InvokeAsync(() =>
            {
                _showBossLaserBlast = false;
                _orbitingWords.Clear();

                if (hskLives <= 0)
                {
                    _isBossCycleTransitioning = false;
                    _ = JS.InvokeVoidAsync("MascotManager.gameSay", "game_over");
                    hskShooterState = HskGameState.GameOver;
                    hskTimer?.Dispose();
                    _countdownTimer?.Dispose();
                    try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBossBgm?.(); window.WordleSfx?.stopBgm?.(); window.WordleSfx?.lose?.()"); } catch { }
                    _ = FocusHskOverlay();
                }
                else
                {
                    if (_bossPhase == BossPhase.Wave2_Charging)
                    {
                        if (_bossChargeCycle < 3)
                        {
                            _bossChargeCycle++;
                            _ = Task.Delay(500).ContinueWith(t => InvokeAsync(StartNextChargeCycle));
                        }
                        else
                        {
                            // Đã xong 3 lần tụ lực Đợt 2 -> Sang Dạo 3
                            _ = Task.Delay(500).ContinueWith(t => InvokeAsync(StartBossWarmup3));
                        }
                    }
                    else if (_bossPhase == BossPhase.Wave3_FinalSurge)
                    {
                        _isBossCycleTransitioning = false;
                        CheckWave3Completion();
                    }
                }
                StateHasChanged();
            });
        });
    }

    private void CheckWave3Completion()
    {
        if (_bossPhase != BossPhase.Wave3_FinalSurge) return;

        bool allMinionsCleared = hskActiveWords.Count(w => !w.IsDestroyed) == 0;
        bool allOrbitsCleared = _orbitingWords.Count == 0 || _orbitingWords.All(w => w.IsDestroyed);

        if (allMinionsCleared && allOrbitsCleared)
        {
            _bossProgressUnits = BossTotalUnits;
            DefeatBoss();
        }
    }

    private void DefeatBoss()
    {
        _bossPhase = BossPhase.Defeated;
        _bossHitFlash = true;
        _orbitingWords.Clear();
        try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBossBgm?.(); window.WordleSfx?.bossDefeatedExplosion?.()"); } catch { }
        BossTaunt("不可能... 汉字奥义，竟被你全参透了... 啊啊啊！", "Không thể nào... Áo nghĩa Hán tự... lại bị ngươi lĩnh hội toàn bộ... A a a!");
        ShowBossAnnouncement("CHIẾN THẮNG! MA VƯƠNG HÁN TỰ ĐÃ BỊ TIÊU DIỆT! 🏆");
        try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.win?.()"); } catch { }

        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                _bossHitFlash = false;
                TriggerStageComplete();
            });
        });
    }

    private HskVocabularyItem GetNextOrRandomVocab()
    {
        if (hskSpawnIndex < _currentStageWords.Count)
        {
            var item = _currentStageWords[hskSpawnIndex++];
            _usedVocabHanziInStage.Add(item.Hanzi);
            return item;
        }

        // Ưu tiên tìm từ chưa từng xuất hiện trong màn này từ toàn bộ pool
        if (hskVocabPool.Count > 0)
        {
            var unused = hskVocabPool.FirstOrDefault(v => !_usedVocabHanziInStage.Contains(v.Hanzi));
            if (unused != null)
            {
                _usedVocabHanziInStage.Add(unused.Hanzi);
                return unused;
            }
        }

        if (_currentStageWords.Count > 0)
        {
            return _currentStageWords[hskRng.Next(_currentStageWords.Count)];
        }
        if (hskVocabPool.Count > 0)
        {
            return hskVocabPool[hskRng.Next(hskVocabPool.Count)];
        }
        return new HskVocabularyItem { Hanzi = "王", Pinyin = "wáng", Meaning = "Vua / Trùm" };
    }

    private bool IsHskTargeted(OrbitingWord word)
    {
        if (string.IsNullOrWhiteSpace(hskInputValue)) return false;
        var normalized = NormalizePinyin(hskInputValue);
        return NormalizePinyin(word.Vocab.Pinyin).StartsWith(normalized, StringComparison.Ordinal);
    }

    private void TriggerStageComplete()
    {
        hskTimer?.Dispose();
        _showStageComplete = true;
        _stageCountdown = 3;

        _clearedStageIndices.Add(_currentStageIndex);
        _highestClearedStageIndex = Math.Max(_highestClearedStageIndex, _currentStageIndex + 1);
        _maxUnlockedStageIndex = Math.Max(_maxUnlockedStageIndex, Math.Min(_currentStageIndex + 1, _totalStages - 1));

        try
        {
            var clearedStr = string.Join(",", _clearedStageIndices);
            _ = JS.InvokeVoidAsync("localStorage.setItem", $"hsk_cleared_stages_{hskShooterSelectedLevel}", clearedStr);
        }
        catch { }

        _ = GameProgressService.SaveProgressAsync("hsk_shooter", hskShooterSelectedLevel, _currentStageIndex, _highestClearedStageIndex, hskScore);
        _ = JS.InvokeVoidAsync("MascotManager.gameSay", "stage_clear");
        StateHasChanged();
        _ = FocusHskOverlay();

        // Phát âm thanh đếm ngược 3s chuẩn bị sang màn
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.countdownTick(3)");

        _countdownTimer?.Dispose();
        _countdownTimer = new Timer(OnCountdownTick, null, 1000, 1000);
    }

    private void OnCountdownTick(object? state)
    {
        InvokeAsync(async () =>
        {
            if (!_showStageComplete || !isPlayingHskShooter)
            {
                _countdownTimer?.Dispose();
                return;
            }

            _stageCountdown--;
            if (_stageCountdown > 0)
            {
                _ = JS.InvokeVoidAsync("eval", $"window.WordleSfx?.countdownTick({_stageCountdown})");
                StateHasChanged();
            }
            else
            {
                // Hết 3 giây đếm ngược -> Âm thanh GO và tự động sang màn tiếp theo!
                _countdownTimer?.Dispose();
                _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.countdownGo()");
                if (_currentStageIndex < _totalStages - 1)
                {
                    await NextStage();
                }
                else
                {
                    CloseHskShooterGame();
                }
            }
        });
    }

    private async Task SkipCountdownAndNextStage()
    {
        _countdownTimer?.Dispose();
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.countdownGo()");
        if (_currentStageIndex < _totalStages - 1)
        {
            await NextStage();
        }
        else
        {
            CloseHskShooterGame();
        }
    }

    private void OnHskTick(object? state)
    {
        if (hskShooterState != HskGameState.Playing || _showStageComplete || _showStageMap) return;

        InvokeAsync(() =>
        {
            var now = DateTime.UtcNow;

            // Nếu đang trong hoạt cảnh cảnh báo hoặc hội thoại của Boss, tạm hoãn cập nhật
            if (_isBossStage && (_bossPhase == BossPhase.Warning || _bossPhase == BossPhase.Dialogue || _bossPhase == BossPhase.None || _bossPhase == BossPhase.Defeated))
            {
                return;
            }

            // 1. Quét các từ/quái đang rơi chạm đáy
            for (int i = hskActiveWords.Count - 1; i >= 0; i--)
            {
                var w = hskActiveWords[i];
                if (w.IsDestroyed) continue;
                if ((now - w.SpawnTime).TotalSeconds >= w.FallDurationSec)
                {
                    hskActiveWords.RemoveAt(i);
                    hskLives = Math.Max(0, hskLives - 1);
                    hskCombo = 0;
                    _lastMissedVocab = w.Vocab;
                    _missedWordsInStage.Add(w.Vocab);
                    ShowMissedAlert();
                    _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.damageHit()");
                    TriggerDamageFlash();
                    if (hskLives <= 0)
                    {
                        _ = JS.InvokeVoidAsync("MascotManager.gameSay", "game_over");
                        hskShooterState = HskGameState.GameOver;
                        hskTimer?.Dispose();
                        _countdownTimer?.Dispose();
                        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBossBgm?.(); window.WordleSfx?.stopBgm?.(); window.WordleSfx?.lose?.()");
                        StateHasChanged();
                        _ = FocusHskOverlay();
                        return;
                    }
                    else
                    {
                        _ = JS.InvokeVoidAsync("MascotManager.gameSay", "damage", null, $"Còn {hskLives} mạng ❤");
                    }

                    if (_isBossStage)
                    {
                        if (_bossPhase == BossPhase.Warmup1)
                        {
                            _bossWarmupWordsShotInPhase++;
                            _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);
                            if (_bossWarmupWordsShotInPhase >= BossWarmup1Target && hskActiveWords.Count(aw => !aw.IsDestroyed) == 0)
                            {
                                StartBossWave1();
                                return;
                            }
                        }
                        else if (_bossPhase == BossPhase.Wave1_Minions)
                        {
                            _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);
                            if (hskActiveWords.Count(aw => !aw.IsDestroyed) == 0)
                            {
                                StartBossWarmup2();
                                return;
                            }
                        }
                        else if (_bossPhase == BossPhase.Warmup2)
                        {
                            _bossWarmupWordsShotInPhase++;
                            _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);
                            if (_bossWarmupWordsShotInPhase >= BossWarmup2Target && hskActiveWords.Count(aw => !aw.IsDestroyed) == 0)
                            {
                                StartBossWave2();
                                return;
                            }
                        }
                        else if (_bossPhase == BossPhase.Warmup3)
                        {
                            _bossWarmupWordsShotInPhase++;
                            _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);
                            if (_bossWarmupWordsShotInPhase >= BossWarmup3Target && hskActiveWords.Count(aw => !aw.IsDestroyed) == 0)
                            {
                                StartBossWave3();
                                return;
                            }
                        }
                        else if (_bossPhase == BossPhase.Wave3_FinalSurge)
                        {
                            _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);
                            CheckWave3Completion();
                        }
                    }
                }
            }

            // 2. Logic điều khiển các pha của Boss Tầng Cuối
            if (_isBossStage)
            {
                if (_bossPhase == BossPhase.Warmup1)
                {
                    if (_bossWarmupWordsShotInPhase >= BossWarmup1Target && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                    {
                        StartBossWave1();
                        return;
                    }

                    int warmupActive = hskActiveWords.Count(w => !w.IsDestroyed);
                    int remainingToSpawn = BossWarmup1Target - _bossWarmupWordsShotInPhase - warmupActive;
                    if (warmupActive < 2 && remainingToSpawn > 0)
                    {
                        var elapsed = (now - _lastHskSpawnTime).TotalSeconds;
                        if (elapsed >= 1.6)
                        {
                            var vocab = GetNextOrRandomVocab();
                            _lastHskSpawnTime = now;
                            hskActiveWords.Add(new FallingWord
                            {
                                Vocab = vocab,
                                SpawnTime = now,
                                FallDurationSec = 11.0,
                                XPercent = 20 + hskRng.NextDouble() * 60
                            });
                        }
                    }
                }
                else if (_bossPhase == BossPhase.Wave1_Minions)
                {
                    if (hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                    {
                        try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.bossWaveCleared?.()"); } catch { }
                        BossTaunt("哼，灭了我的小卒？好戏才刚刚开始！", "Hừ, diệt được lũ tiểu tốt của ta sao? Kịch hay mới chỉ bắt đầu!");
                        StartBossWarmup2();
                        return;
                    }
                }
                else if (_bossPhase == BossPhase.Warmup2)
                {
                    if (_bossWarmupWordsShotInPhase >= BossWarmup2Target && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                    {
                        StartBossWave2();
                        return;
                    }

                    int warmupActive = hskActiveWords.Count(w => !w.IsDestroyed);
                    int remainingToSpawn = BossWarmup2Target - _bossWarmupWordsShotInPhase - warmupActive;
                    if (warmupActive < 2 && remainingToSpawn > 0)
                    {
                        var elapsed = (now - _lastHskSpawnTime).TotalSeconds;
                        if (elapsed >= 1.5)
                        {
                            var vocab = GetNextOrRandomVocab();
                            _lastHskSpawnTime = now;
                            hskActiveWords.Add(new FallingWord
                            {
                                Vocab = vocab,
                                SpawnTime = now,
                                FallDurationSec = 10.5,
                                XPercent = 20 + hskRng.NextDouble() * 60
                            });
                        }
                    }
                }
                else if (_bossPhase == BossPhase.Wave2_Charging)
                {
                    if (_isBossCycleTransitioning)
                    {
                        StateHasChanged();
                        return;
                    }

                    _bossChargeTimer = Math.Max(0, _bossChargeTimer - 0.1);
                    foreach (var ow in _orbitingWords)
                    {
                        ow.AngleDeg = (ow.AngleDeg + 1.8) % 360.0;
                    }

                    if (_orbitingWords.Count > 0 && _orbitingWords.All(w => w.IsDestroyed))
                    {
                        _isBossCycleTransitioning = true;
                        _orbitingWords.Clear();
                        _bossHitFlash = true;
                        try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.bossChargeBroken?.()"); } catch { }
                        BossTaunt("可恶！竟敢破本座的魔光！", "Đáng ghét! Dám phá ma quang của bản tọa!");
                        _ = Task.Delay(400).ContinueWith(t =>
                        {
                            _bossHitFlash = false;
                            InvokeAsync(StateHasChanged);
                        });

                        if (_bossChargeCycle < 3)
                        {
                            _bossChargeCycle++;
                            _ = Task.Delay(700).ContinueWith(t => InvokeAsync(StartNextChargeCycle));
                        }
                        else
                        {
                            // Đã xong 3 lần tụ lực Đợt 2 -> Sang Dạo 3
                            try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.bossWaveCleared?.()"); } catch { }
                            BossTaunt("狂妄凡人，休得放肆！", "Phàm nhân ngông cuồng, chớ có càn rỡ!");
                            _ = Task.Delay(800).ContinueWith(t => InvokeAsync(StartBossWarmup3));
                        }
                    }
                    else if (_bossChargeTimer <= 0)
                    {
                        HandleBossChargeFailed();
                    }
                }
                else if (_bossPhase == BossPhase.Warmup3)
                {
                    if (_bossWarmupWordsShotInPhase >= BossWarmup3Target && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                    {
                        StartBossWave3();
                        return;
                    }

                    int warmupActive = hskActiveWords.Count(w => !w.IsDestroyed);
                    int remainingToSpawn = BossWarmup3Target - _bossWarmupWordsShotInPhase - warmupActive;
                    if (warmupActive < 2 && remainingToSpawn > 0)
                    {
                        var elapsed = (now - _lastHskSpawnTime).TotalSeconds;
                        if (elapsed >= 1.4)
                        {
                            var vocab = GetNextOrRandomVocab();
                            _lastHskSpawnTime = now;
                            hskActiveWords.Add(new FallingWord
                            {
                                Vocab = vocab,
                                SpawnTime = now,
                                FallDurationSec = 10.0,
                                XPercent = 18 + hskRng.NextDouble() * 64
                            });
                        }
                    }
                }
                else if (_bossPhase == BossPhase.Wave3_FinalSurge)
                {
                    if (_orbitingWords.Any(w => !w.IsDestroyed))
                    {
                        _bossChargeTimer = Math.Max(0, _bossChargeTimer - 0.1);
                        foreach (var ow in _orbitingWords)
                        {
                            ow.AngleDeg = (ow.AngleDeg + 1.8) % 360.0;
                        }

                        if (_bossChargeTimer <= 0)
                        {
                            HandleBossChargeFailed();
                        }
                    }
                    else if (_orbitingWords.Count > 0 && _orbitingWords.All(w => w.IsDestroyed))
                    {
                        _orbitingWords.Clear();
                        _bossHitFlash = true;
                        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.bulletHit()");
                        _ = Task.Delay(400).ContinueWith(_ =>
                        {
                            _bossHitFlash = false;
                            InvokeAsync(StateHasChanged);
                        });
                        CheckWave3Completion();
                    }
                }

                StateHasChanged();
                return;
            }

            // 3. Logic tầng thường (Stage 1 đến _totalStages - 2)
            if (hskSpawnIndex >= _currentStageWords.Count && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
            {
                TriggerStageComplete();
                return;
            }

            int maxConcurrent = _currentStageIndex switch
            {
                0 => 1,       // Tầng 1: Cực dễ - đúng 1 từ lần lượt
                1 => 1,       // Tầng 2: Cực dễ - đúng 1 từ lần lượt
                2 => 1,       // Tầng 3: 1 từ
                3 or 4 => 2,  // Tầng 4 - 5: tối đa 2 từ
                5 or 6 => 2,  // Tầng 6 - 7: tối đa 2 từ
                _ => 3
            };

            double baseFallSec = _currentStageIndex switch
            {
                0 => 15.0,    // Tầng 1: 15 giây rất chậm và dễ
                1 => 13.5,    // Tầng 2: 13.5 giây
                2 => 12.0,    // Tầng 3: 12 giây
                3 => 10.5,    // Tầng 4: 10.5 giây
                4 => 9.5,     // Tầng 5: 9.5 giây
                5 => 8.5,     // Tầng 6: 8.5 giây
                6 => 7.5,     // Tầng 7: 7.5 giây
                _ => 6.5
            };

            double minSpawnIntervalSec = _currentStageIndex switch
            {
                0 or 1 => 2.5, // Giãn cách 2.5 giây giữa các từ
                2 or 3 => 2.0,
                _ => 1.5
            };

            var activeCount = hskActiveWords.Count(w => !w.IsDestroyed);
            var elapsedSinceLast = (now - _lastHskSpawnTime).TotalSeconds;
            var requiredInterval = activeCount == 0 ? 0.6 : minSpawnIntervalSec;

            if (activeCount < maxConcurrent && hskSpawnIndex < _currentStageWords.Count && elapsedSinceLast >= requiredInterval)
            {
                var vocab = _currentStageWords[hskSpawnIndex];
                hskSpawnIndex++;
                _usedVocabHanziInStage.Add(vocab.Hanzi);
                _lastHskSpawnTime = now;
                
                var fallSec = baseFallSec + hskRng.NextDouble() * 2.0;

                hskActiveWords.Add(new FallingWord
                {
                    Vocab = vocab,
                    SpawnTime = now,
                    FallDurationSec = fallSec,
                    XPercent = 14 + hskRng.NextDouble() * 72 // 14% to 86%
                });
            }

            StateHasChanged();
        });
    }

    private async Task FocusHskInput()
    {
        try { await hskInputRef.FocusAsync(); } catch { }
    }

    private async Task FocusHskOverlay()
    {
        try { await hskOverlayRef.FocusAsync(); } catch { }
    }

    private void FocusHskOnBackgroundClick()
    {
        if (hskShooterState == HskGameState.Playing && !_showStageComplete && !_showStageMap && !_showResumeDialog)
        {
            _ = FocusHskInput();
        }
    }

    private async void TriggerDamageFlash()
    {
        showDamageFlash = true;
        StateHasChanged();
        await Task.Delay(350);
        showDamageFlash = false;
        StateHasChanged();
    }

    private void ShowMissedAlert()
    {
        _showMissedBanner = true;
        _missedAlertCts?.Cancel();
        _missedAlertCts = new CancellationTokenSource();
        var token = _missedAlertCts.Token;
        _ = Task.Delay(4000, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _showMissedBanner = false;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        var key = e.Key.ToUpperInvariant();

        // 1. Phím 1: Bật/Tắt Nhạc
        if (key == "1" || e.Code == "Digit1" || e.Code == "Numpad1")
        {
            await ToggleBgm();
            return;
        }

        // 2. Phím 2: Ẩn/Hiện Pinyin
        if (key == "2" || e.Code == "Digit2" || e.Code == "Numpad2")
        {
            await TogglePinyin();
            return;
        }

        // 3. Phím 3: Tạm dừng / Tiếp tục
        if (key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
        {
            ToggleHskPause();
            return;
        }

        // Phím Escape: Thoát trò chơi
        if (key == "ESCAPE" || e.Code == "Escape")
        {
            CloseHskShooterGame();
            return;
        }
    }

    private async Task HandleHskKeyDown(KeyboardEventArgs e)
    {
        if (!isPlayingHskShooter) return;

        var key = e.Key.ToUpperInvariant();

        // 0. Hoạt cảnh hội thoại Boss đang hiển thị -> Space / Enter để chạy nhanh hoặc tiếp tục
        if (_showBossDialogue)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                AdvanceBossDialogue();
                return;
            }
            if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
                return;
            }
            return;
        }

        // Cảnh báo ruy băng Hazard Boss đang chiếu
        if (_showBossWarning)
        {
            if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
                return;
            }
            return;
        }

        // 0. Bản đồ tầng đang mở -> Esc để đóng, Enter/Space/3 để tiếp tục chơi
        if (_showStageMap)
        {
            if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseStageMap();
                return;
            }
            if (key == "ENTER" || key == " " || key == "SPACE" || key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
            {
                ResumeAndCloseMap();
                return;
            }
            return;
        }

        // 1. Sang màn khi hoàn thành tầng (Next stage hoặc bấm Enter qua màn ngay, Esc để thoát)
        if (_showStageComplete)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                await SkipCountdownAndNextStage();
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
            }
            return;
        }

        // 2. Tiếp tục khi có hộp thoại lưu tiến trình
        if (_showResumeDialog)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                await ResumeFromSavedStage();
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                await StartFreshFromStage0();
            }
            return;
        }

        // 3. Kết thúc game (Game Over) -> Enter chơi lại ngay, Esc thoát
        if (hskShooterState == HskGameState.GameOver)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                await LoadStage(_currentStageIndex);
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
            }
            return;
        }

        // 4. Tạm dừng -> 3/Enter/Space tiếp tục, Esc thoát
        if (hskShooterState == HskGameState.Paused)
        {
            if (key == "ENTER" || key == " " || key == "SPACE" || key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
            {
                ToggleHskPause();
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
            }
            return;
        }

        // 5. Đang chơi:
        if (hskShooterState == HskGameState.Playing && !_showStageComplete && !_showStageMap && !_showResumeDialog)
        {
            // Phím 1: Bật/Tắt Nhạc
            if (key == "1" || e.Code == "Digit1" || e.Code == "Numpad1")
            {
                await ToggleBgm();
                return;
            }

            // Phím 2: Ẩn/Hiện Pinyin
            if (key == "2" || e.Code == "Digit2" || e.Code == "Numpad2")
            {
                await TogglePinyin();
                return;
            }

            // Phím 3: Tạm dừng
            if (key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
            {
                ToggleHskPause();
                return;
            }

            // Phím Escape: Thoát trò chơi
            if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
                return;
            }

            // Phím Backspace khi click chuột ra ngoài chiến trường: Chỉ xóa ký tự trong ô nhập, KHÔNG BAO GIỜ THOÁT GAME
            if (key == "BACKSPACE" || e.Code == "Backspace")
            {
                if (!string.IsNullOrEmpty(hskInputValue))
                {
                    hskInputValue = hskInputValue[..^1];
                    _ = JS.InvokeVoidAsync("eval", "window.focusHskInput?.()");
                    StateHasChanged();
                }
                return;
            }

            // Tự động gõ chữ vào ô nhập kể cả khi click nhầm chuột ra ngoài
            if (e.Key.Length == 1 && char.IsLetter(e.Key[0]))
            {
                hskInputValue += e.Key.ToLowerInvariant();
                _ = JS.InvokeVoidAsync("eval", "window.focusHskInput?.()");
                StateHasChanged();
                return;
            }
        }
    }

    private async Task ToggleBgm()
    {
        try
        {
            if (_isBossStage)
            {
                _isBgmOn = await JS.InvokeAsync<bool>("eval", "window.WordleSfx?.toggleBossBgm() ?? false");
            }
            else
            {
                _isBgmOn = await JS.InvokeAsync<bool>("eval", "window.WordleSfx?.toggleBgm() ?? false");
            }
            StateHasChanged();
        }
        catch { }
    }

    private void ToggleHskPause()
    {
        if (hskShooterState == HskGameState.Playing)
        {
            hskShooterState = HskGameState.Paused;
            _hskPauseStartTime = DateTime.UtcNow;
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm(); window.WordleSfx?.pauseBossBgm?.(); window.WordleSfx?.stopBossCharge?.(); if ('speechSynthesis' in window) window.speechSynthesis.cancel();");
        }
        else if (hskShooterState == HskGameState.Paused)
        {
            hskShooterState = HskGameState.Playing;
            if (_hskPauseStartTime.HasValue)
            {
                var pausedDuration = DateTime.UtcNow - _hskPauseStartTime.Value;
                _hskPauseStartTime = null;
                foreach (var w in hskActiveWords)
                {
                    w.SpawnTime += pausedDuration;
                }
                _lastHskSpawnTime += pausedDuration;
            }

            if (_isBgmOn)
            {
                if (_isBossStage)
                {
                    _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.resumeBossBgm?.()");
                }
                else
                {
                    _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.startBgm()");
                }
            }
            _ = FocusHskInput();
        }
        StateHasChanged();
    }

    private void CloseHskShooterGame()
    {
        hskTimer?.Dispose();
        _countdownTimer?.Dispose();
        _hskPauseStartTime = null;
        _wasPausedByMap = false;
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm(); window.WordleSfx?.stopBossBgm?.(); window.WordleSfx?.stopBossCharge?.(); if ('speechSynthesis' in window) window.speechSynthesis.cancel();");
        _ = JS.InvokeVoidAsync("MascotManager.setGameMode", false);
        hskShooterState = HskGameState.Menu;
        isPlayingHskShooter = false;
        _showStageMap = false;
        _showStageComplete = false;
        _showResumeDialog = false;
        _showBossSkillBanner = false;
        _showBossTaunt = false;
        hskBullets.Clear();
        hskImpacts.Clear();
    }

    private bool IsHskTargeted(FallingWord word)
    {
        if (string.IsNullOrWhiteSpace(hskInputValue)) return false;
        var normalized = NormalizePinyin(hskInputValue);
        return NormalizePinyin(word.Vocab.Pinyin).StartsWith(normalized, StringComparison.Ordinal);
    }

    private void TryMatchHskWord()
    {
        if (string.IsNullOrWhiteSpace(hskInputValue) || hskShooterState != HskGameState.Playing || _showStageComplete || _showStageMap) return;
        if (_showBossWarning || _showBossDialogue) return;

        var normalized = NormalizePinyin(hskInputValue);

        // 1. Kiểm tra từ xoay quanh quả cầu ma pháp (Wave 2 & Wave 3) trước tiên
        if ((_bossPhase == BossPhase.Wave2_Charging || _bossPhase == BossPhase.Wave3_FinalSurge) && _orbitingWords.Any())
        {
            var orbitMatch = _orbitingWords.FirstOrDefault(w => !w.IsDestroyed && NormalizePinyin(w.Vocab.Pinyin) == normalized);
            if (orbitMatch != null)
            {
                _ = HandleHskOrbitWordHit(orbitMatch);
                return;
            }
        }

        // 2. Kiểm tra từ rơi và tiểu quái
        var match = hskActiveWords.FirstOrDefault(w => !w.IsDestroyed && NormalizePinyin(w.Vocab.Pinyin) == normalized);
        if (match != null)
        {
            _ = HandleHskWordHit(match);
        }
    }

    private async Task HandleHskOrbitWordHit(OrbitingWord match)
    {
        hskInputValue = "";

        // Tọa độ mục tiêu của từ xoay
        double rad = match.AngleDeg * Math.PI / 180.0;
        double offsetX = Math.Cos(rad) * match.RadiusPx;
        double offsetY = Math.Sin(rad) * (match.RadiusPx * 0.55);
        double targetX = Math.Clamp(50.0 + (offsetX / 6.0), 18.0, 82.0);
        double targetY = Math.Clamp(23.0 + (offsetY / 5.0), 12.0, 38.0);

        var bullet = new ActiveBullet
        {
            Id = ++_bulletCounter,
            StartX = 50.0,
            StartY = 86.0,
            TargetX = targetX,
            TargetY = targetY
        };
        hskBullets.Add(bullet);
        try { await JS.InvokeVoidAsync("eval", "window.WordleSfx?.laserShoot()"); } catch { }
        StateHasChanged();

        await Task.Delay(160);
        hskBullets.Remove(bullet);
        try { await JS.InvokeVoidAsync("eval", "window.WordleSfx?.bulletHit()"); } catch { }

        var impact = new ActiveImpact
        {
            Id = ++_impactCounter,
            X = targetX,
            Y = targetY
        };
        hskImpacts.Add(impact);

        match.IsDestroyed = true;
        match.HitFlash = true;
        hskCombo++;
        int comboBonus = hskCombo >= 2 ? (hskCombo * 8) : 0;
        hskScore += 25 + comboBonus;
        hskWordsShot++;
        hskWordsShotInStage++;
        _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);

        if (hskCombo >= 2)
        {
            try { await JS.InvokeVoidAsync("eval", $"window.WordleSfx?.comboSound({hskCombo})"); } catch { }
        }

        _ = HskSvc.UpdateVocabProgressAsync(match.Vocab.Id, true).ContinueWith(t =>
        {
            if (t.Result) hskNewLearned++;
        });

        StateHasChanged();

        await Task.Delay(260);
        hskImpacts.Remove(impact);
        match.HitFlash = false;

        if (_bossPhase == BossPhase.Wave3_FinalSurge)
        {
            CheckWave3Completion();
        }

        StateHasChanged();
    }

    private async Task HandleHskWordHit(FallingWord match)
    {
        hskInputValue = "";

        // 1. Tọa độ mục tiêu của từ vựng rơi tại thời điểm bắn trúng
        double targetX = match.XPercent;
        double elapsed = (DateTime.UtcNow - match.SpawnTime).TotalSeconds;
        double progress = Math.Clamp(elapsed / match.FallDurationSec, 0.0, 0.95);
        double targetY = Math.Clamp(5.0 + progress * 75.0, 10.0, 80.0);

        // 2. Bắn đạn laser từ máy bay (50%, 86%) hướng thẳng tới từ vựng
        var bullet = new ActiveBullet
        {
            Id = ++_bulletCounter,
            StartX = 50.0,
            StartY = 86.0,
            TargetX = targetX,
            TargetY = targetY
        };
        hskBullets.Add(bullet);

        // Âm thanh bắn laser
        try { await JS.InvokeVoidAsync("eval", "window.WordleSfx?.laserShoot()"); } catch { }
        StateHasChanged();

        // 3. Sau 180ms: Đạn chạm vào từ vựng -> Kích hoạt hiệu ứng va chạm nổ và âm thanh nổ
        await Task.Delay(180);
        hskBullets.Remove(bullet);
        
        // Âm thanh va chạm đạn nổ
        try { await JS.InvokeVoidAsync("eval", "window.WordleSfx?.bulletHit()"); } catch { }

        var impact = new ActiveImpact
        {
            Id = ++_impactCounter,
            X = targetX,
            Y = targetY
        };
        hskImpacts.Add(impact);

        match.IsDestroyed = true;
        hskCombo++;
        int comboBonus = hskCombo >= 2 ? (hskCombo * 5) : 0;
        hskScore += (match.IsMinion ? 20 : 10) + comboBonus;
        hskWordsShot++;
        hskWordsShotInStage++;

        // Mascot bình luận cổ vũ theo combo
        if (hskCombo >= 5)
        {
            _ = JS.InvokeVoidAsync("MascotManager.gameSay", "high_combo", $"SIÊU COMBO x{hskCombo}! ⚡", "Xạ thủ thần sầu!");
        }
        else if (hskCombo >= 2)
        {
            _ = JS.InvokeVoidAsync("MascotManager.gameSay", "combo", $"Combo x{hskCombo}! 🔥", "Thừa thắng xông lên!");
        }
        else
        {
            _ = JS.InvokeVoidAsync("MascotManager.gameSay", "hit", null, null);
        }

        // Âm thanh combo khi đoán trúng nhiều từ liên tiếp (>= 2)
        if (hskCombo >= 2)
        {
            try { await JS.InvokeVoidAsync("eval", $"window.WordleSfx?.comboSound({hskCombo})"); } catch { }
        }

        _ = HskSvc.UpdateVocabProgressAsync(match.Vocab.Id, true).ContinueWith(t =>
        {
            if (t.Result) hskNewLearned++;
        });

        StateHasChanged();

        // 4. Sau 320ms: Thu hồi hiệu ứng nổ và xóa thẻ từ vựng
        await Task.Delay(320);
        hskImpacts.Remove(impact);
        hskActiveWords.Remove(match);

        if (_isBossStage)
        {
            _bossProgressUnits = Math.Min(BossTotalUnits, _bossProgressUnits + 1);

            if (_bossPhase == BossPhase.Warmup1)
            {
                _bossWarmupWordsShotInPhase++;
                if (_bossWarmupWordsShotInPhase >= BossWarmup1Target && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                {
                    _ = Task.Delay(400).ContinueWith(_ => InvokeAsync(StartBossWave1));
                }
            }
            else if (_bossPhase == BossPhase.Wave1_Minions)
            {
                if (hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                {
                    try { _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.bossWaveCleared?.()"); } catch { }
                    BossTaunt("哼，灭了我的小卒？好戏才刚刚开始！", "Hừ, diệt được lũ tiểu tốt của ta sao? Kịch hay mới chỉ bắt đầu!");
                    _ = Task.Delay(500).ContinueWith(_ => InvokeAsync(StartBossWarmup2));
                }
            }
            else if (_bossPhase == BossPhase.Warmup2)
            {
                _bossWarmupWordsShotInPhase++;
                if (_bossWarmupWordsShotInPhase >= BossWarmup2Target && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                {
                    _ = Task.Delay(400).ContinueWith(_ => InvokeAsync(StartBossWave2));
                }
            }
            else if (_bossPhase == BossPhase.Warmup3)
            {
                _bossWarmupWordsShotInPhase++;
                if (_bossWarmupWordsShotInPhase >= BossWarmup3Target && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
                {
                    _ = Task.Delay(400).ContinueWith(_ => InvokeAsync(StartBossWave3));
                }
            }
            else if (_bossPhase == BossPhase.Wave3_FinalSurge)
            {
                CheckWave3Completion();
            }
        }
        else
        {
            if (hskSpawnIndex >= _currentStageWords.Count && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
            {
                TriggerStageComplete();
            }
        }

        StateHasChanged();
    }

    private static string NormalizePinyin(string pinyin)
    {
        if (string.IsNullOrEmpty(pinyin)) return "";
        var decomposed = pinyin.ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in decomposed)
        {
            var uc = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (uc != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                if (c >= 'a' && c <= 'z') sb.Append(c);
            }
        }
        return sb.ToString();
    }



    public void Dispose()
    {
        hskTimer?.Dispose();
        _countdownTimer?.Dispose();
        _typewriterCts?.Cancel();
        _announcementCts?.Cancel();
        _skillBannerCts?.Cancel();
        _tauntCts?.Cancel();
        _missedAlertCts?.Cancel();
        _ = JS.InvokeVoidAsync("MascotManager.setGameMode", false);
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm(); window.WordleSfx?.stopBossBgm?.(); window.WordleSfx?.stopBossCharge?.(); if ('speechSynthesis' in window) window.speechSynthesis.cancel();");
    }
