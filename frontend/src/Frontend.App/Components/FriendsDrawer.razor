@code {
    private FriendsSummaryDto? summary;
    private bool isLoading = true;
    private bool isClosing = false;
    private string activeTab = "friends"; // "friends", "requests", "search"

    // Search state
    private string searchQuery = "";
    private bool isSearching = false;
    private List<UserSearchResultDto> searchResults = new();
    private CancellationTokenSource? searchCts;

    // Modals
    private FriendDto? unfriendTarget;
    private UserDetailViewModel? selectedDetailUser;

    private class UserDetailViewModel
    {
        public int Id { get; set; }
        public string Username { get; set; } = "";
        public string FullName { get; set; } = "";
        public string AvatarEmoji { get; set; } = "🎓";
        public string AvatarColor { get; set; } = "#4f46e5";
        public string? TargetExam { get; set; }
        public string? TargetScore { get; set; }
        public string? Level { get; set; }
        public int Streak { get; set; }
        public bool IsOnline { get; set; }
        public string? Bio { get; set; }
    }

    protected override void OnInitialized()
    {
        FriendSvc.OnDrawerStateChanged += HandleDrawerStateChanged;
        FriendSvc.OnChange += HandleFriendServiceChanged;
    }

    private void HandleDrawerStateChanged()
    {
        if (FriendSvc.IsDrawerOpen)
        {
            isClosing = false;
            _ = LoadDataAsync();
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleFriendServiceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();
        summary = await FriendSvc.GetSummaryAsync();
        isLoading = false;
        StateHasChanged();
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        searchCts?.Cancel();

        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults.Clear();
            isSearching = false;
            if (activeTab == "search") activeTab = "friends";
            return;
        }

        activeTab = "search";
        isSearching = true;
        StateHasChanged();

        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
            {
                searchResults = await FriendSvc.SearchUsersAsync(searchQuery);
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private void ClearSearch()
    {
        searchQuery = "";
        searchResults.Clear();
        activeTab = "friends";
    }

    private async Task HandleSendRequest(int targetUserId)
    {
        var success = await FriendSvc.SendFriendRequestAsync(targetUserId);
        if (success)
        {
            // Cập nhật trạng thái item tìm kiếm
            var item = searchResults.FirstOrDefault(u => u.Id == targetUserId);
            if (item != null) item.Relationship = "PendingOutgoing";
            await LoadDataAsync();
        }
    }

    private async Task HandleAcceptRequest(int friendshipId)
    {
        var success = await FriendSvc.AcceptFriendRequestAsync(friendshipId);
        if (success)
        {
            await LoadDataAsync();
            // Cập nhật lại search result nếu có
            var searchItem = searchResults.FirstOrDefault(u => u.FriendshipId == friendshipId);
            if (searchItem != null) searchItem.Relationship = "Friends";
        }
    }

    private async Task HandleDeclineRequest(int friendshipId)
    {
        var success = await FriendSvc.DeclineFriendRequestAsync(friendshipId);
        if (success)
        {
            await LoadDataAsync();
            var searchItem = searchResults.FirstOrDefault(u => u.FriendshipId == friendshipId);
            if (searchItem != null) searchItem.Relationship = "None";
        }
    }

    private async Task HandleCancelRequestByFriendshipId(int? friendshipId)
    {
        if (!friendshipId.HasValue) return;
        var success = await FriendSvc.CancelFriendRequestAsync(friendshipId.Value);
        if (success)
        {
            await LoadDataAsync();
            var searchItem = searchResults.FirstOrDefault(u => u.FriendshipId == friendshipId.Value);
            if (searchItem != null) searchItem.Relationship = "None";
        }
    }

    private async Task HandleToggleFavorite(int friendId)
    {
        var success = await FriendSvc.ToggleFavoriteAsync(friendId);
        if (success)
        {
            var item = summary?.Friends.FirstOrDefault(f => f.Id == friendId);
            if (item != null) item.IsFavorite = !item.IsFavorite;
            StateHasChanged();
        }
    }

    private void ConfirmUnfriend(FriendDto friend)
    {
        unfriendTarget = friend;
    }

    private async Task ExecuteUnfriendAsync()
    {
        if (unfriendTarget == null) return;
        var targetId = unfriendTarget.Id;
        unfriendTarget = null;
        var success = await FriendSvc.RemoveFriendAsync(targetId);
        if (success)
        {
            await LoadDataAsync();
            var searchItem = searchResults.FirstOrDefault(u => u.Id == targetId);
            if (searchItem != null) searchItem.Relationship = "None";
        }
    }

    private void SelectUserForDetail(int id, string username, string fullname, string? avatar, string? color, string? exam, string? score, string? lvl, int streak, bool online, string? bio)
    {
        selectedDetailUser = new UserDetailViewModel
        {
            Id = id,
            Username = username,
            FullName = fullname,
            AvatarEmoji = string.IsNullOrWhiteSpace(avatar) ? "🎓" : avatar,
            AvatarColor = string.IsNullOrWhiteSpace(color) ? "#4f46e5" : color,
            TargetExam = exam,
            TargetScore = score,
            Level = lvl,
            Streak = streak,
            IsOnline = online,
            Bio = bio
        };
    }

    private async Task CloseDrawer()
    {
        isClosing = true;
        StateHasChanged();
        await Task.Delay(250);
        isClosing = false;
        FriendSvc.CloseDrawer();
    }

    private static string GetTimeAgo(DateTime? dt)
    {
        if (!dt.HasValue) return "Lâu rồi";
        var diff = DateTime.UtcNow - dt.Value;
        if (diff.TotalMinutes < 1) return "Vừa xong";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        return dt.Value.ToString("dd/MM/yyyy");
    }

    public void Dispose()
    {
        FriendSvc.OnDrawerStateChanged -= HandleDrawerStateChanged;
        FriendSvc.OnChange -= HandleFriendServiceChanged;
        searchCts?.Dispose();
    }
}
