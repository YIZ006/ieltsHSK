@using Frontend.App.Models
@using Frontend.App.Services
@inject FriendshipService FriendSvc
@inject IJSRuntime JS
@implements IDisposable

@if (FriendSvc.IsDrawerOpen)
{
    @* ── BACKDROP OVERLAY ── *@
    <div class="friends-backdrop" @onclick="CloseDrawer"></div>

    @* ── RIGHT SLIDE-OUT DRAWER ── *@
    <div class="friends-drawer @(isClosing ? "slide-out" : "slide-in")" @onclick:stopPropagation>
        @* ── DRAWER HEADER ── *@
        <div class="drawer-header">
            <div class="header-title-box">
                <div class="header-icon-bubble">
                    <i class="bi bi-people-fill text-primary"></i>
                </div>
                <div>
                    <h3 class="drawer-title">Bạn bè</h3>
                    <div class="drawer-stats">
                        @if (summary != null)
                        {
                            <span class="online-chip"><span class="dot-online"></span> @summary.OnlineFriends online</span>
                            <span class="dot-separator">•</span>
                            <span>@summary.TotalFriends bạn bè</span>
                        }
                        else
                        {
                            <span>Đang nạp dữ liệu...</span>
                        }
                    </div>
                </div>
            </div>

            <button type="button" class="btn-drawer-close" @onclick="CloseDrawer" title="Đóng (ESC)">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @* ── SEARCH BAR (@DisplayName) ── *@
        <div class="drawer-search-wrap">
            <div class="search-input-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       class="search-input"
                       placeholder="Tìm theo @@tên hiển thị (vd: cuongnane)..."
                       value="@searchQuery"
                       @oninput="HandleSearchInput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="btn-clear-search" @onclick="ClearSearch" title="Xóa tìm kiếm">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>
        </div>

        @* ── DRAWER TABS ── *@
        <div class="drawer-tabs">
            <button type="button" class="tab-item @(activeTab == "friends" ? "active" : "")" @onclick='() => SwitchTab("friends")'>
                <i class="bi bi-people-fill"></i>
                <span>Bạn bè</span>
                @if (summary != null && summary.TotalFriends > 0)
                {
                    <span class="tab-badge">@summary.TotalFriends</span>
                }
            </button>
            <button type="button" class="tab-item @(activeTab == "requests" ? "active" : "")" @onclick='() => SwitchTab("requests")'>
                <i class="bi bi-envelope-paper-heart-fill"></i>
                <span>Lời mời</span>
                @if (summary != null && summary.PendingIncomingCount > 0)
                {
                    <span class="tab-badge badge-danger">@summary.PendingIncomingCount</span>
                }
            </button>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button type="button" class="tab-item @(activeTab == "search" ? "active" : "")" @onclick='() => SwitchTab("search")'>
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Tìm bạn</span>
                    @if (searchResults.Count > 0)
                    {
                        <span class="tab-badge badge-primary">@searchResults.Count</span>
                    }
                </button>
            }
        </div>

        @* ── DRAWER BODY ── *@
        <div class="drawer-body">
            @if (isLoading)
            {
                <div class="state-loading">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span>Đang tải danh sách...</span>
                </div>
            }
            else if (activeTab == "search")
            {
                @* ── TAB: SEARCH RESULTS ── *@
                <div class="section-container">
                    <div class="section-label">
                        <span>Kết quả tìm kiếm cho "@searchQuery"</span>
                        <span class="count-chip">@searchResults.Count</span>
                    </div>

                    @if (isSearching)
                    {
                        <div class="state-loading">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span>Đang tra cứu người dùng...</span>
                        </div>
                    }
                    else if (searchResults.Count == 0)
                    {
                        <div class="state-empty">
                            <div class="empty-icon">🔍</div>
                            <div class="empty-title">Không tìm thấy người dùng nào</div>
                            <div class="empty-sub">Hãy thử nhập chính xác <b>@@tên hiển thị</b> hoặc tên của người bạn muốn tìm.</div>
                        </div>
                    }
                    else
                    {
                        <div class="user-list">
                            @foreach (var user in searchResults)
                            {
                                <div class="user-card" @onclick="() => SelectUserForDetail(user.Id, user.Username, user.FullName, user.Avatar, user.AvatarColor, user.TargetExam, user.TargetScore, user.Level, user.Streak, user.IsOnline, null)">
                                    <div class="avatar-wrap">
                                        <div class="avatar-bubble" style="background: @(string.IsNullOrWhiteSpace(user.AvatarColor) ? "#4f46e5" : user.AvatarColor)">
                                            <span class="avatar-emoji">@(string.IsNullOrWhiteSpace(user.Avatar) ? "🎓" : user.Avatar)</span>
                                        </div>
                                        <span class="status-dot @(user.IsOnline ? "online" : "offline")" title="@(user.IsOnline ? "Đang online" : "Ngoại tuyến")"></span>
                                    </div>

                                    <div class="user-info">
                                        <div class="user-handle-row">
                                            <span class="user-handle">@@@user.Username</span>
                                            @if (user.Streak > 0)
                                            {
                                                <span class="user-streak-chip">🔥 @user.Streak</span>
                                            }
                                        </div>
                                        <div class="user-fullname">@user.FullName</div>
                                        <div class="user-meta-tags">
                                            @if (!string.IsNullOrWhiteSpace(user.TargetExam))
                                            {
                                                <span class="badge-exam">@user.TargetExam @user.TargetScore</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(user.Level))
                                            {
                                                <span class="badge-level">@user.Level</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="user-action-cell" @onclick:stopPropagation>
                                        @if (user.Relationship == "Friends")
                                        {
                                            <span class="btn-status-friends"><i class="bi bi-check2"></i> Bạn bè</span>
                                        }
                                        else if (user.Relationship == "PendingOutgoing")
                                        {
                                            <button type="button" class="btn-action-cancel-req" @onclick="() => HandleCancelRequestByFriendshipId(user.FriendshipId)" title="Hủy lời mời đã gửi">
                                                <span>Đã gửi</span> <i class="bi bi-x"></i>
                                            </button>
                                        }
                                        else if (user.Relationship == "PendingIncoming")
                                        {
                                            <button type="button" class="btn-action-accept" @onclick="() => HandleAcceptRequest(user.FriendshipId!.Value)" title="Chấp nhận kết bạn">
                                                <i class="bi bi-check2"></i> Đồng ý
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-action-add" @onclick="() => HandleSendRequest(user.Id)" title="Gửi lời mời kết bạn">
                                                <i class="bi bi-person-plus-fill"></i> Kết bạn
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (activeTab == "requests")
            {
                @* ── TAB: FRIEND REQUESTS ── *@
                <div class="section-container">
                    @* 1. Lời mời nhận được *@
                    <div class="section-label">
                        <span>Lời mời kết bạn nhận được</span>
                        <span class="count-chip badge-danger">@(summary?.IncomingRequests.Count ?? 0)</span>
                    </div>

                    @if (summary == null || summary.IncomingRequests.Count == 0)
                    {
                        <div class="state-empty-sub">
                            <span>Không có lời mời kết bạn nào đang chờ.</span>
                        </div>
                    }
                    else
                    {
                        <div class="user-list mb-3">
                            @foreach (var req in summary.IncomingRequests)
                            {
                                <div class="user-card request-card">
                                    <div class="avatar-wrap">
                                        <div class="avatar-bubble" style="background: @(string.IsNullOrWhiteSpace(req.AvatarColor) ? "#4f46e5" : req.AvatarColor)">
                                            <span class="avatar-emoji">@(string.IsNullOrWhiteSpace(req.Avatar) ? "🎓" : req.Avatar)</span>
                                        </div>
                                    </div>

                                    <div class="user-info">
                                        <div class="user-handle-row">
                                            <span class="user-handle">@@@req.Username</span>
                                            @if (req.Streak > 0)
                                            {
                                                <span class="user-streak-chip">🔥 @req.Streak</span>
                                            }
                                        </div>
                                        <div class="user-fullname">@req.FullName</div>
                                        @if (!string.IsNullOrWhiteSpace(req.TargetExam))
                                        {
                                            <div class="user-meta-tags">
                                                <span class="badge-exam">@req.TargetExam @req.TargetScore</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="request-actions">
                                        <button type="button" class="btn-req-accept" @onclick="() => HandleAcceptRequest(req.FriendshipId)" title="Chấp nhận kết bạn">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                        <button type="button" class="btn-req-decline" @onclick="() => HandleDeclineRequest(req.FriendshipId)" title="Từ chối">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* 2. Lời mời đã gửi *@
                    @if (summary != null && summary.OutgoingRequests.Count > 0)
                    {
                        <div class="section-label mt-4">
                            <span>Lời mời bạn đã gửi</span>
                            <span class="count-chip">@summary.OutgoingRequests.Count</span>
                        </div>
                        <div class="user-list">
                            @foreach (var outReq in summary.OutgoingRequests)
                            {
                                <div class="user-card request-card">
                                    <div class="avatar-wrap">
                                        <div class="avatar-bubble" style="background: @(string.IsNullOrWhiteSpace(outReq.AvatarColor) ? "#4f46e5" : outReq.AvatarColor)">
                                            <span class="avatar-emoji">@(string.IsNullOrWhiteSpace(outReq.Avatar) ? "🎓" : outReq.Avatar)</span>
                                        </div>
                                    </div>

                                    <div class="user-info">
                                        <div class="user-handle-row">
                                            <span class="user-handle">@@@outReq.Username</span>
                                        </div>
                                        <div class="user-fullname">@outReq.FullName</div>
                                        <span class="text-muted-status">Đang chờ đối phương chấp nhận...</span>
                                    </div>

                                    <div class="request-actions">
                                        <button type="button" class="btn-action-cancel-req" @onclick="() => HandleCancelRequestByFriendshipId(outReq.FriendshipId)" title="Thu hồi lời mời">
                                            <span>Hủy</span> <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* ── TAB: ALL FRIENDS (WOLVESVILLE STYLE) ── *@
                <div class="section-container">
                    @if (summary == null || summary.Friends.Count == 0)
                    {
                        <div class="state-empty">
                            <div class="empty-icon">🤝</div>
                            <div class="empty-title">Bạn chưa có bạn bè nào</div>
                            <div class="empty-sub">Hãy tìm kiếm <b>@@tên hiển thị</b> của bạn bè ở ô trên để kết nối và cùng nhau chinh phục mục tiêu học tập!</div>
                        </div>
                    }
                    else
                    {
                        <div class="user-list">
                            @foreach (var friend in summary.Friends)
                            {
                                <div class="user-card @(friend.IsFavorite ? "card-favorite" : "")" @onclick="() => SelectUserForDetail(friend.Id, friend.Username, friend.FullName, friend.Avatar, friend.AvatarColor, friend.TargetExam, friend.TargetScore, friend.Level, friend.Streak, friend.IsOnline, friend.Bio)">
                                    <div class="avatar-wrap">
                                        <div class="avatar-bubble" style="background: @(string.IsNullOrWhiteSpace(friend.AvatarColor) ? "#4f46e5" : friend.AvatarColor)">
                                            <span class="avatar-emoji">@(string.IsNullOrWhiteSpace(friend.Avatar) ? "🎓" : friend.Avatar)</span>
                                        </div>
                                        <span class="status-dot @(friend.IsOnline ? "online pulse" : "offline")" title="@(friend.IsOnline ? "Đang online" : $"Hoạt động {GetTimeAgo(friend.LastActive)}")"></span>
                                    </div>

                                    <div class="user-info">
                                        <div class="user-handle-row">
                                            <span class="user-handle">@@@friend.Username</span>
                                            @if (friend.IsFavorite)
                                            {
                                                <span class="badge-star" title="Bạn thân / Yêu thích">⭐</span>
                                            }
                                            @if (friend.Streak > 0)
                                            {
                                                <span class="user-streak-chip">🔥 @friend.Streak</span>
                                            }
                                        </div>
                                        <div class="user-fullname">@friend.FullName</div>
                                        <div class="user-meta-tags">
                                            @if (!string.IsNullOrWhiteSpace(friend.TargetExam))
                                            {
                                                <span class="badge-exam">@friend.TargetExam @friend.TargetScore</span>
                                            }
                                            @if (friend.IsOnline)
                                            {
                                                <span class="text-online-status">🟢 Đang online</span>
                                            }
                                            else if (friend.LastActive.HasValue)
                                            {
                                                <span class="text-offline-status">@GetTimeAgo(friend.LastActive)</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="friend-actions" @onclick:stopPropagation>
                                        <button type="button" class="btn-star @(friend.IsFavorite ? "active" : "")" @onclick="() => HandleToggleFavorite(friend.Id)" title="@(friend.IsFavorite ? "Bỏ ghim bạn thân" : "Ghim bạn thân lên đầu")">
                                            <i class="bi @(friend.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                                        </button>
                                        <button type="button" class="btn-unfriend" @onclick="() => ConfirmUnfriend(friend)" title="Hủy kết bạn">
                                            <i class="bi bi-person-x-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* ── DRAWER FOOTER ── *@
        <div class="drawer-footer">
            <div class="footer-tip">
                <i class="bi bi-lightbulb text-warning"></i>
                <span>Mẹo: Bạn có thể sao chép <b>@@tên hiển thị</b> trong hồ sơ cá nhân gửi cho bạn bè để họ tìm thấy bạn ngay lập tức!</span>
            </div>
        </div>
    </div>
}

@* ── POPUP XÁC NHẬN HỦY KẾT BẠN ── *@
@if (unfriendTarget != null)
{
    <div class="friends-modal-backdrop" @onclick="() => unfriendTarget = null">
        <div class="confirm-modal-box" @onclick:stopPropagation>
            <div class="confirm-icon-bubble">
                <i class="bi bi-person-x-fill text-danger"></i>
            </div>
            <h4 class="confirm-title">Hủy kết bạn?</h4>
            <p class="confirm-text">
                Bạn có chắc chắn muốn hủy kết bạn với <b>@@@unfriendTarget.Username</b> (@unfriendTarget.FullName)?
            </p>
            <div class="confirm-actions">
                <button type="button" class="btn-confirm-delete" @onclick="ExecuteUnfriendAsync">
                    Hủy kết bạn
                </button>
                <button type="button" class="btn-confirm-cancel" @onclick="() => unfriendTarget = null">
                    Giữ lại
                </button>
            </div>
        </div>
    </div>
}

@* ── POPUP XEM HỒ SƠ BẠN BÈ ── *@
@if (selectedDetailUser != null)
{
    <div class="friends-modal-backdrop" @onclick="() => selectedDetailUser = null">
        <div class="profile-card-modal" @onclick:stopPropagation>
            <div class="profile-cover">
                <button type="button" class="btn-close-profile" @onclick="() => selectedDetailUser = null">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="profile-avatar-wrap">
                <div class="profile-avatar" style="background: @selectedDetailUser.AvatarColor;">
                    <span>@selectedDetailUser.AvatarEmoji</span>
                </div>
                <span class="profile-status-badge @(selectedDetailUser.IsOnline ? "online" : "offline")">
                    @(selectedDetailUser.IsOnline ? "🟢 Đang trực tuyến" : "⚪ Ngoại tuyến")
                </span>
            </div>

            <div class="profile-body">
                <h4 class="profile-name">@selectedDetailUser.FullName</h4>
                <div class="profile-handle">@@@selectedDetailUser.Username</div>

                @if (!string.IsNullOrWhiteSpace(selectedDetailUser.Bio))
                {
                    <p class="profile-bio">"@selectedDetailUser.Bio"</p>
                }

                <div class="profile-stats-grid">
                    <div class="stat-box">
                        <div class="stat-label">Mục tiêu</div>
                        <div class="stat-val text-primary">@(string.IsNullOrWhiteSpace(selectedDetailUser.TargetExam) ? "Chưa đặt" : $"{selectedDetailUser.TargetExam} {selectedDetailUser.TargetScore}")</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Chuỗi học</div>
                        <div class="stat-val text-warning">🔥 @selectedDetailUser.Streak ngày</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-label">Trình độ</div>
                        <div class="stat-val text-success">@(string.IsNullOrWhiteSpace(selectedDetailUser.Level) ? "A1" : selectedDetailUser.Level)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* ─── BACKDROP & DRAWER CONTAINER ─── */
    .friends-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 99980;
        animation: fadeIn 0.2s ease;
    }

    .friends-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 400px;
        max-width: 100vw;
        height: 100vh;
        background: #0f172a;
        border-left: 1px solid rgba(255, 255, 255, 0.12);
        z-index: 99985;
        display: flex;
        flex-direction: column;
        color: #f8fafc;
        box-shadow: -15px 0 45px rgba(0, 0, 0, 0.7);
    }

    .slide-in {
        animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .slide-out {
        animation: slideOutRight 0.25s ease-out forwards;
    }

    @@keyframes slideInRight {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }

    @@keyframes slideOutRight {
        from { transform: translateX(0); }
        to { transform: translateX(100%); }
    }

    /* ─── HEADER ─── */
    .drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(30, 41, 59, 0.5);
    }

    .header-title-box {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon-bubble {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .drawer-title {
        font-size: 1.12rem;
        font-weight: 700;
        margin: 0;
        color: #ffffff;
    }

    .drawer-stats {
        font-size: 0.78rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 2px;
    }

    .online-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #34d399;
        font-weight: 600;
    }

    .dot-online {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
    }

    .dot-separator {
        color: #64748b;
    }

    .btn-drawer-close {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.15rem;
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-drawer-close:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
    }

    /* ─── SEARCH INPUT ─── */
    .drawer-search-wrap {
        padding: 14px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .search-input-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        color: #64748b;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 9px 36px 9px 36px;
        color: #ffffff;
        font-size: 0.88rem;
        outline: none;
        transition: all 0.2s;
    }

    .search-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        background: rgba(30, 41, 59, 0.95);
    }

    .btn-clear-search {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        color: #64748b;
        font-size: 0.95rem;
        cursor: pointer;
        padding: 2px;
    }

    .btn-clear-search:hover {
        color: #94a3b8;
    }

    /* ─── TABS ─── */
    .drawer-tabs {
        display: flex;
        padding: 8px 20px 0 20px;
        gap: 6px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.4);
    }

    .tab-item {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 6px;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: #94a3b8;
        font-size: 0.84rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
