@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject Frontend.App.Services.AuthService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

@if (isCheckingAuth)
{
    <div class="admin-auth-guard">
        <div class="auth-guard-card">
            <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
            <h4 style="font-weight: 800; font-size: 1.15rem; margin: 0;">Đang xác thực quyền Quản trị viên...</h4>
            <p style="font-size: 0.88rem; color: #64748b; margin: 0;">Hệ thống đang kiểm tra phiên làm việc bảo mật</p>
        </div>
    </div>
}
else if (!isAdminAuthenticated)
{
    <div class="admin-auth-guard">
        <div class="auth-guard-card">
            <div class="auth-guard-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h3 style="font-weight: 800; font-size: 1.25rem; margin: 0;">Yêu cầu Đăng nhập Quản trị</h3>
            <p style="font-size: 0.88rem; color: #64748b; margin: 0; text-align: center;">
                Bạn cần đăng nhập bằng tài khoản Quản trị viên (Admin) để có quyền truy cập khu vực này.
            </p>
            <button type="button" class="btn btn-primary" style="font-weight: 700; border-radius: 10px; padding: 8px 24px;" @onclick="NavigateToLogin">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập ngay
            </button>
        </div>
    </div>
}
else
{
    <div class="admin-layout theme-@activeDomain.ToLower()">
        <!-- Top Horizontal Navbar -->
        <header class="admin-topbar">
            <div class="topbar-logo" @onclick='() => NavigationManager.NavigateTo("/portal-hub")'>
                <span class="logo-icon">
                    @if (activeDomain == "TOEIC") { <span>🏆</span> }
                    else if (activeDomain == "HSK") { <span>🇨🇳</span> }
                    else if (activeDomain == "COMMON") { <span>🌐</span> }
                    else { <span>🇬🇧</span> }
                </span>
                <span class="logo-text">Admin Hub</span>
            </div>

            <nav class="topbar-nav">
                <button class="nav-tab tab-ielts @(activeDomain == "IELTS" ? "active" : "")" @onclick='() => SwitchDomain("IELTS")'>
                    <span class="tab-icon">🇬🇧</span> IELTS
                </button>
                <button class="nav-tab tab-toeic @(activeDomain == "TOEIC" ? "active" : "")" @onclick='() => SwitchDomain("TOEIC")'>
                    <span class="tab-icon">🏆</span> TOEIC
                </button>
                <button class="nav-tab tab-hsk @(activeDomain == "HSK" ? "active" : "")" @onclick='() => SwitchDomain("HSK")'>
                    <span class="tab-icon">🇨🇳</span> HSK
                </button>
                <button class="nav-tab tab-common @(activeDomain == "COMMON" ? "active" : "")" @onclick='() => SwitchDomain("COMMON")'>
                    <span class="tab-icon">🌐</span> Quản trị chung
                </button>
                <a href="http://localhost:5101/swagger" target="_blank" class="nav-tab tab-swagger" style="text-decoration: none;">
                    <span class="tab-icon">⚙️</span> Swagger API
                </a>
            </nav>

            <div class="topbar-user">
                <span class="user-avatar">@(string.IsNullOrWhiteSpace(adminName) ? "A" : adminName.Substring(0, 1).ToUpper())</span>
                <div class="user-info-text">
                    <span class="user-name" title="@adminEmail">@(string.IsNullOrWhiteSpace(adminName) ? "Quản trị viên" : adminName)</span>
                    <span class="domain-tag domain-tag-@activeDomain.ToLower()">@(activeDomain == "COMMON" ? "HỆ THỐNG" : activeDomain)</span>
                </div>
                <button type="button" class="btn-admin-logout" @onclick="HandleLogout" title="Đăng xuất khỏi Admin Hub">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </header>

        <div class="admin-body">
            <!-- Left Vertical Sidebar -->
            <aside class="admin-sidebar">
                <div class="sidebar-header">
                    <h3>
                        @if (activeDomain == "COMMON")
                        {
                            <span>Quản trị Hệ thống</span>
                        }
                        else
                        {
                            <span>Quản lý @activeDomain</span>
                        }
                    </h3>
                </div>

                <ul class="sidebar-menu">
                    @if (activeDomain == "COMMON")
                    {
                        <li class="menu-item @(currentUrl == "portal-hub" || currentUrl == "admin" || currentUrl == "" ? "active" : "")">
                            <a href="/portal-hub">
                                <i class="bi bi-speedometer2"></i> Dashboard Tổng quan
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/users") ? "active" : "")">
                            <a href="/portal-hub/users">
                                <i class="bi bi-people-fill"></i> Quản lý Học viên & Users
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/notifications") ? "active" : "")">
                            <a href="/portal-hub/notifications">
                                <i class="bi bi-bell-fill text-info"></i> Quản lý Thông báo
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/navigation") ? "active" : "")">
                            <a href="/portal-hub/navigation">
                                <i class="bi bi-list-nested"></i> Cấu hình Menu Sidebar
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/api-keys") || IsActive("/portal-hub/ai-settings") ? "active" : "")">
                            <a href="/portal-hub/api-keys">
                                <i class="bi bi-key-fill text-warning"></i> Cấu hình API & AI
                            </a>
                        </li>
                    }
                    else if (activeDomain == "IELTS")
                    {
                        <li class="menu-item @(IsActive("/portal-hub/mock-tests") ? "active" : "")">
                            <a href="/portal-hub/mock-tests">
                                <i class="bi bi-journal-text"></i> Quản lý đề thi (Mock Tests)
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/grading") ? "active" : "")">
                            <a href="/portal-hub/grading">
                                <i class="bi bi-pencil-square"></i> Chấm điểm Writing & Speaking
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/listen-videos") ? "active" : "")">
                            <a href="/portal-hub/listen-videos">
                                <i class="bi bi-camera-video"></i> Duyệt Video Nghe Điền
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/stories") ? "active" : "")">
                            <a href="/portal-hub/stories">
                                <i class="bi bi-book"></i> Quản lý Đọc truyện
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/ielts-vocab") ? "active" : "")">
                            <a href="/portal-hub/ielts-vocab">
                                <i class="bi bi-journal-bookmark-fill"></i> Ngân hàng Từ vựng IELTS
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/grammar") ? "active" : "")">
                            <a href="/portal-hub/grammar">
                                <i class="bi bi-diagram-3-fill"></i> Cấu trúc theo Band
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/speak-along") ? "active" : "")">
                            <a href="/portal-hub/speak-along">
                                <i class="bi bi-mic-fill"></i> Quản lý Nói Theo (Shadowing)
                            </a>
                        </li>
                    }
                    else if (activeDomain == "TOEIC")
                    {
                        <li class="menu-item @(IsActive("/portal-hub/toeic-mock-tests") ? "active" : "")">
                            <a href="/portal-hub/toeic-mock-tests">
                                <i class="bi bi-journal-text"></i> Quản lý đề thi TOEIC
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/toeic-builder") ? "active" : "")">
                            <a href="/portal-hub/toeic-builder">
                                <i class="bi bi-pencil-square"></i> Tạo & Sửa đề TOEIC
                            </a>
                        </li>
                    }
                    else if (activeDomain == "HSK")
                    {
                        <li class="menu-item @(IsActive("/portal-hub/hsk-mock-tests") ? "active" : "")">
                            <a href="/portal-hub/hsk-mock-tests">
                                <i class="bi bi-journal-check"></i> Quản lý Đề thi HSK
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/hsk-vocab") ? "active" : "")">
                            <a href="/portal-hub/hsk-vocab">
                                <i class="bi bi-translate"></i> Ngân hàng Từ vựng HSK
                            </a>
                        </li>
                    }
                </ul>
            </aside>

            <!-- Main Content Area -->
            <main class="admin-content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private string activeDomain = "COMMON";
    private string currentUrl = "";
    private bool isCheckingAuth = true;
    private bool isAdminAuthenticated = false;
    private bool isDisposed = false;
    private string? adminName;
    private string? adminEmail;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        
        UpdateActiveDomain(currentUrl);
        await CheckAdminAuthState(initial: true);
    }

    private async Task CheckAdminAuthState(bool initial = false)
    {
        if (isDisposed) return;
        if (initial) isCheckingAuth = true;

        try
        {
            // Kiểm tra token riêng của Quản trị viên
            var adminToken = await AuthService.GetAdminTokenAsync();
            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                var claims = CustomAuthStateProvider.ParseClaimsFromJwt(adminToken);
                var roleClaim = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role")?.Value;
                isAdminAuthenticated = string.Equals(roleClaim, "admin", StringComparison.OrdinalIgnoreCase);

                if (isAdminAuthenticated)
                {
                    adminName = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Name || c.Type == "unique_name" || c.Type == "name")?.Value ?? "Quản trị viên";
                    adminEmail = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email || c.Type == "email")?.Value;
                }
            }
            else
            {
                // Fallback nếu phiên làm việc cũ còn trong AuthStateProvider
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                isAdminAuthenticated = user.Identity?.IsAuthenticated == true && (user.IsInRole("admin") || user.IsInRole("Admin"));
                
                if (isAdminAuthenticated)
                {
                    adminName = user.Identity?.Name 
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value 
                        ?? user.FindFirst("name")?.Value 
                        ?? user.FindFirst("unique_name")?.Value;
                    adminEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                        ?? user.FindFirst("email")?.Value;
                }
            }

            if (!isAdminAuthenticated)
            {
                adminName = null;
                adminEmail = null;
                
                var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                if (!currentPath.Contains("login", StringComparison.OrdinalIgnoreCase))
                {
                    var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
                    NavigationManager.NavigateTo($"/portal-hub/login?returnUrl={returnUrl}");
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLayout] CheckAdminAuthState error: {ex.Message}");
            isAdminAuthenticated = false;
        }
        finally
        {
            if (initial) isCheckingAuth = false;
            if (!isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (isDisposed) return;
        try
        {
            currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
            UpdateActiveDomain(currentUrl);
            await CheckAdminAuthState(initial: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLayout] OnLocationChanged error: {ex.Message}");
        }
    }

    private void UpdateActiveDomain(string url)
    {
        var path = url.ToLowerInvariant();
        
        // 1. Tính năng dùng chung toàn hệ thống -> COMMON
        if (path.StartsWith("portal-hub/users") 
            || path.StartsWith("admin/users")
            || path.Contains("notifications")
            || path.Contains("navigation")
            || path.Contains("api-keys")
            || path.Contains("ai-settings")
            || path == "portal-hub" 
            || path == "portal-hub/" 
            || path == "admin" 
            || path == "admin/" 
            || string.IsNullOrWhiteSpace(path))
        {
            activeDomain = "COMMON";
            return;
        }

        // 2. TOEIC
        if (path.Contains("toeic"))
        {
            activeDomain = "TOEIC";
            return;
        }

        // 3. HSK
        if (path.Contains("hsk"))
        {
            activeDomain = "HSK";
            return;
        }

        // 4. IELTS
        if (path.Contains("mock-tests")
            || path.Contains("grading")
            || path.Contains("listen-videos")
            || path.Contains("stories")
            || path.Contains("ielts-vocab")
            || path.Contains("grammar")
            || path.Contains("speak-along")
            || path.Contains("reading-tool")
            || path.Contains("ielts"))
        {
            activeDomain = "IELTS";
            return;
        }

        activeDomain = "COMMON";
    }

    private void SwitchDomain(string domain)
    {
        activeDomain = domain;
        if (domain == "IELTS")
            NavigationManager.NavigateTo("/portal-hub/mock-tests");
        else if (domain == "TOEIC")
            NavigationManager.NavigateTo("/portal-hub/toeic-mock-tests");
        else if (domain == "HSK")
            NavigationManager.NavigateTo("/portal-hub/hsk-mock-tests");
        else
            NavigationManager.NavigateTo("/portal-hub");
    }

    private void NavigateToLogin()
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
        NavigationManager.NavigateTo($"/portal-hub/login?returnUrl={returnUrl}");
    }

    private async Task HandleLogout()
    {
        await AuthService.AdminLogoutAsync();
        isAdminAuthenticated = false;
        adminName = null;
        adminEmail = null;
        NavigationManager.NavigateTo("/portal-hub/login", forceLoad: true);
    }

    private bool IsActive(string path)
    {
        return $"/{currentUrl}".StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        isDisposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
