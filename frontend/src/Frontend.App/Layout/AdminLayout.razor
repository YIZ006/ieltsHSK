@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="admin-layout">
    <!-- Top Horizontal Navbar -->
    <header class="admin-topbar">
        <div class="topbar-logo" @onclick='() => NavigationManager.NavigateTo("/admin")'>
            <span class="logo-icon">⚙️</span>
            <span class="logo-text">Admin Dashboard</span>
        </div>
        <nav class="topbar-nav">
            <button class="nav-tab @(activeDomain == "IELTS" ? "active" : "")" @onclick='() => SwitchDomain("IELTS")'>
                <span class="tab-icon">🇬🇧</span> IELTS
            </button>
            <button class="nav-tab @(activeDomain == "TOEIC" ? "active" : "")" @onclick='() => SwitchDomain("TOEIC")'>
                <span class="tab-icon">🏆</span> TOEIC
            </button>
            <button class="nav-tab @(activeDomain == "HSK" ? "active" : "")" @onclick='() => SwitchDomain("HSK")'>
                <span class="tab-icon">🇨🇳</span> HSK
            </button>
            <a href="http://localhost:5101/swagger" target="_blank" class="nav-tab" style="text-decoration: none; color: inherit;">
                <span class="tab-icon">⚙️</span> API Swagger
            </a>
        </nav>
        <div class="topbar-user">
            <span class="user-avatar">A</span>
            <span class="user-name">Quản trị viên</span>
        </div>
    </header>

    <div class="admin-body">
        <!-- Left Vertical Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <h3>Quản lý @activeDomain</h3>
            </div>
            <ul class="sidebar-menu">
                @if (activeDomain == "IELTS")
                {
                    <li class="menu-item @(IsActive("/admin/mock-tests") ? "active" : "")">
                        <a href="/admin/mock-tests">
                            <i class="bi bi-journal-text"></i> Quản lý đề thi (Mock Tests)
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/listen-videos") ? "active" : "")">
                        <a href="/admin/listen-videos">
                            <i class="bi bi-camera-video"></i> Duyệt Video Nghe Điền
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/stories") ? "active" : "")">
                        <a href="/admin/stories">
                            <i class="bi bi-book"></i> Quản lý Đọc truyện
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/users") || IsActive("/admin/ielts-users") ? "active" : "")">
                        <a href="/admin/users">
                            <i class="bi bi-people-fill"></i> Quản lý học viên
                        </a>
                    </li>
                }
                else if (activeDomain == "TOEIC")
                {
                    <li class="menu-item @(IsActive("/admin/toeic-mock-tests") ? "active" : "")">
                        <a href="/admin/toeic-mock-tests">
                            <i class="bi bi-journal-text"></i> Quản lý đề thi TOEIC
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/toeic-builder") ? "active" : "")">
                        <a href="/admin/toeic-builder">
                            <i class="bi bi-pencil-square"></i> Tạo & Sửa đề TOEIC
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/users") || IsActive("/admin/toeic-users") ? "active" : "")">
                        <a href="/admin/users">
                            <i class="bi bi-people-fill"></i> Quản lý học viên
                        </a>
                    </li>
                }
                else if (activeDomain == "HSK")
                {
                    <li class="menu-item @(IsActive("/admin/hsk") && !IsActive("/admin/hsk-mock-tests") && !IsActive("/admin/hsk-vocab") ? "active" : "")">
                        <a href="/admin/hsk">
                            <i class="bi bi-grid-fill"></i> Tổng quan HSK
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/hsk-vocab") ? "active" : "")">
                        <a href="/admin/hsk-vocab">
                            <i class="bi bi-translate"></i> Ngân hàng Từ vựng HSK
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/hsk-mock-tests") ? "active" : "")">
                        <a href="/admin/hsk-mock-tests">
                            <i class="bi bi-journal-check"></i> Quản lý Đề thi HSK
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/admin/users") ? "active" : "")">
                        <a href="/admin/users">
                            <i class="bi bi-people-fill"></i> Quản lý học viên
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <!-- Main Content Area -->
        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string activeDomain = "IELTS";
    private string currentUrl = "";

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        
        UpdateActiveDomain(currentUrl);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        UpdateActiveDomain(currentUrl);
        StateHasChanged();
    }

    private void UpdateActiveDomain(string url)
    {
        if (url.Contains("hsk", StringComparison.OrdinalIgnoreCase))
        {
            activeDomain = "HSK";
        }
        else if (url.Contains("toeic", StringComparison.OrdinalIgnoreCase))
        {
            activeDomain = "TOEIC";
        }
        else
        {
            activeDomain = "IELTS";
        }
    }

    private void SwitchDomain(string domain)
    {
        activeDomain = domain;
        if (domain == "IELTS")
            NavigationManager.NavigateTo("/admin/mock-tests");
        else if (domain == "TOEIC")
            NavigationManager.NavigateTo("/admin/toeic-mock-tests");
        else
            NavigationManager.NavigateTo("/admin/hsk");
    }

    private bool IsActive(string path)
    {
        return $"/{currentUrl}".StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
