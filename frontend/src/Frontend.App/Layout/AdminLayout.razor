@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject Frontend.App.Services.AuthService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject Frontend.App.Services.OfflineStorageService OfflineStorageService
@inject Frontend.App.Services.AdminUserService AdminUserService

@if (!isOnline)
{
    <div class="admin-auth-guard">
        <div class="auth-guard-card" style="max-width: 480px; text-align: center;">
            <div class="auth-guard-icon" style="background: #fef2f2; color: #ef4444; width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 1.8rem;">
                <i class="bi bi-wifi-off"></i>
            </div>
            <h3 style="font-weight: 800; font-size: 1.35rem; margin-bottom: 8px; color: #1e293b;">Mất kết nối Internet</h3>
            <p style="font-size: 0.92rem; color: #64748b; margin-bottom: 20px; line-height: 1.6;">
                Trang Quản trị viên (Admin Hub) yêu cầu kết nối mạng để đồng bộ dữ liệu với PostgreSQL và Cloudflare R2.<br />
                Chế độ Offline chỉ khả dụng cho Học viên ôn luyện bài thi.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                <a href="/" class="btn btn-outline-secondary" style="font-weight: 700; border-radius: 10px; padding: 10px 20px;">
                    <i class="bi bi-house-door"></i> Cổng học viên
                </a>
                <a href="/ielts/mock-test" class="btn btn-primary" style="font-weight: 700; border-radius: 10px; padding: 10px 20px;">
                    <i class="bi bi-journal-text"></i> Làm đề Offline
                </a>
            </div>
        </div>
    </div>
}
else if (isCheckingAuth)
{
    <div class="admin-auth-guard">
        <div class="auth-guard-card">
            <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
            <h4 style="font-weight: 800; font-size: 1.15rem; margin: 0;">Đang xác thực quyền Quản trị viên...</h4>
            <p style="font-size: 0.88rem; color: #64748b; margin: 0;">Hệ thống đang kiểm tra phiên làm việc bảo mật</p>
        </div>
    </div>
}
else if (!isAdminAuthenticated)
{
    <div class="admin-auth-guard">
        <div class="auth-guard-card">
            <div class="auth-guard-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h3 style="font-weight: 800; font-size: 1.25rem; margin: 0;">Yêu cầu Đăng nhập Quản trị</h3>
            <p style="font-size: 0.88rem; color: #64748b; margin: 0; text-align: center;">
                Bạn cần đăng nhập bằng tài khoản Quản trị viên (Admin) để có quyền truy cập khu vực này.
            </p>
            <button type="button" class="btn btn-primary" style="font-weight: 700; border-radius: 10px; padding: 8px 24px;" @onclick="NavigateToLogin">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập ngay
            </button>
        </div>
    </div>
}
else
{
    <div class="admin-layout theme-@activeDomain.ToLower()">
        <!-- Top Horizontal Navbar -->
        <header class="admin-topbar">
            <div class="topbar-logo" @onclick='() => NavigationManager.NavigateTo("/portal-hub")'>
                <span class="logo-icon">
                    @if (activeDomain == "HSK") { <span>🇨🇳</span> }
                    else if (activeDomain == "USERS") { <span>👥</span> }
                    else { <span>🇬🇧</span> }
                </span>
                <span class="logo-text">Admin Hub</span>
            </div>

            <nav class="topbar-nav">
                <button class="nav-tab tab-ielts @(activeDomain == "IELTS" ? "active" : "")" @onclick='() => SwitchDomain("IELTS")'>
                    <span class="tab-icon">🇬🇧</span> IELTS
                </button>
                <button class="nav-tab tab-hsk @(activeDomain == "HSK" ? "active" : "")" @onclick='() => SwitchDomain("HSK")'>
                    <span class="tab-icon">🇨🇳</span> HSK
                </button>
                <button class="nav-tab tab-users @(activeDomain == "USERS" ? "active" : "")" @onclick='() => SwitchDomain("USERS")'>
                    <span class="tab-icon">👥</span> Học viên & Users
                </button>
                <a href="http://localhost:5101/swagger" target="_blank" class="nav-tab tab-swagger" style="text-decoration: none;">
                    <span class="tab-icon">⚙️</span> Swagger API
                </a>
            </nav>

            <div class="topbar-user">
                <span class="user-avatar">@(string.IsNullOrWhiteSpace(adminName) ? "A" : adminName.Substring(0, 1).ToUpper())</span>
                <div class="user-info-text">
                    <span class="user-name" title="@adminEmail">@(string.IsNullOrWhiteSpace(adminName) ? "Quản trị viên" : adminName)</span>
                    <span class="domain-tag domain-tag-@activeDomain.ToLower()">@activeDomain</span>
                </div>
                <button type="button" class="btn-admin-logout" @onclick="HandleLogout" title="Đăng xuất khỏi Admin Hub">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </header>

        <div class="admin-body">
            <!-- Left Vertical Sidebar -->
            <aside class="admin-sidebar">
                <div class="sidebar-header">
                    <h3>
                        @if (activeDomain == "USERS")
                        {
                            <span>Quản lý Tài khoản</span>
                        }
                        else
                        {
                            <span>Quản lý @activeDomain</span>
                        }
                    </h3>
                </div>

                <ul class="sidebar-menu">
                    <li class="menu-item @(currentUrl == "portal-hub" || currentUrl == "admin" || currentUrl == "" ? "active" : "")">
                        <a href="/portal-hub">
                            <i class="bi bi-speedometer2"></i> Dashboard Tổng quan
                        </a>
                    </li>
                    @if (activeDomain == "IELTS")
                    {
                        <li class="menu-item @(IsActive("/portal-hub/mock-tests") ? "active" : "")">
                            <a href="/portal-hub/mock-tests">
                                <i class="bi bi-journal-text"></i> Quản lý đề thi (Mock Tests)
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/grading") ? "active" : "")">
                            <a href="/portal-hub/grading">
                                <i class="bi bi-pencil-square"></i> Chấm điểm Writing & Speaking
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/listen-videos") ? "active" : "")">
                            <a href="/portal-hub/listen-videos">
                                <i class="bi bi-camera-video"></i> Duyệt Video Nghe Điền
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/stories") ? "active" : "")">
                            <a href="/portal-hub/stories">
                                <i class="bi bi-book"></i> Quản lý Đọc truyện
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/ielts-vocab") ? "active" : "")">
                            <a href="/portal-hub/ielts-vocab">
                                <i class="bi bi-journal-bookmark-fill"></i> Ngân hàng Từ vựng IELTS
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/grammar") ? "active" : "")">
                            <a href="/portal-hub/grammar">
                                <i class="bi bi-diagram-3-fill"></i> Cấu trúc theo Band
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/speak-along") ? "active" : "")">
                            <a href="/portal-hub/speak-along">
                                <i class="bi bi-mic-fill"></i> Quản lý Nói Theo (Shadowing)
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/navigation") ? "active" : "")">
                            <a href="/portal-hub/navigation">
                                <i class="bi bi-list-nested"></i> Cấu hình Menu (Navigation)
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/users") && (NavigationManager.Uri.Contains("ielts") || !NavigationManager.Uri.Contains("domain")) ? "active" : "")">
                            <a href="/portal-hub/users?domain=ielts">
                                <i class="bi bi-people-fill"></i> Học viên IELTS
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/exam-schedules") ? "active" : "")">
                            <a href="/portal-hub/exam-schedules">
                                <i class="bi bi-calendar2-check-fill text-warning"></i> Lịch thi Chứng chỉ
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/users") && (NavigationManager.Uri.Contains("ielts") || !NavigationManager.Uri.Contains("domain")) ? "active" : "")">
                            <a href="/portal-hub/users?domain=ielts">
                                <i class="bi bi-people-fill"></i> Học viên IELTS
                            </a>
                        </li>
                    }
                    else if (activeDomain == "HSK")
                    {
                        <li class="menu-item @(IsActive("/portal-hub/hsk-mock-tests") ? "active" : "")">
                            <a href="/portal-hub/hsk-mock-tests">
                                <i class="bi bi-journal-check"></i> Quản lý Đề thi HSK
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/hsk-vocab") ? "active" : "")">
                            <a href="/portal-hub/hsk-vocab">
                                <i class="bi bi-translate"></i> Ngân hàng Từ vựng HSK
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/slang-vocabs") ? "active" : "")">
                            <a href="/portal-hub/slang-vocabs">
                                <i class="bi bi-fire text-danger"></i> Tiếng lóng & Trend GenZ
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/culture-stories") ? "active" : "")">
                            <a href="/portal-hub/culture-stories">
                                <i class="bi bi-book-half text-danger"></i> Bài viết Văn hóa
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/exam-schedules") ? "active" : "")">
                            <a href="/portal-hub/exam-schedules">
                                <i class="bi bi-calendar2-check-fill text-warning"></i> Lịch thi Chứng chỉ
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/navigation") ? "active" : "")">
                            <a href="/portal-hub/navigation">
                                <i class="bi bi-list-nested"></i> Cấu hình Menu (Navigation)
                            </a>
                        </li>
                        <li class="menu-item @(IsActive("/portal-hub/users") && NavigationManager.Uri.Contains("hsk") ? "active" : "")">
                            <a href="/portal-hub/users?domain=hsk">
                                <i class="bi bi-people-fill"></i> Học viên HSK
                            </a>
                        </li>
                    }
                    else if (activeDomain == "USERS")
                    {
                        <li class="menu-item @(IsActive("/portal-hub/users") && !NavigationManager.Uri.Contains("domain=") ? "active" : "")">
                            <a href="/portal-hub/users">
                                <i class="bi bi-people-fill"></i> Tất cả người dùng
                            </a>
                        </li>
                        <li class="menu-item @(NavigationManager.Uri.Contains("domain=ielts") ? "active" : "")">
                            <a href="/portal-hub/users?domain=ielts">
                                <i class="bi bi-mortarboard-fill text-primary"></i> Học viên IELTS
                            </a>
                        </li>
                        <li class="menu-item @(NavigationManager.Uri.Contains("domain=hsk") ? "active" : "")">
                            <a href="/portal-hub/users?domain=hsk">
                                <i class="bi bi-translate text-danger"></i> Học viên HSK
                            </a>
                        </li>
                        <li class="menu-item @(NavigationManager.Uri.Contains("domain=admin") ? "active" : "")">
                            <a href="/portal-hub/users?domain=admin">
                                <i class="bi bi-shield-lock-fill text-danger"></i> Ban Quản trị (Admin)
                            </a>
                        </li>
                    }

                    <li class="sidebar-divider my-2"></li>
                    <li class="menu-item @(IsActive("/portal-hub/notifications") ? "active" : "")">
                        <a href="/portal-hub/notifications">
                            <i class="bi bi-bell-fill text-info"></i> Quản lý Thông báo
                        </a>
                    </li>
                    <li class="menu-item @(IsActive("/portal-hub/api-keys") || IsActive("/portal-hub/ai-settings") ? "active" : "")">
                        <a href="/portal-hub/api-keys">
                            <i class="bi bi-key-fill text-warning"></i> Cấu hình API & AI
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- Main Content Area -->
            <main class="admin-content">
                @Body
            </main>
        </div>
    </div>
}

<MascotWidget />


@if (showDeployModal)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(15, 23, 42, 0.7); z-index: 99999;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 100000;" @onclick="CloseDeployModal">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-content" style="border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4); overflow: hidden;">
                <div class="modal-header" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 18px 24px;">
                    <h5 class="modal-title d-flex align-items-center gap-2 text-white m-0" style="font-weight: 700; font-size: 1.1rem;">
                        <span style="font-size: 1.3rem;">🚀</span> Triển khai Frontend (Cloudflare Pages)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeployModal"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    @if (!string.IsNullOrEmpty(deployResultMsg))
                    {
                        <div class="alert @(deployResultSuccess ? "alert-success" : "alert-danger") d-flex align-items-center gap-2" role="alert" style="border-radius: 10px; font-size: 0.9rem;">
                            <i class="bi @(deployResultSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger")" style="font-size: 1.2rem;"></i>
                            <div>@deployResultMsg</div>
                        </div>
                    }

                    <p style="font-size: 0.88rem; color: #64748b; line-height: 1.5; margin-bottom: 16px;">
                        Kích hoạt Cloudflare Pages tự động lấy code mới nhất từ nhánh <code>main</code> và build lại website <code>https://ieltshsk.me</code>.
                    </p>

                    <div class="form-group mb-3">
                        <label style="font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; display: block;">
                            Cloudflare Pages Deploy Hook URL
                        </label>
                        <input type="text" class="form-control" @bind="deployHookUrl" placeholder="https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/..." style="font-family: monospace; font-size: 0.82rem; border-radius: 8px; padding: 10px 12px;" />
                    </div>

                    <div class="p-3" style="background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 0.8rem; color: #64748b;">
                        <strong style="color: #334155; display: block; margin-bottom: 4px;">📌 Hướng dẫn lấy Deploy Hook (chỉ làm 1 lần):</strong>
                        1. Đăng nhập Cloudflare Dashboard ➔ <b>Workers &amp; Pages</b> ➔ chọn project của bạn.<br />
                        2. Vào <b>Settings</b> ➔ <b>Builds &amp; deployments</b> ➔ mục <b>Deploy hooks</b>.<br />
                        3. Bấm <b>Add deploy hook</b>, chọn nhánh <b>main</b> rồi Copy URL và dán vào đây.
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #e2e8f0; padding: 14px 24px; background: #f8fafc;">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeployModal" style="border-radius: 8px; font-weight: 600; font-size: 0.88rem;">Đóng</button>
                    <button type="button" class="btn btn-primary" @onclick="ExecuteDeploy" disabled="@isDeploying" style="border-radius: 8px; font-weight: 700; font-size: 0.88rem; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none; padding: 8px 20px;">
                        @if (isDeploying)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang kích hoạt...</span>
                        }
                        else
                        {
                            <i class="bi bi-rocket-takeoff-fill me-1"></i>
                            <span>Triển khai ngay</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool showDeployModal = false;
    private bool isDeploying = false;
    private string? deployHookUrl = null;
    private string? deployResultMsg = null;
    private bool deployResultSuccess = false;

    private async Task OpenDeployModal()
    {
        deployResultMsg = null;
        showDeployModal = true;
        if (string.IsNullOrWhiteSpace(deployHookUrl))
        {
            var s = await AdminUserService.GetAiSettingsAsync();
            if (!string.IsNullOrWhiteSpace(s?.CloudflarePagesDeployHook))
            {
                deployHookUrl = s.CloudflarePagesDeployHook;
            }
        }
    }

    private void CloseDeployModal()
    {
        showDeployModal = false;
    }

    private async Task ExecuteDeploy()
    {
        isDeploying = true;
        deployResultMsg = null;
        var (ok, msg) = await AdminUserService.DeployFrontendAsync(deployHookUrl);
        isDeploying = false;
        deployResultSuccess = ok;
        deployResultMsg = msg;
    }

    private string activeDomain = "IELTS";
    private string currentUrl = "";
    private bool isCheckingAuth = true;
    private bool isAdminAuthenticated = false;
    private bool isDisposed = false;
    private bool isOnline = true;
    private string? adminName;
    private string? adminEmail;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        await OfflineStorageService.InitializeAsync();
        isOnline = await OfflineStorageService.IsOnlineAsync();
        OfflineStorageService.NetworkStatusChanged += HandleNetworkStatusChanged;

        UpdateActiveDomain(currentUrl);
        await CheckAdminAuthState(initial: true);
    }

    private async Task CheckAdminAuthState(bool initial = false)
    {
        if (isDisposed) return;
        if (initial) isCheckingAuth = true;

        try
        {
            // Kiểm tra token riêng của Quản trị viên
            var adminToken = await AuthService.GetAdminTokenAsync();
            if (!string.IsNullOrWhiteSpace(adminToken) && !CustomAuthStateProvider.IsJwtExpired(adminToken))
            {
                var claims = CustomAuthStateProvider.ParseClaimsFromJwt(adminToken);
                var roleClaim = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role")?.Value;
                isAdminAuthenticated = string.Equals(roleClaim, "admin", StringComparison.OrdinalIgnoreCase);

                if (isAdminAuthenticated)
                {
                    adminName = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Name || c.Type == "unique_name" || c.Type == "name")?.Value ?? "Quản trị viên";
                    adminEmail = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email || c.Type == "email")?.Value;
                }
            }
            else
            {
                // Fallback nếu phiên làm việc cũ còn trong AuthStateProvider
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                isAdminAuthenticated = user.Identity?.IsAuthenticated == true && (user.IsInRole("admin") || user.IsInRole("Admin"));
                
                if (isAdminAuthenticated)
                {
                    adminName = user.Identity?.Name 
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value 
                        ?? user.FindFirst("name")?.Value 
                        ?? user.FindFirst("unique_name")?.Value;
                    adminEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                        ?? user.FindFirst("email")?.Value;
                }
            }

            if (!isAdminAuthenticated)
            {
                adminName = null;
                adminEmail = null;
                
                var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                if (!currentPath.Contains("login", StringComparison.OrdinalIgnoreCase))
                {
                    var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
                    NavigationManager.NavigateTo($"/portal-hub/login?returnUrl={returnUrl}");
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLayout] CheckAdminAuthState error: {ex.Message}");
            isAdminAuthenticated = false;
        }
        finally
        {
            if (initial) isCheckingAuth = false;
            if (!isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (isDisposed) return;
        try
        {
            currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
            UpdateActiveDomain(currentUrl);
            await CheckAdminAuthState(initial: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminLayout] OnLocationChanged error: {ex.Message}");
        }
    }

    private void UpdateActiveDomain(string url)
    {
        if (url.Contains("users", StringComparison.OrdinalIgnoreCase))
        {
            if (NavigationManager.Uri.Contains("domain=hsk", StringComparison.OrdinalIgnoreCase))
                activeDomain = "HSK";
            else if (NavigationManager.Uri.Contains("domain=ielts", StringComparison.OrdinalIgnoreCase))
                activeDomain = "IELTS";
            else
                activeDomain = "USERS";
        }
        else if (url.Contains("hsk", StringComparison.OrdinalIgnoreCase) || url.Contains("culture", StringComparison.OrdinalIgnoreCase))
        {
            activeDomain = "HSK";
        }
        else if (url.Contains("exam-schedules", StringComparison.OrdinalIgnoreCase))
        {
            if (activeDomain != "HSK" && activeDomain != "IELTS")
            {
                activeDomain = "HSK";
            }
        }
        else
        {
            activeDomain = "IELTS";
        }
    }

    private void SwitchDomain(string domain)
    {
        activeDomain = domain;
        if (domain == "IELTS")
            NavigationManager.NavigateTo("/portal-hub/mock-tests");
        else if (domain == "HSK")
            NavigationManager.NavigateTo("/portal-hub/hsk-mock-tests");
        else
            NavigationManager.NavigateTo("/portal-hub/users");
    }

    private void NavigateToLogin()
    {
        var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
        NavigationManager.NavigateTo($"/portal-hub/login?returnUrl={returnUrl}");
    }

    private async Task HandleLogout()
    {
        await AuthService.AdminLogoutAsync();
        isAdminAuthenticated = false;
        adminName = null;
        adminEmail = null;
        NavigationManager.NavigateTo("/portal-hub/login", forceLoad: true);
    }

    private bool IsActive(string path)
    {
        return $"/{currentUrl}".StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    private async void HandleNetworkStatusChanged(bool online)
    {
        if (isDisposed) return;
        isOnline = online;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        isDisposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        OfflineStorageService.NetworkStatusChanged -= HandleNetworkStatusChanged;
    }
}
