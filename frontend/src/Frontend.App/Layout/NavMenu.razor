@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ExamHeaderService ExamHeader
@implements IDisposable

<nav class="navbar">
    <div class="navbar-brand">
        <a class="brand-logo" href="/" style="text-decoration: none; color: inherit;">
            <i class="bi bi-box-fill"></i>
            <span class="brand-text">ieltsHSK</span>
        </a>
    </div>

    <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
        <i class="bi bi-list"></i>
    </button>

    <div class="@NavMenuCssClass navbar-collapse" @onclick="ToggleNavMenu">
        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    Home
                </NavLink>
            </li>
        </ul>

        <div class="exam-toolbar exam-toolbar-desktop">
            @if (ExamHeader.Visible)
            {
                <button class="exam-submit-btn" @onclick="() => ExamHeader.RequestSubmit()" @onclick:stopPropagation>NỘP BÀI</button>
                <span class="exam-timer-chip @(ExamHeader.TimerUrgent ? "urgent" : "")">@ExamHeader.TimerText</span>
            }
        </div>

        <ul class="navbar-nav auth-nav">
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item user-menu">
                        <button class="nav-link welcome-toggle" @onclick="ToggleUserMenu" @onclick:stopPropagation>
                            Xin chào, @(context.User.FindFirst(c => c.Type == "unique_name")?.Value ?? context.User.Identity?.Name ?? "User")!
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        @if (showUserMenu)
                        {
                            <div class="user-backdrop" @onclick="() => showUserMenu = false" @onclick:stopPropagation></div>
                            <div class="user-dropdown">
                                <button class="dropdown-item btn-logout" @onclick="Logout" @onclick:stopPropagation>
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </div>
                        }
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item">
                        <button class="nav-link btn-auth" @onclick="() => OnShowLogin.InvokeAsync()" @onclick:stopPropagation>
                            Login
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn-auth btn-register" @onclick="() => OnShowRegister.InvokeAsync()" @onclick:stopPropagation>
                            Register
                        </button>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>

    <div class="exam-toolbar exam-toolbar-mobile">
        @if (ExamHeader.Visible)
        {
            <button class="exam-submit-btn" @onclick="() => ExamHeader.RequestSubmit()">NỘP BÀI</button>
            <span class="exam-timer-chip @(ExamHeader.TimerUrgent ? "urgent" : "")">@ExamHeader.TimerText</span>
        }
    </div>
</nav>

@code {
    [Parameter]
    public EventCallback OnShowLogin { get; set; }

    [Parameter]
    public EventCallback OnShowRegister { get; set; }

    private bool collapseNavMenu = true;
    private bool showUserMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    protected override void OnInitialized()
    {
        ExamHeader.OnChange += OnExamHeaderChanged;
    }

    private void OnExamHeaderChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ExamHeader.OnChange -= OnExamHeaderChanged;
    }

    private async Task Logout()
    {
        showUserMenu = false;
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", true);
    }
}
