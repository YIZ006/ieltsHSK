@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Frontend.App.Models
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ExamHeaderService ExamHeader
@inject ProfileService ProfileSvc
@inject StreakService StreakSvc
@inject NotificationService NotifSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@implements IDisposable

<nav class="navbar">
    @if (IsStandalonePage)
    {
        <div class="navbar-brand-area">
            <a href="/" class="topbar-brand" title="ieltsHSK - Trang chủ">
                <img src="images/ieltsHSK-logo.png" alt="ieltsHSK" class="topbar-brand-img brand-logo-light" />
                <img src="images/ieltsHSK-logo-white.png" alt="ieltsHSK" class="topbar-brand-img brand-logo-dark" />
            </a>
        </div>

        <nav class="home-nav-links" aria-label="Home Navigation">
            <a href="/ielts/dashboard" class="home-nav-link">
                <span>IELTS Engine</span>
            </a>
            <a href="/hsk" class="home-nav-link hsk-matrix-link">
                <span>HSK 3.0 Matrix</span>
                <span class="home-badge-new">New</span>
            </a>
            <a href="/ielts/mock-test" class="home-nav-link">
                <span>Mock Tests</span>
            </a>
            <a href="/ielts/tu-vung" class="home-nav-link">
                <span>Vocabulary Vault</span>
            </a>
            <a href="/ielts/dashboard" class="home-nav-link">
                <span>Diagnostic Scoring</span>
            </a>
        </nav>

        <button type="button" class="home-mobile-toggle" @onclick="ToggleMobileHomeMenu" aria-label="Toggle navigation menu">
            <i class="bi @(showMobileHomeMenu ? "bi-x-lg" : "bi-list")"></i>
        </button>
    }

    <div class="navbar-collapse">
        <div class="navbar-spacer"></div>

        <div class="exam-toolbar exam-toolbar-desktop">
            @if (ExamHeader.Visible)
            {
                @if (!string.IsNullOrEmpty(ExamHeader.SecondaryButtonText))
                {
                    <button class="exam-secondary-btn" @onclick="() => ExamHeader.RequestSecondaryAction()" @onclick:stopPropagation>@ExamHeader.SecondaryButtonText</button>
                }
                <button class="exam-submit-btn" @onclick="() => ExamHeader.RequestSubmit()" @onclick:stopPropagation>NỘP BÀI</button>
                <span class="exam-timer-chip @(ExamHeader.TimerUrgent ? "urgent" : "")">@ExamHeader.TimerText</span>
            }
        </div>

        <ul class="navbar-nav auth-nav ms-auto">
            @if (IsStandalonePage)
            {
                <li class="nav-item theme-switcher-container">
                    <div class="theme-switch-pill" role="group" aria-label="Giao diện sáng tối">
                        <button type="button" class="theme-btn @(!isDarkMode ? "active" : "")" @onclick="(e) => SetThemeWithCoords(false, e)" title="Chế độ Sáng">
                            <i class="bi bi-sun-fill theme-sun-icon"></i>
                            <span class="theme-text">Sáng</span>
                        </button>
                        <button type="button" class="theme-btn @(isDarkMode ? "active" : "")" @onclick="(e) => SetThemeWithCoords(true, e)" title="Chế độ Tối">
                            <i class="bi bi-moon-stars-fill theme-moon-icon"></i>
                            <span class="theme-text">Tối</span>
                        </button>
                    </div>
                </li>
            }

            <AuthorizeView>
                <Authorized>
                    <li class="nav-item streak-menu">
                        <button class="streak-btn" @onclick="ToggleStreakMenu" @onclick:stopPropagation title="Xem chuỗi học tập">
                            <span class="streak-chip">🔥 @currentStreak</span>
                        </button>
                        @if (showStreakMenu)
                        {
                            <div class="user-backdrop" @onclick="() => showStreakMenu = false" @onclick:stopPropagation></div>
                            <div class="streak-popover">
                                <div class="streak-popover-header">
                                    <span class="streak-popover-icon">🔥</span>
                                    <span class="streak-popover-title">Chuỗi học tập</span>
                                </div>
                                <div class="streak-popover-body">
                                    <div class="streak-stat-row">
                                        <span class="streak-stat-label">Chuỗi hiện tại</span>
                                        <span class="streak-stat-value streak-current">@currentStreak ngày</span>
                                    </div>
                                    <div class="streak-stat-row">
                                        <span class="streak-stat-label">Chuỗi dài nhất</span>
                                        <span class="streak-stat-value">@bestStreak ngày</span>
                                    </div>
                                    <div class="streak-popover-hint">
                                        @if (currentStreak == 0)
                                        {
                                            <span>Hãy bắt đầu học ngay hôm nay để tạo chuỗi!</span>
                                        }
                                        else if (currentStreak == 1)
                                        {
                                            <span>Tuyệt vời! Duy trì mỗi ngày nhé 💪</span>
                                        }
                                        else if (currentStreak < 7)
                                        {
                                            <span>Tiếp tục nhé, sắp đạt mốc 7 ngày! 🎯</span>
                                        }
                                        else
                                        {
                                            <span>Xuất sắc! Bạn đang rất kiên trì 🌟</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </li>

                    <li class="nav-item notif-menu">
                        <button class="notif-btn @(showNotifMenu ? "active" : "") @(unreadNotifCount > 0 ? "has-unread" : "")" 
                                @onclick="ToggleNotifMenu" 
                                @onclick:stopPropagation 
                                title="Thông báo (@unreadNotifCount chưa đọc)">
                            <i class="bi bi-bell-fill notif-bell-icon"></i>
                            @if (unreadNotifCount > 0)
                            {
                                <span class="notif-badge">@(unreadNotifCount > 99 ? "99+" : unreadNotifCount)</span>
                            }
                        </button>
                        @if (showNotifMenu)
                        {
                            <div class="user-backdrop" @onclick="() => showNotifMenu = false" @onclick:stopPropagation></div>
                            <div class="notif-popover" @onclick:stopPropagation>
                                <div class="notif-popover-header">
                                    <div class="notif-header-left">
                                        <i class="bi bi-bell-fill text-warning"></i>
                                        <span class="notif-popover-title">Thông báo</span>
                                        @if (unreadNotifCount > 0)
                                        {
                                            <span class="notif-count-chip">@unreadNotifCount mới</span>
                                        }
                                    </div>
                                    @if (unreadNotifCount > 0)
                                    {
                                        <button type="button" class="notif-mark-all-btn" @onclick="HandleMarkAllAsRead" title="Đánh dấu tất cả đã đọc">
                                            <i class="bi bi-check2-all"></i> Đã đọc tất cả
                                        </button>
                                    }
                                </div>
                                <div class="notif-popover-body">
                                    @if (isLoadingNotifs)
                                    {
                                        <div class="notif-loading">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                            <span>Đang tải thông báo...</span>
                                        </div>
                                    }
                                    else if (notifications.Count == 0)
                                    {
                                        <div class="notif-empty">
                                            <div class="notif-empty-icon">🔔</div>
                                            <div class="notif-empty-title">Chưa có thông báo nào</div>
                                            <div class="notif-empty-sub">Khi có thông báo về đề thi, cập nhật hệ thống hoặc sự kiện, bạn sẽ nhận được tại đây.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="notif-list">
                                            @foreach (var n in notifications)
                                            {
                                                <div class="notif-card @(n.IsRead ? "read" : "unread") @(expandedNotifIds.Contains(n.Id) ? "expanded" : "")" @onclick="() => HandleNotificationCardClick(n)">
                                                    <div class="notif-icon-wrap notif-icon-@n.Type">
                                                        <i class="bi @(string.IsNullOrWhiteSpace(n.Icon) ? "bi-bell-fill" : n.Icon)"></i>
                                                    </div>
                                                    <div class="notif-content-wrap">
                                                        <div class="notif-title-row">
                                                            <span class="notif-item-title">@n.Title</span>
                                                            <div class="notif-title-actions">
                                                                @if (!n.IsRead)
                                                                {
                                                                    <span class="notif-unread-dot" title="Chưa đọc"></span>
                                                                }
                                                                <i class="bi @(expandedNotifIds.Contains(n.Id) ? "bi-chevron-up" : "bi-chevron-down") notif-expand-chevron" title="@(expandedNotifIds.Contains(n.Id) ? "Thu gọn" : "Mở rộng")"></i>
                                                            </div>
                                                        </div>
                                                        <div class="notif-item-message">@n.Message</div>
                                                        <div class="notif-meta-row">
                                                            <span class="notif-time">@GetTimeAgo(n.CreatedAt)</span>
                                                            @if (!string.IsNullOrWhiteSpace(n.TargetUrl))
                                                            {
                                                                <button type="button" class="notif-link-btn" @onclick="() => HandleNavigateTarget(n)" @onclick:stopPropagation title="Xem chi tiết liên kết">
                                                                    <span>Xem chi tiết</span>
                                                                    <i class="bi bi-arrow-right"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </li>

                    <li class="nav-item user-menu">
                        <button class="nav-profile-pill @(showUserMenu ? "active" : "")" @onclick="ToggleUserMenu" @onclick:stopPropagation title="Mở thẻ hồ sơ cá nhân">
                            <span class="profile-avatar-mini">
                                @if (!string.IsNullOrWhiteSpace(avatarEmoji) && avatarEmoji.Length <= 2)
                                {
                                    <span>@avatarEmoji</span>
                                }
                                else
                                {
                                    <span>@GetInitial(welcomeName)</span>
                                }
                            </span>
                            <span class="profile-pill-name">@welcomeName</span>
                            <i class="bi bi-chevron-down profile-pill-arrow @(showUserMenu ? "rotate" : "")"></i>
                        </button>

                        @if (showUserMenu)
                        {
                            <div class="user-backdrop" @onclick="() => showUserMenu = false" @onclick:stopPropagation></div>
                            <div class="profile-popover-card" @onclick:stopPropagation>
                                @* ── Popover Header Cover ── *@
                                <div class="popover-cover">
                                    <button class="popover-close-btn" @onclick="() => showUserMenu = false" title="Đóng">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>

                                @* ── Avatar with online badge ── *@
                                <div class="popover-avatar-container">
                                    <div class="popover-avatar">
                                        @if (!string.IsNullOrWhiteSpace(avatarEmoji) && avatarEmoji.Length <= 2)
                                        {
                                            <span>@avatarEmoji</span>
                                        }
                                        else
                                        {
                                            <span>@GetInitial(welcomeName)</span>
                                        }
                                    </div>
                                    <span class="online-indicator" title="Đang online"></span>
                                </div>

                                @* ── User Basic Info ── *@
                                <div class="popover-user-info">
                                    <h4 class="popover-fullname">@welcomeName</h4>
                                    @if (!string.IsNullOrWhiteSpace(userEmail))
                                    {
                                        <div class="popover-email">@userEmail</div>
                                    }
                                    <div class="popover-badges">
                                        @if (isAdmin)
                                        {
                                            <span class="badge-role badge-admin"><i class="bi bi-shield-check"></i> Quản trị viên</span>
                                        }
                                        else
                                        {
                                            <span class="badge-role badge-member"><i class="bi bi-person-check"></i> Học viên</span>
                                        }
                                        @if (currentStreak > 0)
                                        {
                                            <span class="badge-streak">🔥 @currentStreak ngày</span>
                                        }
                                    </div>
                                </div>

                                @* ── Quick Stats Row ── *@
                                <div class="popover-stats-row">
                                    <div class="popover-stat-item">
                                        <span class="stat-label">Cấp độ</span>
                                        <span class="stat-val">@(string.IsNullOrWhiteSpace(studyLevel) ? "HSK/IELTS" : studyLevel)</span>
                                    </div>
                                    <div class="popover-stat-divider"></div>
                                    <div class="popover-stat-item">
                                        <span class="stat-label">Mục tiêu</span>
                                        <span class="stat-val">@(string.IsNullOrWhiteSpace(targetExam) ? "IELTS" : targetExam)</span>
                                    </div>
                                </div>

                                @* ── Action Navigation List ── *@
                                <div class="popover-nav-list">
                                    <button type="button" class="popover-nav-item" @onclick='() => HandleOpenProfile("info")'>
                                        <div class="nav-item-icon bg-blue"><i class="bi bi-person-gear"></i></div>
                                        <div class="nav-item-content">
                                            <span class="nav-item-title">Hồ sơ cá nhân</span>
                                            <span class="nav-item-subtitle">Cài đặt tài khoản & mục tiêu</span>
                                        </div>
                                        <i class="bi bi-chevron-right nav-item-arrow"></i>
                                    </button>

                                    <button type="button" class="popover-nav-item" @onclick='() => HandleOpenProfile("stats")'>
                                        <div class="nav-item-icon bg-green"><i class="bi bi-trophy"></i></div>
                                        <div class="nav-item-content">
                                            <span class="nav-item-title">Thành tích & Lịch sử</span>
                                            <span class="nav-item-subtitle">Xem điểm thi và tiến độ</span>
                                        </div>
                                        <i class="bi bi-chevron-right nav-item-arrow"></i>
                                    </button>

                                    @if (isAdmin)
                                    {
                                        <a href="/portal-hub/users" class="popover-nav-item" @onclick="() => showUserMenu = false">
                                            <div class="nav-item-icon bg-purple"><i class="bi bi-shield-lock"></i></div>
                                            <div class="nav-item-content">
                                                <span class="nav-item-title">Trang Quản Trị</span>
                                                <span class="nav-item-subtitle">Quản lý người dùng & dữ liệu</span>
                                            </div>
                                            <i class="bi bi-chevron-right nav-item-arrow"></i>
                                        </a>
                                    }
                                </div>

                                @* ── Popover Footer ── *@
                                <div class="popover-footer">
                                    <button class="btn-popover-logout" @onclick="Logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Đăng xuất tài khoản</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item">
                        <button class="btn-signin" @onclick="() => OnShowLogin.InvokeAsync()" @onclick:stopPropagation>
                            Sign In
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn-get-started" @onclick="() => OnShowRegister.InvokeAsync()" @onclick:stopPropagation>
                            Get Started Free
                        </button>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>

    @if (IsStandalonePage && showMobileHomeMenu)
    {
        <div class="home-mobile-backdrop" @onclick="() => showMobileHomeMenu = false"></div>
        <div class="home-mobile-drawer">
            <a href="/ielts/dashboard" class="home-mobile-link" @onclick="() => showMobileHomeMenu = false">
                <span>IELTS Engine</span>
                <i class="bi bi-arrow-right"></i>
            </a>
            <a href="/hsk" class="home-mobile-link" @onclick="() => showMobileHomeMenu = false">
                <span class="d-inline-flex align-items-center gap-2">
                    HSK 3.0 Matrix
                    <span class="home-badge-new">New</span>
                </span>
                <i class="bi bi-arrow-right"></i>
            </a>
            <a href="/ielts/mock-test" class="home-mobile-link" @onclick="() => showMobileHomeMenu = false">
                <span>Mock Tests</span>
                <i class="bi bi-arrow-right"></i>
            </a>
            <a href="/ielts/tu-vung" class="home-mobile-link" @onclick="() => showMobileHomeMenu = false">
                <span>Vocabulary Vault</span>
                <i class="bi bi-arrow-right"></i>
            </a>
            <a href="/ielts/dashboard" class="home-mobile-link" @onclick="() => showMobileHomeMenu = false">
                <span>Diagnostic Scoring</span>
                <i class="bi bi-arrow-right"></i>
            </a>

            <div class="home-mobile-theme-row">
                <span class="theme-mobile-label">Giao diện:</span>
                <div class="theme-switch-pill" role="group" aria-label="Chế độ sáng tối">
                    <button type="button" class="theme-btn @(!isDarkMode ? "active" : "")" @onclick="(e) => SetThemeWithCoords(false, e)" title="Chế độ Sáng">
                        <i class="bi bi-sun-fill theme-sun-icon"></i>
                        <span class="theme-text">Sáng</span>
                    </button>
                    <button type="button" class="theme-btn @(isDarkMode ? "active" : "")" @onclick="(e) => SetThemeWithCoords(true, e)" title="Chế độ Tối">
                        <i class="bi bi-moon-stars-fill theme-moon-icon"></i>
                        <span class="theme-text">Tối</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="exam-toolbar exam-toolbar-mobile">
        @if (ExamHeader.Visible)
        {
            @if (!string.IsNullOrEmpty(ExamHeader.SecondaryButtonText))
            {
                <button class="exam-secondary-btn" @onclick="() => ExamHeader.RequestSecondaryAction()" @onclick:stopPropagation>@ExamHeader.SecondaryButtonText</button>
            }
            <button class="exam-submit-btn" @onclick="() => ExamHeader.RequestSubmit()">NỘP BÀI</button>
            <span class="exam-timer-chip @(ExamHeader.TimerUrgent ? "urgent" : "")">@ExamHeader.TimerText</span>
        }
    </div>
</nav>

@code {
    [Parameter]
    public EventCallback OnShowLogin { get; set; }

    [Parameter]
    public EventCallback OnShowRegister { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenProfile { get; set; }

    private static string _cachedWelcomeName = "";
    private static string _cachedAvatarEmoji = "🎓";
    private static string _cachedUserEmail = "";
    private static string _cachedStudyLevel = "HSK3";
    private static string _cachedTargetExam = "HSK";
    private static bool _cachedIsAdmin = false;
    private static int _cachedCurrentStreak = 0;
    private static int _cachedBestStreak = 0;

    private bool showUserMenu = false;
    private bool showStreakMenu = false;
    private bool showNotifMenu = false;
    private bool showMobileHomeMenu = false;
    private bool isDarkMode = false;
    private bool isLoadingNotifs = false;
    private List<NotificationDto> notifications = new();
    private int unreadNotifCount => notifications.Count(n => !n.IsRead);
    private HashSet<int> expandedNotifIds = new();

    private void ToggleMobileHomeMenu()
    {
        showMobileHomeMenu = !showMobileHomeMenu;
    }

    private async Task SetThemeWithCoords(bool dark, MouseEventArgs e)
    {
        isDarkMode = dark;
        try
        {
            await JSRuntime.InvokeVoidAsync("toggleAppThemeWithRipple", dark, e.ClientX, e.ClientY);
        }
        catch
        {
            await JSRuntime.InvokeVoidAsync("setAppTheme", dark ? "dark" : "light");
        }
    }

    private async Task SetTheme(bool dark)
    {
        isDarkMode = dark;
        try
        {
            await JSRuntime.InvokeVoidAsync("setAppTheme", dark ? "dark" : "light");
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JSRuntime.InvokeAsync<string>("getAppTheme");
                isDarkMode = theme == "dark";
                StateHasChanged();
            }
            catch { }
        }
    }

    private string welcomeName = !string.IsNullOrEmpty(_cachedWelcomeName) ? _cachedWelcomeName : "Học viên";
    private string userEmail = _cachedUserEmail;
    private string avatarEmoji = !string.IsNullOrEmpty(_cachedAvatarEmoji) ? _cachedAvatarEmoji : "🎓";
    private string studyLevel = _cachedStudyLevel;
    private string targetExam = _cachedTargetExam;
    private bool isAdmin = _cachedIsAdmin;
    private int currentStreak = _cachedCurrentStreak;
    private int bestStreak = _cachedBestStreak;

    private async Task HandleOpenProfile(string tab)
    {
        showUserMenu = false;
        if (OnOpenProfile.HasDelegate)
        {
            await OnOpenProfile.InvokeAsync(tab);
        }
        else
        {
            NavigationManager.NavigateTo("/profile");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Check if we have synchronous in-memory profile available
        var cached = ProfileService.CachedProfile;
        if (cached != null)
        {
            ApplyProfile(cached);
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdmin = user.IsInRole("Admin") || user.HasClaim(c => c.Type == ClaimTypes.Role && c.Value == "Admin");
            _cachedIsAdmin = isAdmin;

            if (user.Identity?.IsAuthenticated == true)
            {
                var userNameClaim = user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity.Name;
                if (!string.IsNullOrWhiteSpace(userNameClaim) && welcomeName == "Học viên")
                {
                    welcomeName = userNameClaim;
                    _cachedWelcomeName = userNameClaim;
                }
            }

            userEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
            _cachedUserEmail = userEmail;

            var profile = await ProfileSvc.GetAsync();
            ApplyProfile(profile);

            currentStreak = await StreakSvc.GetCurrentStreakAsync();
            bestStreak = await StreakSvc.GetBestStreakAsync();
            _cachedCurrentStreak = currentStreak;
            _cachedBestStreak = bestStreak;
        }
        catch { }

        ExamHeader.OnChange += OnExamHeaderChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        NotifSvc.OnChange += OnNotifChanged;
        ProfileService.OnProfileChanged += OnProfileServiceChanged;
        _ = LoadNotificationsAsync();
    }

    private static readonly HashSet<string> StandaloneRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "",
        "privacy",
        "terms",
        "curriculum",
        "contact"
    };

    private bool IsStandalonePage
    {
        get
        {
            var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var path = rel.Split('?', '#')[0].Trim('/');
            return StandaloneRoutes.Contains(path);
        }
    }

    private bool IsHomePage
    {
        get
        {
            var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var path = rel.Split('?', '#')[0].Trim('/');
            return string.IsNullOrEmpty(path);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        showUserMenu = false;
        showStreakMenu = false;
        showNotifMenu = false;
        showMobileHomeMenu = false;
        InvokeAsync(StateHasChanged);
    }

    private void ApplyProfile(UserProfile profile)
    {
        if (!string.IsNullOrWhiteSpace(profile.FullName))
        {
            welcomeName = profile.FullName;
        }
        else if (!string.IsNullOrWhiteSpace(profile.DisplayName))
        {
            welcomeName = profile.DisplayName;
        }
        _cachedWelcomeName = welcomeName;

        if (!string.IsNullOrWhiteSpace(profile.Email))
        {
            userEmail = profile.Email;
            _cachedUserEmail = userEmail;
        }
        if (!string.IsNullOrWhiteSpace(profile.AvatarEmoji))
        {
            avatarEmoji = profile.AvatarEmoji;
            _cachedAvatarEmoji = avatarEmoji;
        }
        if (!string.IsNullOrWhiteSpace(profile.StudyLevel))
        {
            studyLevel = profile.StudyLevel;
            _cachedStudyLevel = studyLevel;
        }
        if (!string.IsNullOrWhiteSpace(profile.TargetExam))
        {
            targetExam = profile.TargetExam;
            _cachedTargetExam = targetExam;
        }
    }

    private string GetInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name) || name == "Học viên") return "🎓";
        var trimmed = name.Trim();
        return trimmed.Substring(0, 1).ToUpperInvariant();
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        if (showUserMenu)
        {
            showStreakMenu = false;
            showNotifMenu = false;
        }
    }

    private void ToggleStreakMenu()
    {
        showStreakMenu = !showStreakMenu;
        if (showStreakMenu)
        {
            showUserMenu = false;
            showNotifMenu = false;
        }
    }

    private async Task ToggleNotifMenu()
    {
        showNotifMenu = !showNotifMenu;
        if (showNotifMenu)
        {
            showUserMenu = false;
            showStreakMenu = false;
            await LoadNotificationsAsync();
        }
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            isLoadingNotifs = true;
            notifications = await NotifSvc.GetNotificationsAsync();
        }
        catch
        {
            // fallback gracefully
        }
        finally
        {
            isLoadingNotifs = false;
            StateHasChanged();
        }
    }

    private async Task HandleNotificationCardClick(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            await NotifSvc.MarkAsReadAsync(notif.Id);
            notif.IsRead = true;
        }

        if (expandedNotifIds.Contains(notif.Id))
        {
            expandedNotifIds.Remove(notif.Id);
        }
        else
        {
            expandedNotifIds.Add(notif.Id);
        }
        StateHasChanged();
    }

    private async Task HandleNavigateTarget(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            await NotifSvc.MarkAsReadAsync(notif.Id);
            notif.IsRead = true;
        }
        showNotifMenu = false;
        if (!string.IsNullOrWhiteSpace(notif.TargetUrl))
        {
            NavigationManager.NavigateTo(notif.TargetUrl);
        }
    }

    private async Task HandleMarkAllAsRead()
    {
        await NotifSvc.MarkAllAsReadAsync();
        foreach (var n in notifications)
        {
            n.IsRead = true;
        }
        StateHasChanged();
    }

    private string GetTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} phút trước";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} giờ trước";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} ngày trước";
        return dt.ToLocalTime().ToString("dd/MM/yyyy");
    }

    private void OnNotifChanged()
    {
        _ = InvokeAsync(async () =>
        {
            notifications = await NotifSvc.GetNotificationsAsync();
            StateHasChanged();
        });
    }

    private void OnExamHeaderChanged() => InvokeAsync(StateHasChanged);

    private void OnProfileServiceChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var p = await ProfileSvc.GetAsync(true);
            ApplyProfile(p);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ExamHeader.OnChange -= OnExamHeaderChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        NotifSvc.OnChange -= OnNotifChanged;
        ProfileService.OnProfileChanged -= OnProfileServiceChanged;
    }

    private async Task Logout()
    {
        showUserMenu = false;
        _cachedWelcomeName = "";
        _cachedUserEmail = "";
        _cachedAvatarEmoji = "🎓";
        _cachedIsAdmin = false;
        ProfileService.InvalidateCache();
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", true);
    }
}
