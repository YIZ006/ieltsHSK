@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Frontend.App.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject StreakService Streak
@inject NavigationManager NavManager
@implements IDisposable

<div class="app-shell @(isStandalonePage ? "no-sidebar" : (sidebarCollapsed ? "sidebar-collapsed" : ""))">
    @if (!isStandalonePage)
    {
        <LeftSidebar @ref="leftSidebar" CollapseChanged="OnSidebarCollapseChanged" />
    }

    <div class="app-main">
        <header class="top-navbar">
            <div class="top-navbar-inner">
                @if (!isStandalonePage)
                {
                    <button class="sb-mobile-toggle" @onclick="ToggleMobileSidebar" title="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                }
                <NavMenu OnShowLogin="() => authModal?.Show(true)"
                         OnShowRegister="() => authModal?.Show(false)"
                         OnOpenProfile="@(async tab => { if (profileModal != null) await profileModal.OpenAsync(tab); })" />
            </div>
        </header>

        <main>
            <article class="content @(isHomePage ? "home-content" : (isStandalonePage ? "standalone-content" : "px-4"))">
                @if (!isHomePage)
                {
                    <GuestWarningBanner OnLoginRequested="() => authModal?.Show(true)" />
                }
                @Body
            </article>
        </main>

        @if (isStandalonePage)
        {
            <AppFooter />
        }
    </div>
</div>

<AuthModal @ref="authModal" />
<ProfileModal @ref="profileModal" />
@if (!isStandalonePage)
{
    <MascotWidget />
}
@if (isHomePage)
{
    <DropletScrollbar />
}

@code {
    private static readonly HashSet<string> StandaloneRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "",
        "privacy",
        "terms",
        "curriculum",
        "contact"
    };

    private AuthModal? authModal;
    private ProfileModal? profileModal;
    private LeftSidebar? leftSidebar;
    private bool sidebarCollapsed;
    private bool isHomePage;
    private bool isStandalonePage;

    private void OnSidebarCollapseChanged(bool collapsed) => sidebarCollapsed = collapsed;
    private void ToggleMobileSidebar() => leftSidebar?.OpenMobile();

    protected override async Task OnInitializedAsync()
    {
        CheckHomePage();
        NavManager.LocationChanged += OnLocationChanged;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await Streak.MarkTodayAsync();
            }
        }
        catch
        {
            // Không chặn render nếu ghi chuỗi thất bại
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CheckHomePage();
        InvokeAsync(StateHasChanged);
    }

    private void CheckHomePage()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var path = relativePath.Split('?', '#')[0].Trim('/');
        isHomePage = string.IsNullOrEmpty(path);
        isStandalonePage = StandaloneRoutes.Contains(path);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
