@page "/hsk/tu-vung"
@layout Frontend.App.Layout.HskLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using Blazored.LocalStorage
@using System.Text.Json
@inject HskService HskService
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<PageTitle>HSK Vocabulary - IeltsHSK</PageTitle>

<div class="hsk-vocab-container">
    <div class="vocab-header">
        <h1>📚 HSK Vocabulary</h1>
        <div class="level-tabs">
            @foreach (var level in new[] { "HSK1", "HSK2", "HSK3", "HSK4", "HSK5", "HSK6", "HSK7", "HSK8", "HSK9" })
            {
                <button class="level-tab @(selectedLevel == level ? "active" : "")"
                        @onclick="() => SelectLevel(level)">
                    @level
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-spinner">Loading vocabulary...</div>
    }
    else if (vocabItems.Count == 0)
    {
        <div class="empty-state">No vocabulary entries found for @selectedLevel.</div>
    }
    else
    {
        <div class="vocab-grid">
            @foreach (var item in vocabItems)
            {
                <div class="vocab-card">
                    <div class="vocab-front">
                        <div class="hanzi">@item.Hanzi</div>
                        <div class="pinyin">@item.Pinyin</div>
                    </div>
                    <div class="vocab-back">
                        <div class="meaning">@item.Meaning</div>
                        @if (!string.IsNullOrEmpty(item.WordType))
                        {
                            <div class="word-type">@item.WordType</div>
                        }
                        @if (!string.IsNullOrEmpty(item.ExampleSentence))
                        {
                            <div class="example">
                                <span class="ex-label">例:</span>
                                <span class="ex-hanzi">@item.ExampleSentence</span>
                                @if (!string.IsNullOrEmpty(item.ExamplePinyin))
                                {
                                    <span class="ex-pinyin">@item.ExamplePinyin</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ExampleMeaning))
                                {
                                    <span class="ex-meaning">(@item.ExampleMeaning)</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="vocab-actions">
                        <button class="learn-btn @(IsLearned(item.Id) ? "learned" : "")" @onclick="() => ToggleLearned(item.Id)">
                            @(IsLearned(item.Id) ? "✅ Learned" : "📚 Learn")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hsk-vocab-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }
    .vocab-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .vocab-header h1 {
        margin: 0;
        font-size: 28px;
    }
    .level-tabs {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }
    .level-tab {
        padding: 6px 14px;
        border: 1px solid #444;
        background: transparent;
        color: #ccc;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.2s;
    }
    .level-tab:hover {
        background: #2a2a2a;
    }
    .level-tab.active {
        background: #1a7f5a;
        border-color: #1a7f5a;
        color: #fff;
    }
    .vocab-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }
    .vocab-card {
        background: #1e1e1e;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid #333;
        transition: transform 0.15s;
        display: flex;
        flex-direction: column;
    }
    .vocab-card:hover {
        transform: translateY(-2px);
        border-color: #555;
    }
    .vocab-front {
        margin-bottom: 12px;
    }
    .hanzi {
        font-size: 28px;
        font-weight: 600;
        color: #f0f0f0;
        line-height: 1.3;
    }
    .pinyin {
        font-size: 14px;
        color: #aaa;
        margin-top: 4px;
    }
    .vocab-back {
        border-top: 1px solid #333;
        padding-top: 12px;
        font-size: 14px;
    }
    .meaning {
        font-size: 16px;
        font-weight: 500;
        color: #e0e0e0;
    }
    .word-type {
        font-size: 12px;
        color: #888;
        margin-top: 4px;
    }
    .example {
        margin-top: 8px;
        font-size: 13px;
        color: #bbb;
        line-height: 1.5;
        background: #2a2a2a;
        padding: 8px 10px;
        border-radius: 6px;
    }
    .ex-label { color: #888; margin-right: 4px; }
    .ex-hanzi { font-weight: 500; }
    .ex-pinyin { color: #999; margin-left: 6px; font-size: 12px; }
    .ex-meaning { color: #888; margin-left: 6px; font-size: 12px; }
    .loading-spinner, .empty-state {
        text-align: center;
        padding: 40px;
        color: #888;
    }
    .vocab-actions {
        margin-top: 12px;
        display: flex;
        justify-content: flex-end;
    }
    .learn-btn {
        padding: 4px 12px;
        border: 1px solid #444;
        background: transparent;
        color: #ccc;
        border-radius: 16px;
        cursor: pointer;
        font-size: 12px;
        transition: all 0.2s;
    }
    .learn-btn:hover {
        background: #2a2a2a;
    }
    .learn-btn.learned {
        background: #1a7f5a;
        border-color: #1a7f5a;
        color: #fff;
    }
</style>

@code {
    private string selectedLevel = "HSK1";
    private List<HskVocabularyItem> vocabItems = new();
    private bool isLoading = true;
    private HashSet<int> learnedIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVocabulary();
    }

    private async Task SelectLevel(string level)
    {
        if (selectedLevel == level) return;
        selectedLevel = level;
        await LoadVocabulary();
    }

    private async Task LoadVocabulary()
    {
        isLoading = true;
        StateHasChanged();
        vocabItems = await HskService.GetVocabularyAsync(selectedLevel);
        await LoadLearnedState();
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadLearnedState()
    {
        var key = $"hsk_learned_{selectedLevel}";
        var stored = await LocalStorage.GetItemAsync<string>(key);
        if (!string.IsNullOrEmpty(stored))
        {
            try
            {
                var ids = JsonSerializer.Deserialize<List<int>>(stored);
                learnedIds = new HashSet<int>(ids ?? new List<int>());
            }
            catch { learnedIds = new(); }
        }
        else
        {
            learnedIds = new();
        }
    }

    private async Task SaveLearnedState()
    {
        var key = $"hsk_learned_{selectedLevel}";
        var list = learnedIds.ToList();
        var json = JsonSerializer.Serialize(list);
        await LocalStorage.SetItemAsync(key, json);
    }

    private async Task ToggleLearned(int id)
    {
        if (learnedIds.Contains(id))
            learnedIds.Remove(id);
        else
            learnedIds.Add(id);
        await SaveLearnedState();
        StateHasChanged();
    }

    private bool IsLearned(int id) => learnedIds.Contains(id);
}