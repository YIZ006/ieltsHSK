@page "/admin/stories"
@layout Frontend.App.Layout.AdminLayout
@using Frontend.App.Models
@using Frontend.App.Services
@inject StoryService StoryService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Quản lý Đọc Truyện - Admin</PageTitle>

<div class="admin-stories-page">
    <!-- Header -->
    <div class="page-top-header">
        <div class="header-titles">
            <h1 class="page-title"><i class="bi bi-book-half text-primary"></i> Quản lý Truyện Đọc (Graded Readers)</h1>
            <p class="page-subtitle">Quản lý kho truyện tiếng Anh theo trình độ, lưu trữ Cloudflare R2 và tra từ vựng tương tác.</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-secondary-outline" @onclick="DownloadTemplateJson">
                <i class="bi bi-download"></i> Tải file mẫu JSON
            </button>
            <button class="btn btn-secondary-outline" @onclick="SyncAllStoriesToR2" disabled="@isSyncingR2" title="Đẩy toàn bộ truyện trong database lên Cloudflare R2 trong thư mục stories/">
                @if (isSyncingR2)
                {
                    <span class="mini-spinner"></span>
                    <span>Đang đồng bộ R2...</span>
                }
                else
                {
                    <i class="bi bi-cloud-arrow-up-fill text-primary"></i>
                    <span>Đồng bộ lên R2</span>
                }
            </button>
            <button class="btn btn-primary-outline" @onclick="OpenImportModal">
                <i class="bi bi-cloud-arrow-up-fill"></i> Import Truyện (Dễ dùng)
            </button>
            <button class="btn btn-primary-solid" @onclick="() => OpenEditorModal(null)">
                <i class="bi bi-plus-circle-fill"></i> + Soạn Truyện Mới
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="custom-alert @(alertSuccess ? "alert-success" : "alert-error")">
            <div class="alert-content">
                <i class="bi @(alertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                <span>@alertMessage</span>
            </div>
            <button class="alert-close" @onclick="() => alertMessage = null">×</button>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="filter-toolbar">
        <div class="search-input-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Tìm theo tên truyện, chủ đề hoặc trình độ..." 
                   @bind="filterSearch" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(filterSearch))
            {
                <button class="search-clear-btn" @onclick='() => filterSearch = ""'>×</button>
            }
        </div>
        <div class="filter-controls">
            <label class="filter-label">Trình độ:</label>
            <select class="custom-select" @bind="filterLevel">
                <option value="All">Tất cả trình độ (A1 - C2)</option>
                <option value="A1">A1 - Sơ cấp</option>
                <option value="A2">A2 - Tiền trung cấp</option>
                <option value="B1">B1 - Trung cấp</option>
                <option value="B2">B2 - Trung cao cấp</option>
                <option value="C1">C1 - Cao cấp</option>
                <option value="C2">C2 - Thành thạo</option>
            </select>
        </div>
    </div>

    <!-- Data Table -->
    <div class="content-card">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="custom-spinner"></div>
                <p>Đang tải danh sách truyện đọc...</p>
            </div>
        }
        else if (FilteredStories.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
                <h3>Chưa có truyện nào</h3>
                <p>Bạn có thể bấm nút <b>"Import Truyện"</b> hoặc <b>"+ Soạn Truyện Mới"</b> để thêm bài đọc đầu tiên.</p>
                <button class="btn btn-primary-solid mt-3" @onclick="OpenImportModal">
                    <i class="bi bi-cloud-arrow-up-fill"></i> Import Truyện Ngay
                </button>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="stories-table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Ảnh</th>
                            <th>Tên truyện & Tóm tắt</th>
                            <th style="width: 100px;">Trình độ</th>
                            <th style="width: 110px;">IELTS Band</th>
                            <th style="width: 130px;">Chủ đề</th>
                            <th style="width: 90px;">Độ dài</th>
                            <th style="width: 120px;">Nội dung</th>
                            <th style="width: 110px;">Cloudflare R2</th>
                            <th style="width: 90px;">Lượt đọc</th>
                            <th style="width: 110px;">Trạng thái</th>
                            <th style="width: 130px;" class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in PagedStories)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(s.ThumbnailUrl) ? "https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=200" : s.ThumbnailUrl)" 
                                         alt="@s.Title" 
                                         class="story-thumb" />
                                </td>
                                <td>
                                    <div class="story-title-link" @onclick="() => PreviewStory(s.Slug)">
                                        @s.Title
                                    </div>
                                    <div class="story-summary-preview">
                                        @(string.IsNullOrEmpty(s.Summary) ? "Chưa có tóm tắt tiếng Việt." : s.Summary)
                                    </div>
                                </td>
                                <td>
                                    <span class="level-pill level-@s.Level.ToLower()">@s.Level</span>
                                </td>
                                <td>
                                    <span class="band-pill">Band @s.IeltsBand</span>
                                </td>
                                <td>
                                    <span class="category-pill">@s.Category</span>
                                </td>
                                <td>
                                    <div class="stat-text">@s.WordCount từ</div>
                                    <small class="text-muted">~@s.EstimatedMinutes phút</small>
                                </td>
                                <td>
                                    <div class="content-tags">
                                        <span class="tag tag-vocab"><i class="bi bi-spellcheck"></i> @s.Vocabulary.Count từ</span>
                                        <span class="tag tag-quiz"><i class="bi bi-question-circle"></i> @s.Questions.Count quiz</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.JsonUrl))
                                    {
                                        <a href="@s.JsonUrl" target="_blank" class="r2-badge-link" title="Xem file JSON trên R2: @s.JsonUrl">
                                            <i class="bi bi-cloud-check-fill"></i> File R2
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="r2-badge-local">Local</span>
                                    }
                                </td>
                                <td>
                                    <span class="views-count"><i class="bi bi-eye"></i> @s.ViewsCount</span>
                                </td>
                                <td>
                                    @if (s.IsPublished)
                                    {
                                        <span class="status-pill status-published"><i class="bi bi-check2"></i> Đã đăng</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-draft"><i class="bi bi-pencil"></i> Bản nháp</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <div class="action-btn-group">
                                        <button class="action-btn btn-view" @onclick="() => PreviewStory(s.Slug)" title="Xem bài đọc học viên">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </button>
                                        <button class="action-btn btn-edit" @onclick="() => OpenEditorModal(s)" title="Chỉnh sửa truyện">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="action-btn btn-delete" @onclick="() => ConfirmDelete(s)" title="Xóa truyện">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="pagination-footer">
                <div class="pagination-info">
                    Hiển thị <b>@((currentPage - 1) * pageSize + 1)</b> - <b>@Math.Min(currentPage * pageSize, FilteredStories.Count)</b> trong tổng số <b>@FilteredStories.Count</b> truyện đọc
                </div>

                <div class="pagination-controls">
                    <div class="page-size-selector">
                        <span>Mỗi trang:</span>
                        <select @bind="pageSize" @bind:after="() => currentPage = 1" class="page-size-select">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>

                    <div class="page-nav-buttons">
                        <button class="btn-page-nav" disabled="@(currentPage <= 1)" @onclick="() => currentPage = 1" title="Trang đầu">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                        <button class="btn-page-nav" disabled="@(currentPage <= 1)" @onclick="() => currentPage--" title="Trang trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        @foreach (var p in GetVisiblePageNumbers())
                        {
                            <button class="btn-page-num @(currentPage == p ? "active" : "")" @onclick="() => currentPage = p">
                                @p
                            </button>
                        }

                        <button class="btn-page-nav" disabled="@(currentPage >= totalPages)" @onclick="() => currentPage++" title="Trang sau">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button class="btn-page-nav" disabled="@(currentPage >= totalPages)" @onclick="() => currentPage = totalPages" title="Trang cuối">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL IMPORT TRUYỆN DỄ HIỂU (PREVIEW TRỰC QUAN KHÔNG CẦN ĐỌC CODE JSON) -->
<!-- ========================================================================= -->
@if (isImportModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-card modal-lg">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi bi-cloud-arrow-up-fill text-primary"></i>
                    <div>
                        <h3>Import Truyện tiếng Anh lên Cloudflare R2</h3>
                        <p class="modal-subtitle">Tải file JSON hoặc dán nội dung để hệ thống tự phân tích và tạo bài đọc.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="CloseImportModal">×</button>
            </div>

            <div class="modal-body">
                <!-- Tab chuyển chế độ -->
                <div class="import-tab-nav">
                    <button class="import-tab-btn @(importMode == "file" ? "active" : "")" @onclick='() => importMode = "file"'>
                        <i class="bi bi-file-earmark-arrow-up"></i> 1. Tải file .json từ máy tính
                    </button>
                    <button class="import-tab-btn @(importMode == "text" ? "active" : "")" @onclick='() => importMode = "text"'>
                        <i class="bi bi-code-square"></i> 2. Dán mã JSON trực tiếp
                    </button>
                </div>

                @if (importMode == "file")
                {
                    <div class="file-upload-dropzone">
                        <i class="bi bi-cloud-upload upload-icon"></i>
                        <h4>Chọn file truyện định dạng <code>.json</code></h4>
                        <p>Hệ thống sẽ tự động tải file lên Cloudflare R2 và hiển thị bản xem trước tiếng Việt ở bên dưới.</p>
                        
                        <div class="file-input-wrapper">
                            <InputFile OnChange="HandleJsonFileUploadAndAutoUploadR2" accept=".json" class="custom-file-input" />
                        </div>

                        @if (isUploadingFileToR2)
                        {
                            <div class="upload-progress-text">
                                <span class="mini-spinner"></span> Đang tải lên Cloudflare R2 và phân tích nội dung...
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="json-paste-box">
                        <label class="form-group-label">Dán nội dung JSON vào ô bên dưới:</label>
                        <textarea class="custom-textarea json-textarea" rows="8" 
                                  @bind="importJsonContent" 
                                  @bind:after="OnJsonTextPasted"
                                  placeholder='{ "title": "The School Race", "level": "A1", "paragraphs": [...] }'></textarea>
                    </div>
                }

                @if (!string.IsNullOrEmpty(importError))
                {
                    <div class="custom-alert alert-error mt-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@importError</span>
                    </div>
                }

                <!-- XEM TRƯỚC TRỰC QUAN (PREVIEW) -->
                @if (parsedPreviewStory != null)
                {
                    <div class="import-preview-section">
                        <div class="preview-header">
                            <span class="preview-badge"><i class="bi bi-eye"></i> Bản xem trước bài đọc</span>
                            <span class="preview-info-text">Dữ liệu đã được phân tích thành công!</span>
                        </div>

                        <div class="preview-card">
                            <div class="preview-meta-row">
                                <div class="preview-title">@parsedPreviewStory.Title</div>
                                <div class="preview-badges">
                                    <span class="level-pill level-@parsedPreviewStory.Level.ToLower()">@parsedPreviewStory.Level</span>
                                    <span class="band-pill">Band @parsedPreviewStory.IeltsBand</span>
                                    <span class="category-pill">@parsedPreviewStory.Category</span>
                                </div>
                            </div>
                            <div class="preview-summary">
                                <b>Tóm tắt:</b> @(string.IsNullOrEmpty(parsedPreviewStory.Summary) ? "Không có" : parsedPreviewStory.Summary)
                            </div>

                            <div class="preview-stats-bar">
                                <div class="stat-box">
                                    <i class="bi bi-paragraph"></i>
                                    <span><b>@parsedPreviewStory.Paragraphs.Count</b> Đoạn văn</span>
                                </div>
                                <div class="stat-box">
                                    <i class="bi bi-spellcheck"></i>
                                    <span><b>@parsedPreviewStory.Vocabulary.Count</b> Từ vựng tra cứu</span>
                                </div>
                                <div class="stat-box">
                                    <i class="bi bi-question-circle"></i>
                                    <span><b>@parsedPreviewStory.Questions.Count</b> Câu trắc nghiệm</span>
                                </div>
                            </div>

                            @if (parsedPreviewStory.Paragraphs.Count > 0)
                            {
                                <div class="preview-sample-paragraph">
                                    <div class="en-sample"><b>Đoạn 1 (EN):</b> @parsedPreviewStory.Paragraphs[0].En</div>
                                    <div class="vi-sample"><b>Dịch (VI):</b> @parsedPreviewStory.Paragraphs[0].Vi</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary-outline" @onclick="CloseImportModal">Đóng</button>
                <button class="btn btn-primary-solid" @onclick="SubmitImportJson" disabled="@isImporting">
                    @if (isImporting)
                    {
                        <span class="mini-spinner"></span>
                        <span>Đang lưu lên Cloudflare R2...</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-check-fill"></i>
                        <span>Xác nhận Lưu Lên R2 & Đăng Truyện</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL SOẠN / CHỈNH SỬA TRUYỆN TRỰC QUAN -->
<!-- ========================================================================= -->
@if (isEditorModalOpen && editingStory != null)
{
    <div class="modal-overlay">
        <div class="modal-card modal-xl">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi bi-pencil-square text-primary"></i>
                    <div>
                        <h3>@(editingStory.Id > 0 ? $"Chỉnh sửa truyện: {editingStory.Title}" : "Soạn Truyện Mới")</h3>
                        <p class="modal-subtitle">Soạn nội dung song ngữ, từ vựng trọng tâm và bài tập đọc hiểu.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="CloseEditorModal">×</button>
            </div>

            <div class="modal-body">
                <!-- Navigation Tabs -->
                <div class="editor-tabs-bar">
                    <button class="editor-tab-item @(editorTab == "info" ? "active" : "")" @onclick='() => editorTab = "info"'>
                        <i class="bi bi-info-circle"></i> 1. Thông tin chung & R2
                    </button>
                    <button class="editor-tab-item @(editorTab == "content" ? "active" : "")" @onclick='() => editorTab = "content"'>
                        <i class="bi bi-translate"></i> 2. Đoạn văn Song ngữ (@editingStory.Paragraphs.Count)
                    </button>
                    <button class="editor-tab-item @(editorTab == "vocab" ? "active" : "")" @onclick='() => editorTab = "vocab"'>
                        <i class="bi bi-lightbulb"></i> 3. Từ vựng Tra cứu (@editingStory.Vocabulary.Count)
                    </button>
                    <button class="editor-tab-item @(editorTab == "quiz" ? "active" : "")" @onclick='() => editorTab = "quiz"'>
                        <i class="bi bi-patch-question"></i> 4. Câu hỏi Quiz (@editingStory.Questions.Count)
                    </button>
                </div>

                @if (editorTab == "info")
                {
                    <div class="editor-grid">
                        <!-- Cloudflare R2 Upload Box -->
                        <div class="grid-full">
                            <div class="r2-quick-upload-card">
                                <div class="r2-card-icon"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                                <div class="r2-card-content">
                                    <div class="r2-card-title">Tải nhanh file .json truyện lên Cloudflare R2</div>
                                    <div class="r2-card-desc">Hệ thống sẽ tự động lưu file lên R2 và tự điền các đoạn văn, từ vựng và quiz vào form.</div>
                                    <div class="mt-2">
                                        <InputFile OnChange="HandleEditorJsonUploadToR2" accept=".json" class="custom-file-input" />
                                    </div>
                                    @if (isEditorUploadingR2)
                                    {
                                        <div class="upload-progress-text mt-2">
                                            <span class="mini-spinner"></span> Đang tải file lên Cloudflare R2...
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="grid-full">
                            <label class="form-group-label">Đường dẫn File JSON trên Cloudflare R2 (JsonUrl)</label>
                            <input type="text" class="custom-input font-monospace" @bind="editingStory.JsonUrl" 
                                   placeholder="https://pub-xxx.r2.dev/stories/story-name.json" />
                        </div>

                        <div class="grid-2-3">
                            <label class="form-group-label">Tiêu đề truyện (English Title) *</label>
                            <input type="text" class="custom-input" @bind="editingStory.Title" placeholder="vd: The School Race" />
                        </div>

                        <div class="grid-1-3">
                            <label class="form-group-label">Slug (Đường dẫn thân thiện)</label>
                            <input type="text" class="custom-input" @bind="editingStory.Slug" placeholder="tự tạo nếu để trống" />
                        </div>

                        <div class="grid-1-4">
                            <label class="form-group-label">Trình độ CEFR</label>
                            <select class="custom-select" @bind="editingStory.Level">
                                <option value="A1">A1 - Sơ cấp</option>
                                <option value="A2">A2 - Tiền trung cấp</option>
                                <option value="B1">B1 - Trung cấp</option>
                                <option value="B2">B2 - Trung cao cấp</option>
                                <option value="C1">C1 - Cao cấp</option>
                                <option value="C2">C2 - Thành thạo</option>
                            </select>
                        </div>

                        <div class="grid-1-4">
                            <label class="form-group-label">IELTS Band tương đương</label>
                            <input type="text" class="custom-input" @bind="editingStory.IeltsBand" placeholder="vd: 5.0 - 6.0" />
                        </div>

                        <div class="grid-1-4">
                            <label class="form-group-label">Chủ đề (Category)</label>
                            <input type="text" class="custom-input" @bind="editingStory.Category" placeholder="vd: Đời sống, Khoa học..." />
                        </div>

                        <div class="grid-1-4">
                            <label class="form-group-label">Thời gian đọc (phút)</label>
                            <input type="number" class="custom-input" @bind="editingStory.EstimatedMinutes" min="1" max="60" />
                        </div>

                        <div class="grid-1-2">
                            <label class="form-group-label">Ảnh bìa Thumbnail (URL)</label>
                            <input type="text" class="custom-input" @bind="editingStory.ThumbnailUrl" placeholder="https://images.unsplash.com/..." />
                        </div>

                        <div class="grid-1-2">
                            <label class="form-group-label">Audio đọc bài (Tùy chọn R2/mp3)</label>
                            <input type="text" class="custom-input" @bind="editingStory.AudioUrl" placeholder="https://..." />
                        </div>

                        <div class="grid-full">
                            <label class="form-group-label">Tóm tắt ngắn gọn bài đọc (Tiếng Việt) *</label>
                            <textarea class="custom-textarea" rows="2" @bind="editingStory.Summary" 
                                      placeholder="Tóm tắt 1-2 câu để người học hiểu khái quát câu chuyện..."></textarea>
                        </div>

                        <div class="grid-full">
                            <label class="custom-switch-label">
                                <input type="checkbox" @bind="editingStory.IsPublished" />
                                <span class="switch-slider"></span>
                                <span class="switch-text">Xuất bản công khai ngay cho học viên</span>
                            </label>
                        </div>
                    </div>
                }
                else if (editorTab == "content")
                {
                    <div class="bilingual-editor-section">
                        <div class="section-toolbar">
                            <span class="toolbar-hint">
                                <i class="bi bi-info-circle"></i> Nhập câu tiếng Anh và bản dịch tiếng Việt song song tương ứng cho mỗi đoạn.
                            </span>
                            <button class="btn btn-primary-solid btn-sm" @onclick="AddParagraph">
                                <i class="bi bi-plus-circle"></i> + Thêm Đoạn Mới
                            </button>
                        </div>

                        @for (int i = 0; i < editingStory.Paragraphs.Count; i++)
                        {
                            var pIdx = i;
                            var p = editingStory.Paragraphs[pIdx];
                            <div class="paragraph-card">
                                <div class="paragraph-card-header">
                                    <span class="paragraph-num-badge">Đoạn @(pIdx + 1)</span>
                                    <button class="btn-delete-item" @onclick="() => RemoveParagraph(pIdx)" title="Xóa đoạn này">
                                        <i class="bi bi-trash3"></i> Xóa đoạn
                                    </button>
                                </div>
                                <div class="bilingual-grid">
                                    <div class="lang-col">
                                        <label class="lang-label label-en"><i class="bi bi-translate"></i> Tiếng Anh (English):</label>
                                        <textarea class="custom-textarea lang-textarea" rows="3" 
                                                  @bind="p.En" placeholder="Nhập nội dung câu/đoạn tiếng Anh..."></textarea>
                                    </div>
                                    <div class="lang-col">
                                        <label class="lang-label label-vi"><i class="bi bi-card-text"></i> Dịch Tiếng Việt:</label>
                                        <textarea class="custom-textarea lang-textarea" rows="3" 
                                                  @bind="p.Vi" placeholder="Nhập câu dịch tiếng Việt tương ứng..."></textarea>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (editorTab == "vocab")
                {
                    <div class="vocab-editor-section">
                        <div class="section-toolbar">
                            <span class="toolbar-hint">
                                <i class="bi bi-info-circle"></i> Các từ vựng này sẽ được gạch chân trong bài. Học viên chạm vào từ sẽ mở Popup tra nghĩa & phát âm.
                            </span>
                            <button class="btn btn-primary-solid btn-sm" @onclick="AddVocab">
                                <i class="bi bi-plus-circle"></i> + Thêm Từ Mới
                            </button>
                        </div>

                        @for (int i = 0; i < editingStory.Vocabulary.Count; i++)
                        {
                            var vIdx = i;
                            var v = editingStory.Vocabulary[vIdx];
                            <div class="vocab-item-card">
                                <div class="vocab-card-header">
                                    <span class="vocab-num-badge">Từ vựng #@(vIdx + 1)</span>
                                    <button class="btn-delete-item" @onclick="() => RemoveVocab(vIdx)">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                </div>
                                <div class="vocab-form-grid">
                                    <div class="grid-1-3">
                                        <label class="form-group-label">Từ vựng (Word) *</label>
                                        <input type="text" class="custom-input" @bind="v.Word" placeholder="vd: whisper" />
                                    </div>
                                    <div class="grid-1-3">
                                        <label class="form-group-label">Phiên âm IPA</label>
                                        <input type="text" class="custom-input" @bind="v.Phonetic" placeholder="vd: /ˈwɪs.pər/" />
                                    </div>
                                    <div class="grid-1-3">
                                        <label class="form-group-label">Loại từ (POS)</label>
                                        <input type="text" class="custom-input" @bind="v.Pos" placeholder="vd: verb, noun, adj..." />
                                    </div>
                                    <div class="grid-1-2">
                                        <label class="form-group-label">Nghĩa tiếng Việt *</label>
                                        <input type="text" class="custom-input" @bind="v.Meaning" placeholder="vd: thì thầm, nói nhỏ" />
                                    </div>
                                    <div class="grid-1-2">
                                        <label class="form-group-label">Câu ví dụ (Example)</label>
                                        <input type="text" class="custom-input" @bind="v.Example" placeholder="vd: She whispered a secret." />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (editorTab == "quiz")
                {
                    <div class="quiz-editor-section">
                        <div class="section-toolbar">
                            <span class="toolbar-hint">
                                <i class="bi bi-info-circle"></i> Soạn 2-4 câu hỏi đọc hiểu để học viên kiểm tra kiến thức sau khi đọc xong.
                            </span>
                            <button class="btn btn-primary-solid btn-sm" @onclick="AddQuestion">
                                <i class="bi bi-plus-circle"></i> + Thêm Câu Hỏi
                            </button>
                        </div>

                        @for (int i = 0; i < editingStory.Questions.Count; i++)
                        {
                            var qIdx = i;
                            var q = editingStory.Questions[qIdx];
                            <div class="quiz-item-card">
                                <div class="quiz-card-header">
                                    <span class="quiz-num-badge">Câu hỏi #@(qIdx + 1)</span>
                                    <button class="btn-delete-item" @onclick="() => RemoveQuestion(qIdx)">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                </div>
                                <div class="mb-3">
                                    <label class="form-group-label">Nội dung câu hỏi (English) *</label>
                                    <input type="text" class="custom-input" @bind="q.Question" placeholder="vd: Why did Tom feel pain in his leg?" />
                                </div>

                                <label class="form-group-label mb-2">4 Lựa chọn đáp án (Tích chọn tròn để đặt đáp án đúng):</label>
                                <div class="quiz-options-grid">
                                    @for (int oIdx = 0; oIdx < q.Options.Count; oIdx++)
                                    {
                                        var optIndex = oIdx;
                                        <div class="option-input-wrapper @(q.CorrectIndex == optIndex ? "correct-selected" : "")">
                                            <input type="radio" name="quiz_correct_@qIdx" class="option-radio"
                                                   checked="@(q.CorrectIndex == optIndex)" 
                                                   @onchange="() => q.CorrectIndex = optIndex" />
                                            <span class="option-letter">@((char)('A' + optIndex))</span>
                                            <input type="text" class="custom-input option-text" @bind="q.Options[optIndex]" 
                                                   placeholder="Nội dung đáp án @((char)('A' + optIndex))" />
                                        </div>
                                    }
                                </div>

                                <div class="mt-3">
                                    <label class="form-group-label">Giải thích đáp án (Explanation):</label>
                                    <textarea class="custom-textarea" rows="2" @bind="q.Explanation" 
                                              placeholder="Giải thích lý do vì sao chọn đáp án này..."></textarea>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary-outline" @onclick="CloseEditorModal">Hủy</button>
                <button class="btn btn-primary-solid" @onclick="SaveStory" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="mini-spinner"></span>
                        <span>Đang lưu lên Cloudflare R2...</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>Lưu Lên Cloudflare R2</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static List<StoryModel>? _cachedStories;

    private List<StoryModel> stories = new();
    private bool isLoading = true;

    private string filterSearch = "";
    private string filterLevel = "All";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredStories.Count / pageSize));
    private List<StoryModel> PagedStories => FilteredStories.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private List<int> GetVisiblePageNumbers()
    {
        var list = new List<int>();
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, start + 4);
        if (end - start < 4) start = Math.Max(1, end - 4);
        for (int i = start; i <= end; i++) list.Add(i);
        return list;
    }

    private string? alertMessage;
    private bool alertSuccess = true;

    // Import Modal State
    private bool isImportModalOpen = false;
    private string importMode = "file"; // "file" | "text"
    private string importJsonContent = "";
    private string? importError;
    private bool isImporting = false;
    private bool isUploadingFileToR2 = false;
    private StoryModel? parsedPreviewStory;

    // Editor Modal State
    private bool isEditorModalOpen = false;
    private StoryModel? editingStory;
    private string editorTab = "info";
    private bool isSaving = false;
    private bool isEditorUploadingR2 = false;
    private bool isSyncingR2 = false;

    private List<StoryModel> FilteredStories
    {
        get
        {
            var query = stories.AsEnumerable();
            if (filterLevel != "All")
            {
                query = query.Where(s => s.Level.Equals(filterLevel, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(filterSearch))
            {
                var s = filterSearch.Trim();
                query = query.Where(x => x.Title.Contains(s, StringComparison.OrdinalIgnoreCase) || 
                                         x.Category.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (_cachedStories != null && _cachedStories.Count > 0)
        {
            stories = _cachedStories;
            isLoading = false;
        }

        await LoadStories(silent: _cachedStories != null && _cachedStories.Count > 0);
    }

    private async Task LoadStories(bool silent = false)
    {
        if (!silent) isLoading = true;
        stories = await StoryService.AdminGetAllStoriesAsync();
        _cachedStories = stories;
        isLoading = false;
    }

    private void PreviewStory(string slug)
    {
        NavigationManager.NavigateTo($"/ielts/doc-truyen/{slug}");
    }

    private async Task DownloadTemplateJson()
    {
        var json = await StoryService.AdminGetTemplateJsonAsync();
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:application/json;base64,{base64}'; a.download = 'story_template.json'; a.click();");
    }

    private async Task SyncAllStoriesToR2()
    {
        isSyncingR2 = true;
        alertMessage = null;
        var (success, msg) = await StoryService.SyncAllStoriesToR2Async();
        isSyncingR2 = false;

        alertMessage = msg;
        alertSuccess = success;
        if (success)
        {
            await LoadStories();
        }
    }

    // ================= Import Modal Logic =================
    private void OpenImportModal()
    {
        importMode = "file";
        importJsonContent = "";
        importError = null;
        parsedPreviewStory = null;
        isImportModalOpen = true;
    }

    private void CloseImportModal()
    {
        isImportModalOpen = false;
    }

    private async Task HandleJsonFileUploadAndAutoUploadR2(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            isUploadingFileToR2 = true;
            importError = null;

            var (success, r2Url, jsonContent, msg) = await StoryService.UploadStoryJsonAsync(file);
            isUploadingFileToR2 = false;

            if (success && !string.IsNullOrEmpty(jsonContent))
            {
                importJsonContent = jsonContent;
                ParsePreviewStory(jsonContent, r2Url);
            }
            else
            {
                importError = msg;
            }
        }
        catch (Exception ex)
        {
            isUploadingFileToR2 = false;
            importError = "Không thể đọc file: " + ex.Message;
        }
    }

    private void OnJsonTextPasted()
    {
        if (!string.IsNullOrWhiteSpace(importJsonContent))
        {
            ParsePreviewStory(importJsonContent, null);
        }
    }

    private void ParsePreviewStory(string json, string? r2Url)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var story = new StoryModel
            {
                Title = root.TryGetProperty("title", out var t) ? t.GetString() ?? "Untitled Story" : "Untitled Story",
                Level = root.TryGetProperty("level", out var l) ? l.GetString() ?? "B1" : "B1",
                IeltsBand = root.TryGetProperty("ieltsBand", out var ib) ? ib.GetString() ?? "5.0 - 6.0" : "5.0 - 6.0",
                Category = root.TryGetProperty("category", out var c) ? c.GetString() ?? "Đời sống" : "Đời sống",
                Summary = root.TryGetProperty("summary", out var sm) ? sm.GetString() : "",
                JsonUrl = r2Url
            };

            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            if (root.TryGetProperty("paragraphs", out var pp))
            {
                story.Paragraphs = System.Text.Json.JsonSerializer.Deserialize<List<StoryParagraph>>(pp.GetRawText(), options) ?? new();
            }
            if (root.TryGetProperty("targetVocabulary", out var tvp))
            {
                story.Vocabulary = System.Text.Json.JsonSerializer.Deserialize<List<StoryVocabulary>>(tvp.GetRawText(), options) ?? new();
            }
            if (root.TryGetProperty("questions", out var qp))
            {
                story.Questions = System.Text.Json.JsonSerializer.Deserialize<List<StoryQuestion>>(qp.GetRawText(), options) ?? new();
            }

            parsedPreviewStory = story;
            importError = null;
        }
        catch (Exception ex)
        {
            parsedPreviewStory = null;
            importError = "Cấu trúc JSON chưa đúng chuẩn: " + ex.Message;
        }
    }

    private async Task SubmitImportJson()
    {
        if (string.IsNullOrWhiteSpace(importJsonContent))
        {
            importError = "Vui lòng chọn file JSON hoặc dán nội dung vào ô trên.";
            return;
        }

        isImporting = true;
        importError = null;

        var (success, msg) = await StoryService.AdminImportJsonAsync(importJsonContent);
        isImporting = false;

        if (success)
        {
            alertMessage = "✨ " + msg;
            alertSuccess = true;
            isImportModalOpen = false;
            await LoadStories();
        }
        else
        {
            importError = msg;
        }
    }

    // ================= Editor Modal Logic =================
    private void OpenEditorModal(StoryModel? story)
    {
        editorTab = "info";
        if (story != null)
        {
            editingStory = new StoryModel
            {
                Id = story.Id,
                Title = story.Title,
                Slug = story.Slug,
                Level = story.Level,
                IeltsBand = story.IeltsBand,
                Category = story.Category,
                Summary = story.Summary,
                ThumbnailUrl = story.ThumbnailUrl,
                AudioUrl = story.AudioUrl,
                JsonUrl = story.JsonUrl,
                WordCount = story.WordCount,
                EstimatedMinutes = story.EstimatedMinutes,
                IsPublished = story.IsPublished,
                Paragraphs = story.Paragraphs.Select(p => new StoryParagraph { En = p.En, Vi = p.Vi }).ToList(),
                Vocabulary = story.Vocabulary.Select(v => new StoryVocabulary 
                { 
                    Word = v.Word, 
                    Phonetic = v.Phonetic, 
                    Pos = v.Pos, 
                    Meaning = v.Meaning, 
                    Example = v.Example, 
                    Collocations = v.Collocations?.ToList() ?? new() 
                }).ToList(),
                Questions = story.Questions.Select(q => new StoryQuestion 
                { 
                    Question = q.Question, 
                    Options = q.Options.ToList(), 
                    CorrectIndex = q.CorrectIndex, 
                    Explanation = q.Explanation 
                }).ToList()
            };
        }
        else
        {
            editingStory = new StoryModel
            {
                Level = "B1",
                IeltsBand = "5.0 - 6.0",
                Category = "Đời sống",
                EstimatedMinutes = 5,
                IsPublished = true,
                Paragraphs = new List<StoryParagraph> { new() },
                Vocabulary = new List<StoryVocabulary> { new() },
                Questions = new List<StoryQuestion> 
                { 
                    new StoryQuestion 
                    { 
                        Options = new List<string> { "", "", "", "" }, 
                        CorrectIndex = 0 
                    } 
                }
            };
        }

        isEditorModalOpen = true;
    }

    private async Task HandleEditorJsonUploadToR2(InputFileChangeEventArgs e)
    {
        if (editingStory == null) return;
        try
        {
            var file = e.File;
            if (file == null) return;

            isEditorUploadingR2 = true;
            var (success, r2Url, jsonContent, msg) = await StoryService.UploadStoryJsonAsync(file);
            isEditorUploadingR2 = false;

            if (success)
            {
                editingStory.JsonUrl = r2Url;
                if (!string.IsNullOrEmpty(jsonContent))
                {
                    PopulateStoryFromRawJson(jsonContent);
                }
                alertMessage = "Tải file lên Cloudflare R2 thành công!";
                alertSuccess = true;
            }
            else
            {
                alertMessage = "Lỗi upload R2: " + msg;
                alertSuccess = false;
            }
        }
        catch (Exception ex)
        {
            isEditorUploadingR2 = false;
            alertMessage = "Lỗi khi upload: " + ex.Message;
            alertSuccess = false;
        }
    }

    private void PopulateStoryFromRawJson(string json)
    {
        if (editingStory == null) return;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("title", out var t)) editingStory.Title = t.GetString() ?? editingStory.Title;
            if (root.TryGetProperty("level", out var l)) editingStory.Level = l.GetString() ?? editingStory.Level;
            if (root.TryGetProperty("ieltsBand", out var ib)) editingStory.IeltsBand = ib.GetString() ?? editingStory.IeltsBand;
            if (root.TryGetProperty("category", out var c)) editingStory.Category = c.GetString() ?? editingStory.Category;
            if (root.TryGetProperty("summary", out var sm)) editingStory.Summary = sm.GetString() ?? editingStory.Summary;
            if (root.TryGetProperty("thumbnailUrl", out var th)) editingStory.ThumbnailUrl = th.GetString() ?? editingStory.ThumbnailUrl;
            if (root.TryGetProperty("audioUrl", out var au)) editingStory.AudioUrl = au.GetString() ?? editingStory.AudioUrl;
            if (root.TryGetProperty("estimatedMinutes", out var em)) editingStory.EstimatedMinutes = em.GetInt32();

            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            if (root.TryGetProperty("paragraphs", out var pp))
            {
                editingStory.Paragraphs = System.Text.Json.JsonSerializer.Deserialize<List<StoryParagraph>>(pp.GetRawText(), options) ?? new();
            }
            if (root.TryGetProperty("targetVocabulary", out var tvp))
            {
                editingStory.Vocabulary = System.Text.Json.JsonSerializer.Deserialize<List<StoryVocabulary>>(tvp.GetRawText(), options) ?? new();
            }
            if (root.TryGetProperty("questions", out var qp))
            {
                editingStory.Questions = System.Text.Json.JsonSerializer.Deserialize<List<StoryQuestion>>(qp.GetRawText(), options) ?? new();
            }
        }
        catch { }
    }

    private void CloseEditorModal()
    {
        isEditorModalOpen = false;
        editingStory = null;
    }

    private void AddParagraph()
    {
        editingStory?.Paragraphs.Add(new StoryParagraph());
    }

    private void RemoveParagraph(int index)
    {
        if (editingStory != null && index >= 0 && index < editingStory.Paragraphs.Count)
        {
            editingStory.Paragraphs.RemoveAt(index);
        }
    }

    private void AddVocab()
    {
        editingStory?.Vocabulary.Add(new StoryVocabulary());
    }

    private void RemoveVocab(int index)
    {
        if (editingStory != null && index >= 0 && index < editingStory.Vocabulary.Count)
        {
            editingStory.Vocabulary.RemoveAt(index);
        }
    }

    private void AddQuestion()
    {
        editingStory?.Questions.Add(new StoryQuestion
        {
            Options = new List<string> { "", "", "", "" },
            CorrectIndex = 0
        });
    }

    private void RemoveQuestion(int index)
    {
        if (editingStory != null && index >= 0 && index < editingStory.Questions.Count)
        {
            editingStory.Questions.RemoveAt(index);
        }
    }

    private async Task SaveStory()
    {
        if (editingStory == null) return;

        if (string.IsNullOrWhiteSpace(editingStory.Title))
        {
            alertMessage = "Tiêu đề truyện không được để trống.";
            alertSuccess = false;
            return;
        }

        isSaving = true;

        // Auto serialize JSON
        editingStory.ContentJson = System.Text.Json.JsonSerializer.Serialize(editingStory.Paragraphs);
        editingStory.VocabularyJson = System.Text.Json.JsonSerializer.Serialize(editingStory.Vocabulary);
        editingStory.QuestionsJson = System.Text.Json.JsonSerializer.Serialize(editingStory.Questions);

        // Auto compute word count
        int totalWords = 0;
        foreach (var p in editingStory.Paragraphs)
        {
            if (!string.IsNullOrWhiteSpace(p.En))
            {
                totalWords += p.En.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
            }
        }
        editingStory.WordCount = totalWords > 0 ? totalWords : 150;

        bool success;
        string message;

        if (editingStory.Id > 0)
        {
            (success, message) = await StoryService.AdminUpdateStoryAsync(editingStory.Id, editingStory);
        }
        else
        {
            (success, message) = await StoryService.AdminCreateStoryAsync(editingStory);
        }

        isSaving = false;

        if (success)
        {
            alertMessage = message;
            alertSuccess = true;
            isEditorModalOpen = false;
            await LoadStories();
        }
        else
        {
            alertMessage = message;
            alertSuccess = false;
        }
    }

    private async Task ConfirmDelete(StoryModel story)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa truyện \"{story.Title}\" khỏi hệ thống và Cloudflare R2 không?");
        if (confirmed)
        {
            var success = await StoryService.AdminDeleteStoryAsync(story.Id);
            if (success)
            {
                alertMessage = "Đã xóa truyện thành công.";
                alertSuccess = true;
                await LoadStories();
            }
            else
            {
                alertMessage = "Có lỗi xảy ra khi xóa truyện.";
                alertSuccess = false;
            }
        }
    }
}
