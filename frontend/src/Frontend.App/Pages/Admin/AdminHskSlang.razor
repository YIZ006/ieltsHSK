@code {
    private List<SlangVocabItem> allSlangs = new();
    private List<SlangVocabItem> filteredSlangs = new();
    private List<SlangVocabItem> pagedSlangs = new();

    private bool isLoading = true;
    private string searchKeyword = "";
    private string selectedCategoryFilter = "All";
    private int pageSize = 15;
    private int currentPage = 1;
    private int totalPages = 1;

    private string? alertMessage;
    private bool alertSuccess;

    // Modal state
    private bool isModalOpen = false;
    private bool isEditing = false;
    private SlangVocabItem modalItem = new();

    // Delete state
    private bool isDeleteModalOpen = false;
    private SlangVocabItem? itemToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            allSlangs = await SlangService.GetSlangItemsAsync(forceRefresh: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminHskSlang] Load error: {ex.Message}");
            allSlangs = new();
        }

        ApplyFilters();
        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        var query = allSlangs.AsEnumerable();

        if (selectedCategoryFilter != "All")
        {
            query = query.Where(s =>
                string.Equals(s.Category, selectedCategoryFilter, StringComparison.OrdinalIgnoreCase) ||
                (selectedCategoryFilter == "number_cipher" && IsCipher(s.Category)) ||
                (selectedCategoryFilter == "slang_trend" && IsTrend(s.Category)) ||
                (selectedCategoryFilter == "workplace" && IsLife(s.Category)));
        }

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var kw = searchKeyword.Trim();
            query = query.Where(s =>
                s.Term.Contains(kw, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(s.Hanzi) && s.Hanzi.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                s.Pinyin.Contains(kw, StringComparison.OrdinalIgnoreCase) ||
                s.MeaningVi.Contains(kw, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(s.Origin) && s.Origin.Contains(kw, StringComparison.OrdinalIgnoreCase)));
        }

        filteredSlangs = query.ToList();
        totalPages = Math.Max(1, (int)Math.Ceiling((double)filteredSlangs.Count / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        pagedSlangs = filteredSlangs.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void ClearSearch()
    {
        searchKeyword = "";
        ApplyFilters();
    }

    private void ResetFilters()
    {
        searchKeyword = "";
        selectedCategoryFilter = "All";
        currentPage = 1;
        ApplyFilters();
    }

    private void GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        currentPage = page;
        pagedSlangs = filteredSlangs.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        StateHasChanged();
    }

    private List<int> VisiblePages
    {
        get
        {
            var pages = new List<int>();
            if (totalPages <= 7)
            {
                for (int i = 1; i <= totalPages; i++) pages.Add(i);
            }
            else
            {
                pages.Add(1);
                if (currentPage > 3) pages.Add(-1);

                int start = Math.Max(2, currentPage - 1);
                int end = Math.Min(totalPages - 1, currentPage + 1);

                for (int i = start; i <= end; i++)
                {
                    if (!pages.Contains(i)) pages.Add(i);
                }

                if (currentPage < totalPages - 2) pages.Add(-1);
                if (!pages.Contains(totalPages)) pages.Add(totalPages);
            }
            return pages;
        }
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        modalItem = new SlangVocabItem
        {
            Id = Guid.NewGuid().ToString("N").Substring(0, 8),
            Category = "slang_trend",
            PopularityScore = 90
        };
        isModalOpen = true;
    }

    private void OpenEditModal(SlangVocabItem item)
    {
        isEditing = true;
        modalItem = new SlangVocabItem
        {
            Id = item.Id,
            Term = item.Term,
            Hanzi = item.Hanzi,
            Pinyin = item.Pinyin,
            MeaningVi = item.MeaningVi,
            Category = item.Category,
            Origin = item.Origin,
            DialogueZh = item.DialogueZh,
            DialogueVi = item.DialogueVi,
            PopularityScore = item.PopularityScore
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveModalItem()
    {
        if (string.IsNullOrWhiteSpace(modalItem.Term) || string.IsNullOrWhiteSpace(modalItem.MeaningVi))
        {
            alertMessage = "Vui lòng nhập đầy đủ Thuật ngữ và Nghĩa tiếng Việt.";
            alertSuccess = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(modalItem.Pinyin))
        {
            modalItem.Pinyin = modalItem.Term;
        }

        if (isEditing)
        {
            var idx = allSlangs.FindIndex(s => s.Id == modalItem.Id);
            if (idx >= 0) allSlangs[idx] = modalItem;
            alertMessage = $"Đã cập nhật thuật ngữ '{modalItem.Term}' thành công.";
        }
        else
        {
            allSlangs.Insert(0, modalItem);
            alertMessage = $"Đã thêm mới thuật ngữ '{modalItem.Term}' thành công.";
        }

        alertSuccess = true;
        isModalOpen = false;
        ApplyFilters();
    }

    private void ConfirmDelete(SlangVocabItem item)
    {
        itemToDelete = item;
        isDeleteModalOpen = true;
    }

    private void ExecuteDelete()
    {
        if (itemToDelete != null)
        {
            allSlangs.RemoveAll(s => s.Id == itemToDelete.Id);
            alertMessage = $"Đã xóa thuật ngữ '{itemToDelete.Term}'.";
            alertSuccess = true;
            itemToDelete = null;
            isDeleteModalOpen = false;
            ApplyFilters();
        }
    }

    private async Task ExportJson()
    {
        try
        {
            var json = JsonSerializer.Serialize(allSlangs, new JsonSerializerOptions { WriteIndented = true });
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
            await JS.InvokeVoidAsync("eval", $@"
                (() => {{
                    const a = document.createElement('a');
                    a.href = 'data:application/json;charset=utf-8;base64,{base64}';
                    a.download = 'hsk-genz-slang-export.json';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})()
            ");
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi xuất JSON: {ex.Message}";
            alertSuccess = false;
        }
    }

    private static bool IsCipher(string cat) =>
        cat.Contains("cipher", StringComparison.OrdinalIgnoreCase) || cat.Contains("số", StringComparison.OrdinalIgnoreCase);

    private static bool IsTrend(string cat) =>
        cat.Contains("trend", StringComparison.OrdinalIgnoreCase) || cat.Contains("slang", StringComparison.OrdinalIgnoreCase);

    private static bool IsLife(string cat) =>
        cat.Contains("work", StringComparison.OrdinalIgnoreCase) || cat.Contains("tech", StringComparison.OrdinalIgnoreCase) || cat.Contains("life", StringComparison.OrdinalIgnoreCase);

    private static string GetCategoryBadgeClass(string cat)
    {
        if (IsCipher(cat)) return "cat-cipher";
        if (IsTrend(cat)) return "cat-trend";
        if (cat.Contains("work", StringComparison.OrdinalIgnoreCase)) return "cat-workplace";
        return "cat-tech";
    }

    private static string GetCategoryLabel(string cat)
    {
        if (IsCipher(cat)) return "Mật mã số";
        if (IsTrend(cat)) return "Hot Trend";
        if (cat.Contains("work", StringComparison.OrdinalIgnoreCase)) return "Công sở";
        return "Công nghệ / Đời sống";
    }
}
