    private async Task HandleAudioJsonFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            rawAudioJsonInput = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi khi đọc file: {ex.Message}", "error");
        }
    }

    private async Task ExecuteAudioJsonImport()
    {
        if (string.IsNullOrWhiteSpace(rawAudioJsonInput))
        {
            ShowAlert("Vui lòng chọn file JSON hoặc dán chuỗi JSON!", "error");
            return;
        }

        isImporting = true;
        try
        {
            var parsed = JsonSerializer.Deserialize<AudioLessonDto>(rawAudioJsonInput, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (parsed != null && !string.IsNullOrEmpty(parsed.Title))
            {
                if (string.IsNullOrEmpty(parsed.Id)) parsed.Id = Guid.NewGuid().ToString("N").Substring(0, 8);
                if (parsed.Lines != null)
                {
                    parsed.TotalUnits = parsed.Lines.Count;
                    for (int i = 0; i < parsed.Lines.Count; i++)
                    {
                        parsed.Lines[i].Index = i;
                        parsed.Lines[i].EndTime = Math.Round(parsed.Lines[i].StartTime + parsed.Lines[i].Duration, 2);
                    }
                }
                await SpeakAlongService.SaveAudioLessonAsync(parsed);
                showAudioImportModal = false;
                rawAudioJsonInput = "";
                await LoadData();
                ShowAlert($"Đã nhập thành công bài Audio '{parsed.Title}' ({parsed.TotalUnits} câu)!", "success");
            }
            else
            {
                ShowAlert("Cấu trúc JSON không hợp lệ. Vui lòng kiểm tra lại định dạng!", "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi xử lý JSON: {ex.Message}", "error");
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task ConfirmResetAudioDefault()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn khôi phục danh mục Audio Shadowing về mặc định ban đầu?");
        if (confirmed)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "ielts_audio_shadowing_lessons_catalog");
            await LoadData();
            ShowAlert("Đã khôi phục danh mục bài Audio mặc định!", "success");
        }
    }

    // ── Standard Shadowing CRUD ──────────────────────────────────────────

    private void OpenAddModal()
    {
        isEditing = false;
        int nextId = (examData?.Items.Count > 0) ? (examData.Items.Max(i => i.Id) + 1) : 1;
        formItem = new SpeakAlongItem { Id = nextId, Question = "", ModelAnswer = "", Vocabulary = "", Tips = "" };
        showEditModal = true;
    }

    private void OpenEditModal(SpeakAlongItem item)
    {
        isEditing = true;
        formItem = new SpeakAlongItem
        {
            Id = item.Id,
            Question = item.Question,
            ModelAnswer = item.ModelAnswer,
            Vocabulary = item.Vocabulary,
            Tips = item.Tips
        };
        showEditModal = true;
    }

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(formItem.Question) || string.IsNullOrWhiteSpace(formItem.ModelAnswer))
        {
            ShowAlert("Vui lòng nhập đầy đủ Câu hỏi và Câu trả lời mẫu!", "error");
            return;
        }

        if (examData == null) examData = new SpeakAlongExamData { Part = activePart };

        if (isEditing)
        {
            var idx = examData.Items.FindIndex(i => i.Id == formItem.Id);
            if (idx >= 0) examData.Items[idx] = formItem;
        }
        else
        {
            examData.Items.Add(formItem);
        }

        await SpeakAlongService.SaveExamDataAsync(activePart, examData);
        showEditModal = false;
        ShowAlert($"Đã lưu câu hỏi #{formItem.Id} thành công!", "success");
    }

    private async Task DeleteItem(SpeakAlongItem item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa câu #{item.Id}: '{item.Question}'?");
        if (confirmed && examData != null)
        {
            examData.Items.RemoveAll(i => i.Id == item.Id);
            await SpeakAlongService.SaveExamDataAsync(activePart, examData);
            ShowAlert($"Đã xóa câu hỏi #{item.Id} thành công!", "success");
        }
    }

    private async Task ExportCurrentJson()
    {
        if (examData == null || examData.Items.Count == 0)
        {
            ShowAlert("Không có dữ liệu để xuất!", "error");
            return;
        }
        var json = JsonSerializer.Serialize(examData, new JsonSerializerOptions { WriteIndented = true });
        var fileName = $"ielts-speak-along-{activePart.ToLowerInvariant()}.json";
        await JS.InvokeVoidAsync("SpeakingInterop.downloadJsonFile", fileName, json);
        ShowAlert($"Đã xuất file {fileName} thành công!", "success");
    }

