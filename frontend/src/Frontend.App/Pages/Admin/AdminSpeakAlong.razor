    private async Task HandleJsonFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            rawJsonInput = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi khi đọc file: {ex.Message}", "error");
        }
    }

    private async Task ExecuteJsonImport()
    {
        if (string.IsNullOrWhiteSpace(rawJsonInput))
        {
            ShowAlert("Vui lòng chọn file JSON hoặc dán chuỗi JSON!", "error");
            return;
        }

        isImporting = true;
        try
        {
            var success = await SpeakAlongService.ImportJsonAsync(rawJsonInput, importTargetPart);
            if (success)
            {
                showImportModal = false;
                rawJsonInput = "";
                await LoadData();
                ShowAlert($"Đã nạp thành công dữ liệu vào phần '{importTargetPart}'!", "success");
            }
            else
            {
                ShowAlert("Không tìm thấy câu hỏi hợp lệ trong JSON!", "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi xử lý JSON: {ex.Message}", "error");
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task ConfirmResetDefault()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn khôi phục phần '{activePart}' về mặc định ban đầu?");
        if (confirmed)
        {
            await SpeakAlongService.ResetToDefaultAsync(activePart);
            await LoadData();
            ShowAlert($"Đã khôi phục dữ liệu mặc định cho phần '{activePart}'!", "success");
        }
    }

    private async Task PlayTTS(string text)
    {
        await JS.InvokeVoidAsync("SpeakingInterop.speakText", text, "en-US", 1.0);
    }

    private void ShowAlert(string msg, string type = "success")
    {
        alertMessage = msg;
        alertType = type;
    }

    public class AudioLessonDataParsed
    {
        public string Title { get; set; } = "";
        public string AudioUrl { get; set; } = "";
        public List<AudioLessonLine> Lines { get; set; } = new();
    }
