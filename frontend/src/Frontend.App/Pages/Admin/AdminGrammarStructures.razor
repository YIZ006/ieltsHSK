    private async Task SaveStructureAsync()
    {
        if (string.IsNullOrWhiteSpace(editModel.StructureCode) || string.IsNullOrWhiteSpace(editModel.Formula))
        {
            ShowBanner("Vui lòng nhập Mã cấu trúc và Công thức.", false);
            return;
        }

        isSaving = true;
        try
        {
            if (editingId == 0)
            {
                var created = await GrammarService.CreateAsync(editModel);
                if (created != null)
                {
                    ShowBanner($"Đã thêm cấu trúc '{created.StructureCode}' thành công!", true);
                    CloseEditModal();
                    await LoadStructuresAsync(forceRefresh: true);
                }
                else
                {
                    ShowBanner("Thêm mới thất bại. Vui lòng kiểm tra lại.", false);
                }
            }
            else
            {
                var ok = await GrammarService.UpdateAsync(editingId, new UpdateGrammarStructureDto
                {
                    StructureCode = editModel.StructureCode,
                    BandLevel = editModel.BandLevel,
                    Category = editModel.Category,
                    GrammarTopic = editModel.GrammarTopic,
                    Formula = editModel.Formula,
                    UsageFunction = editModel.UsageFunction,
                    BasicExample = editModel.BasicExample,
                    AdvancedExample = editModel.AdvancedExample,
                    VietnameseMeaning = editModel.VietnameseMeaning,
                    KeyCollocations = editModel.KeyCollocations,
                    CommonMistakes = editModel.CommonMistakes,
                    PracticeExercise = editModel.PracticeExercise,
                    Tags = editModel.Tags,
                    DisplayOrder = editModel.DisplayOrder,
                    IsActive = editModel.IsActive
                });

                if (ok)
                {
                    ShowBanner("Đã cập nhật cấu trúc thành công!", true);
                    CloseEditModal();
                    await LoadStructuresAsync(forceRefresh: true);
                }
                else
                {
                    ShowBanner("Cập nhật thất bại.", false);
                }
            }
        }
        catch (Exception ex)
        {
            ShowBanner($"Lỗi lưu cấu trúc: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmDelete(GrammarStructureDto item)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa cấu trúc '{item.StructureCode}' ({item.GrammarTopic}) không?");
        if (!confirmed) return;

        var ok = await GrammarService.DeleteAsync(item.Id);
        if (ok)
        {
            ShowBanner($"Đã xóa cấu trúc '{item.StructureCode}' thành công!", true);
            selectedIds.Remove(item.Id);
            await LoadStructuresAsync(forceRefresh: true);
        }
        else
        {
            ShowBanner("Xóa cấu trúc thất bại.", false);
        }
    }

    private async Task ConfirmBulkDelete()
    {
        if (selectedIds.Count == 0) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn XÓA HÀNG LOẠT {selectedIds.Count} cấu trúc đã chọn không?");
        if (!confirmed) return;

        var count = await GrammarService.BulkDeleteAsync(selectedIds.ToList());
        if (count > 0)
        {
            ShowBanner($"Đã xóa thành công {count} cấu trúc!", true);
            selectedIds.Clear();
            await LoadStructuresAsync(forceRefresh: true);
        }
        else
        {
            ShowBanner("Xóa hàng loạt thất bại.", false);
        }
    }

    // Import Modal Handlers
    private void OpenImportModal()
    {
        selectedFiles.Clear();
        importResult = null;
        showImportModal = true;
    }

    private void CloseImportModal()
    {
        showImportModal = false;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFiles.Clear();
        foreach (var file in e.GetMultipleFiles(50))
        {
            if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                selectedFiles.Add(file);
            }
        }
    }

    private async Task ExecuteImportAsync()
    {
        if (selectedFiles.Count == 0) return;
        isImporting = true;
        importResult = null;

        try
        {
            importResult = await GrammarService.ImportMultipleExcelAsync(selectedFiles, importMode);
            if (importResult != null)
            {
                ShowBanner($"Import hoàn tất: {importResult.Success} thêm mới, {importResult.Updated} cập nhật, {importResult.Skipped} bỏ qua.", importResult.Fail == 0);
                await LoadStructuresAsync(forceRefresh: true);
            }
            else
            {
                ShowBanner("Import thất bại. Vui lòng kiểm tra định dạng file Excel.", false);
            }
        }
        catch (Exception ex)
        {
            ShowBanner($"Lỗi khi import file: {ex.Message}", false);
        }
        finally
        {
            isImporting = false;
        }
    }

    private void ShowBanner(string message, bool success)
    {
        bannerMessage = message;
        bannerIsSuccess = success;
    }
}
