@page "/portal-hub/navigation"
@page "/admin/navigation"
@layout AdminLayout
@using Frontend.App.Models
@using Frontend.App.Services
@inject NavigationService NavService
@inject NavigationManager NavManager

<PageTitle>Quản lý Sidebar - Admin Hub</PageTitle>

<div class="admin-nav-page">
    <!-- Header Section -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon-badge">
                <i class="bi bi-layout-sidebar-inset-reverse"></i>
            </div>
            <div>
                <h1 class="page-title">Quản lý Sidebar điều hướng</h1>
                <p class="page-subtitle">Cấu hình các mục hiển thị trong Left Sidebar học tập — Thay đổi có hiệu lực tức thì.</p>
            </div>
        </div>
        <button class="btn-create-nav" @onclick="() => OpenForm(null)">
            <i class="bi bi-plus-lg"></i>
            <span>Thêm mục mới</span>
        </button>
    </div>

    <!-- Edit/Create Drawer or Card -->
    @if (isFormOpen)
    {
        <div class="nav-form-overlay" @onclick="() => isFormOpen = false">
            <div class="nav-form-card" @onclick:stopPropagation="true">
                <div class="form-card-header">
                    <div class="form-header-title">
                        <i class="bi @(editId.HasValue ? "bi-pencil-square" : "bi-plus-circle-fill")"></i>
                        <h3>@(editId.HasValue ? "Cập nhật mục Sidebar" : "Thêm mục Sidebar mới")</h3>
                    </div>
                    <button class="btn-close-form" @onclick="() => isFormOpen = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="form-alert-error">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="form-fields-grid">
                    <div class="form-group-item">
                        <label class="form-label-custom">Tên hiển thị <span class="required">*</span></label>
                        <input @bind="form.Name" class="form-input-custom" placeholder="VD: Luyện đề, Luyện nghe..." />
                    </div>

                    <div class="form-group-item">
                        <label class="form-label-custom">Đường dẫn Route <span class="required">*</span></label>
                        <input @bind="form.Route" class="form-input-custom font-mono" placeholder="VD: /hsk/luyen-de, /ielts/reading..." />
                    </div>

                    <div class="form-group-item">
                        <label class="form-label-custom">Chương trình <span class="required">*</span></label>
                        <select @bind="form.Language" class="form-input-custom form-select-custom">
                            <option value="HSK">🇨🇳 HSK (Tiếng Trung)</option>
                            <option value="IELTS">🇬🇧 IELTS (Tiếng Anh)</option>
                            <option value="TOEIC">🏆 TOEIC (Tiếng Anh)</option>
                        </select>
                    </div>

                    <div class="form-group-item">
                        <label class="form-label-custom">Thứ tự hiển thị (Order)</label>
                        <input type="number" @bind="form.OrderIndex" class="form-input-custom" min="1" max="99" />
                    </div>

                    <div class="form-group-item full-span">
                        <label class="form-label-custom">Mã Icon (Bootstrap Icons)</label>
                        <div class="icon-input-wrapper">
                            <input @bind="form.Icon" class="form-input-custom font-mono" placeholder="VD: bi-journal-text, bi-headphones..." />
                            <div class="icon-live-preview">
                                @if (!string.IsNullOrWhiteSpace(form.Icon))
                                {
                                    <i class="bi @form.Icon"></i>
                                    <span>Preview</span>
                                }
                                else
                                {
                                    <i class="bi bi-circle"></i>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-group-item full-span">
                        <label class="form-label-custom">Mô tả ngắn (Hiển thị mờ bên dưới tiêu đề)</label>
                        <input @bind="form.Description" class="form-input-custom" placeholder="VD: Luyện đề thi các cấp, Kho 15.000 từ..." />
                    </div>
                </div>

                <div class="form-footer-actions">
                    <button class="btn-modal-cancel" @onclick="() => isFormOpen = false">Hủy bỏ</button>
                    <button class="btn-modal-save" @onclick="Save" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="btn-spinner"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                            <span>@(editId.HasValue ? "Lưu cập nhật" : "Tạo mục mới")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Toolbar Filters -->
    <div class="nav-toolbar-card">
        <div class="filter-pills-row">
            <button class="filter-pill @(filterLang == "ALL" ? "active" : "")" @onclick='() => filterLang = "ALL"'>
                <span class="pill-dot"></span>
                <span>Tất cả</span>
                <span class="pill-count">@items.Count</span>
            </button>
            <button class="filter-pill pill-hsk @(filterLang == "HSK" ? "active" : "")" @onclick='() => filterLang = "HSK"'>
                <span class="pill-icon">🇨🇳</span>
                <span>HSK</span>
                <span class="pill-count">@items.Count(x => x.Language == "HSK")</span>
            </button>
            <button class="filter-pill pill-ielts @(filterLang == "IELTS" ? "active" : "")" @onclick='() => filterLang = "IELTS"'>
                <span class="pill-icon">🇬🇧</span>
                <span>IELTS</span>
                <span class="pill-count">@items.Count(x => x.Language == "IELTS")</span>
            </button>
            <button class="filter-pill pill-toeic @(filterLang == "TOEIC" ? "active" : "")" @onclick='() => filterLang = "TOEIC"'>
                <span class="pill-icon">🏆</span>
                <span>TOEIC</span>
                <span class="pill-count">@items.Count(x => x.Language == "TOEIC")</span>
            </button>
        </div>

        <div class="search-box-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" @bind="searchQuery" @bind:event="oninput" class="search-input" placeholder="Tìm theo tên mục hoặc route..." />
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button class="btn-clear-search" @onclick='() => searchQuery = ""'>
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            }
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="nav-table-card">
        @if (isLoading)
        {
            <div class="table-loading-state">
                <div class="loading-spinner"></div>
                <span>Đang tải danh sách Sidebar...</span>
            </div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="table-empty-state">
                <div class="empty-icon-wrap">
                    <i class="bi bi-inbox-fill"></i>
                </div>
                <h3>Không tìm thấy mục điều hướng nào</h3>
                <p>Thử thay đổi bộ lọc hoặc bấm nút "Thêm mục mới" để tạo danh mục đầu tiên.</p>
                <button class="btn-create-nav-sm" @onclick="() => OpenForm(null)">
                    <i class="bi bi-plus-lg"></i> Thêm mục ngay
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive-wrapper">
                <table class="modern-nav-table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">#ID</th>
                            <th style="width: 75px; text-align: center;">Icon</th>
                            <th>Tên danh mục & Mô tả</th>
                            <th>Đường dẫn (Route)</th>
                            <th style="width: 140px;">Chương trình</th>
                            <th style="width: 90px; text-align: center;">Thứ tự</th>
                            <th style="width: 160px; text-align: right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Filtered)
                        {
                            <tr>
                                <td>
                                    <span class="id-badge">#@item.Id</span>
                                </td>
                                <td style="text-align: center;">
                                    <div class="icon-avatar-badge icon-lang-@item.Language.ToLower()">
                                        <i class="bi @item.Icon"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="nav-item-name">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="nav-item-desc">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="route-code-pill" title="@item.Route">
                                        <i class="bi bi-link-45deg"></i>
                                        <code>@item.Route</code>
                                    </span>
                                </td>
                                <td>
                                    <span class="program-badge prog-@item.Language.ToLower()">
                                        @if (item.Language == "HSK") { <span>🇨🇳 HSK</span> }
                                        else if (item.Language == "IELTS") { <span>🇬🇧 IELTS</span> }
                                        else { <span>🏆 TOEIC</span> }
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="order-pill">@item.OrderIndex</span>
                                </td>
                                <td>
                                    <div class="actions-group">
                                        <button class="btn-action-edit" @onclick="() => OpenForm(item)" title="Chỉnh sửa mục">
                                            <i class="bi bi-pencil-fill"></i>
                                            <span>Sửa</span>
                                        </button>
                                        <button class="btn-action-delete" @onclick="() => Delete(item.Id)" title="Xóa mục khỏi sidebar">
                                            <i class="bi bi-trash3-fill"></i>
                                            <span>Xóa</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer-summary">
                <span>Hiển thị <b>@Filtered.Count</b> / <b>@items.Count</b> mục điều hướng</span>
            </div>
        }
    </div>
</div>

@code {
    private List<LearningSectionDto> items = new();
    private bool isLoading = true;
    private bool isFormOpen;
    private bool isSaving;
    private string errorMessage = "";
    private string filterLang = "ALL";
    private string searchQuery = "";
    private int? editId;
    private LearningSectionDto form = new();

    private List<LearningSectionDto> Filtered => items
        .Where(x => filterLang == "ALL" || x.Language.Equals(filterLang, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(searchQuery) ||
                    x.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    x.Route.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (x.Description != null && x.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(x => x.Language)
        .ThenBy(x => x.OrderIndex)
        .ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        items = await NavService.GetAllForAdminAsync();
        isLoading = false;
    }

    private void OpenForm(LearningSectionDto? item)
    {
        errorMessage = "";
        if (item == null)
        {
            editId = null;
            form = new LearningSectionDto { Language = "TOEIC", Icon = "bi-circle", OrderIndex = items.Count + 1 };
        }
        else
        {
            editId = item.Id;
            form = new LearningSectionDto
            {
                Id = item.Id,
                Name = item.Name,
                Description = item.Description,
                Icon = item.Icon,
                Route = item.Route,
                Language = item.Language,
                OrderIndex = item.OrderIndex
            };
        }
        isFormOpen = true;
    }

    private async Task Save()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(form.Name) || string.IsNullOrWhiteSpace(form.Route) || string.IsNullOrWhiteSpace(form.Language))
        {
            errorMessage = "Vui lòng nhập Tên, Route và Chương trình.";
            return;
        }
        isSaving = true;
        bool ok;
        if (editId.HasValue)
        {
            form.Id = editId.Value;
            ok = await NavService.UpdateAsync(form);
        }
        else
        {
            var created = await NavService.CreateAsync(form);
            ok = created != null;
        }
        if (ok)
        {
            isFormOpen = false;
            await Load();
        }
        else errorMessage = "Lưu thất bại. Kiểm tra quyền admin hoặc dữ liệu.";
        isSaving = false;
    }

    private async Task Delete(int id)
    {
        if (!await NavService.DeleteAsync(id)) return;
        await Load();
    }
}
