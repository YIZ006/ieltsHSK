@page "/portal-hub/login"
@layout Frontend.App.Layout.PlainLayout
@using Frontend.App.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@implements IDisposable

<PageTitle>Đăng nhập Quản trị viên - Admin Hub</PageTitle>

<div class="admin-login-wrapper">
    <div class="admin-login-card">
        <!-- Brand Header -->
        <div class="card-header-brand">
            <div class="brand-shield-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="brand-title">Admin Hub</h1>
            <p class="brand-subtitle">Cổng đăng nhập hệ thống Quản trị & Điều hành</p>
        </div>

        <!-- Error Message Alert -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="login-alert-box animate-shake">
                <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
                <div class="alert-text">@errorMessage</div>
            </div>
        }

        <!-- Login Form -->
        <EditForm Model="loginModel" OnValidSubmit="HandleAdminLogin" class="login-form">
            <DataAnnotationsValidator />

            <div class="form-group-modern">
                <label class="form-label">
                    Email Quản trị viên
                </label>
                <div class="input-with-icon">
                    <i class="bi bi-envelope-fill input-icon-left"></i>
                    <input @bind="loginModel.Email" 
                           type="email" 
                           class="form-control-modern with-icon-left" 
                           placeholder="admin@example.com" 
                           autocomplete="username" />
                </div>
                <ValidationMessage For="@(() => loginModel.Email)" class="validation-msg" />
            </div>

            <div class="form-group-modern">
                <label class="form-label">
                    Mật khẩu bảo mật
                </label>
                <div class="input-with-icon password-wrapper">
                    <i class="bi bi-key-fill input-icon-left"></i>
                    <input @bind="loginModel.Password" 
                           type="@(showPassword ? "text" : "password")" 
                           class="form-control-modern with-icon-left with-icon-right" 
                           placeholder="••••••••" 
                           autocomplete="current-password" />
                    <button type="button" class="btn-toggle-eye" @onclick="() => showPassword = !showPassword" tabindex="-1" title="Hiện/Ẩn mật khẩu">
                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => loginModel.Password)" class="validation-msg" />
            </div>

            <div class="turnstile-wrapper" style="margin: 14px 0 14px; display: flex; justify-content: center; min-height: 65px;">
                <div id="turnstile-admin-login-widget"></div>
            </div>

            <button type="submit" class="btn-admin-submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="btn-spinner"></span>
                    <span>Đang xác thực bảo mật...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Đăng nhập Quản trị</span>
                }
            </button>
        </EditForm>

        <!-- Back to Student Portal Link -->
        <div class="card-footer-links">
            <a href="/" class="back-home-link">
                <i class="bi bi-arrow-left"></i> Quay lại Cổng học tập học viên
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private string? errorMessage = null;
    private DotNetObjectReference<AdminLogin>? objRef;

    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);

        // Nếu đã có token Quản trị viên hợp lệ thì redirect ngay vào Admin Hub
        var adminToken = await AuthService.GetAdminTokenAsync();
        if (!string.IsNullOrWhiteSpace(adminToken))
        {
            var claims = CustomAuthStateProvider.ParseClaimsFromJwt(adminToken);
            var roleClaim = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role")?.Value;
            if (string.Equals(roleClaim, "admin", StringComparison.OrdinalIgnoreCase))
            {
                var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/portal-hub" : ReturnUrl;
                NavigationManager.NavigateTo(target);
                return;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && objRef != null)
        {
            var siteKey = Configuration["Turnstile:SiteKey"] ?? "1x00000000000000000000AA";
            await JS.InvokeVoidAsync("turnstileHelper.render", "turnstile-admin-login-widget", siteKey, objRef);
        }
    }

    [JSInvokable]
    public void OnTurnstileSuccess(string token)
    {
        loginModel.CaptchaToken = token;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnTurnstileError()
    {
        loginModel.CaptchaToken = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnTurnstileExpired()
    {
        loginModel.CaptchaToken = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private async Task HandleAdminLogin()
    {
        var turnstileEnabled = Configuration.GetValue<bool?>("Turnstile:Enabled") ?? true;
        if (turnstileEnabled && string.IsNullOrWhiteSpace(loginModel.CaptchaToken))
        {
            errorMessage = "Vui lòng xác nhận bạn không phải người máy (CAPTCHA) trước khi bấm Đăng nhập.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var (success, isAdmin, errMsg) = await AuthService.AdminLoginAsync(loginModel);

            if (!success)
            {
                errorMessage = errMsg;
                await JS.InvokeVoidAsync("turnstileHelper.reset", "turnstile-admin-login-widget");
                isLoading = false;
                return;
            }

            // Chuyển hướng tới ReturnUrl hoặc trang Admin Hub
            var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/portal-hub" : ReturnUrl;
            NavigationManager.NavigateTo(target, forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = "Đã xảy ra lỗi kết nối: " + ex.Message;
            await JS.InvokeVoidAsync("turnstileHelper.reset", "turnstile-admin-login-widget");
            isLoading = false;
        }
    }
}
