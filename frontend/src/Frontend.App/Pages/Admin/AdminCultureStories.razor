@code {
    public class CultureStoryItemModel
    {
        public int Id { get; set; }
        public string TitleZh { get; set; } = string.Empty;
        public string TitleVi { get; set; } = string.Empty;
        public string Pinyin { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string Category { get; set; } = "Thành ngữ điển tích";
        public string Level { get; set; } = "HSK 3 - 4";
        public string? SummaryVi { get; set; }
        public string ContentZh { get; set; } = string.Empty;
        public string ContentVi { get; set; } = string.Empty;
        public string ParagraphsJson { get; set; } = "[]";
        public string VocabularyJson { get; set; } = "[]";
        public string QuestionsJson { get; set; } = "[]";
        public string? AudioUrl { get; set; }
        public string? ThumbnailUrl { get; set; }
        public int EstimatedMinutes { get; set; } = 3;
        public int ViewsCount { get; set; }
        public bool IsPublished { get; set; } = true;
        public DateTime CreatedAt { get; set; }
    }

    public class CultureStoryFormModel
    {
        public int Id { get; set; }
        public string TitleZh { get; set; } = string.Empty;
        public string TitleVi { get; set; } = string.Empty;
        public string Pinyin { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string Category { get; set; } = "Thành ngữ điển tích";
        public string Level { get; set; } = "HSK 3 - 4";
        public string SummaryVi { get; set; } = string.Empty;
        public string ContentZh { get; set; } = string.Empty;
        public string ContentVi { get; set; } = string.Empty;
        public string ParagraphsJson { get; set; } = "[]";
        public string VocabularyJson { get; set; } = "[]";
        public string QuestionsJson { get; set; } = "[]";
        public string? AudioUrl { get; set; }
        public string? ThumbnailUrl { get; set; }
        public int EstimatedMinutes { get; set; } = 3;
        public bool IsPublished { get; set; } = true;
    }

    private List<CultureStoryItemModel> allStories = new();
    private List<CultureStoryItemModel> filteredStories = new();
    private bool isLoading = true;
    private string? alertMessage;
    private bool alertSuccess = true;

    // Filters
    private string searchKeyword = "";
    private string selectedCategoryFilter = "All";
    private string selectedLevelFilter = "All";
    private string selectedStatusFilter = "All";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredStories.Count / pageSize));
    private List<CultureStoryItemModel> pagedStories => filteredStories.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    // Editor Modal
    private bool showEditorModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private string editorTab = "info";
    private string? formValidationMessage;
    private CultureStoryFormModel formModel = new();

    // Delete Modal
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private CultureStoryItemModel? deletingItem;

    // Import Modal
    private bool showImportModal = false;
    private bool isImporting = false;
    private string importJsonContent = "";
    private string? importErrorMessage;

    private List<string> availableCategories => allStories
        .Select(s => s.Category)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadStoriesAsync();
    }

    private string GetApiUrl(string path)
    {
        var baseUrl = Configuration["BackendApi:BaseUrl"] ?? "http://localhost:5101/";
        return $"{baseUrl.TrimEnd('/')}/{path.TrimStart('/')}";
    }

    private async Task LoadStoriesAsync()
    {
        isLoading = true;
        alertMessage = null;
        StateHasChanged();

        try
        {
            var apiUrl = GetApiUrl("api/hsk/culture-stories");
            var dtos = await Http.GetFromJsonAsync<List<CultureStoryItemModel>>(apiUrl);
            if (dtos != null && dtos.Count > 0)
            {
                allStories = dtos;
            }
            else
            {
                await LoadFallbackJsonAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminCultureStories] Backend fetch failed ({ex.Message}), loading fallback seed data...");
            await LoadFallbackJsonAsync();
        }

        ApplyFilters();
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadFallbackJsonAsync()
    {
        try
        {
            using var response = await Http.GetAsync("sample-data/hsk-culture-stories.json");
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(jsonStr);
                var list = new List<CultureStoryItemModel>();

                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    int autoId = 1;
                    foreach (var elem in doc.RootElement.EnumerateArray())
                    {
                        var titleZh = elem.TryGetProperty("titleZh", out var tzp) ? tzp.GetString() ?? "" : "";
                        var titleVi = elem.TryGetProperty("titleVi", out var tvp) ? tvp.GetString() ?? "" : "";
                        var pinyin = elem.TryGetProperty("pinyin", out var pyp) ? pyp.GetString() ?? "" : "";
                        var slug = elem.TryGetProperty("slug", out var slp) ? slp.GetString() ?? $"story-{autoId}" : $"story-{autoId}";
                        var category = elem.TryGetProperty("category", out var cgp) ? cgp.GetString() ?? "Thành ngữ điển tích" : "Thành ngữ điển tích";
                        var level = elem.TryGetProperty("level", out var lvp) ? lvp.GetString() ?? "HSK 3 - 4" : "HSK 3 - 4";
                        var summaryVi = elem.TryGetProperty("summaryVi", out var smp) ? smp.GetString() : null;
                        var contentZh = elem.TryGetProperty("contentZh", out var czp) ? czp.GetString() ?? "" : "";
                        var contentVi = elem.TryGetProperty("contentVi", out var cvp) ? cvp.GetString() ?? "" : "";

                        string paragraphsJson = "[]";
                        if (elem.TryGetProperty("paragraphs", out var prp)) paragraphsJson = prp.GetRawText();
                        else if (elem.TryGetProperty("sentences", out var snp)) paragraphsJson = snp.GetRawText();

                        string vocabJson = "[]";
                        if (elem.TryGetProperty("vocabulary", out var vcp)) vocabJson = vcp.GetRawText();

                        string questionsJson = "[]";
                        if (elem.TryGetProperty("questions", out var qsp)) questionsJson = qsp.GetRawText();

                        var audioUrl = elem.TryGetProperty("audioUrl", out var aup) ? aup.GetString() : null;
                        var thumbUrl = elem.TryGetProperty("thumbnailUrl", out var tmp) ? tmp.GetString() : null;

                        list.Add(new CultureStoryItemModel
                        {
                            Id = autoId++,
                            TitleZh = titleZh,
                            TitleVi = titleVi,
                            Pinyin = pinyin,
                            Slug = slug,
                            Category = category,
                            Level = level,
                            SummaryVi = summaryVi,
                            ContentZh = contentZh,
                            ContentVi = contentVi,
                            ParagraphsJson = paragraphsJson,
                            VocabularyJson = vocabJson,
                            QuestionsJson = questionsJson,
                            AudioUrl = audioUrl,
                            ThumbnailUrl = thumbUrl,
                            EstimatedMinutes = 3,
                            IsPublished = true,
                            ViewsCount = 120 + autoId * 15,
                            CreatedAt = DateTime.UtcNow.AddDays(-autoId)
                        });
                    }
                }

                if (list.Count > 0)
                {
                    allStories = list;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminCultureStories] Error loading fallback seed data: {ex.Message}");
        }
    }

    private void ApplyFilters()
    {
        var query = allStories.AsEnumerable();

        if (selectedCategoryFilter != "All")
            query = query.Where(s => s.Category.Equals(selectedCategoryFilter, StringComparison.OrdinalIgnoreCase));

        if (selectedLevelFilter != "All")
            query = query.Where(s => s.Level.Contains(selectedLevelFilter, StringComparison.OrdinalIgnoreCase));

        if (selectedStatusFilter == "Published")
            query = query.Where(s => s.IsPublished);
        else if (selectedStatusFilter == "Draft")
            query = query.Where(s => !s.IsPublished);

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var k = searchKeyword.Trim().ToLowerInvariant();
            query = query.Where(s =>
                s.TitleZh.ToLower().Contains(k) ||
                s.TitleVi.ToLower().Contains(k) ||
                s.Pinyin.ToLower().Contains(k) ||
                s.Slug.ToLower().Contains(k) ||
                (s.SummaryVi != null && s.SummaryVi.ToLower().Contains(k)));
        }

        filteredStories = query.OrderByDescending(s => s.CreatedAt).ToList();
        currentPage = 1;
    }

    private void ClearSearch()
    {
        searchKeyword = "";
        ApplyFilters();
    }

    private List<int> GetVisiblePages()
    {
        var list = new List<int>();
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, start + 4);
        if (end - start < 4) start = Math.Max(1, end - 4);
        for (int i = start; i <= end; i++) list.Add(i);
        return list;
    }

