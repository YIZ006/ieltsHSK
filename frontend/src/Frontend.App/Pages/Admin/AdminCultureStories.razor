    private async Task SaveStoryAsync()
    {
        formValidationMessage = null;

        if (string.IsNullOrWhiteSpace(formModel.TitleZh))
        {
            formValidationMessage = "Vui lòng nhập Tiêu đề chữ Hán (TitleZh).";
            editorTab = "info";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.TitleVi))
        {
            formValidationMessage = "Vui lòng nhập Tiêu đề tiếng Việt (TitleVi).";
            editorTab = "info";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.Pinyin))
        {
            formValidationMessage = "Vui lòng nhập Phiên âm Pinyin.";
            editorTab = "info";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.SummaryVi))
        {
            formValidationMessage = "Vui lòng nhập Tóm tắt ý nghĩa bài viết.";
            editorTab = "info";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.ContentZh) && string.IsNullOrWhiteSpace(formModel.ParagraphsJson))
        {
            formValidationMessage = "Vui lòng nhập nội dung tiếng Trung ở Tab 2.";
            editorTab = "content";
            return;
        }

        isSaving = true;

        try
        {
            var adminToken = await AuthService.GetAdminTokenAsync();
            using var reqMsg = new HttpRequestMessage(
                isEditing ? HttpMethod.Put : HttpMethod.Post,
                isEditing ? GetApiUrl($"api/admin/hsk/culture-stories/{formModel.Id}") : GetApiUrl("api/admin/hsk/culture-stories")
            );

            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                reqMsg.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", adminToken);
            }

            var payload = new
            {
                TitleZh = formModel.TitleZh,
                TitleVi = formModel.TitleVi,
                Pinyin = formModel.Pinyin,
                Slug = string.IsNullOrWhiteSpace(formModel.Slug) ? null : formModel.Slug,
                Category = formModel.Category,
                Level = formModel.Level,
                SummaryVi = formModel.SummaryVi,
                ContentZh = formModel.ContentZh,
                ContentVi = formModel.ContentVi,
                ParagraphsJson = formModel.ParagraphsJson,
                VocabularyJson = formModel.VocabularyJson,
                QuestionsJson = formModel.QuestionsJson,
                AudioUrl = formModel.AudioUrl,
                ThumbnailUrl = formModel.ThumbnailUrl,
                EstimatedMinutes = formModel.EstimatedMinutes,
                IsPublished = formModel.IsPublished
            };

            reqMsg.Content = JsonContent.Create(payload);
            var response = await Http.SendAsync(reqMsg);

            if (response.IsSuccessStatusCode)
            {
                alertMessage = isEditing ? "Đã cập nhật bài viết văn hóa thành công!" : "Đã thêm bài viết văn hóa mới thành công!";
                alertSuccess = true;
                CloseEditorModal();
                await LoadStoriesAsync();
            }
            else
            {
                UpdateLocalStateAfterSave();
                alertMessage = (isEditing ? "Đã cập nhật bài viết" : "Đã thêm bài viết mới") + " (Bộ nhớ cục bộ)";
                alertSuccess = true;
                CloseEditorModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminCultureStories] Error saving story: {ex.Message}");
            UpdateLocalStateAfterSave();
            alertMessage = (isEditing ? "Đã cập nhật bài viết" : "Đã thêm bài viết") + " (Bộ nhớ cục bộ)";
            alertSuccess = true;
            CloseEditorModal();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void UpdateLocalStateAfterSave()
    {
        if (isEditing)
        {
            var existing = allStories.FirstOrDefault(s => s.Id == formModel.Id);
            if (existing != null)
            {
                existing.TitleZh = formModel.TitleZh;
                existing.TitleVi = formModel.TitleVi;
                existing.Pinyin = formModel.Pinyin;
                existing.Slug = string.IsNullOrWhiteSpace(formModel.Slug) ? existing.Slug : formModel.Slug;
                existing.Category = formModel.Category;
                existing.Level = formModel.Level;
                existing.SummaryVi = formModel.SummaryVi;
                existing.ContentZh = formModel.ContentZh;
                existing.ContentVi = formModel.ContentVi;
                existing.ParagraphsJson = formModel.ParagraphsJson;
                existing.VocabularyJson = formModel.VocabularyJson;
                existing.QuestionsJson = formModel.QuestionsJson;
                existing.AudioUrl = formModel.AudioUrl;
                existing.ThumbnailUrl = formModel.ThumbnailUrl;
                existing.EstimatedMinutes = formModel.EstimatedMinutes;
                existing.IsPublished = formModel.IsPublished;
            }
        }
        else
        {
            var nextId = allStories.Count > 0 ? allStories.Max(s => s.Id) + 1 : 1;
            allStories.Insert(0, new CultureStoryItemModel
            {
                Id = nextId,
                TitleZh = formModel.TitleZh,
                TitleVi = formModel.TitleVi,
                Pinyin = formModel.Pinyin,
                Slug = string.IsNullOrWhiteSpace(formModel.Slug) ? $"story-{nextId}" : formModel.Slug,
                Category = formModel.Category,
                Level = formModel.Level,
                SummaryVi = formModel.SummaryVi,
                ContentZh = formModel.ContentZh,
                ContentVi = formModel.ContentVi,
                ParagraphsJson = formModel.ParagraphsJson,
                VocabularyJson = formModel.VocabularyJson,
                QuestionsJson = formModel.QuestionsJson,
                AudioUrl = formModel.AudioUrl,
                ThumbnailUrl = formModel.ThumbnailUrl,
                EstimatedMinutes = formModel.EstimatedMinutes,
                IsPublished = formModel.IsPublished,
                ViewsCount = 0,
                CreatedAt = DateTime.UtcNow
            });
        }
        ApplyFilters();
    }

    private void OpenDeleteModal(CultureStoryItemModel item)
    {
        deletingItem = item;
        showDeleteModal = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (deletingItem == null) return;
        isDeleting = true;

        try
        {
            var adminToken = await AuthService.GetAdminTokenAsync();
            using var reqMsg = new HttpRequestMessage(HttpMethod.Delete, GetApiUrl($"api/admin/hsk/culture-stories/{deletingItem.Id}"));
            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                reqMsg.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", adminToken);
            }

            var response = await Http.SendAsync(reqMsg);
            if (response.IsSuccessStatusCode)
            {
                alertMessage = $"Đã xóa bài viết '{deletingItem.TitleZh}' thành công!";
                alertSuccess = true;
            }
            else
            {
                alertMessage = $"Đã xóa bài viết '{deletingItem.TitleZh}' khỏi bộ nhớ.";
                alertSuccess = true;
            }

            allStories.RemoveAll(s => s.Id == deletingItem.Id);
            ApplyFilters();
            showDeleteModal = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminCultureStories] Error deleting story: {ex.Message}");
            allStories.RemoveAll(s => s.Id == deletingItem.Id);
            ApplyFilters();
            alertMessage = "Đã xóa bài viết khỏi bộ nhớ.";
            alertSuccess = true;
            showDeleteModal = false;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void OpenImportModal()
    {
        importJsonContent = "";
        importErrorMessage = null;
        showImportModal = true;
    }

    private async Task ExecuteImportJsonAsync()
    {
        if (string.IsNullOrWhiteSpace(importJsonContent))
        {
            importErrorMessage = "Vui lòng dán nội dung JSON.";
            return;
        }

        isImporting = true;
        importErrorMessage = null;

        try
        {
            var adminToken = await AuthService.GetAdminTokenAsync();
            using var reqMsg = new HttpRequestMessage(HttpMethod.Post, GetApiUrl("api/admin/hsk/culture-stories/import-json"));
            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                reqMsg.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", adminToken);
            }

            reqMsg.Content = JsonContent.Create(new { JsonContent = importJsonContent });
            var response = await Http.SendAsync(reqMsg);

            if (response.IsSuccessStatusCode)
            {
                alertMessage = "Import bài viết văn hóa từ JSON thành công!";
                alertSuccess = true;
                showImportModal = false;
                await LoadStoriesAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                importErrorMessage = $"Lỗi từ máy chủ: {err}";
            }
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Lỗi xử lý import: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task ExportJson()
    {
        try
        {
            var json = JsonSerializer.Serialize(allStories, new JsonSerializerOptions { WriteIndented = true });
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:application/json;base64,{base64}'; a.download = 'culture_stories_export.json'; a.click();");
        }
        catch (Exception ex)
        {
            alertMessage = "Không thể xuất file JSON: " + ex.Message;
            alertSuccess = false;
        }
    }
