@page "/portal-hub/culture-stories"
@page "/admin/culture-stories"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@layout Frontend.App.Layout.AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject Frontend.App.Services.AuthService AuthService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Quản lý Bài viết Văn hóa &amp; Lịch sử Song ngữ - Admin Portal Hub</PageTitle>

<div class="admin-culture-container">
    <!-- Top Header -->
    <div class="culture-header">
        <div class="header-titles">
            <div class="header-icon-badge">
                <i class="bi bi-book-half text-danger"></i>
            </div>
            <div>
                <h1 class="page-title">Quản lý Bài đọc Văn hóa &amp; Lịch sử Trung Hoa</h1>
                <p class="page-subtitle">Soạn thảo, quản lý kho truyện thành ngữ, điển tích, phong tục lễ hội có Pinyin và audio đọc mẫu.</p>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn btn-action-outline" @onclick="ExportJson">
                <i class="bi bi-download"></i> Xuất JSON
            </button>
            <button class="btn btn-action-outline" @onclick="OpenImportModal">
                <i class="bi bi-cloud-arrow-up-fill"></i> Import JSON
            </button>
            <button class="btn btn-action-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle-fill"></i> + Thêm Bài Viết Mới
            </button>
        </div>
    </div>

    <!-- Stats Overview Cards -->
    <div class="stats-overview">
        <div class="stat-card">
            <div class="stat-icon icon-total"><i class="bi bi-collection-fill"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allStories.Count</span>
                <span class="stat-label">Tổng bài viết</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-chengyu"><i class="bi bi-translate"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allStories.Count(s => s.Category.Contains("Thành ngữ", StringComparison.OrdinalIgnoreCase) || s.Category.Contains("chengyu", StringComparison.OrdinalIgnoreCase))</span>
                <span class="stat-label">Thành ngữ điển tích</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-history"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allStories.Count(s => s.Category.Contains("Lịch sử", StringComparison.OrdinalIgnoreCase) || s.Category.Contains("history", StringComparison.OrdinalIgnoreCase) || s.Category.Contains("Phong tục", StringComparison.OrdinalIgnoreCase))</span>
                <span class="stat-label">Lịch sử &amp; Phong tục</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-published"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allStories.Count(s => s.IsPublished)</span>
                <span class="stat-label">Đã xuất bản</span>
            </div>
        </div>
    </div>

    <!-- Alert Banner -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="custom-alert @(alertSuccess ? "alert-success" : "alert-danger")">
            <i class="bi @(alertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            <span>@alertMessage</span>
            <button class="alert-close" @onclick="() => alertMessage = null">×</button>
        </div>
    }

    <!-- Toolbar Filters -->
    <div class="toolbar-card">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Tìm theo tiêu đề chữ Hán, tiếng Việt, Pinyin, tóm tắt..."
                   @bind="searchKeyword" @bind:event="oninput" @bind:after="ApplyFilters" />
            @if (!string.IsNullOrEmpty(searchKeyword))
            {
                <button class="btn-clear-search" @onclick="ClearSearch">×</button>
            }
        </div>

        <div class="filter-controls">
            <div class="filter-item">
                <label>Chủ đề / Thể loại:</label>
                <select class="custom-select" @bind="selectedCategoryFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả chủ đề</option>
                    @foreach (var cat in availableCategories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>Trình độ HSK:</label>
                <select class="custom-select" @bind="selectedLevelFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả trình độ</option>
                    <option value="HSK 1 - 2">HSK 1 - 2 (Sơ cấp)</option>
                    <option value="HSK 3 - 4">HSK 3 - 4 (Trung cấp)</option>
                    <option value="HSK 5 - 6">HSK 5 - 6 (Cao cấp)</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                </select>
            </div>

            <div class="filter-item">
                <label>Trạng thái:</label>
                <select class="custom-select" @bind="selectedStatusFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả</option>
                    <option value="Published">Đã xuất bản</option>
                    <option value="Draft">Bản nháp</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="content-card">
        @if (isLoading)
        {
            <div class="state-container">
                <div class="custom-spinner"></div>
                <p class="state-text">Đang tải danh sách bài viết văn hóa...</p>
            </div>
        }
        else if (filteredStories.Count == 0)
        {
            <div class="state-container">
                <i class="bi bi-journal-x state-icon"></i>
                <h3>Không tìm thấy bài viết văn hóa nào</h3>
                <p class="state-text">Thử thay đổi bộ lọc tìm kiếm hoặc bấm "Thêm Bài Viết Mới" để tạo bài viết đầu tiên.</p>
                <button class="btn btn-action-primary mt-3" @onclick="OpenCreateModal">
                    <i class="bi bi-plus-circle-fill"></i> Thêm Bài Viết Ngay
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="stories-table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Ảnh</th>
                            <th>Tiêu đề &amp; Tóm tắt nội dung</th>
                            <th style="width: 140px;">Phiên âm Pinyin</th>
                            <th style="width: 150px;">Thể loại</th>
                            <th style="width: 110px;">Trình độ</th>
                            <th style="width: 90px;">Đọc (phút)</th>
                            <th style="width: 100px;">Lượt xem</th>
                            <th style="width: 110px;">Trạng thái</th>
                            <th style="width: 130px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var story in pagedStories)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(story.ThumbnailUrl) ? "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=150" : story.ThumbnailUrl)"
                                         alt="@story.TitleVi" class="story-thumb" />
                                </td>
                                <td>
                                    <div class="story-title-row">
                                        <span class="story-title-zh">@story.TitleZh</span>
                                        <span class="story-title-separator">—</span>
                                        <span class="story-title-vi">@story.TitleVi</span>
                                    </div>
                                    <div class="story-summary-text">
                                        @(string.IsNullOrEmpty(story.SummaryVi) ? "Chưa có tóm tắt tiếng Việt." : story.SummaryVi)
                                    </div>
                                </td>
                                <td>
                                    <span class="pinyin-badge">@story.Pinyin</span>
                                </td>
                                <td>
                                    <span class="category-pill">@story.Category</span>
                                </td>
                                <td>
                                    <span class="level-pill">@story.Level</span>
                                </td>
                                <td>
                                    <span class="read-time"><i class="bi bi-clock me-1"></i>~@story.EstimatedMinutes'</span>
                                </td>
                                <td>
                                    <span class="views-badge"><i class="bi bi-eye"></i> @story.ViewsCount</span>
                                </td>
                                <td>
                                    @if (story.IsPublished)
                                    {
                                        <span class="status-pill status-published"><i class="bi bi-check2"></i> Xuất bản</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-draft"><i class="bi bi-pencil"></i> Nháp</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="action-btn-group">
                                        <button class="action-btn btn-preview" @onclick="() => PreviewStory(story.Slug)" title="Xem trước bài đọc">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </button>
                                        <button class="action-btn btn-edit" @onclick="() => OpenEditModal(story)" title="Chỉnh sửa bài viết">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="action-btn btn-delete" @onclick="() => OpenDeleteModal(story)" title="Xóa bài viết">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="pagination-footer">
                <div class="pagination-info">
                    Hiển thị <b>@(((currentPage - 1) * pageSize) + 1)</b> - <b>@Math.Min(currentPage * pageSize, filteredStories.Count)</b> trong tổng số <b>@filteredStories.Count</b> bài viết
                    <select class="custom-select page-size-select ms-2" @bind="pageSize" @bind:after="() => currentPage = 1">
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                        <option value="50">50 / trang</option>
                    </select>
                </div>

                @if (totalPages > 1)
                {
                    <div class="pagination-buttons">
                        <button class="btn-page" disabled="@(currentPage <= 1)" @onclick="() => currentPage--" title="Trang trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @foreach (var p in GetVisiblePages())
                        {
                            <button class="btn-page @(currentPage == p ? "active" : "")" @onclick="() => currentPage = p">
                                @p
                            </button>
                        }
                        <button class="btn-page" disabled="@(currentPage >= totalPages)" @onclick="() => currentPage++" title="Trang sau">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL THÊM / CHỈNH SỬA BÀI VIẾT VĂN HÓA -->
<!-- ========================================================================= -->
@if (showEditorModal)
{
    <div class="modal-overlay">
        <div class="modal-card modal-xl">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi @(isEditing ? "bi-pencil-square text-primary" : "bi-plus-circle-fill text-danger")"></i>
                    <div>
                        <h3>@(isEditing ? $"Chỉnh sửa bài viết: {formModel.TitleZh} ({formModel.TitleVi})" : "Thêm Bài Viết Văn Hóa Mới")</h3>
                        <p class="modal-subtitle">Soạn thảo tiêu đề Hán tự, Pinyin, nội dung song ngữ, từ vựng và câu hỏi đọc hiểu.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="CloseEditorModal">×</button>
            </div>

            <!-- Navigation Tabs in Modal -->
            <div class="modal-tabs-nav">
                <button class="modal-tab-btn @(editorTab == "info" ? "active" : "")" @onclick='() => editorTab = "info"'>
                    <i class="bi bi-info-circle me-1"></i> 1. Thông tin chung
                </button>
                <button class="modal-tab-btn @(editorTab == "content" ? "active" : "")" @onclick='() => editorTab = "content"'>
                    <i class="bi bi-translate me-1"></i> 2. Nội dung Song ngữ
                </button>
                <button class="modal-tab-btn @(editorTab == "vocab" ? "active" : "")" @onclick='() => editorTab = "vocab"'>
                    <i class="bi bi-lightbulb me-1"></i> 3. Từ vựng trọng tâm
                </button>
                <button class="modal-tab-btn @(editorTab == "quiz" ? "active" : "")" @onclick='() => editorTab = "quiz"'>
                    <i class="bi bi-question-circle me-1"></i> 4. Câu hỏi Đọc hiểu
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(formValidationMessage))
                {
                    <div class="custom-alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>@formValidationMessage</span>
                    </div>
                }

                @if (editorTab == "info")
                {
                    <div class="form-grid">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Tiêu đề Chữ Hán (TitleZh) <span class="text-danger">*</span></label>
                            <input type="text" class="custom-input font-chinese" placeholder="VD: 塞翁失马" @bind="formModel.TitleZh" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Tiêu đề Tiếng Việt (TitleVi) <span class="text-danger">*</span></label>
                            <input type="text" class="custom-input" placeholder="VD: Tái Ông Mất Ngựa" @bind="formModel.TitleVi" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Phiên âm Pinyin (có dấu) <span class="text-danger">*</span></label>
                            <input type="text" class="custom-input" placeholder="VD: Sài Wēng Shī Mǎ" @bind="formModel.Pinyin" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Slug (Đường dẫn thân thiện)</label>
                            <input type="text" class="custom-input" placeholder="tự tạo nếu để trống (vd: sai-weng-shi-ma)" @bind="formModel.Slug" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Thể loại / Chủ đề</label>
                            <select class="custom-select w-100" @bind="formModel.Category">
                                <option value="Thành ngữ điển tích">Thành ngữ điển tích (成语故事)</option>
                                <option value="Lịch sử &amp; Nhân vật">Lịch sử &amp; Nhân vật (历史人物)</option>
                                <option value="Phong tục &amp; Lễ hội">Phong tục &amp; Lễ hội (风俗节日)</option>
                                <option value="Truyện ngụ ngôn &amp; Đời sống">Truyện ngụ ngôn &amp; Đời sống (寓言故事)</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Trình độ HSK</label>
                            <select class="custom-select w-100" @bind="formModel.Level">
                                <option value="HSK 1 - 2">HSK 1 - 2 (Sơ cấp)</option>
                                <option value="HSK 3 - 4">HSK 3 - 4 (Trung cấp)</option>
                                <option value="HSK 5 - 6">HSK 5 - 6 (Cao cấp)</option>
                                <option value="Intermediate">Intermediate (Trung cấp)</option>
                                <option value="Advanced">Advanced (Cao cấp)</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Ảnh Thumbnail (URL)</label>
                            <input type="url" class="custom-input" placeholder="https://images.unsplash.com/..." @bind="formModel.ThumbnailUrl" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Audio đọc mẫu (URL / mp3)</label>
                            <input type="text" class="custom-input" placeholder="sample-data/audio/... hoặc https://..." @bind="formModel.AudioUrl" />
                        </div>

                        <div class="col-12 col-md-2">
                            <label class="form-label">Thời gian đọc (phút)</label>
                            <input type="number" min="1" max="60" class="custom-input" @bind="formModel.EstimatedMinutes" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Tóm tắt ý nghĩa / Bài học nhân sinh (Tiếng Việt) <span class="text-danger">*</span></label>
                            <textarea class="custom-textarea" rows="2" placeholder="Họa phúc khôn lường, trong cái rủi có cái may. Khuyên con người giữ tâm thế bình thản..." @bind="formModel.SummaryVi"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="custom-checkbox-label">
                                <input type="checkbox" @bind="formModel.IsPublished" />
                                <span>Xuất bản công khai bài đọc cho học viên trên trang /culture</span>
                            </label>
                        </div>
                    </div>
                }
                else if (editorTab == "content")
                {
                    <div class="content-tab-section">
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <label class="form-label"><i class="bi bi-translate text-danger me-1"></i> Toàn văn Tiếng Trung (ContentZh) <span class="text-danger">*</span></label>
                                <textarea class="custom-textarea font-chinese" rows="8" placeholder="Nhập toàn bộ đoạn văn chữ Hán..." @bind="formModel.ContentZh"></textarea>
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label"><i class="bi bi-card-text text-primary me-1"></i> Toàn văn Dịch Tiếng Việt (ContentVi) <span class="text-danger">*</span></label>
                                <textarea class="custom-textarea" rows="8" placeholder="Nhập toàn bộ bản dịch tiếng Việt tương ứng..." @bind="formModel.ContentVi"></textarea>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label"><i class="bi bi-code-square me-1"></i> Chi tiết các câu ngắt đoạn (Paragraphs / Sentences JSON):</label>
                            <small class="text-muted d-block mb-1">Định dạng mảng JSON <code>[ { "index": 1, "zh": "...", "pinyin": "...", "vi": "..." } ]</code></small>
                            <textarea class="custom-textarea font-monospace" rows="6" @bind="formModel.ParagraphsJson" placeholder='[&#10;  {&#10;    "index": 1,&#10;    "zh": "从前，在靠近边境的一个村庄里...",&#10;    "pinyin": "Cóngqián, zài kàojìn biānjìng...",&#10;    "vi": "Ngày xưa, ở một ngôi làng gần biên ải..."&#10;  }&#10;]'></textarea>
                        </div>
                    </div>
                }
                else if (editorTab == "vocab")
                {
                    <div class="vocab-tab-section">
                        <label class="form-label"><i class="bi bi-spellcheck text-info me-1"></i> Danh sách Từ vựng Trọng tâm (Vocabulary JSON):</label>
                        <small class="text-muted d-block mb-2">Định dạng mảng JSON: <code>[ { "word": "边塞", "pinyin": "biānsài", "meaning": "biên ải", "sinoVi": "Biên tái" } ]</code></small>
                        <textarea class="custom-textarea font-monospace" rows="10" @bind="formModel.VocabularyJson" placeholder='[&#10;  {&#10;    "word": "边塞",&#10;    "pinyin": "biānsài",&#10;    "meaning": "biên ải, biên giới",&#10;    "sinoVi": "Biên tái"&#10;  }&#10;]'></textarea>
                    </div>
                }
                else if (editorTab == "quiz")
                {
                    <div class="quiz-tab-section">
                        <label class="form-label"><i class="bi bi-patch-question text-warning me-1"></i> Bộ Câu hỏi Đọc hiểu (Questions JSON):</label>
                        <small class="text-muted d-block mb-2">Định dạng mảng JSON: <code>[ { "question": "...", "options": ["A", "B", "C", "D"], "correctIndex": 1, "explanation": "..." } ]</code></small>
                        <textarea class="custom-textarea font-monospace" rows="10" @bind="formModel.QuestionsJson" placeholder='[&#10;  {&#10;    "question": "Câu chuyện dạy chúng ta điều gì?",&#10;    "options": ["Biết kiên trì", "Họa phúc khôn lường", "Không nên nuôi ngựa", "Phải đề phòng trộm"],&#10;    "correctIndex": 1,&#10;    "explanation": "Thành ngữ Tái ông thất mã ngụ ý họa phúc khôn lường."&#10;  }&#10;]'></textarea>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-action-outline" @onclick="CloseEditorModal">Hủy</button>
                <button class="btn btn-action-primary" @onclick="SaveStoryAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                        <span>@(isEditing ? "Cập Nhật Bài Viết" : "Lưu Bài Viết Mới")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL XÁC NHẬN XÓA BÀI VIẾT -->
<!-- ========================================================================= -->
@if (showDeleteModal && deletingItem != null)
{
    <div class="modal-overlay">
        <div class="modal-card modal-sm">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi bi-trash3-fill text-danger"></i>
                    <div>
                        <h3>Xác nhận xóa bài viết</h3>
                        <p class="modal-subtitle">Gỡ bỏ bài viết khỏi hệ thống đọc truyện văn hóa.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="() => showDeleteModal = false">×</button>
            </div>

            <div class="modal-body">
                <div class="delete-confirm-box">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa bài viết văn hóa sau không?</p>
                    <div class="delete-info-card">
                        <div><strong>Chữ Hán:</strong> @deletingItem.TitleZh</div>
                        <div><strong>Tiếng Việt:</strong> @deletingItem.TitleVi</div>
                        <div><strong>Thể loại:</strong> @deletingItem.Category</div>
                        <div><strong>Trình độ:</strong> @deletingItem.Level</div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-action-outline" @onclick="() => showDeleteModal = false">Hủy</button>
                <button class="btn btn-danger-solid" @onclick="ExecuteDeleteAsync" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Đang xóa...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3 me-1"></i>
                        <span>Xác Nhận Xóa</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL IMPORT JSON -->
