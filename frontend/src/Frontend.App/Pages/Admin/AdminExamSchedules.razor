    public class ExamScheduleItemModel
    {
        public int Id { get; set; }
        public string CertificateType { get; set; } = "HSK";
        public string? Level { get; set; }
        public DateTime ExamDate { get; set; }
        public DateTime RegistrationDeadline { get; set; }
        public string Location { get; set; } = string.Empty;
        public string TestCenter => Location;
        public string City { get; set; } = string.Empty;
        public string Format { get; set; } = "Computer";
        public decimal FeeVnd { get; set; }
        public string Organizer { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? RegistrationUrl { get; set; }
        public string Status { get; set; } = "RegistrationOpen";
        public bool IsActive { get; set; } = true;
    }

    public class ExamScheduleFormModel
    {
        public int Id { get; set; }
        public string CertificateType { get; set; } = "HSK";
        public string Level { get; set; } = "HSK 3 - 6 & HSKK";
        public DateTime ExamDate { get; set; } = DateTime.Today.AddMonths(1);
        public DateTime RegistrationDeadline { get; set; } = DateTime.Today.AddDays(14);
        public string Location { get; set; } = string.Empty;
        public string City { get; set; } = "Hà Nội";
        public string Format { get; set; } = "Computer";
        public decimal FeeVnd { get; set; } = 1080000;
        public string Organizer { get; set; } = "Chinese Testing International (CTI)";
        public string Description { get; set; } = string.Empty;
        public string RegistrationUrl { get; set; } = "http://www.chinesetest.cn";
        public string Status { get; set; } = "RegistrationOpen";
        public bool IsActive { get; set; } = true;
    }

    private List<ExamScheduleItemModel> allSchedules = new();
    private List<ExamScheduleItemModel> filteredSchedules = new();
    private bool isLoading = true;
    private string? alertMessage;
    private bool alertSuccess = true;

    // Filters
    private string searchKeyword = "";
    private string selectedCertFilter = "All";
    private string selectedCityFilter = "All";
    private string selectedFormatFilter = "All";
    private string selectedStatusFilter = "All";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredSchedules.Count / pageSize));
    private List<ExamScheduleItemModel> pagedSchedules => filteredSchedules.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    // Editor Modal
    private bool showEditorModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private string? formValidationMessage;
    private ExamScheduleFormModel formModel = new();

    // Delete Modal
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private ExamScheduleItemModel? deletingItem;

    // Import Modal
    private bool showImportModal = false;
    private bool isImporting = false;
    private string importJsonContent = "";
    private string? importErrorMessage;

    private List<string> availableCities => allSchedules
        .Select(s => s.City)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedulesAsync();
    }

    private string GetApiUrl(string path)
    {
        var baseUrl = Configuration["BackendApi:BaseUrl"] ?? "http://localhost:5101/";
        return $"{baseUrl.TrimEnd('/')}/{path.TrimStart('/')}";
    }

    private async Task LoadSchedulesAsync()
    {
        isLoading = true;
        alertMessage = null;
        StateHasChanged();

        try
        {
            var apiUrl = GetApiUrl("api/exam-schedules");
            var dtos = await Http.GetFromJsonAsync<List<ExamScheduleItemModel>>(apiUrl);
            if (dtos != null && dtos.Count > 0)
            {
                allSchedules = dtos;
            }
            else
            {
                await LoadFallbackJsonAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminExamSchedules] Backend fetch failed ({ex.Message}), loading fallback seed data...");
            await LoadFallbackJsonAsync();
        }

        ApplyFilters();
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadFallbackJsonAsync()
    {
        try
        {
            using var response = await Http.GetAsync("sample-data/exam-schedules-2026.json");
            if (response.IsSuccessStatusCode)
            {
                var jsonStr = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(jsonStr);
                var list = new List<ExamScheduleItemModel>();

                JsonElement arrayElement;
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = doc.RootElement;
                }
                else if (doc.RootElement.TryGetProperty("schedules", out var schElement) && schElement.ValueKind == JsonValueKind.Array)
                {
                    arrayElement = schElement;
                }
                else
                {
                    arrayElement = default;
                }

                if (arrayElement.ValueKind == JsonValueKind.Array)
                {
                    int autoId = 1;
                    foreach (var elem in arrayElement.EnumerateArray())
                    {
                        var certType = elem.TryGetProperty("certificateType", out var ctp) ? ctp.GetString() ?? "HSK" : "HSK";
                        var level = elem.TryGetProperty("level", out var lp) ? lp.GetString() : null;
                        var examDateStr = elem.TryGetProperty("examDate", out var edp) ? edp.GetString() : null;
                        var regDeadlineStr = elem.TryGetProperty("registrationDeadline", out var rdp) ? rdp.GetString() : null;
                        var location = elem.TryGetProperty("location", out var locp) ? locp.GetString() : null;
                        if (string.IsNullOrEmpty(location) && elem.TryGetProperty("testCenter", out var tcp)) location = tcp.GetString();
                        if (string.IsNullOrEmpty(location) && elem.TryGetProperty("locationName", out var lnp)) location = lnp.GetString();

                        var city = elem.TryGetProperty("city", out var cip) ? cip.GetString() ?? "Hà Nội" : "Hà Nội";
                        var format = elem.TryGetProperty("format", out var fmp) ? fmp.GetString() ?? "Computer" : "Computer";
                        var feeVnd = elem.TryGetProperty("feeVnd", out var fvp) ? fvp.GetDecimal() : 0m;
                        var organizer = elem.TryGetProperty("organizer", out var ogp) ? ogp.GetString() ?? "" : "";
                        var desc = elem.TryGetProperty("description", out var dp) ? dp.GetString() : null;
                        var regUrl = elem.TryGetProperty("registrationUrl", out var rup) ? rup.GetString() : null;
                        var status = elem.TryGetProperty("status", out var stp) ? stp.GetString() ?? "RegistrationOpen" : "RegistrationOpen";

                        DateTime.TryParse(examDateStr, out var parsedExamDate);
                        DateTime.TryParse(regDeadlineStr, out var parsedRegDeadline);

                        list.Add(new ExamScheduleItemModel
                        {
                            Id = autoId++,
                            CertificateType = certType,
                            Level = level,
                            ExamDate = parsedExamDate == default ? DateTime.UtcNow.AddMonths(1) : parsedExamDate,
                            RegistrationDeadline = parsedRegDeadline == default ? DateTime.UtcNow.AddDays(14) : parsedRegDeadline,
                            Location = location ?? "Điểm thi toàn quốc",
                            City = city,
                            Format = format,
                            FeeVnd = feeVnd,
                            Organizer = organizer,
                            Description = desc,
                            RegistrationUrl = regUrl,
                            Status = status,
                            IsActive = true
                        });
                    }
                }

                if (list.Count > 0)
                {
                    allSchedules = list;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminExamSchedules] Error loading fallback JSON: {ex.Message}");
        }
    }

    private void ApplyFilters()
    {
        var query = allSchedules.AsEnumerable();

        if (selectedCertFilter != "All")
            query = query.Where(s => s.CertificateType.Equals(selectedCertFilter, StringComparison.OrdinalIgnoreCase));

        if (selectedCityFilter != "All")
            query = query.Where(s => s.City.Equals(selectedCityFilter, StringComparison.OrdinalIgnoreCase));

        if (selectedFormatFilter != "All")
            query = query.Where(s => s.Format.Equals(selectedFormatFilter, StringComparison.OrdinalIgnoreCase));

        if (selectedStatusFilter != "All")
            query = query.Where(s => s.Status.Equals(selectedStatusFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var k = searchKeyword.Trim().ToLowerInvariant();
            query = query.Where(s =>
                s.Location.ToLower().Contains(k) ||
                s.Organizer.ToLower().Contains(k) ||
                s.City.ToLower().Contains(k) ||
                (s.Level != null && s.Level.ToLower().Contains(k)) ||
                (s.Description != null && s.Description.ToLower().Contains(k)));
        }

        filteredSchedules = query.OrderBy(s => s.ExamDate).ToList();
        currentPage = 1;
    }

    private void ClearSearch()
    {
        searchKeyword = "";
        ApplyFilters();
    }

    private List<int> GetVisiblePages()
    {
        var list = new List<int>();
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, start + 4);
        if (end - start < 4) start = Math.Max(1, end - 4);
        for (int i = start; i <= end; i++) list.Add(i);
        return list;
    }

    private string GetVietnameseDayOfWeek(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ Hai",
            DayOfWeek.Tuesday => "Thứ Ba",
            DayOfWeek.Wednesday => "Thứ Tư",
            DayOfWeek.Thursday => "Thứ Năm",
            DayOfWeek.Friday => "Thứ Sáu",
            DayOfWeek.Saturday => "Thứ Bảy",
            DayOfWeek.Sunday => "Chủ Nhật",
            _ => ""
        };
    }

    private bool IsClosingSoon(DateTime deadline)
    {
        var days = (deadline.Date - DateTime.UtcNow.Date).TotalDays;
        return days >= 0 && days <= 5;
    }

    private string GetDaysRemaining(DateTime deadline)
    {
        var days = (int)(deadline.Date - DateTime.UtcNow.Date).TotalDays;
        if (days < 0) return "Đã hết hạn";
        if (days == 0) return "Hết hạn hôm nay";
        return $"Còn {days} ngày";
    }

