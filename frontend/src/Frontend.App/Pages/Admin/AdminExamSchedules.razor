    private async Task SaveScheduleAsync()
    {
        formValidationMessage = null;

        // Validation
        if (string.IsNullOrWhiteSpace(formModel.Location))
        {
            formValidationMessage = "Vui lòng nhập Điểm thi / Trung tâm khảo thí (TestCenter).";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.City))
        {
            formValidationMessage = "Vui lòng nhập Tỉnh / Thành phố.";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel.Organizer))
        {
            formValidationMessage = "Vui lòng nhập Đơn vị tổ chức.";
            return;
        }

        if (formModel.FeeVnd <= 0)
        {
            formValidationMessage = "Lệ phí thi phải lớn hơn 0 VNĐ.";
            return;
        }

        if (formModel.ExamDate == default || formModel.RegistrationDeadline == default)
        {
            formValidationMessage = "Vui lòng chọn ngày thi và hạn chót đăng ký hợp lệ.";
            return;
        }

        if (formModel.RegistrationDeadline > formModel.ExamDate)
        {
            formValidationMessage = "Hạn chót đăng ký không thể diễn ra sau ngày thi.";
            return;
        }

        isSaving = true;

        try
        {
            var adminToken = await AuthService.GetAdminTokenAsync();
            using var reqMsg = new HttpRequestMessage(
                isEditing ? HttpMethod.Put : HttpMethod.Post,
                isEditing ? GetApiUrl($"api/admin/exam-schedules/{formModel.Id}") : GetApiUrl("api/admin/exam-schedules")
            );

            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                reqMsg.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", adminToken);
            }

            var payload = new
            {
                CertificateType = formModel.CertificateType,
                Level = formModel.Level,
                ExamDate = formModel.ExamDate,
                RegistrationDeadline = formModel.RegistrationDeadline,
                Location = formModel.Location,
                TestCenter = formModel.Location,
                City = formModel.City,
                Format = formModel.Format,
                FeeVnd = formModel.FeeVnd,
                Organizer = formModel.Organizer,
                Description = formModel.Description,
                RegistrationUrl = formModel.RegistrationUrl,
                Status = formModel.Status,
                IsActive = formModel.IsActive
            };

            reqMsg.Content = JsonContent.Create(payload);
            var response = await Http.SendAsync(reqMsg);

            if (response.IsSuccessStatusCode)
            {
                alertMessage = isEditing ? "Đã cập nhật lịch thi thành công!" : "Đã thêm lịch thi mới thành công!";
                alertSuccess = true;
                CloseEditorModal();
                await LoadSchedulesAsync();
            }
            else
            {
                // Fallback local update
                UpdateLocalStateAfterSave();
                alertMessage = (isEditing ? "Đã cập nhật lịch thi" : "Đã thêm lịch thi mới") + " (Lưu vào bộ nhớ cục bộ)";
                alertSuccess = true;
                CloseEditorModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminExamSchedules] Error saving schedule: {ex.Message}");
            UpdateLocalStateAfterSave();
            alertMessage = (isEditing ? "Đã cập nhật lịch thi" : "Đã thêm lịch thi") + " (Bộ nhớ cục bộ)";
            alertSuccess = true;
            CloseEditorModal();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void UpdateLocalStateAfterSave()
    {
        if (isEditing)
        {
            var existing = allSchedules.FirstOrDefault(s => s.Id == formModel.Id);
            if (existing != null)
            {
                existing.CertificateType = formModel.CertificateType;
                existing.Level = formModel.Level;
                existing.ExamDate = formModel.ExamDate;
                existing.RegistrationDeadline = formModel.RegistrationDeadline;
                existing.Location = formModel.Location;
                existing.City = formModel.City;
                existing.Format = formModel.Format;
                existing.FeeVnd = formModel.FeeVnd;
                existing.Organizer = formModel.Organizer;
                existing.Description = formModel.Description;
                existing.RegistrationUrl = formModel.RegistrationUrl;
                existing.Status = formModel.Status;
                existing.IsActive = formModel.IsActive;
            }
        }
        else
        {
            var nextId = allSchedules.Count > 0 ? allSchedules.Max(s => s.Id) + 1 : 1;
            allSchedules.Insert(0, new ExamScheduleItemModel
            {
                Id = nextId,
                CertificateType = formModel.CertificateType,
                Level = formModel.Level,
                ExamDate = formModel.ExamDate,
                RegistrationDeadline = formModel.RegistrationDeadline,
                Location = formModel.Location,
                City = formModel.City,
                Format = formModel.Format,
                FeeVnd = formModel.FeeVnd,
                Organizer = formModel.Organizer,
                Description = formModel.Description,
                RegistrationUrl = formModel.RegistrationUrl,
                Status = formModel.Status,
                IsActive = formModel.IsActive
            });
        }
        ApplyFilters();
    }

    private void OpenDeleteModal(ExamScheduleItemModel item)
    {
        deletingItem = item;
        showDeleteModal = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (deletingItem == null) return;
        isDeleting = true;

        try
        {
            var adminToken = await AuthService.GetAdminTokenAsync();
            using var reqMsg = new HttpRequestMessage(HttpMethod.Delete, GetApiUrl($"api/admin/exam-schedules/{deletingItem.Id}"));
            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                reqMsg.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", adminToken);
            }

            var response = await Http.SendAsync(reqMsg);
            if (response.IsSuccessStatusCode)
            {
                alertMessage = $"Đã xóa lịch thi '{deletingItem.TestCenter}' thành công!";
                alertSuccess = true;
            }
            else
            {
                alertMessage = $"Đã xóa lịch thi '{deletingItem.TestCenter}' khỏi bộ nhớ.";
                alertSuccess = true;
            }

            allSchedules.RemoveAll(s => s.Id == deletingItem.Id);
            ApplyFilters();
            showDeleteModal = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminExamSchedules] Error deleting schedule: {ex.Message}");
            allSchedules.RemoveAll(s => s.Id == deletingItem.Id);
            ApplyFilters();
            alertMessage = "Đã xóa lịch thi khỏi bộ nhớ.";
            alertSuccess = true;
            showDeleteModal = false;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void OpenImportModal()
    {
        importJsonContent = "";
        importErrorMessage = null;
        showImportModal = true;
    }

    private async Task ExecuteImportJsonAsync()
    {
        if (string.IsNullOrWhiteSpace(importJsonContent))
        {
            importErrorMessage = "Vui lòng dán nội dung JSON.";
            return;
        }

        isImporting = true;
        importErrorMessage = null;

        try
        {
            var adminToken = await AuthService.GetAdminTokenAsync();
            using var reqMsg = new HttpRequestMessage(HttpMethod.Post, GetApiUrl("api/admin/exam-schedules/import-json"));
            if (!string.IsNullOrWhiteSpace(adminToken))
            {
                reqMsg.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", adminToken);
            }

            reqMsg.Content = JsonContent.Create(new { JsonContent = importJsonContent });
            var response = await Http.SendAsync(reqMsg);

            if (response.IsSuccessStatusCode)
            {
                alertMessage = "Import danh sách lịch thi từ JSON thành công!";
                alertSuccess = true;
                showImportModal = false;
                await LoadSchedulesAsync();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                importErrorMessage = $"Lỗi từ máy chủ: {err}";
            }
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Lỗi xử lý import: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task ExportJson()
    {
        try
        {
            var json = JsonSerializer.Serialize(allSchedules, new JsonSerializerOptions { WriteIndented = true });
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:application/json;base64,{base64}'; a.download = 'exam_schedules_export.json'; a.click();");
        }
        catch (Exception ex)
        {
            alertMessage = "Không thể xuất file JSON: " + ex.Message;
            alertSuccess = false;
        }
    }
