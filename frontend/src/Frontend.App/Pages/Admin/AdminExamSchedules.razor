@page "/portal-hub/exam-schedules"
@page "/admin/exam-schedules"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@layout Frontend.App.Layout.AdminLayout
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject Frontend.App.Services.AuthService AuthService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Quản lý Lịch thi Chứng chỉ (HSK & IELTS) - Admin Portal Hub</PageTitle>

<div class="admin-schedules-container">
    <!-- Top Header -->
    <div class="schedules-header">
        <div class="header-titles">
            <div class="header-icon-badge">
                <i class="bi bi-calendar2-check-fill text-warning"></i>
            </div>
            <div>
                <h1 class="page-title">Quản lý Lịch thi Chứng chỉ (HSK &amp; IELTS)</h1>
                <p class="page-subtitle">Cập nhật lịch thi toàn quốc, địa điểm, hạn đăng ký và lệ phí thi HSK/HSKK &amp; IELTS năm 2026.</p>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn btn-action-outline" @onclick="ExportJson">
                <i class="bi bi-download"></i> Xuất JSON
            </button>
            <button class="btn btn-action-outline" @onclick="OpenImportModal">
                <i class="bi bi-cloud-arrow-up-fill"></i> Import JSON
            </button>
            <button class="btn btn-action-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle-fill"></i> + Thêm Lịch Thi Mới
            </button>
        </div>
    </div>

    <!-- Stat Summary Cards -->
    <div class="stats-overview">
        <div class="stat-card">
            <div class="stat-icon icon-total"><i class="bi bi-calendar3"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allSchedules.Count</span>
                <span class="stat-label">Tổng đợt thi</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-hsk"><i class="bi bi-translate"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allSchedules.Count(s => s.CertificateType.Equals("HSK", StringComparison.OrdinalIgnoreCase))</span>
                <span class="stat-label">Kỳ thi HSK / HSKK</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-ielts"><i class="bi bi-award"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allSchedules.Count(s => s.CertificateType.Equals("IELTS", StringComparison.OrdinalIgnoreCase))</span>
                <span class="stat-label">Kỳ thi IELTS (IDP / BC)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-open"><i class="bi bi-door-open-fill"></i></div>
            <div class="stat-content">
                <span class="stat-number">@allSchedules.Count(s => s.Status.Equals("RegistrationOpen", StringComparison.OrdinalIgnoreCase) || s.Status.Equals("Open", StringComparison.OrdinalIgnoreCase))</span>
                <span class="stat-label">Đang mở đăng ký</span>
            </div>
        </div>
    </div>

    <!-- Alert Banner -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="custom-alert @(alertSuccess ? "alert-success" : "alert-danger")">
            <i class="bi @(alertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            <span>@alertMessage</span>
            <button class="alert-close" @onclick="() => alertMessage = null">×</button>
        </div>
    }

    <!-- Filter & Search Toolbar -->
    <div class="toolbar-card">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Tìm theo điểm thi, đơn vị tổ chức, tỉnh thành, ghi chú..."
                   @bind="searchKeyword" @bind:event="oninput" @bind:after="ApplyFilters" />
            @if (!string.IsNullOrEmpty(searchKeyword))
            {
                <button class="btn-clear-search" @onclick="ClearSearch">×</button>
            }
        </div>

        <div class="filter-controls">
            <div class="filter-item">
                <label>Chứng chỉ:</label>
                <select class="custom-select" @bind="selectedCertFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả chứng chỉ</option>
                    <option value="HSK">HSK &amp; HSKK</option>
                    <option value="IELTS">IELTS</option>
                </select>
            </div>

            <div class="filter-item">
                <label>Tỉnh/Thành phố:</label>
                <select class="custom-select" @bind="selectedCityFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả thành phố</option>
                    @foreach (var city in availableCities)
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>Hình thức:</label>
                <select class="custom-select" @bind="selectedFormatFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả hình thức</option>
                    <option value="Computer">🖥️ Thi trên máy tính</option>
                    <option value="Paper">📝 Thi trên giấy</option>
                </select>
            </div>

            <div class="filter-item">
                <label>Trạng thái:</label>
                <select class="custom-select" @bind="selectedStatusFilter" @bind:after="ApplyFilters">
                    <option value="All">Tất cả trạng thái</option>
                    <option value="RegistrationOpen">Đang mở đăng ký</option>
                    <option value="ClosingSoon">Sắp hết hạn</option>
                    <option value="Closed">Đã đóng đăng ký</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="content-card">
        @if (isLoading)
        {
            <div class="state-container">
                <div class="custom-spinner"></div>
                <p class="state-text">Đang tải lịch thi chứng chỉ...</p>
            </div>
        }
        else if (filteredSchedules.Count == 0)
        {
            <div class="state-container">
                <i class="bi bi-calendar-x state-icon"></i>
                <h3>Không tìm thấy lịch thi nào</h3>
                <p class="state-text">Thử thay đổi bộ lọc hoặc bấm "Thêm Lịch Thi Mới" để tạo đợt thi đầu tiên.</p>
                <button class="btn btn-action-primary mt-3" @onclick="OpenCreateModal">
                    <i class="bi bi-plus-circle-fill"></i> Thêm Lịch Thi Ngay
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="schedules-table">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Chứng chỉ</th>
                            <th style="width: 120px;">Ngày thi</th>
                            <th style="width: 120px;">Hạn đăng ký</th>
                            <th>Địa điểm &amp; Đơn vị tổ chức</th>
                            <th style="width: 130px;">Khu vực</th>
                            <th style="width: 110px;">Hình thức</th>
                            <th style="width: 130px;">Lệ phí (VNĐ)</th>
                            <th style="width: 120px;">Trạng thái</th>
                            <th style="width: 120px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in pagedSchedules)
                        {
                            <tr>
                                <td>
                                    <span class="cert-badge cert-@s.CertificateType.ToLowerInvariant()">
                                        @s.CertificateType
                                    </span>
                                    @if (!string.IsNullOrEmpty(s.Level))
                                    {
                                        <div class="level-subtext">@s.Level</div>
                                    }
                                </td>
                                <td>
                                    <div class="date-main">@s.ExamDate.ToString("dd/MM/yyyy")</div>
                                    <div class="date-weekday">@GetVietnameseDayOfWeek(s.ExamDate)</div>
                                </td>
                                <td>
                                    <div class="deadline-text @(IsClosingSoon(s.RegistrationDeadline) ? "deadline-urgent" : "")">
                                        @s.RegistrationDeadline.ToString("dd/MM/yyyy")
                                    </div>
                                    <small class="deadline-relative">@GetDaysRemaining(s.RegistrationDeadline)</small>
                                </td>
                                <td>
                                    <div class="location-name">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        <strong>@s.TestCenter</strong>
                                    </div>
                                    <div class="organizer-text">
                                        <i class="bi bi-building me-1"></i> @s.Organizer
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <div class="desc-preview" title="@s.Description">@s.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="city-pill">
                                        <i class="bi bi-pin-map"></i> @s.City
                                    </span>
                                </td>
                                <td>
                                    @if (s.Format.Equals("Computer", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="format-badge format-computer"><i class="bi bi-display"></i> Máy tính</span>
                                    }
                                    else
                                    {
                                        <span class="format-badge format-paper"><i class="bi bi-pencil-square"></i> Giấy</span>
                                    }
                                </td>
                                <td>
                                    <div class="fee-text">@s.FeeVnd.ToString("N0") ₫</div>
                                </td>
                                <td>
                                    @if (s.Status.Equals("RegistrationOpen", StringComparison.OrdinalIgnoreCase) || s.Status.Equals("Open", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-pill status-open"><i class="bi bi-check-circle-fill"></i> Mở đăng ký</span>
                                    }
                                    else if (s.Status.Equals("ClosingSoon", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-pill status-urgent"><i class="bi bi-clock-fill"></i> Sắp hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-closed"><i class="bi bi-x-circle-fill"></i> Đã đóng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="action-btn-group">
                                        @if (!string.IsNullOrWhiteSpace(s.RegistrationUrl))
                                        {
                                            <a href="@s.RegistrationUrl" target="_blank" class="action-btn btn-link-out" title="Trang đăng ký chính thức">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                        <button class="action-btn btn-edit" @onclick="() => OpenEditModal(s)" title="Chỉnh sửa lịch thi">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="action-btn btn-delete" @onclick="() => OpenDeleteModal(s)" title="Xóa lịch thi">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="pagination-footer">
                <div class="pagination-info">
                    Hiển thị <b>@(((currentPage - 1) * pageSize) + 1)</b> - <b>@Math.Min(currentPage * pageSize, filteredSchedules.Count)</b> trong tổng số <b>@filteredSchedules.Count</b> lịch thi
                    <select class="custom-select page-size-select ms-2" @bind="pageSize" @bind:after="() => currentPage = 1">
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                        <option value="50">50 / trang</option>
                    </select>
                </div>

                @if (totalPages > 1)
                {
                    <div class="pagination-buttons">
                        <button class="btn-page" disabled="@(currentPage <= 1)" @onclick="() => currentPage--" title="Trang trước">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        @foreach (var p in GetVisiblePages())
                        {
                            <button class="btn-page @(currentPage == p ? "active" : "")" @onclick="() => currentPage = p">
                                @p
                            </button>
                        }
                        <button class="btn-page" disabled="@(currentPage >= totalPages)" @onclick="() => currentPage++" title="Trang sau">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL THÊM / CHỈNH SỬA LỊCH THI -->
<!-- ========================================================================= -->
@if (showEditorModal)
{
    <div class="modal-overlay">
        <div class="modal-card modal-lg">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi @(isEditing ? "bi-pencil-square text-primary" : "bi-plus-circle-fill text-warning")"></i>
                    <div>
                        <h3>@(isEditing ? $"Chỉnh sửa lịch thi: #{formModel.Id}" : "Thêm Lịch Thi Mới")</h3>
                        <p class="modal-subtitle">Điền đầy đủ thông tin kỳ thi, địa điểm, lệ phí và hạn chót đăng ký.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="CloseEditorModal">×</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(formValidationMessage))
                {
                    <div class="custom-alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>@formValidationMessage</span>
                    </div>
                }

                <div class="form-grid">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Loại chứng chỉ <span class="text-danger">*</span></label>
                        <select class="custom-select w-100" @bind="formModel.CertificateType">
                            <option value="HSK">HSK (Tiếng Trung)</option>
                            <option value="IELTS">IELTS (Tiếng Anh)</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Cấp độ / Phân hệ</label>
                        <input type="text" class="custom-input" placeholder="VD: HSK 3 - 6 & HSKK, IELTS Academic..." @bind="formModel.Level" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Ngày thi chính thức <span class="text-danger">*</span></label>
                        <input type="date" class="custom-input" @bind="formModel.ExamDate" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Hạn chót đăng ký <span class="text-danger">*</span></label>
                        <input type="date" class="custom-input" @bind="formModel.RegistrationDeadline" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Điểm thi / Trung tâm khảo thí (TestCenter) <span class="text-danger">*</span></label>
                        <input type="text" class="custom-input" placeholder="VD: Viện Khổng Tử - Trường Đại học Hà Nội (HANU)" @bind="formModel.Location" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                        <input type="text" class="custom-input" placeholder="VD: Hà Nội, TP. Hồ Chí Minh, Đà Nẵng..." @bind="formModel.City" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Hình thức thi <span class="text-danger">*</span></label>
                        <select class="custom-select w-100" @bind="formModel.Format">
                            <option value="Computer">🖥️ Thi trên máy tính (Computer)</option>
                            <option value="Paper">📝 Thi trên giấy (Paper)</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Lệ phí thi (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="custom-input" step="10000" min="0" placeholder="VD: 1080000" @bind="formModel.FeeVnd" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Đơn vị tổ chức (Organizer) <span class="text-danger">*</span></label>
                        <input type="text" class="custom-input" placeholder="VD: Chinese Testing International (CTI), IDP, British Council..." @bind="formModel.Organizer" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Trạng thái kỳ thi</label>
                        <select class="custom-select w-100" @bind="formModel.Status">
                            <option value="RegistrationOpen">Đang mở đăng ký (RegistrationOpen)</option>
                            <option value="ClosingSoon">Sắp hết hạn (ClosingSoon)</option>
                            <option value="Closed">Đã đóng đăng ký (Closed)</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Liên kết đăng ký chính thức (URL)</label>
                        <input type="url" class="custom-input" placeholder="https://..." @bind="formModel.RegistrationUrl" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả / Ghi chú đợt thi</label>
                        <textarea class="custom-textarea" rows="2" placeholder="Thông tin thêm về ca thi, giấy tờ cần mang theo..." @bind="formModel.Description"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="custom-checkbox-label">
                            <input type="checkbox" @bind="formModel.IsActive" />
                            <span>Hiển thị công khai trên Cổng Lịch Thi toàn quốc</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-action-outline" @onclick="CloseEditorModal">Hủy</button>
                <button class="btn btn-action-primary" @onclick="SaveScheduleAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                        <span>@(isEditing ? "Cập Nhật Lịch Thi" : "Lưu Lịch Thi Mới")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL XÁC NHẬN XÓA LỊCH THI -->
<!-- ========================================================================= -->
@if (showDeleteModal && deletingItem != null)
{
    <div class="modal-overlay">
        <div class="modal-card modal-sm">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi bi-trash3-fill text-danger"></i>
                    <div>
                        <h3>Xác nhận xóa lịch thi</h3>
                        <p class="modal-subtitle">Thao tác này sẽ gỡ bỏ đợt thi khỏi hệ thống tra cứu.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="() => showDeleteModal = false">×</button>
            </div>

            <div class="modal-body">
                <div class="delete-confirm-box">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa đợt thi này không?</p>
                    <div class="delete-info-card">
                        <div><strong>Chứng chỉ:</strong> @deletingItem.CertificateType - @deletingItem.Level</div>
                        <div><strong>Ngày thi:</strong> @deletingItem.ExamDate.ToString("dd/MM/yyyy")</div>
                        <div><strong>Địa điểm:</strong> @deletingItem.TestCenter (@deletingItem.City)</div>
                        <div><strong>Đơn vị tổ chức:</strong> @deletingItem.Organizer</div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-action-outline" @onclick="() => showDeleteModal = false">Hủy</button>
                <button class="btn btn-danger-solid" @onclick="ExecuteDeleteAsync" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Đang xóa...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3 me-1"></i>
                        <span>Xác Nhận Xóa</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL IMPORT JSON -->
<!-- ========================================================================= -->
@if (showImportModal)
{
    <div class="modal-overlay">
        <div class="modal-card modal-lg">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="bi bi-cloud-arrow-up-fill text-primary"></i>
                    <div>
                        <h3>Import Lịch Thi Hàng Loạt Từ JSON</h3>
                        <p class="modal-subtitle">Dán mảng JSON hoặc cấu trúc <code>{ "schedules": [...] }</code> để nạp nhanh vào cơ sở dữ liệu.</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="() => showImportModal = false">×</button>
            </div>

            <div class="modal-body">
                <label class="form-label">Dán nội dung JSON vào khung bên dưới:</label>
                <textarea class="custom-textarea font-monospace" rows="10" @bind="importJsonContent"
                          placeholder='[&#10;  {&#10;    "certificateType": "HSK",&#10;    "examDate": "2026-03-15",&#10;    "registrationDeadline": "2026-02-15",&#10;    "testCenter": "Viện Khổng Tử HANU",&#10;    "city": "Hà Nội",&#10;    "format": "Computer",&#10;    "feeVnd": 1080000,&#10;    "organizer": "CTI"&#10;  }&#10;]'></textarea>
                @if (!string.IsNullOrEmpty(importErrorMessage))
                {
                    <div class="custom-alert alert-danger mt-2">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span>@importErrorMessage</span>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-action-outline" @onclick="() => showImportModal = false">Đóng</button>
                <button class="btn btn-action-primary" @onclick="ExecuteImportJsonAsync" disabled="@isImporting">
                    @if (isImporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Đang xử lý import...</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i>
                        <span>Tiến Hành Import</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .admin-schedules-container {
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
        color: var(--ig-text, #0f172a);
    }

    .schedules-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .header-titles {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .header-icon-badge {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        background: rgba(234, 179, 8, 0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .page-title {
        font-size: 1.55rem;
        font-weight: 800;
        margin: 0 0 4px 0;
        color: var(--ig-text, #0f172a);
    }

    .page-subtitle {
        font-size: 0.92rem;
        color: var(--ig-text-secondary, #64748b);
        margin: 0;
    }

