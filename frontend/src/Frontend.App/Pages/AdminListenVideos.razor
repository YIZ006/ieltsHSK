@page "/admin/listen-videos"
@layout Frontend.App.Layout.AdminLayout
@using Frontend.App.Models
@using Frontend.App.Services
@inject IeltsService IeltsService
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Quản lý Video Nghe Điền - Admin</PageTitle>

<div class="admin-page-header">
    <div class="header-title">
        <h2><i class="bi bi-camera-video"></i> Quản lý Video Nghe Điền</h2>
        <p>Danh sách tất cả các video trên hệ thống và thêm phụ đề thủ công.</p>
    </div>
    <div class="header-actions">
        <a href="@templateUrl" class="btn btn-outline-success me-2" download="ListenVideos_Template.xlsx">
            <i class="bi bi-file-earmark-spreadsheet"></i> Tải Form Mẫu
        </a>
        <button class="btn btn-success me-2" @onclick="TriggerFileInput" disabled="@isImporting">
            @if (isImporting)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Đang xử lý...</span>
            }
            else
            {
                <i class="bi bi-cloud-arrow-up"></i> <span>Nhập Excel</span>
            }
        </button>
        <InputFile id="excelFileInput" OnChange="HandleExcelUpload" accept=".xlsx" style="display: none;" />
        <button class="btn btn-primary" @onclick="LoadVideos">
            <i class="bi bi-arrow-clockwise"></i> Tải lại
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert alert-@alertType alert-dismissible fade show mb-4 shadow-sm" role="alert">
        @if(alertType == "success") {
            <i class="bi bi-check-circle-fill me-2"></i>
        } else {
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
        }
        <strong>Thông báo:</strong> @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}

<div class="admin-card mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Tìm kiếm theo tên video..." @bind="searchTitle" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <input type="date" class="form-control" @bind="searchDate" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="searchStatus">
                <option value="All">Tất cả trạng thái</option>
                <option value="Approved">Đã duyệt</option>
                <option value="Pending">Chờ duyệt</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">Xóa lọc</button>
        </div>
    </div>
</div>

<div class="admin-card">
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Đang tải danh sách video...</p>
        </div>
    }
    else if (FilteredVideos.Count == 0)
    {
        <div class="empty-state text-center p-5">
            <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Không tìm thấy video nào</h4>
            <p class="text-muted">Không có dữ liệu phù hợp với điều kiện lọc hiện tại.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th width="120">Thumbnail</th>
                        <th>Video Info</th>
                        <th width="120">Trạng thái</th>
                        <th width="120">Ngày gửi</th>
                        <th width="280" class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var video in FilteredVideos)
                    {
                        <tr>
                            <td>
                                <img src="@video.ThumbnailUrl" alt="Thumbnail" class="img-thumbnail" style="width: 100px; height: 56px; object-fit: cover;" onerror="this.src='https://placehold.co/100x56/e9ecef/495057?text=No+Img'" />
                            </td>
                            <td>
                                <h6 class="mb-1 text-primary" style="max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@video.Title">@video.Title</h6>
                                <div class="text-muted small">
                                    <span><i class="bi bi-link-45deg"></i> <a href="@video.YoutubeUrl" target="_blank">Xem trên YouTube</a></span>
                                    @if (video.WordCount > 0)
                                    {
                                        <span class="ms-2 text-success fw-bold"><i class="bi bi-file-word"></i> @video.WordCount từ</span>
                                    }
                                    else
                                    {
                                        <span class="ms-2 text-danger small"><i class="bi bi-exclamation-triangle"></i> Chưa có phụ đề</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (video.IsApproved)
                                {
                                    <span class="badge bg-success">Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@video.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenTranscriptModal(video)" title="Thêm hoặc chỉnh sửa phụ đề">
                                    <i class="bi bi-file-earmark-text"></i> <span>Phụ đề</span>
                                </button>

                                @if (!video.IsApproved)
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveVideo(video.Id)" disabled="@isApproving">
                                        @if (approvingId == video.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-lg"></i> <span>Duyệt</span>
                                        }
                                    </button>
                                }

                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteVideo(video.Id)" title="Xóa video">
                                    <i class="bi bi-trash"></i> <span>Xóa</span>
                                </button>
                                
                                @if (showTranscriptModal && selectedVideo?.Id == video.Id)
                                {
                                    <div class="mt-2 p-2 bg-light border rounded shadow-sm" style="min-width: 300px; position: absolute; right: 20px; z-index: 100;">
                                        <label class="form-label small fw-bold mb-1">Dán phụ đề tiếng Anh:</label>
                                        <textarea class="form-control form-control-sm mb-2" rows="5" placeholder="Copy từ Youtube dán vào đây..." @bind="manualText"></textarea>
                                        
                                        @if (!string.IsNullOrEmpty(modalError))
                                        {
                                            <div class="text-danger small mb-2">@modalError</div>
                                        }
                                        
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn btn-sm btn-secondary" @onclick="CloseTranscriptModal">Hủy</button>
                                            <button class="btn btn-sm btn-primary" @onclick="SaveTranscript" disabled="@isSavingTranscript">
                                                @if (isSavingTranscript)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <span>Lưu</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>




<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e9ecef;
    }
    
    .admin-page-header h2 {
        margin: 0 0 5px 0;
        font-weight: 700;
        color: #2c3e50;
    }
    
    .admin-page-header p {
        margin: 0;
        color: #6c757d;
    }
    
    .admin-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #e9ecef;
        padding: 20px;
    }
</style>

@code {
    private List<ListenVideoDto> allVideos = new();
    private bool isLoading = true;
    private string? alertMessage;
    private string alertType = "success";
    
    private bool isApproving = false;
    private int? approvingId = null;

    // Filters
    private string searchTitle = "";
    private DateTime? searchDate = null;
    private string searchStatus = "All";

    // Mẫu URL
    private string templateUrl = "";

    // Modal Phụ Đề
    private bool showTranscriptModal = false;
    private ListenVideoDto? selectedVideo = null;
    private string manualText = "";
    private bool isSavingTranscript = false;
    private string? modalError = null;
    
    // Upload Excel
    private bool isImporting = false;

    private List<ListenVideoDto> FilteredVideos
    {
        get
        {
            var query = allVideos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTitle))
            {
                query = query.Where(v => v.Title.Contains(searchTitle, StringComparison.OrdinalIgnoreCase) || 
                                         v.YoutubeUrl.Contains(searchTitle, StringComparison.OrdinalIgnoreCase));
            }

            if (searchDate.HasValue)
            {
                query = query.Where(v => v.SubmittedAt.ToLocalTime().Date == searchDate.Value.Date);
            }

            if (searchStatus == "Approved")
            {
                query = query.Where(v => v.IsApproved);
            }
            else if (searchStatus == "Pending")
            {
                query = query.Where(v => !v.IsApproved);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var baseUrl = Configuration["BackendApi:BaseUrl"]?.TrimEnd('/') ?? "http://localhost:5242";
        templateUrl = $"{baseUrl}/api/admin/listen-videos/template-excel";
        await LoadVideos();
    }

    private async Task LoadVideos()
    {
        isLoading = true;
        allVideos = await IeltsService.GetAllListenVideosAsync();
        isLoading = false;
    }

    private void ClearFilters()
    {
        searchTitle = "";
        searchDate = null;
        searchStatus = "All";
    }

    private void OpenTranscriptModal(ListenVideoDto video)
    {
        selectedVideo = video;
        manualText = "";
        modalError = null;
        showTranscriptModal = true;
    }

    private void CloseTranscriptModal()
    {
        showTranscriptModal = false;
        selectedVideo = null;
        manualText = "";
        modalError = null;
    }

    private async Task SaveTranscript()
    {
        if (selectedVideo == null) return;
        if (string.IsNullOrWhiteSpace(manualText))
        {
            modalError = "Vui lòng dán văn bản phụ đề trước khi lưu!";
            return;
        }

        isSavingTranscript = true;
        modalError = null;

        var result = await IeltsService.UpdateManualTranscriptAsync(selectedVideo.Id, manualText);
        if (result.Success)
        {
            ShowAlert("Đã tải lên và lưu phụ đề thành công!", "success");
            CloseTranscriptModal();
            await LoadVideos();
        }
        else
        {
            modalError = result.Message;
        }

        isSavingTranscript = false;
    }

    private async Task ApproveVideo(int id)
    {
        isApproving = true;
        approvingId = id;
        StateHasChanged();

        var result = await IeltsService.ApproveListenVideoAsync(id);
        if (result.Success)
        {
            ShowAlert("Đã phê duyệt video thành công!", "success");
            await LoadVideos();
        }
        else
        {
            ShowAlert(result.Message, "danger");
        }
        
        isApproving = false;
        approvingId = null;
    }

    private async Task DeleteVideo(int id)
    {
        var success = await IeltsService.DeleteListenVideoAsync(id);
        if (success)
        {
            ShowAlert("Đã xóa video thành công!", "success");
            allVideos.RemoveAll(v => v.Id == id);
        }
        else
        {
            ShowAlert("Lỗi khi xóa video.", "danger");
        }
    }

    private async Task TriggerFileInput()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('excelFileInput').click();");
    }

    private async Task HandleExcelUpload(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            isImporting = true;
            StateHasChanged();

            var result = await IeltsService.ImportListenVideosExcelAsync(file);
            
            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                await LoadVideos();
            }
            else
            {
                ShowAlert(result.Message, "danger");
            }

            isImporting = false;
            StateHasChanged();
        }
    }

    private void ShowAlert(string message, string type)
    {
        alertMessage = message;
        alertType = type;
        
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            alertMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }
}
