@code {
    [Parameter]
    public string? Slug { get; set; }

    private List<CultureStoryItem>? allStories;
    private List<CultureStoryItem>? stories;
    private CultureStoryItem? selectedStory;

    private string selectedCategory = "all";
    private string searchQuery = "";
    private bool isLoading = true;

    // Reader Settings
    private bool showPinyin = true;
    private bool showTranslation = true;
    private int fontSize = 18;
    private bool isNarrating = false;
    private int playingSentenceIndex = -1;

    // Word Lookup Popup
    private StoryVocabItem? activeLookupWord;

    // Quiz State
    private Dictionary<int, int> userQuizAnswers = new();
    private CultureQuizResult? quizResult;

    private int chengyuCount => allStories?.Count(s => s.Category.Contains("Thành ngữ") || s.Category.Contains("chengyu")) ?? 0;
    private int historyCount => allStories?.Count(s => s.Category.Contains("Lịch sử") || s.Category.Contains("history")) ?? 0;
    private int customsCount => allStories?.Count(s => s.Category.Contains("Phong tục") || s.Category.Contains("Lễ hội") || s.Category.Contains("custom")) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        await LoadStoriesDataAsync();
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            await LoadStoryBySlugAsync(Slug);
        }
    }

    private async Task LoadStoriesDataAsync()
    {
        isLoading = true;
        try
        {
            allStories = await CultureService.GetStoriesAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CultureReader] Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStoryBySlugAsync(string slugOrId)
    {
        selectedStory = await CultureService.GetStoryDetailAsync(slugOrId);
        ResetQuiz();
    }

    private void ApplyFilter()
    {
        if (allStories == null)
        {
            stories = new List<CultureStoryItem>();
            return;
        }

        var filtered = allStories.AsEnumerable();

        if (selectedCategory == "chengyu")
        {
            filtered = filtered.Where(s => s.Category.Contains("Thành ngữ") || s.Category.Contains("chengyu"));
        }
        else if (selectedCategory == "history")
        {
            filtered = filtered.Where(s => s.Category.Contains("Lịch sử") || s.Category.Contains("history"));
        }
        else if (selectedCategory == "customs")
        {
            filtered = filtered.Where(s => s.Category.Contains("Phong tục") || s.Category.Contains("Lễ hội") || s.Category.Contains("custom"));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            filtered = filtered.Where(s =>
                s.TitleZh.ToLowerInvariant().Contains(q) ||
                s.TitleVi.ToLowerInvariant().Contains(q) ||
                s.Pinyin.ToLowerInvariant().Contains(q) ||
                (s.SummaryVi != null && s.SummaryVi.ToLowerInvariant().Contains(q)));
        }

        stories = filtered.ToList();
    }

    private void FilterCategory(string cat)
    {
        selectedCategory = cat;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFilter();
    }

    private void ResetFilters()
    {
        selectedCategory = "all";
        searchQuery = "";
        ApplyFilter();
    }

    private async Task OpenStory(CultureStoryItem s)
    {
        selectedStory = await CultureService.GetStoryDetailAsync(s.Slug ?? s.Id);
        ResetQuiz();
    }

    private void CloseStory()
    {
        selectedStory = null;
        isNarrating = false;
        playingSentenceIndex = -1;
        ResetQuiz();
    }

    private void IncreaseFontSize()
    {
        if (fontSize < 28) fontSize += 2;
    }

    private void DecreaseFontSize()
    {
        if (fontSize > 14) fontSize -= 2;
    }

    private async Task PlaySentence(int index, string text)
    {
        playingSentenceIndex = index;
        await SpeakText(text);
    }

    private async Task ToggleStoryNarration()
    {
        if (isNarrating)
        {
            isNarrating = false;
            playingSentenceIndex = -1;
            return;
        }

        if (selectedStory == null) return;
        isNarrating = true;

        var sentences = (selectedStory.Sentences != null && selectedStory.Sentences.Count > 0)
            ? selectedStory.Sentences
            : selectedStory.Paragraphs;

        if (sentences != null && sentences.Count > 0)
        {
            foreach (var line in sentences)
            {
                if (!isNarrating) break;
                playingSentenceIndex = line.Index;
                StateHasChanged();
                await SpeakText(line.Zh);
                await Task.Delay(1500); // Pause between sentences
            }
        }
        else if (!string.IsNullOrEmpty(selectedStory.ContentZh))
        {
            await SpeakText(selectedStory.ContentZh);
        }

        isNarrating = false;
        playingSentenceIndex = -1;
        StateHasChanged();
    }

    private async Task SpeakText(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("speakText", text, "zh-CN");
        }
        catch { }
    }

    private void OpenWordModal(StoryVocabItem vocab) => activeLookupWord = vocab;
    private void CloseWordModal() => activeLookupWord = null;

    private void SelectAnswer(int qIndex, int optIndex)
    {
        if (quizResult != null) return;
        userQuizAnswers[qIndex] = optIndex;
    }

    private async Task SubmitQuiz()
    {
        if (selectedStory == null || selectedStory.Questions == null) return;

        var answersList = new List<int>();
        for (int i = 0; i < selectedStory.Questions.Count; i++)
        {
            answersList.Add(userQuizAnswers.ContainsKey(i) ? userQuizAnswers[i] : -1);
        }

        quizResult = await CultureService.SubmitQuizAsync(selectedStory.StoryId, selectedStory.Slug, answersList);
    }

    private void ResetQuiz()
    {
        userQuizAnswers.Clear();
        quizResult = null;
    }
}
