@page "/ielts/listening/preview"
@page "/ielts/listening/{ExamUrl}"
@page "/ielts/listening"
@layout Frontend.App.Layout.ExamLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using Microsoft.JSInterop
@inject ExamService ExamService
@inject AnswerKeyService answerKeyService
@inject IJSRuntime JS
@inject ExamSessionService ExamSession
@inject ExamSubmissionService SubmissionService
@inject ExamCheckpointService CheckpointService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(isFinished ? "Đáp án & Chấm điểm: " : "")@(exam?.Title ?? "IELTS Listening") - IeltsHSK</PageTitle>

@if (isLoading)
{
    <div class="reading-loading">
        <div class="loading-ring"></div>
        <p>Đang tải đề thi...</p>
    </div>
}
else if (exam == null)
{
    <div class="reading-error">
        <div class="error-icon">📭</div>
        <h3>Không tải được đề thi</h3>
        <p>Vui lòng thử lại hoặc chọn đề khác.</p>
        <button class="nav-part-btn submit" style="margin-top:16px;" @onclick="ExitExam">Quay lại danh sách</button>
    </div>
}
else
{
    var activePart = exam.Parts[activePartIndex];
    int qStart = exam.Parts.Take(activePartIndex).Sum(p => p.QuestionGroups.Sum(g => g.Questions.Count)) + 1;
    int qEnd   = qStart + activePart.QuestionGroups.Sum(g => g.Questions.Count) - 1;

    @* ── TOP BAR / REVIEW BANNER ── *@
    @if (isFinished && gradingResult != null)
    {
        <div class="reading-review-topbar">
            <div class="review-top-left">
                <span class="review-badge">✨ KẾT QUẢ ĐÁP ÁN LISTENING</span>
                <span class="exam-title-short">@exam.Title</span>
            </div>
            <div class="review-top-stats">
                <div class="stat-pill band">
                    <span class="stat-lbl">Band</span>
                    <span class="stat-val">@gradingResult.BandScore.ToString("0.0")</span>
                </div>
                <div class="stat-pill correct">
                    <span class="stat-lbl">Đúng</span>
                    <span class="stat-val">@gradingResult.CorrectCount/@gradingResult.TotalCount</span>
                </div>
                <div class="stat-pill wrong">
                    <span class="stat-lbl">Sai</span>
                    <span class="stat-val">@(gradingResult.TotalCount - gradingResult.CorrectCount - gradingResult.Questions.Values.Count(q => q.IsBlank))</span>
                </div>
                <div class="stat-pill blank">
                    <span class="stat-lbl">Bỏ trống</span>
                    <span class="stat-val">@gradingResult.Questions.Values.Count(q => q.IsBlank)</span>
                </div>
            </div>
            <div class="review-top-actions">
                <button class="btn-action review-btn" style="background:#2563eb; color:#fff; font-weight:700;" @onclick="NavigateToReviewDetail">
                    <i class="bi bi-file-earmark-check-fill"></i> Xem giải thích chi tiết
                </button>
                <button class="btn-action summary-btn" @onclick="NavigateToSummary">
                    <i class="bi bi-bar-chart-fill"></i> Tổng hợp kết quả
                </button>
                <button class="btn-action next-btn" @onclick="NavigateToNextSkill">
                    <i class="bi bi-arrow-right-circle-fill"></i> Phần thi tiếp theo
                </button>
                <button class="btn-action retake-btn" @onclick="RetakeExam">
                    <i class="bi bi-arrow-counterclockwise"></i> Làm lại
                </button>
                <button class="btn-action exit-btn" @onclick="ExitExam">
                    <i class="bi bi-x-lg"></i> Thoát
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="reading-topbar">
            <div class="topbar-left">
                <span class="exam-title-short">@exam.Title</span>
            </div>
            <div class="topbar-center">
                <div class="timer-box @(secondsLeft < 600 ? "timer-warning" : "")">
                    <span class="timer-icon">⏱</span>
                    <span class="timer-text">@TimerDisplay remaining</span>
                </div>
            </div>
            <div class="topbar-right">
                <button class="btn-exit-exam" @onclick="ExitExam">Exit test</button>
                <button class="btn-submit-exam" disabled="@isSubmitting" @onclick="SubmitExam">
                    @(isSubmitting ? "Đang chấm..." : "Nộp bài ➤")
                </button>
            </div>
        </div>
    }

    @* ── CHECKPOINT RESTORE BANNER ── *@
    @if (!isFinished && pendingCheckpoint != null)
    {
        <div class="checkpoint-banner">
            <div class="cb-left">
                <i class="bi bi-clock-history cb-icon"></i>
                <div class="cb-info">
                    <strong>Phát hiện bài làm dở:</strong> Lưu lúc @pendingCheckpoint.LastSavedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                    (Còn @(pendingCheckpoint.SecondsRemaining / 60) phút @(pendingCheckpoint.SecondsRemaining % 60) giây · Đã điền @pendingCheckpoint.AnsweredCount câu)
                </div>
            </div>
            <div class="cb-actions">
                <button class="btn-cb-restore" @onclick="RestoreCheckpoint">
                    <i class="bi bi-arrow-repeat"></i> Khôi phục bài làm dở
                </button>
                <button class="btn-cb-discard" @onclick="DiscardCheckpoint">
                    <i class="bi bi-trash3"></i> Làm bài mới
                </button>
            </div>
        </div>
    }

    @* ── PART TABS ── *@
    <div class="part-tabs-bar">
        @for (int i = 0; i < exam.Parts.Count; i++)
        {
            var idx  = i;
            var part = exam.Parts[i];
            int answered = AnsweredCount(part);
            <button class="part-tab-btn @(activePartIndex == idx ? "active" : "")"
                    @onclick="() => ChangePart(idx)">
                Part @part.PartNumber
                <span class="part-tab-score">@answered/@part.QuestionGroups.Sum(g => g.Questions.Count)</span>
            </button>
        }
        <div class="part-tabs-spacer"></div>
        <span class="total-progress">
            Tổng: @exam.Parts.Sum(p => AnsweredCount(p))/@exam.Parts.Sum(p => p.QuestionGroups.Sum(g => g.Questions.Count)) câu
        </span>
    </div>

    @* ── AUDIO PLAYER AND QUESTIONS LAYOUT ── *@
    <div class="listening-layout">
        
        <div class="custom-audio-player">
            @if (!string.IsNullOrEmpty(exam.AudioUrl))
            {
                <div id="yt-hidden-player" style="position:absolute; width:1px; height:1px; top:-9999px;"></div>
                
                <button class="player-btn" @onclick="TogglePlay">
                    @if(isPlaying)
                    {
                        <i class="bi bi-pause-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-play-fill"></i>
                    }
                </button>
                
                <div class="progress-container" @onclick="SeekAudio">
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill" style="width: @(ProgressPercent)%"></div>
                    </div>
                </div>
                
                <div class="time-display">
                    @FormatTime(currentTime) / @FormatTime(totalDuration)
                </div>
            }
            else
            {
                <div class="audio-placeholder">Không tìm thấy file nghe cho đề này.</div>
            }
        </div>

        <div class="questions-col listening-questions" id="questions-scroll">
            <div class="part-header-label">PART @activePart.PartNumber</div>
            <p class="part-time-note">
                Questions <strong>@qStart–@qEnd</strong>.
            </p>

            @foreach (var group in activePart.QuestionGroups)
            {
                <div class="q-group-container">
                    @if (!string.IsNullOrWhiteSpace(group.Instruction))
                    {
                        <div class="q-group-instruction">
                            @((MarkupString)group.Instruction.Replace("\n", "<br/>"))
                        </div>
                    }
                    
                    @if (group.GroupType == "HtmlBlock")
                    {
                        <div class="q-html-block">
                            @((MarkupString)group.GroupHtml)
                        </div>

                        @* Bảng đối chiếu đáp án chi tiết khi đã nộp bài *@
                        @if (isFinished && gradingResult != null)
                        {
                            <div class="listening-group-review">
                                <div class="review-group-title">📋 Đối chiếu đáp án phần này:</div>
                                <div class="review-chips-grid">
                                    @foreach (var q in group.Questions)
                                    {
                                        var qr = gradingResult.Questions.TryGetValue(q.Id, out var qRes) ? qRes : null;
                                        if (qr != null)
                                        {
                                            <div class="review-chip @(qr.IsCorrect ? "chip-correct" : qr.IsBlank ? "chip-blank" : "chip-wrong")">
                                                <div class="chip-header">
                                                    <span class="chip-num">Câu @(q.Id)</span>
                                                    <span class="chip-status-tag @(qr.IsCorrect ? "tag-correct" : qr.IsBlank ? "tag-blank" : "tag-wrong")">
                                                        @(qr.IsCorrect ? "✓ Đúng" : qr.IsBlank ? "⚪ Chưa làm" : "✕ Sai")
                                                    </span>
                                                </div>
                                                <div class="chip-student">Bạn: <strong>@(string.IsNullOrWhiteSpace(qr.StudentAnswer) ? "(trống)" : qr.StudentAnswer)</strong></div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var q in group.Questions)
                        {
                            bool isActive = q.Id == activeQuestionId;
                            var qr = (isFinished && gradingResult != null && gradingResult.Questions.TryGetValue(q.Id, out var qRes)) ? qRes : null;
                            var reviewClass = qr == null ? "" : (qr.IsCorrect ? "q-review-correct" : qr.IsBlank ? "q-review-blank" : "q-review-wrong");

                            <div class="question-block @(IsAnswered(q) ? "answered" : "") @(isActive ? "q-focused" : "") @reviewClass"
                                 id="q-block-@q.Id"
                                 @onclick="() => activeQuestionId = q.Id">

                                <div class="q-header-row">
                                    <div class="q-text">@((MarkupString)q.Text)</div>
                                    @if (qr != null)
                                    {
                                        <span class="q-badge @(qr.IsCorrect ? "badge-correct" : qr.IsBlank ? "badge-blank" : "badge-wrong")">
                                            @(qr.IsCorrect ? "✓ Đúng" : qr.IsBlank ? "⚪ Chưa làm" : "✕ Sai")
                                        </span>
                                    }
                                </div>

                                @if (q.Options.Count > 0)
                                {
                                    <ul class="q-option-list">
                                        @foreach (var opt in q.Options)
                                        {
                                            bool isOptSelected = q.SelectedOptionId == opt.Id;
                                            bool isOptCorrectAnswer = qr != null && (string.Equals(opt.Label, qr.CorrectAnswer, StringComparison.OrdinalIgnoreCase) || qr.AcceptedAnswers.Any(a => string.Equals(a, opt.Label, StringComparison.OrdinalIgnoreCase)));
                                            bool isOptWrongSelected = qr != null && !qr.IsCorrect && isOptSelected;

                                            <li class="q-option @(isOptSelected ? "selected" : "") @(isOptCorrectAnswer ? "opt-is-correct" : "") @(isOptWrongSelected ? "opt-is-wrong" : "")"
                                                @onclick="() => SelectOption(q, opt.Id)">
                                                <span class="opt-badge">@opt.Label</span>
                                                <span class="opt-body">@opt.Text</span>
                                                @if (isOptCorrectAnswer)
                                                {
                                                    <span class="opt-correct-tag">✓ Đáp án đúng</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (qr != null)
                                {
                                    <div class="q-answer-feedback @(qr.IsCorrect ? "fb-correct" : qr.IsBlank ? "fb-blank" : "fb-wrong")">
                                        <div class="fb-row">
                                            <span class="fb-label">Đáp án của bạn:</span>
                                            <span class="fb-val student">@(string.IsNullOrWhiteSpace(qr.StudentAnswer) ? "— (Bỏ trống)" : qr.StudentAnswer)</span>
                                        </div>
                                        @if (!qr.IsCorrect)
                                        {
                                            <div class="fb-row">
                                                <span class="fb-label">Đáp án chính xác:</span>
                                                <span class="fb-val correct">@qr.CorrectAnswer @(qr.AcceptedAnswers.Count > 1 ? $"(chấp nhận: {string.Join(" / ", qr.AcceptedAnswers)})" : "")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }

            @* ── NAVIGATION BUTTONS ── *@
            <div class="part-nav-buttons">
                @if (activePartIndex > 0)
                {
                    <button class="nav-part-btn prev" @onclick="() => ChangePart(activePartIndex - 1)">
                        ← Part @(exam.Parts[activePartIndex - 1].PartNumber)
                    </button>
                }
                @if (activePartIndex < exam.Parts.Count - 1)
                {
                    <button class="nav-part-btn next" @onclick="() => ChangePart(activePartIndex + 1)">
                        Part @(exam.Parts[activePartIndex + 1].PartNumber) →
                    </button>
                }
                else if (!isFinished)
                {
                    <button class="nav-part-btn submit" disabled="@isSubmitting" @onclick="SubmitExam">
                        @(isSubmitting ? "Đang chấm..." : "Nộp bài ✓")
                    </button>
                }
                else
                {
                    <button class="nav-part-btn summary-btn" @onclick="NavigateToSummary">
                        📊 Xem tổng hợp kết quả
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── BOTTOM: QUESTION NAVIGATOR ── *@
    <div class="q-navigator-bar">
        <div class="q-navigator-label">Part @activePart.PartNumber</div>
        <div class="q-navigator-nums">
            @foreach (var group in activePart.QuestionGroups)
            {
                @foreach (var q in group.Questions)
                {
                    var qr = (isFinished && gradingResult != null && gradingResult.Questions.TryGetValue(q.Id, out var qRes)) ? qRes : null;
                    var navStateClass = qr == null 
                        ? (IsAnswered(q) ? "nav-answered" : "") 
                        : (qr.IsCorrect ? "nav-correct" : qr.IsBlank ? "nav-blank" : "nav-wrong");

                    <button class="q-nav-num @navStateClass @(q.Id == activeQuestionId ? "nav-active" : "")"
                            @onclick="async () => { activeQuestionId = q.Id; await ScrollToQuestion(q.Id); }">
                        @q.Id
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "ExamUrl")]
    public string? QueryExamUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "AnswerUrl")]
    public string? QueryAnswerUrl { get; set; }

    [Parameter] 
    public string? ExamUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Session")]
    public string? TestSessionId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "CollectionName")]
    public string? QueryCollectionName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Title")]
    public string? QueryTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "MockTestId")]
    public int? QueryMockTestId { get; set; }

    private ExamData? exam;
    private bool isLoading = true;
    private int activePartIndex = 0;
    private int activeQuestionId = 0;

    // Timer: 40 minutes for listening
    private int secondsLeft = 40 * 60;
    private System.Threading.Timer? _timer;
    private DotNetObjectReference<IeltsListening>? _dotNetRef;
    private IDisposable? _navigationRegistration;
    private string? _sessionKey;
    private bool isFinished;
    private bool showReview = true;
    private bool timedOut;
    private bool isSubmitting;
    private GradingResult? gradingResult;
    private string? _examUrlLoaded;
    private string? _answerUrlLoaded;
    private string? _statusMessage;
    private ExamCheckpointDto? pendingCheckpoint;
    private int _autoSaveCounter = 0;

    private const string DefaultExamUrl = "sample-data/listening-test-1.json";

    // Player state
    private bool isPlaying = false;
    private double currentTime = 0;
    private double totalDuration = 1;

    private double ProgressPercent => totalDuration > 0 ? (currentTime / totalDuration) * 100 : 0;

    private string TimerDisplay
    {
        get
        {
            int m = secondsLeft / 60, s = secondsLeft % 60;
            return $"{m:D2}:{s:D2}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        
        string? actualUrl = ExamUrl;
        if (string.IsNullOrWhiteSpace(actualUrl)) actualUrl = QueryExamUrl;
        
        string url = string.IsNullOrWhiteSpace(actualUrl) ? DefaultExamUrl : Uri.UnescapeDataString(actualUrl);
        _examUrlLoaded = url;
        _answerUrlLoaded = string.IsNullOrWhiteSpace(QueryAnswerUrl) ? null : Uri.UnescapeDataString(QueryAnswerUrl);
        exam = await ExamService.LoadExamAsync(url);
        if (exam?.Parts?.Count > 0)
            activeQuestionId = exam.Parts[0].QuestionGroups.FirstOrDefault()?.Questions.FirstOrDefault()?.Id ?? 0;
        isLoading = false;

        _sessionKey = ExamSessionService.CreateStorageKey("listening", TestSessionId, url);
        var session = await ExamSession.StartAsync(_sessionKey, 40 * 60);
        secondsLeft = session.SecondsRemaining;
        isFinished = session.IsCompleted || session.IsExpired;
        timedOut = session.IsTimedOut || session.IsExpired;

        if (isFinished)
        {
            await LoadGradingResultOnRestoreAsync();
            return;
        }

        // Kiểm tra bài làm dở của tài khoản hiện tại
        var cp = await CheckpointService.GetCheckpointAsync("Listening", url, QueryMockTestId);
        if (cp != null && cp.AnsweredCount > 0)
        {
            pendingCheckpoint = cp;
        }

        _navigationRegistration = Navigation.RegisterLocationChangingHandler(ConfirmLeave);
        await ExamSession.SetUnloadWarningAsync(true);
        _timer = new System.Threading.Timer(_ => _ = UpdateTimerAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void RestoreCheckpoint()
    {
        if (pendingCheckpoint == null || exam == null) return;
        
        foreach (var part in exam.Parts)
        {
            foreach (var group in part.QuestionGroups)
            {
                foreach (var q in group.Questions)
                {
                    if (pendingCheckpoint.SelectedOptions.TryGetValue(q.Id, out var optId))
                    {
                        q.SelectedOptionId = optId;
                    }
                    if (pendingCheckpoint.FillAnswers.TryGetValue(q.Id, out var fill))
                    {
                        q.FillAnswer = fill;
                    }
                }
            }
        }

        if (pendingCheckpoint.SecondsRemaining > 0)
        {
            secondsLeft = pendingCheckpoint.SecondsRemaining;
        }

        if (pendingCheckpoint.ActivePartIndex >= 0 && pendingCheckpoint.ActivePartIndex < exam.Parts.Count)
        {
            ChangePart(pendingCheckpoint.ActivePartIndex);
        }

        pendingCheckpoint = null;
        StateHasChanged();
    }

    private async Task DiscardCheckpoint()
    {
        if (pendingCheckpoint != null)
        {
            await CheckpointService.ClearCheckpointAsync("Listening", _examUrlLoaded ?? "", QueryMockTestId);
            pendingCheckpoint = null;
            StateHasChanged();
        }
    }

    private async Task AutoSaveCheckpointAsync()
    {
        if (isFinished || exam == null || string.IsNullOrEmpty(_examUrlLoaded)) return;

        var cp = new ExamCheckpointDto
        {
            Skill = "Listening",
            ExamUrl = _examUrlLoaded,
            MockTestId = QueryMockTestId,
            CollectionName = QueryCollectionName,
            TestTitle = QueryTitle ?? exam.Title,
            SessionId = TestSessionId,
            SecondsRemaining = secondsLeft,
            TotalDurationSeconds = 40 * 60,
            ActivePartIndex = activePartIndex
        };

        foreach (var part in exam.Parts)
        {
            foreach (var group in part.QuestionGroups)
            {
                foreach (var q in group.Questions)
                {
                    if (q.SelectedOptionId.HasValue) cp.SelectedOptions[q.Id] = q.SelectedOptionId.Value;
                    if (!string.IsNullOrWhiteSpace(q.FillAnswer)) cp.FillAnswers[q.Id] = q.FillAnswer;
                }
            }
        }

        await CheckpointService.SaveCheckpointAsync(cp);
    }

    private async Task LoadGradingResultOnRestoreAsync()
    {
        try
        {
            var answerKey = !string.IsNullOrWhiteSpace(_answerUrlLoaded)
                ? await answerKeyService.LoadAsync(_answerUrlLoaded)
                : await answerKeyService.LoadFromExamUrlAsync(_examUrlLoaded ?? "");

            if (answerKey != null)
            {
                var studentAnswers = CollectStudentAnswers();
                gradingResult = AnswerKeyService.Grade(answerKey, studentAnswers);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Listening] Error restoring grading result: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isFinished)
            await ExamSession.LockTestContentAsync(".listening-layout");

        if (exam != null && !isLoading && !string.IsNullOrEmpty(exam.AudioUrl) && _dotNetRef == null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            // Extract Video ID
            string videoId = exam.AudioUrl.Split('/').Last().Split('?').First();
            await JS.InvokeVoidAsync("initYouTubePlayer", videoId, _dotNetRef);
            await JS.InvokeVoidAsync("bindListeningInputs", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnPlayerReady(double duration)
    {
        totalDuration = duration;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlayerStateChanged(bool playing)
    {
        isPlaying = playing;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlayerProgress(double time)
    {
        currentTime = time;
        StateHasChanged();
    }

    private async Task TogglePlay()
    {
        if (isPlaying)
            await JS.InvokeVoidAsync("pauseYouTube");
        else
            await JS.InvokeVoidAsync("playYouTube");
    }

    private async Task SeekAudio(MouseEventArgs e)
    {
    }

    private string FormatTime(double seconds)
    {
        int m = (int)(seconds / 60);
        int s = (int)(seconds % 60);
        return $"{m:D2}:{s:D2}";
    }

    [JSInvokable]
    public void OnHtmlInputChange(int questionId, string value)
    {
        if (exam == null || isFinished) return;
        var q = exam.Parts.SelectMany(p => p.QuestionGroups).SelectMany(g => g.Questions).FirstOrDefault(x => x.Id == questionId);
        if (q != null)
        {
            q.FillAnswer = value;
            _ = AutoSaveCheckpointAsync();
            StateHasChanged();
        }
    }

    private void ChangePart(int index)
    {
        activePartIndex = index;
        activeQuestionId = exam!.Parts[index].QuestionGroups.FirstOrDefault()?.Questions.FirstOrDefault()?.Id ?? 0;
    }

    private void SelectOption(QuestionData q, int optionId)
    {
        if (!isFinished)
        {
            q.SelectedOptionId = q.SelectedOptionId == optionId ? null : optionId;
            _ = AutoSaveCheckpointAsync();
        }
    }

    private bool IsAnswered(QuestionData q)
        => q.SelectedOptionId.HasValue || !string.IsNullOrEmpty(q.FillAnswer);

    private int AnsweredCount(ExamPart part)
        => part.QuestionGroups.Sum(g => g.Questions.Count(IsAnswered));

    private async Task ScrollToQuestion(int qId) 
    { 
        await Task.Delay(50);
        try 
        {
            await JS.InvokeVoidAsync("scrollToElementId", $"q-{qId}"); 
        } 
        catch (Exception ex) 
        {
            Console.WriteLine($"Lỗi JS Interop: {ex.Message}");
        }
    }

    private Task SubmitExam() => FinishExamAsync(false);

    private async Task UpdateTimerAsync()
    {
        if (isFinished || string.IsNullOrEmpty(_sessionKey)) return;
        var session = await ExamSession.GetAsync(_sessionKey);
        if (session == null) return;
        secondsLeft = session.SecondsRemaining;

        _autoSaveCounter++;
        if (_autoSaveCounter % 5 == 0)
        {
            _ = AutoSaveCheckpointAsync();
        }

        if (session.IsExpired) await InvokeAsync(() => FinishExamAsync(true));
        else await InvokeAsync(StateHasChanged);
    }

    private async Task FinishExamAsync(bool timeExpired)
    {
        if (isFinished || isSubmitting) return;
        isSubmitting = true;
        _statusMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            timedOut = timeExpired;
            _timer?.Dispose();
            if (!string.IsNullOrEmpty(_sessionKey)) await ExamSession.CompleteAsync(_sessionKey, timeExpired);
            await ExamSession.LockTestContentAsync(".listening-layout");
            await ExamSession.SetUnloadWarningAsync(false);
            await CheckpointService.ClearCheckpointAsync("Listening", _examUrlLoaded, QueryMockTestId);

            if (!string.IsNullOrEmpty(_examUrlLoaded))
            {
                var answerKey = !string.IsNullOrWhiteSpace(_answerUrlLoaded)
                    ? await answerKeyService.LoadAsync(_answerUrlLoaded)
                    : await answerKeyService.LoadFromExamUrlAsync(_examUrlLoaded);
                if (answerKey != null)
                {
                    var studentAnswers = CollectStudentAnswers();
                    gradingResult = AnswerKeyService.Grade(answerKey, studentAnswers);
                    isFinished = true;

                    var duration = Math.Max(40 * 60 - secondsLeft, 0);
                    var submission = new IeltsSubmissionRecord
                    {
                        Skill = "Listening",
                        ExamTitle = exam?.Title ?? QueryTitle ?? "IELTS Listening",
                        ExamUrl = _examUrlLoaded,
                        SessionId = TestSessionId,
                        MockTestId = QueryMockTestId,
                        CollectionName = QueryCollectionName,
                        TestTitle = QueryTitle,
                        AnswerUrl = _answerUrlLoaded,
                        TimedOut = timeExpired,
                        DurationSeconds = duration
                    };

                    await SubmissionService.SaveListeningSubmissionAsync(submission, gradingResult);
                }
                else
                {
                    isFinished = true;
                    _statusMessage = "Không tải được file đáp án Listening. Hãy kiểm tra link AnswerUrl trong admin.";
                }
            }
        }
        catch (Exception ex)
        {
            isFinished = true;
            _statusMessage = $"Lỗi khi nộp bài Listening: {ex.Message}";
            Console.WriteLine($"[Listening] Submit failed: {ex}");
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

