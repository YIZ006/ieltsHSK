        var extraColl = string.IsNullOrWhiteSpace(QueryCollectionName) ? "" : $"&CollectionName={Uri.EscapeDataString(QueryCollectionName)}";
        var extraTitle = string.IsNullOrWhiteSpace(QueryTitle) ? "" : $"&Title={Uri.EscapeDataString(QueryTitle)}";
        var extraMockId = QueryMockTestId.HasValue ? $"&MockTestId={QueryMockTestId.Value}" : "";
        Navigation.NavigateTo($"/ielts/listening/preview?ExamUrl={Uri.EscapeDataString(_examUrlLoaded ?? "")}{extraAnswer}{extraColl}{extraTitle}{extraMockId}&Session={newSession}", forceLoad: true);
    }

    private Dictionary<int, string> CollectStudentAnswers()
    {
        var result = new Dictionary<int, string>();
        if (exam == null) return result;
        int qNum = 1;
        foreach (var part in exam.Parts)
            foreach (var group in part.QuestionGroups)
                foreach (var q in group.Questions)
                {
                    var answer = q.FillAnswer?.Trim();
                    if (q.SelectedOptionId.HasValue)
                    {
                        var opt = q.Options?.FirstOrDefault(o => o.Id == q.SelectedOptionId);
                        answer = opt?.Label ?? q.SelectedOptionId.ToString();
                    }
                    result[qNum++] = answer ?? "";
                }
        return result;
    }

    private async ValueTask ConfirmLeave(LocationChangingContext context)
    {
        if (!isFinished && !await ExamSession.ConfirmLeaveAsync()) context.PreventNavigation();
    }

