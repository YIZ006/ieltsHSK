                </div>

                <div class="asset-card">
                    <div class="asset-top">
                        <span class="asset-name">🗣️ SPEAKING</span>
                        <span class="asset-signal breakout">BREAKOUT</span>
                    </div>
                    <div class="asset-value">Band @(summary.Speaking?.BandScore > 0 ? summary.Speaking.BandScore.ToString("0.0") : "—")</div>
                    <div class="asset-sub">Weight: 25% | Fluency & Lexical Analysis</div>
                </div>
            </div>
        </div>

        <!-- Global Action Bar -->
        <div class="summary-bottom-actions">
            <button class="btn-bottom back" @onclick="GoBackToTests">
                <i class="bi bi-grid-fill"></i> Quay về kho đề thi
            </button>
            <button class="btn-bottom retake-all" @onclick="RetakeFullExam">
                <i class="bi bi-arrow-repeat"></i> Làm lại toàn bộ đề thi mới
            </button>
        </div>
    }
</div>

@code {
    [Parameter][SupplyParameterFromQuery(Name = "CollectionName")] public string? QueryCollectionName { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "Title")] public string? QueryTitle { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "MockTestId")] public int? QueryMockTestId { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "Session")] public string? QuerySessionId { get; set; }

    private MockTestSummaryModel? summary;
    private MockTestDto? mockTest;
    private bool isLoading = true;

    private const double TargetBandScore = 7.0;

    private double GetTargetDelta() => (summary?.OverallBandScore ?? 0) - TargetBandScore;

    private static double GetChartY(double band) => 220 - ((Math.Clamp(band, 0, 9) / 9.0) * 180);

    private double GetSkillY(string skill)
    {
        double score = skill switch
        {
            "Listening" => summary?.Listening?.BandScore ?? 0,
            "Reading"   => summary?.Reading?.BandScore ?? 0,
            "Writing"   => summary?.Writing?.BandScore ?? 0,
            "Speaking"  => summary?.Speaking?.BandScore ?? 0,
            _ => 0
        };
        return GetChartY(score);
    }

    private string GetTrendPath()
    {
        double ly = GetSkillY("Listening");
        double ry = GetSkillY("Reading");
        double wy = GetSkillY("Writing");
        double sy = GetSkillY("Speaking");
        return $"M 120,{ly:0.0} C 210,{ly:0.0} 210,{ry:0.0} 300,{ry:0.0} C 390,{ry:0.0} 390,{wy:0.0} 480,{wy:0.0} C 570,{wy:0.0} 570,{sy:0.0} 660,{sy:0.0}";
    }

    private string GetAreaPath()
    {
        double ly = GetSkillY("Listening");
        double ry = GetSkillY("Reading");
        double wy = GetSkillY("Writing");
        double sy = GetSkillY("Speaking");
        return $"M 120,{ly:0.0} C 210,{ly:0.0} 210,{ry:0.0} 300,{ry:0.0} C 390,{ry:0.0} 390,{wy:0.0} 480,{wy:0.0} C 570,{wy:0.0} 570,{sy:0.0} 660,{sy:0.0} L 660,220 L 120,220 Z";
    }

    private int? _visibilityHookId;
    private DotNetObjectReference<IeltsMockTestSummary>? _dotNetRef;
    private DateTimeOffset _lastLoad = DateTimeOffset.MinValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                _visibilityHookId = await JS.InvokeAsync<int>("TabVisibility.register", _dotNetRef, nameof(OnTabVisibleAsync));
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[IeltsMockTestSummary] Tab visibility hook: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public async Task OnTabVisibleAsync()
    {
        if (DateTimeOffset.UtcNow - _lastLoad < TimeSpan.FromSeconds(2)) return;
        _lastLoad = DateTimeOffset.UtcNow;
        try
        {
            await LoadDataAsync(silent: true);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[IeltsMockTestSummary] Refresh on visible: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_visibilityHookId.HasValue)
        {
            try
            {
                await JS.InvokeVoidAsync("TabVisibility.unregister", _visibilityHookId.Value);
            }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }

    private async Task LoadDataAsync(bool silent = false)
    {
        if (!silent) isLoading = true;
        try
        {
            var allTests = await MockTestService.GetMockTestsAsync();
            mockTest = allTests.FirstOrDefault(t => 
                (QueryMockTestId.HasValue && t.Id == QueryMockTestId.Value) ||
                (!string.IsNullOrEmpty(QueryTitle) && string.Equals(t.Title, QueryTitle, StringComparison.OrdinalIgnoreCase))
            );

            summary = await SubmissionService.GetMockTestSummaryAsync(QueryCollectionName, QueryTitle, QuerySessionId, mockTest);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading summary: {ex.Message}");
        }
        finally
        {
            if (!silent) isLoading = false;
        }
    }

    private static double GetBarWidth(double score) => Math.Min(Math.Max((score / 9.0) * 100, 0), 100);

    private static string GetCefrLevel(double band) => band switch
    {
        >= 8.5 => "CEFR C2 (Mastery)",
        >= 7.0 => "CEFR C1 (Effective Operational Proficiency)",
        >= 5.5 => "CEFR B2 (Vantage)",
        >= 4.0 => "CEFR B1 (Threshold)",
        > 0   => "CEFR A2 (Waystage)",
        _     => "Chưa xếp hạng"
    };

    private static string GetBandDescription(double band) => band switch
    {
        >= 8.5 => "Khả năng sử dụng tiếng Anh hoàn toàn tự nhiên, lưu loát và chính xác trong mọi tình huống phức tạp.",
        >= 7.5 => "Có khả năng sử dụng ngôn ngữ tốt, hiểu được các lý lẽ phức tạp, đôi khi xảy ra một vài lỗi nhỏ không đáng kể.",
        >= 6.5 => "Nhìn chung nắm vững ngôn ngữ, có khả năng sử dụng và hiểu tốt ngữ cảnh phức tạp, thích hợp cho môi trường học thuật.",
        >= 5.5 => "Khả năng sử dụng ngôn ngữ trung bình, nắm được ý nghĩa tổng quát, có thể mắc lỗi trong các tình huống chuyên sâu.",
        >= 4.5 => "Khả năng hạn chế, phù hợp trong các tình huống giao tiếp quen thuộc hàng ngày.",
        > 0   => "Cần tiếp tục trau dồi thêm các kỹ năng cơ bản để cải thiện điểm số.",
        _     => "Hãy hoàn thành các bài thi để nhận báo cáo phân tích toàn diện."
    };

    private static string FormatDuration(int seconds)
    {
        int m = seconds / 60;
        int s = seconds % 60;
        return $"{m} phút {s} giây";
    }

    private void ReviewSkill(SkillSummaryItem? item)
    {
        if (item == null) return;
        var answerExtra = string.IsNullOrWhiteSpace(item.AnswerUrl) ? "" : $"&AnswerUrl={Uri.EscapeDataString(item.AnswerUrl)}";
        var mockId = mockTest != null ? $"&MockTestId={mockTest.Id}" : (QueryMockTestId.HasValue ? $"&MockTestId={QueryMockTestId.Value}" : "");
        Navigation.NavigateTo($"/ielts/review?Skill={Uri.EscapeDataString(item.Skill)}&ExamUrl={Uri.EscapeDataString(item.ExamUrl)}{answerExtra}&CollectionName={Uri.EscapeDataString(summary?.CollectionName ?? "")}&Title={Uri.EscapeDataString(summary?.TestTitle ?? "")}&Session={Uri.EscapeDataString(summary?.SessionId ?? "")}{mockId}");
    }

    private void ReviewWriting()
    {
        var url = mockTest?.WritingUrl ?? "sample-data/writing-test-1.json";
