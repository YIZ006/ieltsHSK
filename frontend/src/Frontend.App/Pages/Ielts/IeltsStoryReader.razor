    // Reader UI state
    private bool showBilingual = false;
    private int fontSize = 18; // default 18px for optimal reading
    private string currentTheme = "light"; // "light" | "paper" | "dark"
    private string fontFamily = "sans"; // "sans" | "serif"
    private bool isPlayingAudio = false;
    private int? activePlayingIndex = null;
    private double audioSpeed = 1.0;
    private int readingProgress = 0;
    private string? toastMessage = null;
    private CancellationTokenSource? toastCts = null;

    // Reading analytics
    private DateTime readingStartTime = DateTime.UtcNow;
    private int readingWpm = 0;

    // Active vocab popup & filters
    private StoryVocabulary? activeVocab;
    private bool isWordSaved = false;
    private bool isLookingUpWord = false;
    private string vocabFilter = "all";
    private HashSet<string> savedWordsSet = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<StoryVocabulary> FilteredVocabulary
    {
        get
        {
            if (story?.Vocabulary == null) return Enumerable.Empty<StoryVocabulary>();
            return vocabFilter switch
            {
                "verb" => story.Vocabulary.Where(v => v.Pos.Contains("verb", StringComparison.OrdinalIgnoreCase) || v.Pos.Contains("động", StringComparison.OrdinalIgnoreCase)),
                "noun" => story.Vocabulary.Where(v => v.Pos.Contains("noun", StringComparison.OrdinalIgnoreCase) || v.Pos.Contains("danh", StringComparison.OrdinalIgnoreCase)),
                "adj" => story.Vocabulary.Where(v => v.Pos.Contains("adj", StringComparison.OrdinalIgnoreCase) || v.Pos.Contains("tính", StringComparison.OrdinalIgnoreCase)),
                "other" => story.Vocabulary.Where(v => 
                    !v.Pos.Contains("verb", StringComparison.OrdinalIgnoreCase) && 
                    !v.Pos.Contains("động", StringComparison.OrdinalIgnoreCase) && 
                    !v.Pos.Contains("noun", StringComparison.OrdinalIgnoreCase) && 
                    !v.Pos.Contains("danh", StringComparison.OrdinalIgnoreCase) && 
                    !v.Pos.Contains("adj", StringComparison.OrdinalIgnoreCase) && 
                    !v.Pos.Contains("tính", StringComparison.OrdinalIgnoreCase)),
                _ => story.Vocabulary
            };
        }
    }

    private int CountByPos(string type)
    {
        if (story?.Vocabulary == null) return 0;
        return type switch
        {
            "verb" => story.Vocabulary.Count(v => v.Pos.Contains("verb", StringComparison.OrdinalIgnoreCase) || v.Pos.Contains("động", StringComparison.OrdinalIgnoreCase)),
            "noun" => story.Vocabulary.Count(v => v.Pos.Contains("noun", StringComparison.OrdinalIgnoreCase) || v.Pos.Contains("danh", StringComparison.OrdinalIgnoreCase)),
            "adj" => story.Vocabulary.Count(v => v.Pos.Contains("adj", StringComparison.OrdinalIgnoreCase) || v.Pos.Contains("tính", StringComparison.OrdinalIgnoreCase)),
            "other" => story.Vocabulary.Count(v => 
                !v.Pos.Contains("verb", StringComparison.OrdinalIgnoreCase) && 
                !v.Pos.Contains("động", StringComparison.OrdinalIgnoreCase) && 
                !v.Pos.Contains("noun", StringComparison.OrdinalIgnoreCase) && 
                !v.Pos.Contains("danh", StringComparison.OrdinalIgnoreCase) && 
                !v.Pos.Contains("adj", StringComparison.OrdinalIgnoreCase) && 
                !v.Pos.Contains("tính", StringComparison.OrdinalIgnoreCase)),
            _ => story.Vocabulary.Count
        };
    }

    private string GetPosBadgeClass(string pos)
    {
        if (pos.Contains("verb", StringComparison.OrdinalIgnoreCase) || pos.Contains("động", StringComparison.OrdinalIgnoreCase)) return "pos-verb";
        if (pos.Contains("noun", StringComparison.OrdinalIgnoreCase) || pos.Contains("danh", StringComparison.OrdinalIgnoreCase)) return "pos-noun";
        if (pos.Contains("adj", StringComparison.OrdinalIgnoreCase) || pos.Contains("tính", StringComparison.OrdinalIgnoreCase)) return "pos-adj";
        if (pos.Contains("adv", StringComparison.OrdinalIgnoreCase) || pos.Contains("phó", StringComparison.OrdinalIgnoreCase) || pos.Contains("trạng", StringComparison.OrdinalIgnoreCase)) return "pos-adv";
        return "pos-other";
    }

    private StoryVocabulary? FindTargetVocab(string cleanWord)
    {
        if (story?.Vocabulary == null || string.IsNullOrWhiteSpace(cleanWord)) return null;

        var exact = story.Vocabulary.FirstOrDefault(v => v.Word.Equals(cleanWord, StringComparison.OrdinalIgnoreCase));
        if (exact != null) return exact;

        var lower = cleanWord.ToLowerInvariant();
        foreach (var v in story.Vocabulary)
        {
            var baseWord = v.Word.ToLowerInvariant();
            if (lower == baseWord + "s" || 
                lower == baseWord + "es" || 
                (baseWord.EndsWith("y") && lower == baseWord[..^1] + "ies") ||
                lower == baseWord + "ed" || 
                (baseWord.EndsWith("e") && lower == baseWord + "d") ||
                lower == baseWord + "ing" ||
                (baseWord.EndsWith("e") && lower == baseWord[..^1] + "ing"))
            {
                return v;
            }
        }
        return null;
    }

    private bool IsTfngQuestion(StoryQuestion q)
    {
        if (q.Options == null || q.Options.Count == 0) return false;
        if (q.Options.Count == 3)
        {
            return q.Options.Any(o => o.Equals("TRUE", StringComparison.OrdinalIgnoreCase)) &&
                   q.Options.Any(o => o.Equals("FALSE", StringComparison.OrdinalIgnoreCase));
        }
        if (q.Options.Count == 2)
        {
            return q.Options.Any(o => o.Equals("TRUE", StringComparison.OrdinalIgnoreCase)) &&
                   q.Options.Any(o => o.Equals("FALSE", StringComparison.OrdinalIgnoreCase));
        }
        return false;
    }

    private string GetTfngColorClass(string optionText)
    {
        if (optionText.Equals("TRUE", StringComparison.OrdinalIgnoreCase)) return "tfng-true";
        if (optionText.Equals("FALSE", StringComparison.OrdinalIgnoreCase)) return "tfng-false";
        return "tfng-notgiven";
    }

    private string GetCleanQuestionText(string raw, bool isTfng)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        if (isTfng)
        {
            var match = Regex.Match(raw, "\"([^\"]+)\"");
            if (match.Success)
            {
                return match.Groups[1].Value.Trim();
            }
            string cleaned = Regex.Replace(
                raw,
                @"^Do the following statement[s]? agree with the information given in the passage\?\s*",
                "",
                RegexOptions.IgnoreCase
            );
            cleaned = cleaned.Trim(' ', '"', '\n', '\r');
            return string.IsNullOrEmpty(cleaned) ? raw : cleaned;
        }
        return raw.Trim();
    }

