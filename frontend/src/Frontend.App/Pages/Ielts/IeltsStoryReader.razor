    private async Task OpenVocabPopup(StoryVocabulary vocab)
    {
        activeVocab = vocab;
        await CheckIfWordIsSaved(vocab.Word);
    }

    private async Task LocateVocabInPassage(StoryVocabulary v)
    {
        if (story == null || story.Paragraphs.Count == 0) return;

        // Close popup if open so user can see passage clearly
        activeVocab = null;

        int targetPara = -1;
        var cleanTarget = v.Word.Trim();

        for (int i = 0; i < story.Paragraphs.Count; i++)
        {
            if (story.Paragraphs[i].En.Contains(cleanTarget, StringComparison.OrdinalIgnoreCase))
            {
                targetPara = i;
                break;
            }
        }

        // Fallback: check first word of phrase
        if (targetPara == -1 && cleanTarget.Contains(' '))
        {
            var firstWord = cleanTarget.Split(' ')[0];
            for (int i = 0; i < story.Paragraphs.Count; i++)
            {
                if (story.Paragraphs[i].En.Contains(firstWord, StringComparison.OrdinalIgnoreCase))
                {
                    targetPara = i;
                    break;
                }
            }
        }

        if (targetPara != -1)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("locateAndHighlightParagraph", targetPara);
                await ShowToast($"📍 Đã định vị từ \"{v.Word}\" ở Đoạn {targetPara + 1}!");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error locating paragraph: {ex.Message}");
            }
        }
        else
        {
            await ShowToast($"Từ \"{v.Word}\" xuất hiện trong bài đọc.");
        }
    }

    private async Task LookupAnyWord(string word)
    {
        var clean = word.Trim(',', '.', '!', '?', '"', '“', '”', ':', ';', '(', ')', '-');
        if (string.IsNullOrWhiteSpace(clean)) return;

        // If it matches a target vocab, show the rich target vocab
        var match = FindTargetVocab(clean);
        if (match != null)
        {
            isLookingUpWord = false;
            await OpenVocabPopup(match);
            _ = SpeakWord(match.Word);
            return;
        }

        isLookingUpWord = true;
        activeVocab = new StoryVocabulary
        {
            Word = clean,
            Pos = "Từ vựng",
            Phonetic = "",
            Meaning = "Đang tra nghĩa từ điển...",
            Example = story != null ? $"Trích trong bài đọc: {story.Title}" : ""
        };
        await CheckIfWordIsSaved(clean);
        _ = SpeakWord(clean);

        try
        {
            var dictResult = await StoryService.LookupWordAsync(clean);
            if (dictResult != null && activeVocab != null && activeVocab.Word.Equals(clean, StringComparison.OrdinalIgnoreCase))
            {
                activeVocab = dictResult;
                if (string.IsNullOrWhiteSpace(activeVocab.Example) && story != null)
                {
                    activeVocab.Example = $"Trích trong bài đọc: {story.Title}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error looking up word {clean}: {ex.Message}");
        }
        finally
        {
            isLookingUpWord = false;
            StateHasChanged();
        }
    }

    private void CloseVocabPopup()
