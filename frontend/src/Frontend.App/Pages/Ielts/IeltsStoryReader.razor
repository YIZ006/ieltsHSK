@page "/ielts/doc-truyen/{Slug}"
@layout Frontend.App.Layout.IeltsLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using System.Text.Json
@using System.Text.RegularExpressions
@implements IDisposable
@inject StoryService StoryService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(story?.Title ?? "Đang tải truyện...") - IELTS Đọc Truyện</PageTitle>

@if (isLoading)
{
    <div class="reader-loading">
        <div class="custom-spinner"></div>
        <p class="mt-3">Đang mở truyện...</p>
    </div>
}
else if (story == null)
{
    <div class="reader-error">
        <div class="custom-alert alert-error text-center">
            <h3>Không tìm thấy truyện</h3>
            <p>Truyện này không tồn tại hoặc đã được gỡ xuống.</p>
            <a href="/ielts/doc-truyen" class="btn btn-primary-outline mt-2">Về danh sách truyện</a>
        </div>
    </div>
}
else
{
    <div class="story-reader-wrapper theme-@currentTheme font-@fontFamily">
        <!-- Top Sticky Control Bar -->
        <div class="reader-topbar">
            <div class="topbar-left">
                <a href="/ielts/doc-truyen" class="btn-back">
                    <i class="bi bi-arrow-left"></i> <span>Kho truyện</span>
                </a>
                <span class="topbar-divider">|</span>
                <span class="badge-level level-@story.Level.ToLower()">@story.Level</span>
                <span class="story-category-tag">@story.Category</span>
            </div>

            <div class="topbar-controls">
                <!-- Audio Speech Narration -->
                <div class="speech-controls">
                    <button class="ctrl-btn btn-audio @(isPlayingAudio ? "active" : "")" @onclick="TogglePlayStory" title="Đọc toàn bài">
                        <i class="bi @(isPlayingAudio ? "bi-stop-fill" : "bi-volume-up-fill")"></i>
                        <span>@(isPlayingAudio ? "Dừng đọc" : "Nghe đọc")</span>
                    </button>
                    <select class="speed-select" @bind="audioSpeed" title="Tốc độ đọc">
                        <option value="0.8">0.8x</option>
                        <option value="1.0">1.0x</option>
                        <option value="1.2">1.2x</option>
                    </select>
                </div>

                <span class="topbar-divider">|</span>

                <!-- Bilingual Translation Toggle -->
                <button class="ctrl-btn btn-bilingual @(showBilingual ? "active" : "")" @onclick="ToggleBilingual" title="Bật/tắt dịch song ngữ">
                    <i class="bi bi-translate"></i>
                    <span>Song ngữ</span>
                </button>

                <!-- Font Family Toggle -->
                <button class="ctrl-btn-icon btn-font-family" @onclick="ToggleFontFamily" title="Đổi kiểu font (Sans / Serif)">
                    @(fontFamily == "sans" ? "Aa" : "𝒯")
                </button>

                <!-- Font Size -->
                <div class="font-size-group">
                    <button class="ctrl-btn-icon" @onclick="DecreaseFontSize" title="Giảm cỡ chữ">A-</button>
                    <button class="ctrl-btn-icon" @onclick="IncreaseFontSize" title="Tăng cỡ chữ">A+</button>
                </div>

                <!-- Theme Switcher -->
                <div class="theme-switcher">
                    <button class="theme-dot theme-light @(currentTheme == "light" ? "active" : "")" @onclick='() => ChangeTheme("light")' title="Giao diện Sáng"></button>
                    <button class="theme-dot theme-paper @(currentTheme == "paper" ? "active" : "")" @onclick='() => ChangeTheme("paper")' title="Giao diện Giấy đọc"></button>
                    <button class="theme-dot theme-dark @(currentTheme == "dark" ? "active" : "")" @onclick='() => ChangeTheme("dark")' title="Giao diện Ban đêm"></button>
                </div>
            </div>
        </div>

        <!-- Sticky Reading Progress Bar -->
        <div class="reading-progress-track">
            <div class="reading-progress-bar" style="width: @(readingProgress)%;"></div>
        </div>

        <!-- Toast Notification for Saved Words -->
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="story-toast-notification">
                <i class="bi bi-check-circle-fill text-success"></i>
                <span>@toastMessage</span>
            </div>
        }

        <!-- IELTS Split Reading View Container (Left: Passage, Right: Questions) -->
        <div class="ielts-split-view" style="font-size: @(fontSize)px;">
            <!-- LEFT PANE: Reading Passage (Independent Scroll) -->
            <section class="ielts-passage-pane">
                <!-- Story Header -->
                <header class="story-header">
                    <div class="story-meta-line">
                        <span class="meta-badge band-badge"><i class="bi bi-award-fill"></i> Band @story.IeltsBand</span>
                        <span class="meta-badge"><i class="bi bi-file-earmark-text"></i> @story.WordCount từ</span>
                        <span class="meta-badge"><i class="bi bi-clock"></i> ~@story.EstimatedMinutes phút</span>
                        <span class="meta-badge"><i class="bi bi-eye"></i> @story.ViewsCount lượt</span>
                        @if (readingWpm > 0)
                        {
                            <span class="meta-badge wpm-badge"><i class="bi bi-speedometer2"></i> ~@readingWpm WPM</span>
                        }
                    </div>
                    <h1 class="story-main-title">@story.Title</h1>
                    @if (!string.IsNullOrEmpty(story.Summary))
                    {
                        <div class="story-summary-box">
                            <i class="bi bi-quote summary-quote-icon"></i>
                            <p class="story-lead-summary">@story.Summary</p>
                        </div>
                    }

                    @if (showGuideTip)
                    {
                        <div class="reading-guide-pill">
                            <div class="guide-pill-left">
                                <span class="guide-pill-icon"><i class="bi bi-lightbulb-fill"></i></span>
                                <span class="guide-pill-text">Chạm từ <span class="tip-highlight">màu vàng</span> để xem Paraphrase & Collocation. Chạm từ bất kỳ để tra nhanh. Bật <b>Song ngữ</b> ở trên để đối chiếu bản dịch.</span>
                            </div>
                            <button type="button" class="btn-dismiss-tip" @onclick="() => showGuideTip = false" title="Ẩn mẹo này">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }
                </header>

                <!-- Story Body Paragraphs -->
                <article class="story-article">
                    @for (int pIdx = 0; pIdx < story.Paragraphs.Count; pIdx++)
                    {
                        var paraIndex = pIdx;
                        var para = story.Paragraphs[paraIndex];
                        bool isPlayingThis = activePlayingIndex == paraIndex;
                        char paraLetter = (char)('A' + paraIndex);
                        <div class="paragraph-block @(isPlayingThis ? "is-active-reading" : "")" id="para-@paraIndex">
                            <div class="paragraph-top-bar">
                                <span class="para-letter-tag" title="Đoạn @paraLetter">@paraLetter</span>
                                <button class="btn-read-para @(isPlayingThis ? "playing" : "")" 
                                        @onclick="() => ToggleSpeakSentence(paraIndex, para.En)" 
                                        title="@(isPlayingThis ? "Dừng đọc đoạn này" : "Nghe phát âm đoạn này")">
                                    <i class="bi @(isPlayingThis ? "bi-stop-circle-fill text-danger" : "bi-volume-up")"></i>
                                    <span class="btn-para-text">@(isPlayingThis ? "Dừng" : "Nghe")</span>
                                    @if (isPlayingThis)
                                    {
                                        <span class="soundwave-anim">
                                            <span></span><span></span><span></span>
                                        </span>
                                    }
                                </button>
                            </div>
                            <div class="paragraph-en">
                                @RenderParagraphEn(paraIndex, para.En)
                            </div>

                            @if (showBilingual && !string.IsNullOrEmpty(para.Vi))
                            {
                                <div class="paragraph-vi">
                                    <i class="bi bi-translate text-primary me-1"></i> @para.Vi
                                </div>
                            }
                        </div>
                    }
                </article>
            </section>

            <!-- CENTER SPLIT DIVIDER -->
            <div class="ielts-split-divider">
                <div class="divider-handle"></div>
            </div>

            <!-- RIGHT PANE: IELTS Reading Questions (Independent Scroll) -->
            <section class="ielts-questions-pane">
                <div class="questions-pane-header">
                    <div class="header-badge-row">
                        <span class="reading-exam-tag"><i class="bi bi-mortarboard-fill"></i> READING TEST</span>
                        <span class="questions-total-pill">@(story.Questions?.Count ?? 0) CÂU HỎI</span>
                    </div>
                    <h2 class="pane-title">IELTS Reading Comprehension</h2>
                    <p class="pane-subtitle">Cuộn bên phải để làm bài. Bài đọc bên trái được cố định giúp bạn đối chiếu bằng chứng.</p>
                </div>

                @if (story.Questions != null && story.Questions.Count > 0)
                {
                    var tfngQuestions = story.Questions.Where(q => IsTfngQuestion(q)).ToList();
                    var mcQuestions = story.Questions.Where(q => !IsTfngQuestion(q)).ToList();

                    <div class="quiz-container">
                        @if (tfngQuestions.Count > 0)
                        {
                            <div class="ielts-group-section">
                                <div class="ielts-group-banner">
                                    <div class="group-banner-top">
                                        <div class="group-banner-tag">
                                            <span class="part-pill">Part 1</span>
                                            <span class="range-pill">Questions 1–@tfngQuestions.Count</span>
                                        </div>
                                        <span class="type-pill tfng"><i class="bi bi-patch-question-fill"></i> TRUE / FALSE / NOT GIVEN</span>
                                    </div>
                                    <div class="group-instruction-box">
                                        <p class="instruction-main">
                                            <i class="bi bi-info-circle-fill text-primary me-1"></i>
                                            Do the following statements agree with the information given in the Reading Passage?
                                        </p>
                                        <div class="instruction-rules-grid">
                                            <div class="rule-chip"><strong class="chip-true">TRUE</strong><span>nếu thông tin đúng với bài đọc</span></div>
                                            <div class="rule-chip"><strong class="chip-false">FALSE</strong><span>nếu thông tin trái ngược với bài đọc</span></div>
                                            <div class="rule-chip"><strong class="chip-ng">NOT GIVEN</strong><span>nếu bài đọc không có thông tin</span></div>
                                        </div>
                                    </div>
                                </div>

                                @for (int i = 0; i < tfngQuestions.Count; i++)
                                {
                                    var qIndex = i;
                                    var question = tfngQuestions[i];
                                    bool isGraded = quizResult != null;
                                    bool isCorrect = isGraded && quizResult!.AnswerCorrectness.Count > qIndex && quizResult.AnswerCorrectness[qIndex];

                                    <div class="quiz-card @(isGraded ? (isCorrect ? "quiz-correct" : "quiz-wrong") : "")">
                                        <div class="quiz-card-head">
                                            <span class="quiz-qnum">@(qIndex + 1)</span>
                                            <div class="quiz-statement-text">
                                                @GetCleanQuestionText(question.Question, true)
                                            </div>
                                        </div>

                                        <div class="tfng-button-group">
                                            @for (int oIdx = 0; oIdx < question.Options.Count; oIdx++)
                                            {
                                                var optIndex = oIdx;
                                                var optionText = question.Options[optIndex];
                                                bool isSelected = selectedAnswers.ContainsKey(qIndex) && selectedAnswers[qIndex] == optIndex;
                                                bool isOptionCorrect = isGraded && question.CorrectIndex == optIndex;

                                                <button type="button" 
                                                        class="tfng-chip @GetTfngColorClass(optionText) @(isSelected ? "selected" : "") @(isGraded && isOptionCorrect ? "opt-correct" : "") @(isGraded && isSelected && !isOptionCorrect ? "opt-wrong" : "")"
                                                        @onclick="() => SelectOption(qIndex, optIndex)">
                                                    @if (optionText.Equals("TRUE", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-check-lg chip-icon"></i>
                                                    }
                                                    else if (optionText.Equals("FALSE", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <i class="bi bi-x-lg chip-icon"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-question-lg chip-icon"></i>
                                                    }
                                                    <span class="chip-text">@optionText</span>
                                                </button>
                                            }
                                        </div>

                                        @if (isGraded && !string.IsNullOrEmpty(question.Explanation))
                                        {
                                            <div class="quiz-explanation">
                                                <div class="expl-head"><i class="bi bi-lightbulb-fill"></i> <strong>Giải thích chi tiết:</strong></div>
                                                <div class="expl-body">@question.Explanation</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (mcQuestions.Count > 0)
                        {
                            int startMcIndex = tfngQuestions.Count;
                            <div class="ielts-group-section mt-4">
                                <div class="ielts-group-banner mc-banner">
                                    <div class="group-banner-top">
                                        <div class="group-banner-tag">
                                            <span class="part-pill mc">Part 2</span>
                                            <span class="range-pill">Questions @(startMcIndex + 1)–@story.Questions.Count</span>
                                        </div>
                                        <span class="type-pill mc"><i class="bi bi-list-check"></i> MULTIPLE CHOICE</span>
                                    </div>
                                    <div class="group-instruction-box">
                                        <p class="instruction-main">
                                            <i class="bi bi-check2-square text-primary me-1"></i>
                                            Choose the correct letter, <strong>A</strong>, <strong>B</strong>, <strong>C</strong>, or <strong>D</strong>.
                                        </p>
                                    </div>
                                </div>

                                @for (int j = 0; j < mcQuestions.Count; j++)
                                {
                                    var qIndex = startMcIndex + j;
                                    var question = mcQuestions[j];
                                    bool isGraded = quizResult != null;
                                    bool isCorrect = isGraded && quizResult!.AnswerCorrectness.Count > qIndex && quizResult.AnswerCorrectness[qIndex];

                                    <div class="quiz-card @(isGraded ? (isCorrect ? "quiz-correct" : "quiz-wrong") : "")">
                                        <div class="quiz-card-head">
                                            <span class="quiz-qnum mc-qnum">@(qIndex + 1)</span>
                                            <div class="quiz-statement-text mc-text">
                                                @GetCleanQuestionText(question.Question, false)
                                            </div>
                                        </div>

                                        <div class="quiz-options">
                                            @for (int oIdx = 0; oIdx < question.Options.Count; oIdx++)
                                            {
                                                var optIndex = oIdx;
                                                var optionText = question.Options[optIndex];
                                                bool isSelected = selectedAnswers.ContainsKey(qIndex) && selectedAnswers[qIndex] == optIndex;
                                                bool isOptionCorrect = isGraded && question.CorrectIndex == optIndex;

                                                <div class="quiz-option @(isSelected ? "selected" : "") @(isGraded && isOptionCorrect ? "opt-correct" : "") @(isGraded && isSelected && !isOptionCorrect ? "opt-wrong" : "")"
                                                     @onclick="() => SelectOption(qIndex, optIndex)">
                                                    <span class="opt-indicator">@((char)('A' + optIndex))</span>
                                                    <span class="opt-text">@optionText</span>
                                                    @if (isGraded && isOptionCorrect)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success ms-auto"></i>
                                                    }
                                                    else if (isGraded && isSelected && !isOptionCorrect)
                                                    {
                                                        <i class="bi bi-x-circle-fill text-danger ms-auto"></i>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @if (isGraded && !string.IsNullOrEmpty(question.Explanation))
                                        {
                                            <div class="quiz-explanation">
                                                <div class="expl-head"><i class="bi bi-lightbulb-fill"></i> <strong>Giải thích chi tiết:</strong></div>
                                                <div class="expl-body">@question.Explanation</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="quiz-actions-bar">
                            @if (quizResult == null)
                            {
                                <button class="btn-submit-quiz" @onclick="SubmitQuiz" disabled="@isSubmittingQuiz">
                                    @if (isSubmittingQuiz)
                                    {
                                        <span class="mini-spinner"></span>
                                        <span>Đang chấm điểm...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send-check-fill"></i>
                                        <span>Nộp bài & Chấm điểm</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <div class="quiz-result-summary">
                                    <div class="score-circle">
                                        <span class="score-num">@quizResult.CorrectCount/@quizResult.TotalQuestions</span>
                                        <span class="score-label">Đúng</span>
                                    </div>
                                    <div class="score-details">
                                        <h4>@(quizResult.ScorePercentage >= 80 ? "Xuất sắc! 🎉" : (quizResult.ScorePercentage >= 50 ? "Khá tốt! 👍" : "Cần cố gắng thêm! 💪"))</h4>
                                        <p>Độ chính xác: <b>@quizResult.ScorePercentage%</b> (@quizResult.CorrectCount / @quizResult.TotalQuestions câu đúng).</p>
                                    </div>
                                    <button class="btn btn-secondary-outline ms-auto" @onclick="RetryQuiz">
                                        <i class="bi bi-arrow-repeat"></i> Làm lại
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>

        <!-- Floating / Active Vocabulary Tooltip Modal -->
        @if (activeVocab != null)
        {
            <div class="vocab-popup-overlay" @onclick="CloseVocabPopup">
                <div class="vocab-popup-card" @onclick:stopPropagation="true">
                    <div class="vocab-popup-header">
                        <div class="vocab-word-info">
                            <div class="vocab-word-row">
                                <span class="vocab-word">@activeVocab.Word</span>
                                @if (!string.IsNullOrEmpty(activeVocab.Level))
                                {
                                    <span class="vocab-badge-band">@activeVocab.Level</span>
                                }
                            </div>
                            <div class="vocab-meta-sub">
                                @if (!string.IsNullOrEmpty(activeVocab.Pos))
                                {
                                    <span class="vocab-pos @GetPosBadgeClass(activeVocab.Pos)">@activeVocab.Pos</span>
                                }
                                @if (!string.IsNullOrEmpty(activeVocab.Phonetic))
                                {
                                    <span class="vocab-phonetic">@activeVocab.Phonetic</span>
                                }
                            </div>
                        </div>
                        <div class="vocab-popup-actions">
                            <button class="btn-audio-speak" @onclick="() => SpeakWord(activeVocab.Word)" title="Phát âm từ vựng">
                                <i class="bi bi-volume-up-fill"></i>
                            </button>
                            <button class="btn-close-popup" @onclick="CloseVocabPopup">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="vocab-meaning-box">
                        <label class="vocab-label">Nghĩa theo ngữ cảnh:</label>
                        @if (isLookingUpWord)
                        {
                            <div class="dict-lookup-loading">
                                <span class="mini-spinner"></span>
                                <span>Đang tra nghĩa từ điển...</span>
                            </div>
                        }
                        else
                        {
                            <p class="vocab-meaning">@activeVocab.Meaning</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(activeVocab.Synonyms))
                    {
                        <div class="vocab-synonyms-box">
                            <label class="vocab-label"><i class="bi bi-arrow-repeat text-warning"></i> IELTS Paraphrase / Từ đồng nghĩa:</label>
                            <p class="vocab-synonyms-text">@activeVocab.Synonyms</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(activeVocab.ContextNote))
                    {
                        <div class="vocab-context-box">
                            <label class="vocab-label"><i class="bi bi-pin-angle-fill text-primary"></i> Gợi ý ngữ cảnh trong bài:</label>
                            <p class="vocab-context-text">@activeVocab.ContextNote</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(activeVocab.Example))
                    {
                        <div class="vocab-example-box">
                            <label class="vocab-label">Ví dụ / Câu trích dẫn:</label>
                            <p class="vocab-example">@activeVocab.Example</p>
                        </div>
                    }

                    <div class="vocab-popup-footer">
                        <button type="button" class="btn-locate-passage" @onclick="() => LocateVocabInPassage(activeVocab)" title="Cuộn tới đoạn văn chứa từ này trong bài đọc">
                            <i class="bi bi-geo-alt-fill text-primary"></i> <span>Xem trong bài đọc</span>
                        </button>
                        <button class="btn-save-vocab @(isWordSaved ? "saved" : "")" @onclick="ToggleSaveWord">
                            <i class="bi @(isWordSaved ? "bi-bookmark-check-fill text-primary" : "bi-bookmark")"></i>
                            <span>@(isWordSaved ? "Đã lưu" : "Lưu từ")</span>
                        </button>
                        <a href="https://dictionary.cambridge.org/dictionary/english/@activeVocab.Word" 
                           target="_blank" 
                           class="btn-cambridge-link"
                           title="Mở từ điển Cambridge chính thức">
                            <i class="bi bi-box-arrow-up-right"></i> Cambridge
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- BOTTOM FULL-WIDTH VOCABULARY SECTION -->
        @if (story.Vocabulary != null && story.Vocabulary.Count > 0)
        {
            <div class="ielts-bottom-vocab-section">
                <div class="target-vocab-recap">
                    <div class="recap-header">
                        <div class="recap-header-text">
                            <h3><i class="bi bi-journal-bookmark-fill text-primary"></i> Từ vựng trọng tâm trong bài (@story.Vocabulary.Count từ)</h3>
                            <p>Từ vựng & cụm từ học thuật B2–C1 phục vụ trực tiếp cho việc đọc hiểu và giải đề thi IELTS. Bấm vào nút vị trí để cuộn tới đoạn văn tương ứng.</p>
                        </div>
                    </div>

                    <!-- Filter Bar -->
                    <div class="recap-filter-bar">
                        <button type="button" class="recap-filter-chip @(vocabFilter == "all" ? "active" : "")" @onclick='() => vocabFilter = "all"'>
                            Tất cả (@story.Vocabulary.Count)
                        </button>
                        @if (CountByPos("verb") > 0)
                        {
                            <button type="button" class="recap-filter-chip @(vocabFilter == "verb" ? "active" : "")" @onclick='() => vocabFilter = "verb"'>
                                <i class="bi bi-lightning-charge"></i> Động từ (@CountByPos("verb"))
                            </button>
                        }
                        @if (CountByPos("noun") > 0)
                        {
                            <button type="button" class="recap-filter-chip @(vocabFilter == "noun" ? "active" : "")" @onclick='() => vocabFilter = "noun"'>
                                <i class="bi bi-box-seam"></i> Danh từ / Cụm từ (@CountByPos("noun"))
                            </button>
                        }
                        @if (CountByPos("adj") > 0)
                        {
                            <button type="button" class="recap-filter-chip @(vocabFilter == "adj" ? "active" : "")" @onclick='() => vocabFilter = "adj"'>
                                <i class="bi bi-palette"></i> Tính từ (@CountByPos("adj"))
                            </button>
                        }
                        @if (CountByPos("other") > 0)
                        {
                            <button type="button" class="recap-filter-chip @(vocabFilter == "other" ? "active" : "")" @onclick='() => vocabFilter = "other"'>
                                Khác (@CountByPos("other"))
                            </button>
                        }
                    </div>

                    <div class="recap-vocab-grid">
                        @foreach (var v in FilteredVocabulary)
                        {
                            <div class="recap-vocab-item" @onclick="() => OpenVocabPopup(v)">
                                <div class="recap-vocab-header">
                                    <div class="recap-word-group">
                                        <span class="recap-word">@v.Word</span>
                                        @if (!string.IsNullOrEmpty(v.Level))
                                        {
                                            <span class="vocab-badge-band">@v.Level</span>
                                        }
                                    </div>
                                    <div class="recap-actions">
                                        <button type="button" class="recap-icon-btn locate-btn" title="Xem vị trí trong bài đọc" @onclick:stopPropagation="true" @onclick="() => LocateVocabInPassage(v)">
                                            <i class="bi bi-geo-alt-fill text-primary"></i>
                                        </button>
                                        <button type="button" class="recap-icon-btn speak-btn" title="Nghe phát âm" @onclick:stopPropagation="true" @onclick="() => SpeakWord(v.Word)">
                                            <i class="bi bi-volume-up-fill"></i>
                                        </button>
                                        <button type="button" class="recap-icon-btn save-btn @(savedWordsSet.Contains(v.Word) ? "is-saved" : "")" title="@(savedWordsSet.Contains(v.Word) ? "Đã lưu trong Sổ từ" : "Lưu vào Sổ từ vựng")" @onclick:stopPropagation="true" @onclick="() => ToggleSaveWordDirect(v)">
                                            <i class="bi @(savedWordsSet.Contains(v.Word) ? "bi-bookmark-check-fill text-primary" : "bi-bookmark")"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="recap-meta-row">
                                    <span class="recap-pos @GetPosBadgeClass(v.Pos)">@v.Pos</span>
                                    @if (!string.IsNullOrWhiteSpace(v.Phonetic))
                                    {
                                        <span class="recap-phonetic">@v.Phonetic</span>
                                    }
                                </div>
                                <div class="recap-meaning">@v.Meaning</div>
                                @if (!string.IsNullOrWhiteSpace(v.Synonyms))
                                {
                                    <div class="recap-synonyms">
                                        <i class="bi bi-arrow-repeat text-warning"></i> <span><b>Paraphrase:</b> @v.Synonyms</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(v.Example))
                                {
                                    <div class="recap-example" title="Ví dụ ngữ cảnh">
                                        <i class="bi bi-chat-quote"></i> @v.Example
                                    </div>
                                }
                                @if (v.Collocations != null && v.Collocations.Count > 0)
                                {
                                    <div class="recap-collocations">
                                        <i class="bi bi-link-45deg"></i> @string.Join(" • ", v.Collocations.Take(2))
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private StoryModel? story;
