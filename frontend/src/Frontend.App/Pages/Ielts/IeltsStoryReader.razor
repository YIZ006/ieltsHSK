    private void SelectOption(int questionIndex, int optionIndex)
    {
        if (quizResult != null) return;
        selectedAnswers[questionIndex] = optionIndex;
    }

    private async Task SubmitQuiz()
    {
        if (story == null || story.Questions.Count == 0) return;

        isSubmittingQuiz = true;
        var answersList = new List<int>();
        for (int i = 0; i < story.Questions.Count; i++)
        {
            answersList.Add(selectedAnswers.TryGetValue(i, out int val) ? val : -1);
        }

        // Try backend submit with client-side fallback
        try
        {
            quizResult = await StoryService.SubmitQuizAsync(story.Id, answersList);
        }
        catch { }

        // Client-side grading fallback if backend is offline/unreachable
        if (quizResult == null)
        {
            int correct = 0;
            var correctList = new List<bool>();
            for (int i = 0; i < story.Questions.Count; i++)
            {
                bool isCorrect = selectedAnswers.TryGetValue(i, out int ans) && ans == story.Questions[i].CorrectIndex;
                if (isCorrect) correct++;
                correctList.Add(isCorrect);
            }
            quizResult = new StoryQuizResultModel
            {
                StoryId = story.Id,
                TotalQuestions = story.Questions.Count,
                CorrectCount = correct,
                ScorePercentage = Math.Round((double)correct / story.Questions.Count * 100, 1),
                AnswerCorrectness = correctList,
                CorrectIndices = story.Questions.Select(q => q.CorrectIndex).ToList(),
                Explanations = story.Questions.Select(q => q.Explanation).ToList()
            };
        }

        // Save result to localStorage
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"story_quiz_{story.Slug}", JsonSerializer.Serialize(quizResult));
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"story_completed_{story.Slug}", "true");
        }
        catch { }

        isSubmittingQuiz = false;
    }

    private async Task RetryQuiz()
    {
        quizResult = null;
        selectedAnswers.Clear();
        if (story != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"story_quiz_{story.Slug}");
            }
            catch { }
        }
    }

    private async Task ToggleSaveWordDirect(StoryVocabulary v)
    {
        try
        {
            var savedJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "ieltshsk_saved_vocabulary");
            var list = !string.IsNullOrEmpty(savedJson)
                ? JsonSerializer.Deserialize<List<SavedStoryVocabItem>>(savedJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new()
                : new List<SavedStoryVocabItem>();

            var existing = list.FirstOrDefault(w => w.Word.Equals(v.Word, StringComparison.OrdinalIgnoreCase));
            if (existing != null)
            {
                list.Remove(existing);
                savedWordsSet.Remove(v.Word);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "ieltshsk_saved_vocabulary", JsonSerializer.Serialize(list));
                await ShowToast($"Đã xóa \"{v.Word}\" khỏi Sổ từ.");
            }
            else
            {
                list.Insert(0, new SavedStoryVocabItem
                {
                    Word = v.Word,
                    Pos = v.Pos,
                    Phonetic = v.Phonetic,
                    Meaning = v.Meaning,
                    Example = v.Example,
                    Level = v.Level,
                    Synonyms = v.Synonyms,
                    StorySlug = story?.Slug ?? "",
                    StoryTitle = story?.Title ?? "",
                    SavedAt = DateTime.UtcNow
                });
                savedWordsSet.Add(v.Word);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "ieltshsk_saved_vocabulary", JsonSerializer.Serialize(list));
                await ShowToast($"Đã lưu từ \"{v.Word}\" vào Sổ từ vựng!");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggle save word: {ex.Message}");
        }
    }

    private struct TextSegment
    {
        public string Text { get; set; }
        public bool IsTarget { get; set; }
        public StoryVocabulary? TargetVocab { get; set; }
    }

    private List<TextSegment> SegmentParagraph(string text)
    {
        var segments = new List<TextSegment>();
        if (story?.Vocabulary == null || story.Vocabulary.Count == 0 || string.IsNullOrEmpty(text))
        {
            segments.Add(new TextSegment { Text = text, IsTarget = false });
            return segments;
        }

        var vocabDict = new Dictionary<string, StoryVocabulary>();
        var patterns = new List<string>();

        // Sort descending by word length so longer phrases match before subwords
        int groupIndex = 0;
        foreach (var v in story.Vocabulary.OrderByDescending(x => x.Word.Length))
        {
            var word = v.Word.Trim();
            if (string.IsNullOrEmpty(word)) continue;

            string pat;
            if (word.Contains(' ') || word.Contains('-'))
            {
                var escaped = Regex.Escape(word);
                pat = escaped.Replace(@"\ ", @"\s+");
            }
            else
            {
                var escaped = Regex.Escape(word);
                if (escaped.EndsWith("e", StringComparison.OrdinalIgnoreCase) && escaped.Length > 2)
                {
                    var stem = escaped[..^1];
                    pat = $@"\b(?:{escaped}(?:s|d)?|{stem}ing)\b";
                }
                else if (escaped.EndsWith("y", StringComparison.OrdinalIgnoreCase) && escaped.Length > 2)
                {
                    var stem = escaped[..^1];
                    pat = $@"\b(?:{escaped}(?:s|ed|ing)?|{stem}ies)\b";
                }
                else
                {
                    pat = $@"\b{escaped}(?:s|es|ed|ing)?\b";
                }
            }

            var groupName = $"v_{groupIndex++}";
            patterns.Add($"(?<{groupName}>{pat})");
            vocabDict[groupName] = v;
        }

        if (patterns.Count == 0)
        {
            segments.Add(new TextSegment { Text = text, IsTarget = false });
            return segments;
        }

        var fullPattern = string.Join("|", patterns);
        var regex = new Regex(fullPattern, RegexOptions.IgnoreCase);

        int lastIdx = 0;
        foreach (Match m in regex.Matches(text))
        {
            if (m.Index > lastIdx)
            {
                segments.Add(new TextSegment 
                { 
                    Text = text.Substring(lastIdx, m.Index - lastIdx), 
                    IsTarget = false 
                });
            }

            StoryVocabulary? matchedVocab = null;
            foreach (var kvp in vocabDict)
            {
                if (m.Groups[kvp.Key].Success)
                {
                    matchedVocab = kvp.Value;
                    break;
                }
            }

            segments.Add(new TextSegment
            {
                Text = m.Value,
                IsTarget = true,
                TargetVocab = matchedVocab
            });

            lastIdx = m.Index + m.Length;
        }

        if (lastIdx < text.Length)
        {
            segments.Add(new TextSegment
            {
                Text = text.Substring(lastIdx),
                IsTarget = false
            });
        }

        return segments;
    }

    private RenderFragment RenderParagraphEn(int paraIndex, string text) => builder =>
    {
        var segments = SegmentParagraph(text);
        int seq = 0;

        foreach (var seg in segments)
        {
            if (seg.IsTarget && seg.TargetVocab != null)
            {
                var target = seg.TargetVocab;
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "target-word");
                builder.AddAttribute(seq++, "title", $"Từ vựng trọng tâm IELTS: {target.Word} ({(string.IsNullOrEmpty(target.Level) ? target.Pos : target.Level)}) - Chạm để xem chi tiết");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OpenVocabPopup(target)));
                builder.AddContent(seq++, seg.Text);
                builder.CloseElement();
            }
            else
            {
                var subWords = Regex.Split(seg.Text, @"(\s+|[.,!?:;""“”()\-]+)");
                foreach (var sub in subWords)
                {
                    if (string.IsNullOrEmpty(sub)) continue;
                    var cleanSub = sub.Trim(',', '.', '!', '?', '"', '“', '”', ':', ';', '(', ')', '-', ' ');
                    if (!string.IsNullOrWhiteSpace(cleanSub) && cleanSub.Length > 1)
                    {
                        var currentWord = cleanSub;
                        builder.OpenElement(seq++, "span");
                        builder.AddAttribute(seq++, "class", "readable-word");
                        builder.AddAttribute(seq++, "title", $"Chạm để nghe phát âm & tra từ '{cleanSub}'");
                        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => LookupAnyWord(currentWord)));
                        builder.AddContent(seq++, sub);
                        builder.CloseElement();
                    }
                    else
                    {
                        builder.AddContent(seq++, sub);
                    }
                }
            }
        }
    };

    public void Dispose()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
        dotNetHelper?.Dispose();
    }
