@page "/ielts/doc-truyen/{Slug}"
@layout Frontend.App.Layout.IeltsLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using System.Text.Json
@implements IDisposable
@inject StoryService StoryService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(story?.Title ?? "Đang tải truyện...") - IELTS Đọc Truyện</PageTitle>

@if (isLoading)
{
    <div class="reader-loading">
        <div class="custom-spinner"></div>
        <p class="mt-3">Đang mở truyện...</p>
    </div>
}
else if (story == null)
{
    <div class="reader-error">
        <div class="custom-alert alert-error text-center">
            <h3>Không tìm thấy truyện</h3>
            <p>Truyện này không tồn tại hoặc đã được gỡ xuống.</p>
            <a href="/ielts/doc-truyen" class="btn btn-primary-outline mt-2">Về danh sách truyện</a>
        </div>
    </div>
}
else
{
    <div class="story-reader-wrapper theme-@currentTheme font-@fontFamily">
        <!-- Top Sticky Control Bar -->
        <div class="reader-topbar">
            <div class="topbar-left">
                <a href="/ielts/doc-truyen" class="btn-back">
                    <i class="bi bi-arrow-left"></i> <span>Kho truyện</span>
                </a>
                <span class="topbar-divider">|</span>
                <span class="badge-level level-@story.Level.ToLower()">@story.Level</span>
                <span class="story-category-tag">@story.Category</span>
            </div>

            <div class="topbar-controls">
                <!-- Audio Speech Narration -->
                <div class="speech-controls">
                    <button class="ctrl-btn btn-audio @(isPlayingAudio ? "active" : "")" @onclick="TogglePlayStory" title="Đọc toàn bài">
                        <i class="bi @(isPlayingAudio ? "bi-stop-fill" : "bi-volume-up-fill")"></i>
                        <span>@(isPlayingAudio ? "Dừng đọc" : "Nghe đọc")</span>
                    </button>
                    <select class="speed-select" @bind="audioSpeed" title="Tốc độ đọc">
                        <option value="0.8">0.8x</option>
                        <option value="1.0">1.0x</option>
                        <option value="1.2">1.2x</option>
                    </select>
                </div>

                <span class="topbar-divider">|</span>

                <!-- Bilingual Translation Toggle -->
                <button class="ctrl-btn btn-bilingual @(showBilingual ? "active" : "")" @onclick="ToggleBilingual" title="Bật/tắt dịch song ngữ">
                    <i class="bi bi-translate"></i>
                    <span>Song ngữ</span>
                </button>

                <!-- Font Family Toggle -->
                <button class="ctrl-btn-icon btn-font-family" @onclick="ToggleFontFamily" title="Đổi kiểu font (Sans / Serif)">
                    @(fontFamily == "sans" ? "Aa" : "𝒯")
                </button>

                <!-- Font Size -->
                <div class="font-size-group">
                    <button class="ctrl-btn-icon" @onclick="DecreaseFontSize" title="Giảm cỡ chữ">A-</button>
                    <button class="ctrl-btn-icon" @onclick="IncreaseFontSize" title="Tăng cỡ chữ">A+</button>
                </div>

                <!-- Theme Switcher -->
                <div class="theme-switcher">
                    <button class="theme-dot theme-light @(currentTheme == "light" ? "active" : "")" @onclick='() => ChangeTheme("light")' title="Giao diện Sáng"></button>
                    <button class="theme-dot theme-paper @(currentTheme == "paper" ? "active" : "")" @onclick='() => ChangeTheme("paper")' title="Giao diện Giấy đọc"></button>
                    <button class="theme-dot theme-dark @(currentTheme == "dark" ? "active" : "")" @onclick='() => ChangeTheme("dark")' title="Giao diện Ban đêm"></button>
                </div>
            </div>
        </div>

        <!-- Sticky Reading Progress Bar -->
        <div class="reading-progress-track">
            <div class="reading-progress-bar" style="width: @(readingProgress)%;"></div>
        </div>

        <!-- Toast Notification for Saved Words -->
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="story-toast-notification">
                <i class="bi bi-check-circle-fill text-success"></i>
                <span>@toastMessage</span>
            </div>
        }

        <!-- Main Reading Container -->
        <div class="reader-container" style="font-size: @(fontSize)px;">
            <!-- Story Header -->
            <header class="story-header">
                <div class="story-meta-line">
                    <span class="meta-item"><i class="bi bi-award-fill text-primary"></i> Band @story.IeltsBand</span>
                    <span class="meta-item"><i class="bi bi-file-earmark-text-fill"></i> @story.WordCount từ</span>
                    <span class="meta-item"><i class="bi bi-clock-fill"></i> ~@story.EstimatedMinutes phút đọc</span>
                    <span class="meta-item"><i class="bi bi-eye-fill"></i> @story.ViewsCount lượt đọc</span>
                    @if (readingWpm > 0)
                    {
                        <span class="meta-item text-success"><i class="bi bi-speedometer2"></i> ~@readingWpm WPM</span>
                    }
                </div>
                <h1 class="story-main-title">@story.Title</h1>
                @if (!string.IsNullOrEmpty(story.Summary))
                {
                    <p class="story-lead-summary">@story.Summary</p>
                }

                <div class="reading-guide-tip">
                    <i class="bi bi-lightbulb-fill tip-icon"></i>
                    <span>Chạm vào từ <span class="tip-highlight">màu vàng</span> để xem từ vựng trọng tâm IELTS, hoặc <b>chạm vào bất kỳ từ nào khác</b> để nghe phát âm và tra nghĩa nhanh. Bật <b>Song ngữ</b> ở trên để xem bản dịch tiếng Việt.</span>
                </div>
            </header>

            <!-- Story Body Paragraphs -->
            <article class="story-article">
                @for (int pIdx = 0; pIdx < story.Paragraphs.Count; pIdx++)
                {
                    var paraIndex = pIdx;
                    var para = story.Paragraphs[paraIndex];
                    bool isPlayingThis = activePlayingIndex == paraIndex;
                    <div class="paragraph-block @(isPlayingThis ? "is-active-reading" : "")" id="para-@paraIndex">
                        <div class="paragraph-en">
                            @RenderParagraphEn(paraIndex, para.En)
                            <button class="btn-read-sentence @(isPlayingThis ? "playing" : "")" 
                                    @onclick="() => ToggleSpeakSentence(paraIndex, para.En)" 
                                    title="@(isPlayingThis ? "Dừng đọc đoạn này" : "Nghe đọc đoạn này")">
                                <i class="bi @(isPlayingThis ? "bi-stop-circle-fill text-danger" : "bi-volume-up-fill")"></i>
                                @if (isPlayingThis)
                                {
                                    <span class="soundwave-anim">
                                        <span></span><span></span><span></span>
                                    </span>
                                }
                            </button>
                        </div>

                        @if (showBilingual && !string.IsNullOrEmpty(para.Vi))
                        {
                            <div class="paragraph-vi">
                                @para.Vi
                            </div>
                        }
                    </div>
                }
            </article>

            <!-- Floating / Active Vocabulary Tooltip Modal -->
            @if (activeVocab != null)
            {
                <div class="vocab-popup-overlay" @onclick="CloseVocabPopup">
                    <div class="vocab-popup-card" @onclick:stopPropagation="true">
                        <div class="vocab-popup-header">
                            <div class="vocab-word-info">
                                <span class="vocab-word">@activeVocab.Word</span>
                                @if (!string.IsNullOrEmpty(activeVocab.Pos))
                                {
                                    <span class="vocab-pos">@activeVocab.Pos</span>
                                }
                                @if (!string.IsNullOrEmpty(activeVocab.Phonetic))
                                {
                                    <span class="vocab-phonetic">@activeVocab.Phonetic</span>
                                }
                            </div>
                            <div class="vocab-popup-actions">
                                <button class="btn-audio-speak" @onclick="() => SpeakWord(activeVocab.Word)" title="Phát âm từ vựng">
                                    <i class="bi bi-volume-up-fill"></i>
                                </button>
                                <button class="btn-close-popup" @onclick="CloseVocabPopup">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>

                        <div class="vocab-meaning-box">
                            <label class="vocab-label">Nghĩa tiếng Việt:</label>
                            @if (isLookingUpWord)
                            {
                                <div class="dict-lookup-loading">
                                    <span class="mini-spinner"></span>
                                    <span>Đang tra nghĩa từ điển...</span>
                                </div>
                            }
                            else
                            {
                                <p class="vocab-meaning">@activeVocab.Meaning</p>
                            }
                        </div>

                        @if (!isLookingUpWord && !string.IsNullOrEmpty(activeVocab.Example))
                        {
                            <div class="vocab-example-box">
                                <label class="vocab-label">Ví dụ trong ngữ cảnh:</label>
                                <p class="vocab-example">"@activeVocab.Example"</p>
                            </div>
                        }

                        @if (!isLookingUpWord && activeVocab.Collocations != null && activeVocab.Collocations.Count > 0)
                        {
                            <div class="vocab-collocations-box">
                                <label class="vocab-label">Cụm từ liên quan (Collocations):</label>
                                <div class="collocation-tags">
                                    @foreach (var col in activeVocab.Collocations)
                                    {
                                        <span class="collocation-tag">@col</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="vocab-popup-footer">
                            <button class="btn-save-vocab @(isWordSaved ? "saved" : "")" @onclick="ToggleSaveWord" disabled="@isLookingUpWord">
                                <i class="bi @(isWordSaved ? "bi-check-circle-fill" : "bi-bookmark-plus-fill")"></i>
                                <span>@(isWordSaved ? "Đã lưu vào sổ từ" : "Lưu vào sổ từ vựng")</span>
                            </button>
                            <a href="https://dictionary.cambridge.org/dictionary/english/@Uri.EscapeDataString(activeVocab.Word.ToLower())" 
                               target="_blank" 
                               class="btn-cambridge-dict" 
                               title="Mở từ điển Cambridge chính thức">
                                <i class="bi bi-box-arrow-up-right"></i> Cambridge Dict
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Post-Reading Section: Quiz & Diagnostic -->
            <section class="post-reading-section">
                <div class="section-title-wrapper">
                    <span class="section-badge"><i class="bi bi-patch-check-fill"></i> BÀI TẬP CUỐI TRUYỆN</span>
                    <h2>Kiểm tra Đọc hiểu & Từ vựng</h2>
                    <p class="section-desc">Làm bài tập ngắn để củng cố nội dung và phát hiện các từ vựng bạn chưa nắm vững.</p>
                </div>

                @if (story.Questions != null && story.Questions.Count > 0)
                {
                    <div class="quiz-container">
                        @for (int qIdx = 0; qIdx < story.Questions.Count; qIdx++)
                        {
                            var qIndex = qIdx;
                            var question = story.Questions[qIndex];
                            bool isGraded = quizResult != null;
                            bool isCorrect = isGraded && quizResult!.AnswerCorrectness.Count > qIndex && quizResult.AnswerCorrectness[qIndex];

                            <div class="quiz-card @(isGraded ? (isCorrect ? "quiz-correct" : "quiz-wrong") : "")">
                                <div class="quiz-question-header">
                                    <span class="quiz-num">Câu @(qIndex + 1)</span>
                                    <h4 class="quiz-question-text">@question.Question</h4>
                                </div>

                                <div class="quiz-options">
                                    @for (int oIdx = 0; oIdx < question.Options.Count; oIdx++)
                                    {
                                        var optIndex = oIdx;
                                        var optionText = question.Options[optIndex];
                                        bool isSelected = selectedAnswers.ContainsKey(qIndex) && selectedAnswers[qIndex] == optIndex;
                                        bool isOptionCorrect = isGraded && question.CorrectIndex == optIndex;

                                        <div class="quiz-option @(isSelected ? "selected" : "") @(isGraded && isOptionCorrect ? "opt-correct" : "") @(isGraded && isSelected && !isOptionCorrect ? "opt-wrong" : "")"
                                             @onclick="() => SelectOption(qIndex, optIndex)">
                                            <span class="opt-indicator">@((char)('A' + optIndex))</span>
                                            <span class="opt-text">@optionText</span>
                                            @if (isGraded && isOptionCorrect)
                                            {
                                                <i class="bi bi-check-circle-fill text-success ms-auto"></i>
                                            }
                                            else if (isGraded && isSelected && !isOptionCorrect)
                                            {
                                                <i class="bi bi-x-circle-fill text-danger ms-auto"></i>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (isGraded && !string.IsNullOrEmpty(question.Explanation))
                                {
                                    <div class="quiz-explanation">
                                        <strong><i class="bi bi-lightbulb-fill"></i> Giải thích:</strong> @question.Explanation
                                    </div>
                                }
                            </div>
                        }

                        <div class="quiz-actions-bar">
                            @if (quizResult == null)
                            {
                                <button class="btn-submit-quiz" @onclick="SubmitQuiz" disabled="@isSubmittingQuiz">
                                    @if (isSubmittingQuiz)
                                    {
                                        <span class="mini-spinner"></span>
                                        <span>Đang chấm điểm...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send-check-fill"></i>
                                        <span>Nộp bài & Chấm điểm</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <div class="quiz-result-summary">
                                    <div class="score-circle">
                                        <span class="score-num">@quizResult.CorrectCount/@quizResult.TotalQuestions</span>
                                        <span class="score-label">Đúng</span>
                                    </div>
                                    <div class="score-details">
                                        <h4>@(quizResult.ScorePercentage >= 80 ? "Xuất sắc! 🎉" : (quizResult.ScorePercentage >= 50 ? "Khá tốt! 👍" : "Cần cố gắng thêm! 💪"))</h4>
                                        <p>Bạn đã hoàn thành bài kiểm tra đọc hiểu với độ chính xác <b>@quizResult.ScorePercentage%</b>.</p>
                                    </div>
                                    <button class="btn btn-secondary-outline ms-auto" @onclick="RetryQuiz">
                                        <i class="bi bi-arrow-repeat"></i> Làm lại
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Target Vocabulary Summary Card -->
                @if (story.Vocabulary != null && story.Vocabulary.Count > 0)
                {
                    <div class="target-vocab-recap">
                        <div class="recap-header">
                            <h3><i class="bi bi-journal-bookmark-fill text-primary"></i> Từ vựng trọng tâm trong bài (@story.Vocabulary.Count từ)</h3>
                            <p>Chạm vào từ để phát âm hoặc ôn tập lại nghĩa.</p>
                        </div>
                        <div class="recap-vocab-grid">
                            @foreach (var v in story.Vocabulary)
                            {
                                <div class="recap-vocab-item" @onclick="() => OpenVocabPopup(v)">
                                    <div class="recap-vocab-top">
                                        <span class="recap-word">@v.Word</span>
                                        <span class="recap-pos">@v.Pos</span>
                                    </div>
                                    <div class="recap-phonetic">@v.Phonetic</div>
                                    <div class="recap-meaning">@v.Meaning</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private StoryModel? story;
    private bool isLoading = true;

    // Reader UI state
    private bool showBilingual = false;
    private int fontSize = 18; // default 18px for optimal reading
    private string currentTheme = "light"; // "light" | "paper" | "dark"
    private string fontFamily = "sans"; // "sans" | "serif"
    private bool isPlayingAudio = false;
    private int? activePlayingIndex = null;
    private double audioSpeed = 1.0;
    private int readingProgress = 0;
    private string? toastMessage = null;
    private CancellationTokenSource? toastCts = null;

    // Reading analytics
    private DateTime readingStartTime = DateTime.UtcNow;
    private int readingWpm = 0;

    // Active vocab popup
    private StoryVocabulary? activeVocab;
    private bool isWordSaved = false;
    private bool isLookingUpWord = false;

    // Quiz state
    private Dictionary<int, int> selectedAnswers = new();
    private StoryQuizResultModel? quizResult;
    private bool isSubmittingQuiz = false;

    private DotNetObjectReference<IeltsStoryReader>? dotNetHelper;

    protected override async Task OnParametersSetAsync()
    {
        await LoadStory();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("initReadingProgressBar", dotNetHelper);
            }
            catch { }
        }
    }

    private async Task LoadStory()
    {
        isLoading = true;
        story = await StoryService.GetStoryAsync(Slug);
        readingStartTime = DateTime.UtcNow;
        readingWpm = 0;

        // Check if user already took quiz before
        if (story != null)
        {
            try
            {
                var cached = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", $"story_quiz_{story.Slug}");
                if (!string.IsNullOrEmpty(cached))
                {
                    quizResult = JsonSerializer.Deserialize<StoryQuizResultModel>(cached, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                }
            }
            catch { }
        }

        isLoading = false;
    }

    [JSInvokable]
    public void UpdateReadingProgress(int progress)
    {
        readingProgress = progress;
        if (progress >= 80 && readingWpm == 0 && story != null && story.WordCount > 0)
        {
            var elapsedMins = (DateTime.UtcNow - readingStartTime).TotalMinutes;
            if (elapsedMins > 0.2)
            {
                readingWpm = (int)Math.Round(story.WordCount / elapsedMins);
            }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSentenceEnded(int sentenceIndex)
    {
        if (activePlayingIndex == sentenceIndex)
        {
            if (isPlayingAudio && story != null && sentenceIndex + 1 < story.Paragraphs.Count)
            {
                // Auto play next sentence
                await Task.Delay(300);
                await ToggleSpeakSentence(sentenceIndex + 1, story.Paragraphs[sentenceIndex + 1].En);
            }
            else
            {
                activePlayingIndex = null;
                isPlayingAudio = false;
                StateHasChanged();
            }
        }
    }

    private void ToggleBilingual() => showBilingual = !showBilingual;
    private void ToggleFontFamily() => fontFamily = fontFamily == "sans" ? "serif" : "sans";
    private void IncreaseFontSize() { if (fontSize < 28) fontSize += 2; }
    private void DecreaseFontSize() { if (fontSize > 14) fontSize -= 2; }
    private void ChangeTheme(string theme) => currentTheme = theme;

    private async Task TogglePlayStory()
    {
        if (isPlayingAudio)
        {
            await JSRuntime.InvokeVoidAsync("stopSpeakText");
            isPlayingAudio = false;
            activePlayingIndex = null;
        }
        else
        {
            if (story == null || story.Paragraphs.Count == 0) return;
            isPlayingAudio = true;
            await ToggleSpeakSentence(0, story.Paragraphs[0].En);
        }
    }

    private async Task ToggleSpeakSentence(int pIdx, string text)
    {
        if (activePlayingIndex == pIdx)
        {
            await JSRuntime.InvokeVoidAsync("stopSpeakText");
            activePlayingIndex = null;
            isPlayingAudio = false;
        }
        else
        {
            activePlayingIndex = pIdx;
            await JSRuntime.InvokeVoidAsync("speakSentenceWithCallback", text, "en-US", audioSpeed, dotNetHelper, pIdx);
        }
        StateHasChanged();
    }

    private async Task SpeakWord(string word)
    {
        await JSRuntime.InvokeVoidAsync("speakText", word, "en-US", 0.9);
    }

    private async Task OpenVocabPopup(StoryVocabulary vocab)
    {
        activeVocab = vocab;
        await CheckIfWordIsSaved(vocab.Word);
    }

    private async Task LookupAnyWord(string word)
    {
        var clean = word.Trim(',', '.', '!', '?', '"', '“', '”', ':', ';', '(', ')', '-');
        if (string.IsNullOrWhiteSpace(clean)) return;

        // If it matches a target vocab, show the rich target vocab
        var match = story?.Vocabulary?.FirstOrDefault(v => v.Word.Equals(clean, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            isLookingUpWord = false;
            await OpenVocabPopup(match);
            _ = SpeakWord(match.Word);
            return;
        }

        isLookingUpWord = true;
        activeVocab = new StoryVocabulary
        {
            Word = clean,
            Pos = "Từ vựng",
            Phonetic = "",
            Meaning = "Đang tra nghĩa từ điển...",
            Example = story != null ? $"Trích trong bài đọc: {story.Title}" : ""
        };
        await CheckIfWordIsSaved(clean);
        _ = SpeakWord(clean);

        try
        {
            var dictResult = await StoryService.LookupWordAsync(clean);
            if (dictResult != null && activeVocab != null && activeVocab.Word.Equals(clean, StringComparison.OrdinalIgnoreCase))
            {
                activeVocab = dictResult;
                if (string.IsNullOrWhiteSpace(activeVocab.Example) && story != null)
                {
                    activeVocab.Example = $"Trích trong bài đọc: {story.Title}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error looking up word {clean}: {ex.Message}");
        }
        finally
        {
            isLookingUpWord = false;
            StateHasChanged();
        }
    }

    private void CloseVocabPopup()
    {
        activeVocab = null;
    }

    private async Task CheckIfWordIsSaved(string word)
    {
        try
        {
            var savedJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "ieltshsk_saved_vocabulary");
            if (!string.IsNullOrEmpty(savedJson))
            {
                var list = JsonSerializer.Deserialize<List<SavedStoryVocabItem>>(savedJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                isWordSaved = list?.Any(w => w.Word.Equals(word, StringComparison.OrdinalIgnoreCase)) ?? false;
                return;
            }
        }
        catch { }
        isWordSaved = false;
    }

    private async Task ToggleSaveWord()
    {
        if (activeVocab == null) return;
        try
        {
            var savedJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "ieltshsk_saved_vocabulary");
            var list = !string.IsNullOrEmpty(savedJson)
                ? JsonSerializer.Deserialize<List<SavedStoryVocabItem>>(savedJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new()
                : new List<SavedStoryVocabItem>();

            var existing = list.FirstOrDefault(w => w.Word.Equals(activeVocab.Word, StringComparison.OrdinalIgnoreCase));
            if (existing != null)
            {
                list.Remove(existing);
                isWordSaved = false;
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "ieltshsk_saved_vocabulary", JsonSerializer.Serialize(list));
                await ShowToast($"Đã xóa từ \"{activeVocab.Word}\" khỏi Sổ từ.");
            }
            else
            {
                list.Insert(0, new SavedStoryVocabItem
                {
                    Word = activeVocab.Word,
                    Pos = activeVocab.Pos,
                    Phonetic = activeVocab.Phonetic,
                    Meaning = activeVocab.Meaning,
                    Example = activeVocab.Example,
                    StorySlug = story?.Slug ?? "",
                    StoryTitle = story?.Title ?? "",
                    SavedAt = DateTime.UtcNow
                });
                isWordSaved = true;
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "ieltshsk_saved_vocabulary", JsonSerializer.Serialize(list));
                await ShowToast($"Đã lưu từ \"{activeVocab.Word}\" vào Sổ từ vựng!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving word: {ex.Message}");
        }
    }

    private async Task ShowToast(string message)
    {
        toastMessage = message;
        StateHasChanged();
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(2500, toastCts.Token);
            toastMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void SelectOption(int questionIndex, int optionIndex)
    {
        if (quizResult != null) return;
        selectedAnswers[questionIndex] = optionIndex;
    }

    private async Task SubmitQuiz()
    {
        if (story == null || story.Questions.Count == 0) return;

        isSubmittingQuiz = true;
        var answersList = new List<int>();
        for (int i = 0; i < story.Questions.Count; i++)
        {
            answersList.Add(selectedAnswers.TryGetValue(i, out int val) ? val : -1);
        }

        // Try backend submit with client-side fallback
        try
        {
            quizResult = await StoryService.SubmitQuizAsync(story.Id, answersList);
        }
        catch { }

        // Client-side grading fallback if backend is offline/unreachable
        if (quizResult == null)
        {
            int correct = 0;
            var correctList = new List<bool>();
            for (int i = 0; i < story.Questions.Count; i++)
            {
                bool isCorrect = selectedAnswers.TryGetValue(i, out int ans) && ans == story.Questions[i].CorrectIndex;
                if (isCorrect) correct++;
                correctList.Add(isCorrect);
            }
            quizResult = new StoryQuizResultModel
            {
                StoryId = story.Id,
                TotalQuestions = story.Questions.Count,
                CorrectCount = correct,
                ScorePercentage = Math.Round((double)correct / story.Questions.Count * 100, 1),
                AnswerCorrectness = correctList,
                CorrectIndices = story.Questions.Select(q => q.CorrectIndex).ToList(),
                Explanations = story.Questions.Select(q => q.Explanation).ToList()
            };
        }

        // Save result to localStorage
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"story_quiz_{story.Slug}", JsonSerializer.Serialize(quizResult));
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"story_completed_{story.Slug}", "true");
        }
        catch { }

        isSubmittingQuiz = false;
    }

    private async Task RetryQuiz()
    {
        quizResult = null;
        selectedAnswers.Clear();
        if (story != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"story_quiz_{story.Slug}");
            }
            catch { }
        }
    }

    private RenderFragment RenderParagraphEn(int paraIndex, string text) => builder =>
    {
        var words = text.Split(' ');
        for (int i = 0; i < words.Length; i++)
        {
            var rawWord = words[i];
            var cleanWord = rawWord.Trim(',', '.', '!', '?', '"', '“', '”', ':', ';', '(', ')', '-');
            var currentClean = cleanWord;

            var target = story?.Vocabulary?.FirstOrDefault(v => 
                v.Word.Equals(cleanWord, StringComparison.OrdinalIgnoreCase));

            builder.OpenElement(1, "span");
            if (target != null)
            {
                builder.AddAttribute(2, "class", "target-word");
                builder.AddAttribute(3, "title", $"Từ vựng trọng tâm IELTS: {target.Word}");
                builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => OpenVocabPopup(target)));
            }
            else if (!string.IsNullOrWhiteSpace(cleanWord) && cleanWord.Length > 1)
            {
                builder.AddAttribute(2, "class", "readable-word");
                builder.AddAttribute(3, "title", $"Chạm để nghe phát âm & tra từ '{cleanWord}'");
                builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => LookupAnyWord(currentClean)));
            }
            builder.AddContent(5, rawWord);
            builder.CloseElement();

            if (i < words.Length - 1)
            {
                builder.AddContent(6, " ");
            }
        }
    };

    public void Dispose()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
        dotNetHelper?.Dispose();
    }
