    /// <summary>
    /// Extracts a clean English search keyword from a grammar topic name.
    /// - Pulls text from inside parentheses if present:
    ///   "Thì Quá khứ hoàn thành (Past Perfect)" → "Past Perfect"
    /// - Takes only the first part when "/" separates two names:
    ///   "To the extent that / To such an extent that" → "To the extent that"
    /// - Cleans formula markers (+ bare V, etc.)
    /// </summary>
    private static string ExtractEnglishKeyword(string? grammarTopic)
    {
        if (string.IsNullOrWhiteSpace(grammarTopic)) return string.Empty;

        var term = grammarTopic.Trim();

        // Pull English text from inside the last set of parentheses
        var start = term.LastIndexOf('(');
        var end   = term.LastIndexOf(')');
        if (start >= 0 && end > start)
        {
            var inner = term.Substring(start + 1, end - start - 1).Trim();
            if (!string.IsNullOrWhiteSpace(inner)) term = inner;
        }

        // Take only the first alternative when "/" separates two names
        var slashIdx = term.IndexOf(" / ");
        if (slashIdx > 0) term = term.Substring(0, slashIdx).Trim();

        // Strip formula markers
        term = term.Replace("+ bare V", "").Replace("+ V", "").Replace("...", "").Trim();

        if (term.Length > 60) term = term.Substring(0, 60).Trim();

        return term;
    }

    /// <summary>
    /// Builds a targeted Google search URL that directly locates the authoritative lesson / explanation:
    /// 1. Uses the handcrafted clean English keyword for the structure (110 items covered).
    /// 2. Combines with the authoritative publisher (Cambridge, Oxford, or British Council).
    /// 3. Never redirects to an unsearched generic homepage, never gives 404 or spellcheck error.
    /// (Note: perfect-english-grammar.com is strictly excluded).
    /// </summary>
    private string GetReferenceSourceUrl(string? structureCode, string? source, string? grammarTopic = null)
    {
        string keyword;
        if (!string.IsNullOrWhiteSpace(structureCode) && CleanSearchKeywords.TryGetValue(structureCode.Trim(), out var cleanKw))
        {
            keyword = cleanKw;
        }
        else
        {
            keyword = ExtractEnglishKeyword(grammarTopic);
        }

        if (string.IsNullOrWhiteSpace(keyword))
        {
            keyword = "IELTS grammar";
        }

        var s = (source ?? string.Empty).ToLowerInvariant();
        string authority;

        if (s.Contains("oxford"))
        {
            authority = "Oxford Learner's Dictionaries";
        }
        else if (s.Contains("british council") || s.Contains("raymond murphy") || s.Contains("martin hewings"))
        {
            authority = "British Council grammar";
        }
        else
        {
            authority = "Cambridge Dictionary grammar";
        }

        var query = $"{keyword} {authority}";
        return $"https://www.google.com/search?q={Uri.EscapeDataString(query)}";
    }
