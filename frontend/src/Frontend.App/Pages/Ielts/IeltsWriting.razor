@page "/ielts/writing/preview"
@page "/ielts/writing/{ExamUrl}"
@page "/ielts/writing"
@layout Frontend.App.Layout.ExamLayout
@using Frontend.App.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject ExamSessionService ExamSession
@inject ExamSubmissionService Submissions
@inject ExamCheckpointService CheckpointService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(exam?.Title ?? "IELTS Writing") - IeltsHSK</PageTitle>

@if (isLoading)
{
    <div class="writing-loading">
        <div class="loading-ring"></div>
        <p>Đang tải đề thi...</p>
    </div>
}
else if (exam == null)
{
    <div class="writing-error">
        <div class="error-icon">📭</div>
        <h3>Không tải được đề thi</h3>
        <p>Vui lòng thử lại hoặc chọn đề khác.</p>
    </div>
}
else
{
    var activeTask = exam.Tasks[activeTaskIndex];

    @* ── TOP BAR ── *@
    <div class="writing-topbar">
        <div class="topbar-left">
            <span class="exam-title-short">@exam.Title</span>
        </div>
        <div class="topbar-center">
            <div class="timer-box @(secondsLeft < 600 ? "timer-warning" : "")">
                <span class="timer-icon">⏱</span>
                <span>@TimerDisplay remaining</span>
            </div>
        </div>
        <div class="topbar-right">
            <button class="btn-exit-exam" @onclick="ExitExam">Exit test</button>
            @if (isFinished)
            {
                <span class="test-session-status">@(timedOut ? "Time is up" : "Submitted")</span>
            }
            <button class="btn-submit-exam" disabled="@(isFinished || isSubmitting)" @onclick="SubmitExam">
                @(isSubmitting ? "Saving..." : "Submit ➤")
            </button>
        </div>
    </div>

    @* ── REVIEW / RESULT TOP BANNER (HIỂN THỊ ĐÁP ÁN & KẾT QUẢ TRÊN CÙNG) ── *@
    @if (isFinished || savedSubmission != null)
    {
        <div class="writing-result-top-banner">
            <div class="result-banner-header">
                <div class="banner-badge-box">
                    @if (savedSubmission?.Status == "Graded" && savedSubmission?.BandScore.HasValue == true)
                    {
                        <span class="status-badge-pill">🎉 ĐÃ CÓ KẾT QUẢ CHẤM ĐIỂM</span>
                        <span class="status-sub-note">Bài viết đã được giáo viên có trình độ chuyên môn hoàn tất chấm điểm và nhận xét chi tiết.</span>
                    }
                    else
                    {
                        <span class="status-badge-pill pending">⏳ ĐÃ NỘP BÀI — CHỜ CHẤM ĐIỂM</span>
                        <span class="status-sub-note">Bài viết của bạn đã được ghi nhận. Giáo viên có trình độ chuyên môn sẽ tiến hành chấm điểm 4 tiêu chí và phản hồi sớm nhất.</span>
                    }
                </div>
                <div class="banner-actions">
                    <button class="btn-banner-action review-btn" style="background:#7e22ce; color:#fff;" @onclick="NavigateToReviewDetail">
                        <i class="bi bi-file-earmark-check-fill"></i> Xem lại bài & Bài mẫu
                    </button>
                    <button class="btn-banner-action summary-btn" @onclick="NavigateToSummary">
                        <i class="bi bi-bar-chart-fill"></i> Tổng hợp kết quả (4 kỹ năng)
                    </button>
                    <button class="btn-banner-action retake-btn" @onclick="RetakeExam">
                        <i class="bi bi-arrow-counterclockwise"></i> Viết lại
                    </button>
                    <button class="btn-banner-action exit-btn" @onclick="ExitExam">
                        <i class="bi bi-x-lg"></i> Thoát
                    </button>
                </div>
            </div>

            <div class="result-banner-grid">
                @if (savedSubmission?.Status == "Graded" && savedSubmission?.BandScore.HasValue == true)
                {
                    <div class="score-card-band">
                        <span class="band-label">OFFICIAL BAND</span>
                        <span class="band-number">@savedSubmission.BandScore.Value.ToString("0.0")</span>
                        <span class="band-note">Đã được giáo viên chấm</span>
                    </div>
                    
                    <div class="criteria-card-grid">
                        @if (scoreReport?.Criteria != null && scoreReport.Criteria.Count > 0)
                        {
                            @foreach (var crit in scoreReport.Criteria)
                            {
                                <div class="crit-item">
                                    <span class="crit-name">@crit.Name</span>
                                    <span class="crit-score">Band @crit.Score.ToString("0.0")</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="crit-item"><span class="crit-name">Overall Band</span><span class="crit-score">Band @savedSubmission.BandScore.Value.ToString("0.0")</span></div>
                        }
                    </div>
                }
                else
                {
                    <div class="score-card-band pending-card">
                        <span class="band-label">TRẠNG THÁI</span>
                        <span class="band-number pending-icon"><i class="bi bi-hourglass-split"></i></span>
                        <span class="band-note">Đang chờ Giáo viên chấm</span>
                    </div>
                    
                    <div class="pending-info-box">
                        <p><i class="bi bi-info-circle"></i> Kỹ năng IELTS Writing được chấm trực tiếp bởi Giáo viên có trình độ chuyên môn theo 4 tiêu chí chuẩn Cambridge (Task Response, Coherence & Cohesion, Lexical Resource, Grammatical Range & Accuracy).</p>
                        <p class="pending-sub">Điểm số và nhận xét chi tiết sẽ hiển thị tại đây ngay sau khi hoàn thành chấm bài.</p>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(savedSubmission?.TeacherFeedback))
            {
                <div class="teacher-feedback-alert">
                    <strong><i class="bi bi-chat-left-quote-fill"></i> Nhận xét từ Giáo viên:</strong>
                    <p>@savedSubmission.TeacherFeedback</p>
                </div>
            }
        </div>
    }

    @* ── CHECKPOINT RESTORE BANNER ── *@
    @if (!isFinished && pendingCheckpoint != null)
    {
        <div class="checkpoint-banner">
            <div class="cb-left">
                <i class="bi bi-clock-history cb-icon"></i>
                <div class="cb-info">
                    <strong>Phát hiện bài làm dở:</strong> Lưu lúc @pendingCheckpoint.LastSavedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                    (Còn @(pendingCheckpoint.SecondsRemaining / 60) phút @(pendingCheckpoint.SecondsRemaining % 60) giây · Đã viết @pendingCheckpoint.WritingTasks.Values.Count(w => !string.IsNullOrWhiteSpace(w)) Task)
                </div>
            </div>
            <div class="cb-actions">
                <button class="btn-cb-restore" @onclick="RestoreCheckpoint">
                    <i class="bi bi-arrow-repeat"></i> Khôi phục bài viết dở
                </button>
                <button class="btn-cb-discard" @onclick="DiscardCheckpoint">
                    <i class="bi bi-trash3"></i> Viết bài mới
                </button>
            </div>
        </div>
    }

    @* ── TASK TABS ── *@
    <div class="writing-task-tabs">
        @for (int i = 0; i < exam.Tasks.Count; i++)
        {
            var idx = i;
            var task = exam.Tasks[i];
            <button class="task-tab-btn @(activeTaskIndex == idx ? "active" : "")"
                    @onclick="() => SwitchTask(idx)">
                @task.TaskTitle
                <span class="word-count-badge">@task.WordCount / @task.MinWords words</span>
            </button>
        }
        @if (isFinished)
        {
            <div class="task-tabs-right">
                <button class="view-mode-btn @(viewSampleMode ? "" : "active")" @onclick="() => viewSampleMode = false">
                    📝 Bài viết của bạn
                </button>
                <button class="view-mode-btn sample @(viewSampleMode ? "active" : "")" @onclick="() => viewSampleMode = true">
                    📖 Đáp án mẫu Band @(activeTask.ExaminerBand?.ToString("0.0") ?? "8.0+")
                </button>
            </div>
        }
    </div>

    @* ── SPLIT LAYOUT ── *@
    <div class="writing-split">
        @* LEFT: Prompt + Image *@
        <div class="prompt-col" id="prompt-scroll">
            <div class="task-instruction">
                <h2 class="task-title">@activeTask.TaskTitle</h2>
                <p class="task-meta">@((MarkupString)activeTask.Instruction)</p>
                <div class="task-prompt">@((MarkupString)activeTask.Prompt)</div>
                <p class="task-word-req">You should write <strong>@activeTask.RequireWords.</strong></p>
            </div>

            @if (!string.IsNullOrEmpty(activeTask.ImageUrl))
            {
                <div class="task-image-wrap">
                    <img src="@activeTask.ImageUrl" alt="@activeTask.ImageAlt" class="task-image" />
                </div>
            }
        </div>

        @* DIVIDER *@
        <div class="split-divider"></div>

        @* RIGHT: Essay Editor OR Sample Answer *@
        <div class="editor-col">
            @if (isFinished && viewSampleMode)
            {
                <div class="sample-answer-panel">
                    <div class="sample-answer-header">
                        <span class="sample-badge">🏆 MODEL ANSWER (BAND @(activeTask.ExaminerBand?.ToString("0.0") ?? "8.5"))</span>
                        <span class="sample-words">Words: @(activeTask.SampleAnswer != null ? System.Text.RegularExpressions.Regex.Matches(activeTask.SampleAnswer, @"\b[\w'-]+\b").Count : 0)</span>
                    </div>
                    <div class="sample-answer-body">
                        @if (!string.IsNullOrEmpty(activeTask.SampleAnswer))
                        {
                            @((MarkupString)activeTask.SampleAnswer)
                        }
                        else
                        {
                            <p class="no-sample">Chưa có bài mẫu cho đề thi này.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <textarea class="essay-textarea"
                          placeholder="Type your essay here (English only)..."
                          disabled="@isFinished"
                          value="@activeTask.Answer"
                          @oninput="HandleInput"
                          spellcheck="false"></textarea>
                <div class="editor-footer">
                    <span class="word-count @(activeTask.WordCount >= activeTask.MinWords ? "count-ok" : "count-low")">
                        Words: <strong>@activeTask.WordCount</strong> / @activeTask.MinWords required
                    </span>
                    @if (showInvalidCharWarning)
                    {
                        <span class="invalid-char-warning" style="color: #ef4444; margin-left: 12px; font-size: 0.85rem;"><i class="bi bi-exclamation-triangle-fill"></i> Chỉ hỗ trợ tiếng Anh và dấu (! , . ?)</span>
                    }
                    @if (activeTask.WordCount >= activeTask.MinWords && !showInvalidCharWarning)
                    {
                        <span class="count-check" style="margin-left: 12px;">✓ Minimum reached</span>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "ExamUrl")]
    public string? QueryExamUrl { get; set; }

    [Parameter]
    public string? ExamUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Session")]
    public string? TestSessionId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "CollectionName")]
    public string? QueryCollectionName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Title")]
    public string? QueryTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "MockTestId")]
    public int? QueryMockTestId { get; set; }

    private bool showInvalidCharWarning = false;

    private void HandleInput(ChangeEventArgs e)
    {
        if (exam == null || exam.Tasks == null || activeTaskIndex >= exam.Tasks.Count) return;
        var task = exam.Tasks[activeTaskIndex];

        var val = e.Value?.ToString() ?? "";
        
        // Cho phép: chữ cái (a-z), số (0-9), khoảng trắng, xuống dòng và các dấu câu cơ bản.
        var regex = new System.Text.RegularExpressions.Regex(@"[^a-zA-Z0-9\s\.,!\?'""\-\(\)]");
        
        if (regex.IsMatch(val))
        {
            showInvalidCharWarning = true;
            task.Answer = regex.Replace(val, "");
        }
        else
        {
            showInvalidCharWarning = false;
            task.Answer = val;
        }
    }

    private WritingExamData? exam;
    private bool isLoading = true;
    private int activeTaskIndex = 0;

    // Timer: 60 minutes
    private int secondsLeft = 60 * 60;
    private System.Threading.Timer? _timer;
    private IDisposable? _navigationRegistration;
    private string? _sessionKey;
    private bool viewSampleMode = true;
    private bool isFinished;
    private bool timedOut;
    private bool isSubmitting;
    private string currentExamUrl = DefaultExamUrl;
    private IeltsSubmissionRecord? savedSubmission;
    private IeltsScoreReport? scoreReport;
    private ExamCheckpointDto? pendingCheckpoint;
    private int _autoSaveCounter = 0;

    private const string DefaultExamUrl = "sample-data/writing-test-1.json";

    private string TimerDisplay
    {
        get
        {
            int m = secondsLeft / 60, s = secondsLeft % 60;
            return $"{m:D2}:{s:D2}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        string? actualUrl = ExamUrl;
        if (string.IsNullOrWhiteSpace(actualUrl)) actualUrl = QueryExamUrl;
        string url = string.IsNullOrWhiteSpace(actualUrl) ? DefaultExamUrl : Uri.UnescapeDataString(actualUrl);
        currentExamUrl = url;

        try
        {
            exam = await Http.GetFromJsonAsync<WritingExamData>(url);
        }
        catch
        {
            exam = null;
        }

        isLoading = false;

        _sessionKey = ExamSessionService.CreateStorageKey("writing", TestSessionId, url);
        var session = await ExamSession.StartAsync(_sessionKey, 60 * 60);
        secondsLeft = session.SecondsRemaining;
        isFinished = session.IsCompleted || session.IsExpired;
        timedOut = session.IsTimedOut || session.IsExpired;
        if (isFinished)
        {
            savedSubmission = await Submissions.GetLatestSubmissionForSkillAsync("Writing", url, TestSessionId);
            if (savedSubmission?.Writing?.Tasks != null && exam?.Tasks != null)
            {
                foreach (var st in savedSubmission.Writing.Tasks)
                {
                    var match = exam.Tasks.FirstOrDefault(t => t.TaskNumber == st.TaskNumber);
                    if (match != null && !string.IsNullOrWhiteSpace(st.Answer)) match.Answer = st.Answer;
                }
            }
            scoreReport = savedSubmission?.Score;
            return;
        }

        // Kiểm tra bài viết dở của tài khoản hiện tại
        var cp = await CheckpointService.GetCheckpointAsync("Writing", url, QueryMockTestId);
        if (cp != null && cp.WritingTasks.Count > 0 && cp.WritingTasks.Values.Any(w => !string.IsNullOrWhiteSpace(w)))
        {
            pendingCheckpoint = cp;
        }

        _navigationRegistration = Navigation.RegisterLocationChangingHandler(ConfirmLeave);
        await ExamSession.SetUnloadWarningAsync(true);
        _timer = new System.Threading.Timer(_ => _ = UpdateTimerAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void RestoreCheckpoint()
    {
        if (pendingCheckpoint == null || exam == null) return;

        foreach (var task in exam.Tasks)
        {
            if (pendingCheckpoint.WritingTasks.TryGetValue(task.TaskNumber, out var ans))
            {
                task.Answer = ans;
            }
        }

        if (pendingCheckpoint.SecondsRemaining > 0)
        {
            secondsLeft = pendingCheckpoint.SecondsRemaining;
        }

        if (pendingCheckpoint.ActivePartIndex >= 0 && pendingCheckpoint.ActivePartIndex < exam.Tasks.Count)
        {
            activeTaskIndex = pendingCheckpoint.ActivePartIndex;
        }

        pendingCheckpoint = null;
        StateHasChanged();
    }

    private async Task DiscardCheckpoint()
    {
        if (pendingCheckpoint != null)
        {
            await CheckpointService.ClearCheckpointAsync("Writing", currentExamUrl, QueryMockTestId);
            pendingCheckpoint = null;
            StateHasChanged();
        }
    }

    private async Task AutoSaveCheckpointAsync()
    {
        if (isFinished || isSubmitting || exam == null || string.IsNullOrEmpty(currentExamUrl)) return;

        var cp = new ExamCheckpointDto
        {
            Skill = "Writing",
            ExamUrl = currentExamUrl,
            MockTestId = QueryMockTestId,
            CollectionName = QueryCollectionName,
            TestTitle = QueryTitle ?? exam.Title,
            SessionId = TestSessionId,
            SecondsRemaining = secondsLeft,
            TotalDurationSeconds = (exam.TotalMinutes > 0 ? exam.TotalMinutes : 60) * 60,
            ActivePartIndex = activeTaskIndex
        };

        foreach (var task in exam.Tasks)
        {
            if (!string.IsNullOrWhiteSpace(task.Answer))
            {
                cp.WritingTasks[task.TaskNumber] = task.Answer;
            }
        }

        await CheckpointService.SaveCheckpointAsync(cp);
    }

    private void SwitchTask(int index)
    {
        activeTaskIndex = index;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isFinished) await ExamSession.LockTestContentAsync(".writing-split");
    }

    private void OnInput()
    {
        _ = AutoSaveCheckpointAsync();
        StateHasChanged();
    }

    private async Task SubmitExam()
    {
        if (isFinished || isSubmitting) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Bạn có chắc chắn muốn nộp bài thi Writing không?");
        if (!confirmed) return;

        await FinishExamAsync(false);
    }

    private async Task UpdateTimerAsync()
    {
        if (isFinished || string.IsNullOrEmpty(_sessionKey)) return;
        var session = await ExamSession.GetAsync(_sessionKey);
        if (session == null) return;
        secondsLeft = session.SecondsRemaining;

        _autoSaveCounter++;
        if (_autoSaveCounter % 5 == 0)
        {
            _ = AutoSaveCheckpointAsync();
        }

        if (session.IsExpired) await InvokeAsync(() => FinishExamAsync(true));
        else await InvokeAsync(StateHasChanged);
    }

    private async Task FinishExamAsync(bool timeExpired)
    {
        if (isFinished || isSubmitting) return;
        isSubmitting = true;
        isFinished = true;
        _timer?.Dispose();
        await InvokeAsync(StateHasChanged);

        try
        {
            try { await CheckpointService.ClearCheckpointAsync("Writing", currentExamUrl, QueryMockTestId); } catch { }

            savedSubmission = BuildSubmission(timeExpired);
            try
            {
                savedSubmission = await Submissions.SaveWritingSubmissionAsync(savedSubmission);
                scoreReport = savedSubmission.Score;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Writing] Lỗi khi lưu bài nộp: {ex.Message}");
            }

            timedOut = timeExpired;
            viewSampleMode = true;
            
            try { if (!string.IsNullOrEmpty(_sessionKey)) await ExamSession.CompleteAsync(_sessionKey, timeExpired); } catch { }
            try { await ExamSession.LockTestContentAsync(".writing-split"); } catch { }
            try { await ExamSession.SetUnloadWarningAsync(false); } catch { }

            if (!timeExpired)
            {
                try
                {
                    await JS.InvokeVoidAsync("alert", "🎉 Bài thi Writing đã được nộp thành công!\nKết quả chấm điểm và nhận xét chi tiết sẽ sớm được thông báo cho bạn.");
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Writing] Lỗi khi nộp bài: {ex.Message}");
            try
            {
                await JS.InvokeVoidAsync("alert", $"Đã xảy ra lỗi khi nộp bài: {ex.Message}");
            }
            catch { }
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RetakeExam()
    {
        if (!string.IsNullOrEmpty(_sessionKey))
        {
            await ExamSession.ClearAsync(_sessionKey);
        }
        if (exam?.Tasks != null)
        {
            foreach (var t in exam.Tasks) t.Answer = "";
        }
        isFinished = false;
        timedOut = false;
        savedSubmission = null;
        scoreReport = null;
        viewSampleMode = false;
        activeTaskIndex = 0;
        secondsLeft = (exam?.TotalMinutes ?? 60) * 60;
        _timer = new System.Threading.Timer(_ => _ = UpdateTimerAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        StateHasChanged();
    }

    private IeltsSubmissionRecord BuildSubmission(bool timeExpired)
    {
        var durationSeconds = Math.Max((exam?.TotalMinutes ?? 60) * 60 - secondsLeft, 0);
        return new IeltsSubmissionRecord
        {
            Skill = "writing",
            ExamTitle = exam?.Title ?? QueryTitle ?? "IELTS Writing",
            ExamUrl = currentExamUrl,
            SessionId = TestSessionId,
            MockTestId = QueryMockTestId,
            CollectionName = QueryCollectionName,
            TestTitle = QueryTitle,
            TimedOut = timeExpired,
            DurationSeconds = durationSeconds,
            Writing = new WritingSubmissionData
            {
                Tasks = exam?.Tasks.Select(task => new WritingTaskSubmission
                {
                    TaskNumber = task.TaskNumber,
                    TaskTitle = task.TaskTitle,
                    Prompt = task.Prompt,
                    Answer = task.Answer,
                    WordCount = task.WordCount,
                    MinWords = task.MinWords
                }).ToList() ?? new()
            }
        };
    }

    private void NavigateToReviewDetail()
    {
        var coll = QueryCollectionName ?? "IELTS Mock Test 2025 December";
        var title = QueryTitle ?? exam?.Title ?? "Practise Test 1";
        var sess = TestSessionId ?? "";
        var extraMockId = QueryMockTestId.HasValue ? $"&MockTestId={QueryMockTestId.Value}" : "";
        Navigation.NavigateTo($"/ielts/review?Skill=Writing&ExamUrl={Uri.EscapeDataString(currentExamUrl)}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(title)}&Session={Uri.EscapeDataString(sess)}{extraMockId}");
    }

    private void NavigateToSummary()
    {
        var coll = QueryCollectionName ?? "IELTS Mock Test 2025 December";
        var title = QueryTitle ?? exam?.Title ?? "Practise Test 1";
        var sess = TestSessionId ?? "";
        Navigation.NavigateTo($"/ielts/mock-test/summary?CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(title)}&Session={Uri.EscapeDataString(sess)}");
    }

    private async ValueTask ConfirmLeave(LocationChangingContext context)
    {
        if (!isFinished && !await ExamSession.ConfirmLeaveAsync()) context.PreventNavigation();
    }

    private void ExitExam() => Navigation.NavigateTo("/ielts/luyen-de");

    public void Dispose()
    {
        _timer?.Dispose();
        _navigationRegistration?.Dispose();
        _ = ExamSession.SetUnloadWarningAsync(false);
    }
}
