    private void BuildTopicGroups()
    {
        topics.Clear();
        if (allItems.Count == 0) return;

        var topicDefs = new[]
        {
            ("hometown", "🏡", "Hometown & Living", "Quê hương & Nhà ở", 1, 10, "Band 6.0 - 6.5"),
            ("routine", "⏰", "Daily Routine & Habits", "Thói quen hàng ngày", 21, 30, "Band 6.0 - 6.5"),
            ("food", "🍜", "Food & Culinary Culture", "Ẩm thực & Nấu ăn", 41, 50, "Band 6.5 - 7.0"),
            ("work", "💼", "Work & Study", "Công việc & Học tập", 11, 20, "Band 6.5 - 7.0"),
            ("travel", "✈️", "Travel & Transport", "Du lịch & Đi lại", 31, 40, "Band 7.0 - 7.5"),
            ("health", "🏃", "Fitness & Wellbeing", "Thể thao & Sức khỏe", 81, 90, "Band 7.0 - 7.5"),
            ("tech", "🤖", "Technology & AI", "Công nghệ & Trí tuệ nhân tạo", 51, 60, "Band 7.5 - 8.0"),
            ("environment", "🌿", "Environment & Nature", "Môi trường & Thiên nhiên", 61, 70, "Band 7.5 - 8.0"),
            ("art", "🎨", "Art, Music & Cinema", "Nghệ thuật & Giải trí", 71, 80, "Band 8.0 - 8.5"),
            ("future", "🚀", "Vision & Society", "Tầm nhìn & Xã hội", 91, 100, "Band 8.0 - 8.5")
        };

        foreach (var (id, icon, en, vi, startId, endId, bandTag) in topicDefs)
        {
            var chunk = allItems.Where(i => i.Id >= startId && i.Id <= endId).ToList();
            if (chunk.Count > 0)
            {
                topics.Add(new TopicGroup
                {
                    Id = id,
                    Icon = icon,
                    TitleEn = en,
                    TitleVi = vi,
                    LevelTag = bandTag,
                    Items = chunk
                });
            }
        }
    }

