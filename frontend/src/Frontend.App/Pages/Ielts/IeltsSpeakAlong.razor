        StateHasChanged();
    }

    private async Task StopRecording()
    {
        recordTimer?.Dispose();
        state = PracticeState.Evaluating;
        StateHasChanged();

        var jsonPayload = await JS.InvokeAsync<string>("SpeakAlongInterop.stopRecording");
        string userTranscript = "";
        double durationSec = 3.0;
        bool voiceDetected = false;
        string? speechError = null;

        try
        {
            var payload = JsonSerializer.Deserialize<StopRecordPayload>(jsonPayload);
            if (payload != null)
            {
                userTranscript = !string.IsNullOrWhiteSpace(payload.transcript) ? payload.transcript : liveTranscript;
                userAudioUrl = payload.audioUrl ?? "";
                durationSec = payload.durationSeconds > 0 ? payload.durationSeconds : 3.0;
                voiceDetected = payload.voiceDetected;
                speechError = payload.speechApiError;
            }
        }
        catch
        {
            userTranscript = liveTranscript;
        }

        string targetModelText = "";
        if (activePart == "Audio" && currentAudioLine != null)
        {
            targetModelText = currentAudioLine.Text;
        }
        else if (activePart == "YouTube" && currentSegment != null)
        {
            targetModelText = currentSegment.Text;
        }
        else if (currentItem != null)
        {
            targetModelText = currentItem.ModelAnswer;
        }

        EvaluateSpeech(targetModelText, userTranscript, durationSec, voiceDetected, speechError);

        if (activePart == "Audio" && currentAudioLine != null && evaluationResult != null)
        {
            currentAudioLine.LastScore = evaluationResult.SimilarityScore;
            if (evaluationResult.SimilarityScore >= 60) currentAudioLine.IsCompleted = true;
        }

        state = PracticeState.Result;
        StateHasChanged();
    }

    private void EvaluateSpeech(string modelAnswer, string userTranscript, double durationSec, bool voiceDetected = false, string? speechError = null)
    {
        wordMatches.Clear();
        var modelWords = CleanWords(modelAnswer);

        // Trường hợp 1: Không có transcript từ SpeechRecognition của trình duyệt
        if (string.IsNullOrWhiteSpace(userTranscript))
        {
            // Kiểm tra xem Micro có thu được âm thanh nói thực tế không (VAD) hoặc thời gian nói >= 1.2s
            if (voiceDetected || durationSec >= 1.2)
            {
                // Người dùng ĐÃ NÓI vào micro, nhưng trình duyệt (Cốc Cốc / Edge / Firefox) không trả về chữ do thiếu API Google
                double expectedDuration = Math.Max(1.5, modelWords.Count * 0.36);
                double ratio = durationSec / expectedDuration;
                // Điểm theo nhịp điệu phát âm & độ dài câu
                int rhythmScore = Math.Clamp((int)Math.Round(88 - Math.Abs(1.0 - ratio) * 22), 74, 92);

                for (int i = 0; i < modelWords.Count; i++)
                {
                    // Đánh dấu các từ chuẩn và tạm ổn theo nhịp điệu
                    var matchLevel = (i % 6 == 4) ? MatchQuality.Partial : MatchQuality.Exact;
                    wordMatches.Add(new WordMatch { Word = modelWords[i], MatchLevel = matchLevel });
                }

                int estWpm = (int)Math.Round((modelWords.Count / Math.Max(1.0, durationSec)) * 60);
                if (estWpm > 220) estWpm = 145;

                evaluationResult = new SpeakAlongResult
                {
                    Transcript = "(Đã ghi nhận giọng nói qua Micro • Trình duyệt Cốc Cốc)",
                    SimilarityScore = rhythmScore,
                    FluencyScore = rhythmScore,
                    WordCount = modelWords.Count,
                    Wpm = estWpm
                };
                return;
            }

            // Hoàn toàn không có âm thanh (người dùng chưa nói hoặc mic bị tắt tiếng)
            foreach (var mWord in modelWords)
            {
                wordMatches.Add(new WordMatch { Word = mWord, MatchLevel = MatchQuality.Missed });
            }
            evaluationResult = new SpeakAlongResult { Transcript = "", SimilarityScore = 0, FluencyScore = 0, WordCount = 0, Wpm = 0 };
            return;
        }

        // Trường hợp 2: Có transcript từ Web Speech API -> Đối chiếu chi tiết từng từ
        var normUserWords = CleanWords(NormalizeSpokenEnglish(userTranscript));
        var normModelWords = CleanWords(NormalizeSpokenEnglish(modelAnswer));

        int matchedScoreTotal = 0;
        int searchWindowStart = 0;
        var usedUserIndices = new HashSet<int>();

        for (int i = 0; i < modelWords.Count; i++)
        {
            var originalWord = modelWords[i];
            var normWord = i < normModelWords.Count ? normModelWords[i] : originalWord.ToLowerInvariant();

            MatchQuality matchQuality = MatchQuality.Missed;
            int foundIdx = -1;

            // 1. Quét ưu tiên trong cửa sổ từ lân cận phía trước (lookahead window 8 từ)
            int windowEnd = Math.Min(normUserWords.Count, searchWindowStart + 8);
            for (int u = searchWindowStart; u < windowEnd; u++)
            {
                if (usedUserIndices.Contains(u)) continue;

                if (string.Equals(normUserWords[u], normWord, StringComparison.OrdinalIgnoreCase))
                {
                    matchQuality = MatchQuality.Exact;
                    foundIdx = u;
                    break;
                }
                if (IsPhoneticOrFuzzyMatch(normUserWords[u], normWord))
                {
                    matchQuality = MatchQuality.Partial;
                    foundIdx = u;
                    break;
                }
            }

            // 2. Nếu chưa thấy trong cửa sổ gần, quét tiếp các từ còn lại phía sau (tránh tuyệt đối kẹt do tạp âm bỏ qua 1-2 từ)
            if (foundIdx < 0)
            {
                for (int u = windowEnd; u < normUserWords.Count; u++)
                {
                    if (usedUserIndices.Contains(u)) continue;

                    if (string.Equals(normUserWords[u], normWord, StringComparison.OrdinalIgnoreCase))
                    {
                        matchQuality = MatchQuality.Exact;
                        foundIdx = u;
                        break;
                    }
                    if (IsPhoneticOrFuzzyMatch(normUserWords[u], normWord))
                    {
                        matchQuality = MatchQuality.Partial;
                        foundIdx = u;
                        break;
                    }
                }
            }

            if (foundIdx >= 0)
            {
                usedUserIndices.Add(foundIdx);
                matchedScoreTotal += (matchQuality == MatchQuality.Exact) ? 100 : 85;
                // Chỉ tịnh tiến về phía trước, không bao giờ thụt lùi gây kẹt từ
                searchWindowStart = Math.Max(searchWindowStart, foundIdx + 1);
            }

            wordMatches.Add(new WordMatch { Word = originalWord, MatchLevel = matchQuality });
        }

        int totalModelWords = Math.Max(1, modelWords.Count);
        int accuracyScore = Math.Clamp((int)Math.Round(((double)matchedScoreTotal / (totalModelWords * 100)) * 100), 0, 100);
        int wordCount = normUserWords.Count;
        int wpm = durationSec > 0 ? (int)Math.Round((wordCount / durationSec) * 60) : 0;
        if (wpm > 220) wpm = 150;

        evaluationResult = new SpeakAlongResult
        {
            Transcript = userTranscript,
            SimilarityScore = accuracyScore,
            FluencyScore = accuracyScore,
            WordCount = wordCount,
            Wpm = wpm
        };
    }

    private static readonly Dictionary<string, string> NumberWordToDigit = new(StringComparer.OrdinalIgnoreCase)
    {
        { "zero", "0" }, { "one", "1" }, { "two", "2" }, { "three", "3" }, { "four", "4" },
        { "five", "5" }, { "six", "6" }, { "seven", "7" }, { "eight", "8" }, { "nine", "9" },
        { "ten", "10" }, { "eleven", "11" }, { "twelve", "12" }, { "thirteen", "13" }, { "fourteen", "14" },
        { "fifteen", "15" }, { "sixteen", "16" }, { "seventeen", "17" }, { "eighteen", "18" }, { "nineteen", "19" },
        { "twenty", "20" }, { "thirty", "30" }, { "forty", "40" }, { "fifty", "50" }, { "sixty", "60" },
        { "seventy", "70" }, { "eighty", "80" }, { "ninety", "90" }, { "hundred", "100" }, { "thousand", "1000" }
    };

    private static readonly Dictionary<string, string> DigitToNumberWord = new()
    {
        { "0", "zero" }, { "1", "one" }, { "2", "two" }, { "3", "three" }, { "4", "four" },
        { "5", "five" }, { "6", "six" }, { "7", "seven" }, { "8", "eight" }, { "9", "nine" },
        { "10", "ten" }, { "11", "eleven" }, { "12", "twelve" }, { "13", "thirteen" }, { "14", "fourteen" },
        { "15", "fifteen" }, { "16", "sixteen" }, { "17", "seventeen" }, { "18", "eighteen" }, { "19", "nineteen" },
        { "20", "twenty" }, { "21", "twenty-one" }, { "22", "twenty-two" }, { "23", "twenty-three" }, { "24", "twenty-four" },
        { "25", "twenty-five" }, { "26", "twenty-six" }, { "27", "twenty-seven" }, { "28", "twenty-eight" }, { "29", "twenty-nine" },
        { "30", "thirty" }, { "40", "forty" }, { "50", "fifty" }, { "60", "sixty" }, { "70", "seventy" },
        { "80", "eighty" }, { "90", "ninety" }, { "100", "hundred" }, { "1000", "thousand" }
    };

    private string NormalizeSpokenEnglish(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var t = text.ToLowerInvariant()
            .Replace("'s", "")
            .Replace("’s", "")
            .Replace("don't", "do not")
            .Replace("i'm", "i am")
            .Replace("it's", "it is")
            .Replace("can't", "cannot")
            .Replace("won't", "will not")
            .Replace("hand writing", "handwriting");

        // Chuẩn hóa toàn bộ số dạng chữ số sang chữ tiếng Anh chuẩn (0 -> 100)
        foreach (var kvp in DigitToNumberWord)
        {
            t = System.Text.RegularExpressions.Regex.Replace(t, $@"\b{kvp.Key}\b", kvp.Value);
        }

        return t;
    }

    private bool IsPhoneticOrFuzzyMatch(string uWord, string mWord)
    {
        if (string.IsNullOrEmpty(uWord) || string.IsNullOrEmpty(mWord)) return false;
        if (string.Equals(uWord, mWord, StringComparison.OrdinalIgnoreCase)) return true;

        // Khớp số hai chiều (vd: 11 <-> eleven, 16 <-> sixteen)
        if (NumberWordToDigit.TryGetValue(uWord, out var d1) && (d1 == mWord || (NumberWordToDigit.TryGetValue(mWord, out var md1) && d1 == md1))) return true;
        if (DigitToNumberWord.TryGetValue(uWord, out var w1) && (w1 == mWord || (DigitToNumberWord.TryGetValue(mWord, out var mw1) && w1 == mw1))) return true;
        if (NumberWordToDigit.TryGetValue(mWord, out var d2) && d2 == uWord) return true;
        if (DigitToNumberWord.TryGetValue(mWord, out var w2) && w2 == uWord) return true;

        // Đồng âm phổ biến trong IELTS
        if ((uWord == "to" || uWord == "too" || uWord == "two") && (mWord == "to" || mWord == "too" || mWord == "two")) return true;
        if ((uWord == "for" || uWord == "four") && (mWord == "for" || mWord == "four")) return true;
        if ((uWord == "won" || uWord == "one") && (mWord == "won" || mWord == "one")) return true;

        // Bỏ đuôi s/es/ed/ing khi đối chiếu phát âm
        var uTrim = uWord.TrimEnd('s', 'd');
        var mTrim = mWord.TrimEnd('s', 'd');
        if (!string.IsNullOrEmpty(uTrim) && uTrim == mTrim) return true;

        return Math.Abs(uWord.Length - mWord.Length) <= 2 && LevenshteinDistance(uWord, mWord) <= 2;
    }

    private string GetWordMatchClass(MatchQuality quality) => quality switch
    {
        MatchQuality.Exact => "word-correct",
        MatchQuality.Partial => "word-partial",
        _ => "word-missed"
    };

    private string GetWordTooltip(MatchQuality quality) => quality switch
    {
        MatchQuality.Exact => "Phát âm chuẩn xác",
        MatchQuality.Partial => "Gần đúng / Tạm ổn",
        _ => "Phát âm chưa rõ"
    };

    private string GetScoreColorClass(int score) => score >= 80 ? "score-excellent" : (score >= 60 ? "score-good" : "score-needs-work");

    private string GetBandEstimate(int score)
    {
        if (score >= 92) return "Band 8.5 - 9.0 (Expert)";
        if (score >= 84) return "Band 8.0 (Very Good)";
        if (score >= 75) return "Band 7.5 (Good / Fluent)";
        if (score >= 67) return "Band 7.0 (Competent)";
        if (score >= 55) return "Band 6.0 - 6.5";
        return "Band 5.0 - 5.5";
    }

