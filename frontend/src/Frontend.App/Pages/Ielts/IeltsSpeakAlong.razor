@page "/ielts/speak-along"
@page "/ielts/speak-along/{Part}"
@page "/ielts/noi-theo"
@page "/ielts/noi-theo/{Part}"
@layout Frontend.App.Layout.IeltsLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using System.Text.Json
@using Microsoft.JSInterop
@inject SpeakAlongService SpeakAlongService
@inject IeltsService IeltsService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>IELTS Nói Theo (Shadowing) - IeltsHSK</PageTitle>

<div class="speak-along-page">
    <!-- Top Header -->
    <div class="page-top-header">
        <div class="header-titles">
            <div class="header-badge-row">
                <span class="badge-hero">
                    <i class="bi bi-mic-fill"></i> IELTS Shadowing Studio
                </span>
                <!-- Streak Badge -->
                <span class="badge-streak" title="Số ngày học liên tiếp của bạn!">
                    <span class="streak-flame">🔥</span>
                    <strong>@streakDays ngày Streak</strong>
                </span>
                <!-- Nút Phỏng vấn Giả lập -->
                @if (activePart != "YouTube" && activePart != "Audio")
                {
                    <button class="btn-mock-interview-toggle @(isMockInterviewMode ? "active" : "")" @onclick="ToggleMockInterviewMode">
                        <i class="bi bi-person-video3"></i>
                        <span>@(isMockInterviewMode ? "Thoát Phỏng Vấn" : "Phỏng Vấn Giả Lập")</span>
                    </button>
                }
                <!-- Nút Test Âm thanh ở góc -->
                <button class="btn-corner-mic-test" @onclick="OpenAudioTestModal" title="Kiểm tra Micro & Loa tai nghe">
                    <i class="bi bi-gear-wide-connected text-primary"></i>
                    <span>Kiểm tra Micro & Loa</span>
                    <span class="mic-status-indicator @(isMicReady ? "online" : "offline")"></span>
                </button>
            </div>
            <h1 class="page-title">Luyện Nói Theo & Phản Xạ IELTS (Shadowing)</h1>
            <p class="page-subtitle">Phương pháp Shadowing chuẩn quốc tế: Luyện từng câu theo Audio chuẩn Cambridge IELTS & Engnovate, làm chủ ngữ điệu và phát âm như người bản xứ.</p>
        </div>

        <div class="part-selector-tabs">
            @foreach (var p in partList)
            {
                <button class="part-tab-btn @(activePart == p.Key ? "active" : "")" @onclick="() => SwitchPart(p.Key)">
                    <span class="part-tab-num">@p.Key</span>
                    <span class="part-tab-label">@p.Label</span>
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="custom-spinner"></div>
            <p>Đang nạp dữ liệu bài nói theo...</p>
        </div>
    }
    else if (activePart == "Audio")
    {
        <!-- ================================================================= -->
        <!-- CHẾ ĐỘ: AUDIO SHADOWING (CAMBRIDGE IELTS & ENGNOVATE CHUẨN)       -->
        <!-- ================================================================= -->
        @if (selectedAudioLesson == null)
        {
            <!-- Danh sách Bài Audio Shadowing -->
            <div class="audio-catalog-section">
                <div class="section-intro-bar">
                    <div class="intro-left">
                        <h2 class="section-heading"><i class="bi bi-headphones text-primary"></i> Danh Sách Bài Audio Shadowing Chuẩn Cambridge & Engnovate</h2>
                        <p class="section-desc">Audio gốc bản quyền kèm mốc thời gian từng câu <strong>100% chuẩn xác</strong>, không bị lệch hay ngắt chữ.</p>
                    </div>
                    <div class="overall-progress-chip">
                        <i class="bi bi-disc text-primary"></i>
                        <span>Hiện có: <strong>@audioLessons.Count</strong> bài luyện</span>
                    </div>
                </div>

                <!-- Khung vàng nổi bật: Khuyến nghị truy cập bằng Chrome -->
                <div class="chrome-notice-banner" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 2px solid #f59e0b; border-left: 6px solid #d97706; border-radius: 14px; padding: 14px 20px; margin-bottom: 24px; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.16); display: flex; align-items: center; gap: 14px;">
                    <div style="width: 42px; height: 42px; border-radius: 12px; background: #f59e0b; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; flex-shrink: 0; box-shadow: 0 2px 6px rgba(217, 119, 6, 0.3);">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px; flex: 1;">
                        <div style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: #b45309; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-bell-fill"></i>
                            <span>LƯU Ý QUAN TRỌNG VỀ GIỌNG NÓI</span>
                        </div>
                        <div style="font-size: 0.94rem; color: #78350f; line-height: 1.5; font-weight: 500;">
                            Để tính năng <strong style="color: #92400e; font-weight: 800;">nhận diện giọng nói</strong> và <strong style="color: #92400e; font-weight: 800;">chấm phát âm AI</strong> hoạt động nhạy và chuẩn xác nhất (không bị lỗi mất chữ), bạn hãy mở trang trên trình duyệt <strong style="color: #b45309; font-weight: 800; text-decoration: underline;">Google Chrome</strong> trên máy tính.
                        </div>
                    </div>
                </div>

                <!-- Grid Audio Lesson Cards -->
                <div class="audio-lesson-grid">
                    @foreach (var lesson in audioLessons)
                    {
                        <div class="audio-lesson-card" @onclick="() => SelectAudioLesson(lesson)">
                            <div class="audio-card-top">
                                <div class="audio-icon-wrap">
                                    <span class="audio-lesson-icon">@lesson.Icon</span>
                                </div>
                                <span class="audio-level-badge">@lesson.Level</span>
                            </div>
                            <div class="audio-card-body">
                                <span class="audio-category-tag">@lesson.Category</span>
                                <h3 class="audio-card-title">@lesson.Title</h3>
                                <p class="audio-card-desc">@lesson.Description</p>
                                <div class="audio-card-footer">
                                    <span class="audio-unit-count"><i class="bi bi-list-check"></i> @lesson.TotalUnits câu</span>
                                    <span class="btn-start-audio-shadow">Luyện Audio Shadowing →</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- ============================================================= -->
            <!-- WORKSPACE: AUDIO SHADOWING (ENGNOVATE UI WITH NATIVE MP3)     -->
            <!-- ============================================================= -->
            <div class="engnovate-shadowing-container">
                <!-- Header Bar -->
                <div class="engnovate-header-bar">
                    <button class="btn-engnovate-back" @onclick="BackToAudioList">
                        <i class="bi bi-arrow-left"></i> Đổi Bài Nghe khác
                    </button>
                    <div class="engnovate-meta-info">
                        <span class="mode-badge"><i class="bi bi-headphones"></i> Practice Mode: Audio Shadowing</span>
                        <h2 class="exercise-video-title" title="@selectedAudioLesson.Title">@selectedAudioLesson.Title</h2>
                    </div>
                    <div class="engnovate-speed-bar">
                        <span class="speed-title">Tốc độ:</span>
                        <button class="speed-chip @(audioSpeed == 0.75 ? "active" : "")" @onclick="() => SetAudioSpeed(0.75)">0.75x</button>
                        <button class="speed-chip @(audioSpeed == 1.0 ? "active" : "")" @onclick="() => SetAudioSpeed(1.0)">1.0x</button>
                        <button class="speed-chip @(audioSpeed == 1.25 ? "active" : "")" @onclick="() => SetAudioSpeed(1.25)">1.25x</button>
                    </div>
                </div>

                <!-- Main Grid -->
                <div class="engnovate-main-grid">
                    <!-- Cột 1: Audio Player & Kịch bản toàn bài -->
                    <div class="engnovate-video-col">
                        <div class="engnovate-video-card">
                            <div class="engnovate-audio-player-box mb-3">
                                <label class="audio-player-label">
                                    <i class="bi bi-music-note-beamed text-primary"></i> Audio bài nghe gốc:
                                </label>
                                <audio id="engnovate-main-audio" class="dictation-audio w-100" controls src="@selectedAudioLesson.AudioUrl">
                                    Trình duyệt không hỗ trợ thẻ audio.
                                </audio>
                            </div>
                            <div class="unit-progress-bar-wrap">
                                <div class="unit-progress-text">
                                    <span>Tiến độ: <strong>@(currentAudioLineIndex + 1) / @selectedAudioLesson.Lines.Count</strong> câu</span>
                                    <span class="completed-count-badge">@GetCompletedAudioLineCount() đã hoàn thành</span>
                                </div>
                                <div class="unit-progress-track">
                                    <div class="unit-progress-fill" style="width: @((currentAudioLineIndex + 1) * 100 / Math.Max(1, selectedAudioLesson.Lines.Count))%"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Full Transcript Accordion -->
                        <div class="engnovate-transcript-wrapper">
                            <div class="transcript-toggle-bar" @onclick="() => showFullTranscript = !showFullTranscript">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-text-fill text-primary"></i>
                                    <strong>Toàn bộ kịch bản Audio (Full Transcript)</strong>
                                </div>
                                <i class="bi @(showFullTranscript ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </div>

                            @if (showFullTranscript)
                            {
                                <div class="transcript-lines-list">
                                    @for (int i = 0; i < selectedAudioLesson.Lines.Count; i++)
                                    {
                                        var lineIdx = i;
                                        var line = selectedAudioLesson.Lines[i];
                                        var isActive = lineIdx == currentAudioLineIndex;
                                        <div class="transcript-line @(isActive ? "active-line" : "") @(line.IsCompleted ? "completed-line" : "")" 
                                             @onclick="() => SelectAudioLine(lineIdx)">
                                            <span class="line-speaker">(@(lineIdx + 1))</span>
                                            <div class="line-content">
                                                @if (!string.IsNullOrEmpty(line.Speaker))
                                                {
                                                    <span class="line-speaker-tag">@line.Speaker</span>
                                                }
                                                <span class="line-text">@line.Text</span>
                                            </div>
                                            <span class="line-time">@FormatTimestamp(line.StartTime)</span>
                                            @if (line.IsCompleted)
                                            {
                                                <i class="bi bi-check-circle-fill text-success ms-1"></i>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Cột 2: Dictation & Shadowing Card (Engnovate) -->
                    <div class="engnovate-shadow-col">
                        <div class="dictation-card-wrapper">
                            <!-- Unit Counter Header -->
                            <div class="dictation-unit-counter-row">
                                <span class="unit-counter-pill">
                                    <i class="bi bi-bookmark-fill"></i> Câu @(currentAudioLineIndex + 1) / @selectedAudioLesson.Lines.Count
                                </span>
                                <span class="segment-timing-pill">
                                    <i class="bi bi-clock-history"></i> @FormatTimestamp(currentAudioLine?.StartTime ?? 0) - @FormatTimestamp(currentAudioLine?.EndTime ?? 0)
                                </span>
                            </div>

                            <!-- Target Caption -->
                            <div class="dictation-unit-wrapper">
                                @if (!string.IsNullOrEmpty(currentAudioLine?.Speaker))
                                {
                                    <div class="caption-speaker-badge">
                                        <i class="bi bi-person-fill"></i> @currentAudioLine.Speaker
                                    </div>
                                }
                                <div class="dictation-unit-caption">
                                    @for (int i = 0; i < modelTokens.Count; i++)
                                    {
                                        var token = modelTokens[i];
                                        var isKaraokeActive = isPlayingAll && i == activeKaraokeWordIndex;
                                        <span class="caption-word @(isKaraokeActive ? "karaoke-active" : "")">
                                            @token
                                        </span>
                                    }
                                </div>

                                <div class="caption-action-bar">
                                    <button class="btn-play-caption-tts" @onclick="PlayModelTts" title="Nghe AI đọc câu này">
                                        <i class="bi bi-volume-up-fill"></i> Nghe TTS
                                    </button>
                                </div>
                            </div>

                            <!-- User Input & Recording Area -->
                            <div class="user-speech-card">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                                    <label class="speech-box-label mb-0">
                                        <i class="bi bi-soundwave"></i> Lời bạn nói (Your speech):
                                    </label>
                                    <span class="speech-chrome-tip" title="Google Chrome hỗ trợ Web Speech API với độ nhạy cao nhất">
                                        <i class="bi bi-browser-chrome text-primary"></i> Khuyên dùng Chrome để bắt giọng chuẩn
                                    </span>
                                </div>

                                <div class="speech-display-box @(state == PracticeState.Recording ? "is-recording" : "")">
                                    @if (state == PracticeState.Recording)
                                    {
                                        <canvas id="active-recording-waveform" class="speech-live-waveform" width="460" height="50"></canvas>
                                        <div class="speech-live-text">
                                            @(string.IsNullOrWhiteSpace(liveTranscript) ? "Đang lắng nghe giọng nói của bạn..." : liveTranscript)
                                        </div>
                                    }
                                    else if (state == PracticeState.Evaluating)
                                    {
                                        <div class="speech-evaluating-placeholder">
                                            <div class="spinner-border text-primary spinner-border-sm"></div>
                                            <span>Đang phân tích đối chiếu phát âm...</span>
                                        </div>
                                    }
                                    else if (state == PracticeState.Result && evaluationResult != null)
                                    {
                                        <div class="speech-result-text">
                                            @(string.IsNullOrWhiteSpace(evaluationResult.Transcript) ? "(Không nhận diện được giọng nói rõ ràng)" : $"\"{evaluationResult.Transcript}\"")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="speech-placeholder">
                                            Bấm nút Microphone tròn bên dưới và đọc theo phụ đề...
                                        </div>
                                    }
                                </div>

                                <!-- Big Circular Microphone Button (Engnovate Style) -->
                                <div class="record-button-center-wrapper">
                                    @if (state == PracticeState.Idle || state == PracticeState.Result)
                                    {
                                        <button class="big-engnovate-mic-btn" @onclick="StartRecording" title="Bắt đầu ghi âm nói theo">
                                            <div class="mic-inner-circle">
                                                <i class="bi bi-mic-fill"></i>
                                            </div>
                                            <span class="mic-btn-label">Bấm để Nói Theo</span>
                                        </button>
                                    }
                                    else if (state == PracticeState.Recording)
                                    {
                                        <button class="big-engnovate-mic-btn recording-active" @onclick="StopRecording" title="Dừng và chấm điểm">
                                            <div class="mic-inner-circle">
                                                <i class="bi bi-stop-fill"></i>
                                            </div>
                                            <span class="mic-btn-label">Dừng & Chấm điểm (@recordDurationSec s)</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Results & Word Diff Container -->
                            @if (state == PracticeState.Result && evaluationResult != null)
                            {
                                <div class="engnovate-result-box">
                                    <div class="result-score-banner @GetScoreColorClass(evaluationResult.SimilarityScore)">
                                        <div class="score-main">
                                            <span class="score-digit">@evaluationResult.SimilarityScore%</span>
                                            <span class="score-lbl">Độ chính xác</span>
                                        </div>
                                        <div class="score-sub">
                                            <span class="score-sub-item">⚡ <strong>@evaluationResult.Wpm WPM</strong></span>
                                            <span class="score-sub-item">🎯 <strong>@GetBandEstimate(evaluationResult.SimilarityScore)</strong></span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(evaluationResult.Transcript) && evaluationResult.Transcript.Contains("Cốc Cốc"))
                                    {
                                        <div class="alert alert-info py-2 px-3 mt-2 mb-2 d-flex align-items-center" style="font-size: 0.85rem; border-radius: 10px; background: #f0f9ff; border: 1px solid #bae6fd; color: #0369a1;">
                                            <i class="bi bi-info-circle-fill me-2 fs-6 text-primary"></i>
                                            <span><strong>Mẹo nhỏ:</strong> Hệ thống đã ghi nhận & chấm điểm ngữ điệu theo micro của bạn. Trình duyệt Cốc Cốc không tích hợp sẵn API nhận diện chữ của Google. Để đối chiếu chuẩn xác từng từ bằng AI Google, bạn hãy mở trên <strong>Google Chrome</strong> nhé!</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(userAudioUrl))
                                    {
                                        <div class="user-audio-review-bar">
                                            <span class="audio-lbl"><i class="bi bi-headphones"></i> Nghe lại giọng của bạn:</span>
                                            <audio src="@userAudioUrl" controls class="engnovate-audio-player"></audio>
                                        </div>
                                    }

                                    <!-- Word-by-word Highlight Diff -->
                                    <div class="dictation-diff-box">
                                        <div class="diff-header">
                                            <span><i class="bi bi-spellcheck"></i> Đối chiếu chi tiết từng từ:</span>
                                            <div class="diff-legend">
                                                <span class="legend-chip chip-exact">🟢 Chuẩn</span>
                                                <span class="legend-chip chip-partial">🟡 Tạm ổn</span>
                                                <span class="legend-chip chip-missed">🔴 Cần sửa</span>
                                            </div>
                                        </div>
                                        <div class="diff-words-flow">
                                            @foreach (var w in wordMatches)
                                            {
                                                <span class="diff-word-badge @GetWordMatchClass(w.MatchLevel)" title="@GetWordTooltip(w.MatchLevel)">
                                                    @w.Word
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Engnovate Control Buttons Bar -->
                            <div class="engnovate-control-buttons-bar">
                                <button class="engnovate-ctrl-btn btn-relisten" @onclick="PlayCurrentAudioLineOnce" title="Nghe lại câu này (Shift + R)">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span>Nghe lại câu</span>
                                </button>
                                <button class="engnovate-ctrl-btn btn-loop @(isLoopingAudio ? "active" : "")" @onclick="ToggleLoopAudio" title="Lặp đi lặp lại câu này">
                                    <i class="bi bi-repeat"></i>
                                    <span>@(isLoopingAudio ? "Đang lặp" : "Lặp câu")</span>
                                </button>
                                <button class="engnovate-ctrl-btn btn-prev auto-margin-left" @onclick="PrevAudioLine" disabled="@(currentAudioLineIndex == 0)" title="Câu trước">
                                    <i class="bi bi-arrow-left"></i>
                                    <span>Câu trước</span>
                                </button>
                                <button class="engnovate-ctrl-btn btn-next" @onclick="NextAudioLine" disabled="@(currentAudioLineIndex >= selectedAudioLesson.Lines.Count - 1)" title="Câu tiếp">
                                    <span>Câu tiếp</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (activePart == "YouTube")
    {
        <!-- ================================================================= -->
        <!-- CHẾ ĐỘ: VIDEO SHADOWING YOUTUBE (KHÓA - SẮP CẬP NHẬT)              -->
        <!-- ================================================================= -->
        <div class="coming-soon-card-container">
            <div class="coming-soon-card">
                <div class="coming-soon-badge">
                    <i class="bi bi-lock-fill"></i> Tính Năng Đang Nâng Cấp
                </div>
                <div class="coming-soon-icon-wrap">
                    <span class="coming-soon-icon">🚀</span>
                </div>
                <h2 class="coming-soon-title">Video Shadowing (YouTube) Sẽ Sớm Ra Mắt!</h2>
                <p class="coming-soon-desc">
                    Hệ thống AI nhận diện và đồng bộ mốc thời gian phụ đề YouTube đang được tối ưu hóa để đạt độ chính xác chuẩn từng mili-giây. 
                    Chức năng sẽ sớm được mở trong bản cập nhật tới!
                </p>
                <div class="coming-soon-recommendation">
                    <i class="bi bi-lightbulb-fill text-warning"></i>
                    <span>Trong thời gian này, bạn hãy luyện tập với <strong>Audio Shadowing (Cambridge IELTS)</strong> với Audio gốc bản quyền và mốc thời gian từng câu chuẩn xác 100%!</span>
                </div>
                <button class="btn-switch-to-audio" @onclick='() => SwitchPart("Audio")'>
                    <i class="bi bi-headphones"></i>
                    <span>Chuyển sang Audio Shadowing (Cambridge IELTS) ngay</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    }
    else if (exam == null || allItems.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-exclamation-circle text-warning fs-1"></i>
            <h3>Chưa có dữ liệu bài nói cho phần này</h3>
        </div>
    }
    else if (isMockInterviewMode)
    {
        <div class="mock-interview-container">
            <div class="interview-header-card">
                <div class="interview-title-row">
                    <div class="interview-badge"><i class="bi bi-award-fill"></i> IELTS Speaking Mock Interview</div>
                    <div class="interview-countdown @(interviewSecondsLeft <= 10 ? "urgent" : "")">
                        <i class="bi bi-stopwatch"></i> Thời gian còn lại: <strong>@interviewSecondsLeft s</strong>
                    </div>
                </div>
            </div>
            @if (interviewState == InterviewState.QuestionActive)
            {
                <div class="interview-practice-box">
                    <div class="examiner-avatar-box">
                        <div class="examiner-icon">🎙️</div>
                        <h3>Giám khảo đang lắng nghe bạn...</h3>
                    </div>
                    <div class="interview-record-area">
                        @if (state == PracticeState.Idle)
                        {
                            <button class="btn-start-record btn-lg" @onclick="StartRecording">Bấm để trả lời</button>
                        }
                        else if (state == PracticeState.Recording)
                        {
                            <button class="btn-stop-record" @onclick="StopRecording">Hoàn thành câu này</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (currentTopic == null)
    {
        <!-- View 10 Topic Cards -->
        <div class="topics-overview-section">
            <div class="section-intro-bar">
                <div class="intro-left">
                    <h2 class="section-heading"><i class="bi bi-grid-fill text-primary"></i> Chọn Chủ Đề Luyện Tập</h2>
                </div>
            </div>

            <!-- Khung vàng nổi bật: Khuyến nghị truy cập bằng Chrome -->
