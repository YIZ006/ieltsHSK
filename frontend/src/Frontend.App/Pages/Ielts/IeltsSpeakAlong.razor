    protected override async Task OnParametersSetAsync()
    {
        var targetPart = !string.IsNullOrWhiteSpace(Part) ? NormalizePart(Part) : "Audio";
        if (targetPart != activePart)
        {
            activePart = targetPart;
            await LoadExamData();
        }
    }

    private string NormalizePart(string p)
    {
        var clean = p.ToLowerInvariant().Replace(" ", "").Replace("-", "").Replace("_", "");
        if (clean.Contains("audio") || clean.Contains("cambridge")) return "Audio";
        if (clean.Contains("youtube") || clean.Contains("video")) return "YouTube";
        if (clean.Contains("100") || clean.Contains("all") || clean.Contains("full")) return "100Sentences";
        if (clean.Contains("part1") || clean.Contains("1")) return "Part1";
        if (clean.Contains("part2") || clean.Contains("2")) return "Part2";
        if (clean.Contains("part3") || clean.Contains("3")) return "Part3";
        return "Audio";
    }

    private async Task LoadStreakData()
    {
        try
        {
            var savedStreak = await JS.InvokeAsync<string?>("localStorage.getItem", "ielts_shadowing_streak_days");
            if (int.TryParse(savedStreak, out int s)) streakDays = s;
            else streakDays = 5;
        }
        catch { streakDays = 5; }
    }

    private async Task LoadAudioLessons()
    {
        try
        {
            audioLessons = await SpeakAlongService.LoadAudioLessonsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[IeltsSpeakAlong] LoadAudioLessons failed: {ex.Message}");
        }
    }

    private async Task LoadExamData()
    {
        isLoading = true;
        ResetToIdle();
        currentTopic = null;
        selectedVideo = null;
        selectedAudioLesson = null;

        if (activePart == "Audio")
        {
            await LoadAudioLessons();
        }
        else if (activePart == "YouTube")
        {
            await LoadYouTubeVideos();
        }
        else
        {
            exam = await SpeakAlongService.LoadExamAsync(activePart);
            if (exam != null && exam.Items != null)
            {
                allItems = exam.Items.ToList();
                BuildTopicGroups();
            }
        }

        isLoading = false;
    }

    // ── Audio Shadowing Logic ────────────────────────────────────────────

    private async Task SelectAudioLesson(AudioLessonDto lesson)
    {
        isLoading = true;
        selectedAudioLesson = lesson;
        currentAudioLineIndex = 0;
        ResetToIdle();

        if (selectedAudioLesson.Lines == null || selectedAudioLesson.Lines.Count == 0)
        {
            try
            {
                var source = !string.IsNullOrEmpty(lesson.JsonFile) ? lesson.JsonFile : $"sample-data/{lesson.Id}.json";
                var jsonText = await Http.GetStringAsync(source);
                var parsed = JsonSerializer.Deserialize<AudioLessonDataParsed>(jsonText, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (parsed?.Lines != null && parsed.Lines.Count > 0)
                {
                    selectedAudioLesson.Lines = parsed.Lines;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading audio lesson JSON: {ex.Message}");
            }
        }

        currentAudioLine = selectedAudioLesson?.Lines?.FirstOrDefault();
        if (currentAudioLine != null)
        {
            PrepareModelTokens(currentAudioLine.Text);
        }

        isLoading = false;
        StateHasChanged();

        await Task.Delay(150);
        await JS.InvokeVoidAsync("initAudioShadowPlayer", "engnovate-main-audio", selectedAudioLesson?.AudioUrl);
    }

    public class AudioLessonDataParsed
    {
        public string Title { get; set; } = "";
        public string AudioUrl { get; set; } = "";
        public List<AudioLessonLine> Lines { get; set; } = new();
    }

    private void SelectAudioLine(int index)
    {
        if (selectedAudioLesson != null && index >= 0 && index < selectedAudioLesson.Lines.Count)
        {
            currentAudioLineIndex = index;
            currentAudioLine = selectedAudioLesson.Lines[index];
            PrepareModelTokens(currentAudioLine.Text);
            ResetToIdle();
            _ = PlayCurrentAudioLineOnce();
        }
    }

    private void NextAudioLine()
    {
        if (selectedAudioLesson != null && currentAudioLineIndex < selectedAudioLesson.Lines.Count - 1)
        {
            SelectAudioLine(currentAudioLineIndex + 1);
        }
    }

    private void PrevAudioLine()
    {
        if (selectedAudioLesson != null && currentAudioLineIndex > 0)
        {
            SelectAudioLine(currentAudioLineIndex - 1);
        }
    }

    private void BackToAudioList()
    {
        selectedAudioLesson = null;
        isLoopingAudio = false;
        isPlayingAudio = false;
        JS.InvokeVoidAsync("pauseAudioSegment");
        ResetToIdle();
    }

    private async Task PlayCurrentAudioLineOnce()
    {
        if (currentAudioLine == null) return;
        isPlayingAudio = true;
        isLoopingAudio = false;
        await JS.InvokeVoidAsync("playAudioSegment", currentAudioLine.StartTime, currentAudioLine.EndTime, audioSpeed, false, dotNetRef);
    }

    private async Task ToggleLoopAudio()
    {
        if (currentAudioLine == null) return;
        isLoopingAudio = !isLoopingAudio;
        isPlayingAudio = isLoopingAudio;

        if (isLoopingAudio)
        {
            await JS.InvokeVoidAsync("playAudioSegment", currentAudioLine.StartTime, currentAudioLine.EndTime, audioSpeed, true, dotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("pauseAudioSegment");
        }
    }

    private async Task SetAudioSpeed(double speed)
    {
        audioSpeed = speed;
        await JS.InvokeVoidAsync("setAudioSegmentRate", audioSpeed);
    }

    private int GetCompletedAudioLineCount()
    {
        if (selectedAudioLesson == null) return 0;
        return selectedAudioLesson.Lines.Count(l => l.IsCompleted);
    }

    // ── YouTube Video Shadowing Logic ────────────────────────────────────

    private async Task LoadYouTubeVideos()
    {
        try
        {
            var all = await IeltsService.GetListenFillVideosAsync();
            if (all != null && all.Count > 0)
            {
                ytVideos = all.Take(8).ToList();
            }
        }
        catch { }
    }

    private async Task SelectYouTubeVideo(ListenVideoDto video)
    {
        selectedVideo = video;
        currentSegmentIndex = 0;
        videoSegments.Clear();
        ResetToIdle();

        if (!string.IsNullOrEmpty(video.TranscriptUrl))
        {
            try
            {
                var transcriptData = await Http.GetFromJsonAsync<TranscriptRootDto>(video.TranscriptUrl);
                if (transcriptData?.Words != null && transcriptData.Words.Count > 0)
                {
                    BuildSegmentsFromWords(transcriptData.Words);
                }
            }
            catch { }
        }

        currentSegment = videoSegments.FirstOrDefault();
        if (currentSegment != null)
        {
            PrepareModelTokens(currentSegment.Text);
        }

        await Task.Delay(150);
        var ytId = GetYouTubeId(selectedVideo.YoutubeUrl);
        await JS.InvokeVoidAsync("initYouTubeShadowPlayer", "yt-shadow-player", ytId, dotNetRef);
    }

    private void BuildSegmentsFromWords(List<TranscriptWordDto> words)
    {
        videoSegments.Clear();
        if (words == null || words.Count == 0) return;

        var currentChunk = new List<TranscriptWordDto>();
        int segIndex = 0;

        for (int i = 0; i < words.Count; i++)
        {
            var w = words[i];
            currentChunk.Add(w);

            var cleanWord = w.Text.Trim();
            bool isTerminalPunctuation = cleanWord.EndsWith(".") || cleanWord.EndsWith("?") || cleanWord.EndsWith("!") || cleanWord.EndsWith("...");
            if (isTerminalPunctuation && cleanWord.Length <= 4 && char.IsUpper(cleanWord[0]))
            {
                isTerminalPunctuation = false;
            }

            double silenceGap = (i < words.Count - 1) ? (words[i + 1].Start - (w.Start + w.Duration)) : 0;
            bool isNaturalPauseEnd = silenceGap >= 0.70 && currentChunk.Count >= 4;
            bool isLastWord = (i == words.Count - 1);

            if (isTerminalPunctuation || isNaturalPauseEnd || currentChunk.Count >= 18 || isLastWord)
            {
                var start = currentChunk.First().Start;
                var lastW = currentChunk.Last();
                double naturalEnd = lastW.Start + Math.Max(lastW.Duration, 0.45);
                double end = (i < words.Count - 1) ? Math.Min(naturalEnd + 0.35, words[i + 1].Start - 0.05) : naturalEnd + 0.4;
                if (end < naturalEnd) end = naturalEnd + 0.15;

                videoSegments.Add(new VideoSegment
                {
                    Index = segIndex++,
                    StartTime = Math.Round(Math.Max(0, start), 2),
                    EndTime = Math.Round(end, 2),
                    Text = string.Join(" ", currentChunk.Select(c => c.Text.Trim()))
                });
                currentChunk.Clear();
            }
        }
    }

    private void SelectSegment(int index)
    {
        if (index >= 0 && index < videoSegments.Count)
        {
            currentSegmentIndex = index;
            currentSegment = videoSegments[index];
            PrepareModelTokens(currentSegment.Text);
            ResetToIdle();
            _ = PlayCurrentSegmentOnce();
        }
    }

    private void NextVideoSegment()
    {
        if (currentSegmentIndex < videoSegments.Count - 1)
        {
            SelectSegment(currentSegmentIndex + 1);
        }
    }

    private void PrevVideoSegment()
    {
        if (currentSegmentIndex > 0)
        {
            SelectSegment(currentSegmentIndex - 1);
        }
    }

    private void BackToVideoList()
    {
        selectedVideo = null;
        JS.InvokeVoidAsync("pauseYouTubeShadowPlayer");
        ResetToIdle();
    }

    private async Task PlayCurrentSegmentOnce()
    {
        if (currentSegment == null) return;
        await JS.InvokeVoidAsync("playYouTubeSegment", currentSegment.StartTime, currentSegment.EndTime, videoSpeed, false, dotNetRef);
    }

    [JSInvokable]
    public void OnShadowPlayerReady() { }

    [JSInvokable]
    public void OnSegmentPlaybackEnded()
    {
        isPlayingAudio = false;
        InvokeAsync(StateHasChanged);
    }

    private string GetYouTubeId(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "";
        if (url.Contains("v=")) return url.Split("v=")[1].Split("&")[0];
        if (url.Contains("youtu.be/")) return url.Split("youtu.be/")[1].Split("?")[0];
        return url;
    }

    private string FormatTimestamp(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.ToString(@"mm\:ss");
    }

    // ── Topic Groups (Standard Shadowing) ────────────────────────────────

    private void BuildTopicGroups()
    {
        topics.Clear();
        if (allItems.Count == 0) return;

        var topicDefs = new[]
        {
            ("hometown", "🏡", "Hometown & Living", "Quê hương & Nhà ở", 1, 10, "Band 6.0 - 6.5"),
            ("routine", "⏰", "Daily Routine & Habits", "Thói quen hàng ngày", 21, 30, "Band 6.0 - 6.5"),
            ("food", "🍜", "Food & Culinary Culture", "Ẩm thực & Nấu ăn", 41, 50, "Band 6.5 - 7.0"),
            ("work", "💼", "Work & Study", "Công việc & Học tập", 11, 20, "Band 6.5 - 7.0"),
            ("travel", "✈️", "Travel & Transport", "Du lịch & Đi lại", 31, 40, "Band 7.0 - 7.5"),
            ("health", "🏃", "Fitness & Wellbeing", "Thể thao & Sức khỏe", 81, 90, "Band 7.0 - 7.5"),
            ("tech", "🤖", "Technology & AI", "Công nghệ & Trí tuệ nhân tạo", 51, 60, "Band 7.5 - 8.0"),
            ("environment", "🌿", "Environment & Nature", "Môi trường & Thiên nhiên", 61, 70, "Band 7.5 - 8.0"),
            ("art", "🎨", "Art, Music & Cinema", "Nghệ thuật & Giải trí", 71, 80, "Band 8.0 - 8.5"),
            ("future", "🚀", "Vision & Society", "Tầm nhìn & Xã hội", 91, 100, "Band 8.0 - 8.5")
        };

        foreach (var (id, icon, en, vi, startId, endId, bandTag) in topicDefs)
        {
            var chunk = allItems.Where(i => i.Id >= startId && i.Id <= endId).ToList();
            if (chunk.Count > 0)
            {
                topics.Add(new TopicGroup
                {
                    Id = id,
                    Icon = icon,
                    TitleEn = en,
                    TitleVi = vi,
                    LevelTag = bandTag,
                    Items = chunk
                });
            }
        }
    }

    private void SelectTopic(TopicGroup topic)
    {
        currentTopic = topic;
        topicCurrentIndex = 0;
        LoadCurrentItem();
    }

    private void BackToTopics()
    {
        currentTopic = null;
        ResetToIdle();
    }

    private void LoadCurrentItem()
    {
        if (currentTopic != null && currentTopic.Items.Count > topicCurrentIndex)
        {
            currentItem = currentTopic.Items[topicCurrentIndex];
            PrepareModelTokens(currentItem.ModelAnswer);
            ResetToIdle();
        }
    }

    private void PrepareModelTokens(string answer)
    {
        if (string.IsNullOrWhiteSpace(answer))
        {
            modelTokens = new List<string>();
            return;
        }
        modelTokens = answer.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        activeKaraokeWordIndex = -1;
    }

    private async Task PlayModelTts()
    {
        var text = activePart == "Audio" ? currentAudioLine?.Text : (activePart == "YouTube" ? currentSegment?.Text : currentItem?.ModelAnswer);
        if (string.IsNullOrWhiteSpace(text)) return;

        isPlayingAll = true;
        activeKaraokeWordIndex = 0;
        StateHasChanged();
        await JS.InvokeVoidAsync("SpeakAlongInterop.speakTextWithKaraoke", text, "en-US", ttsRate, dotNetRef);
    }

    [JSInvokable]
    public void OnKaraokeWordBoundary(int charIndex, int charLength)
    {
        if (modelTokens.Count == 0) return;
        int curChar = 0;
        for (int i = 0; i < modelTokens.Count; i++)
        {
            if (curChar <= charIndex && charIndex < curChar + modelTokens[i].Length + 1)
            {
                activeKaraokeWordIndex = i;
                InvokeAsync(StateHasChanged);
                break;
            }
            curChar += modelTokens[i].Length + 1;
        }
    }

    [JSInvokable]
    public void OnKaraokeEnded()
    {
        isPlayingAll = false;
        activeKaraokeWordIndex = -1;
        InvokeAsync(StateHasChanged);
    }

