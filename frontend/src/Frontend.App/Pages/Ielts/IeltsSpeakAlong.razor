    private void BuildSegmentsFromWords(List<TranscriptWordDto> words)
    {
        videoSegments.Clear();
        if (words == null || words.Count == 0) return;

        var currentChunk = new List<TranscriptWordDto>();
        int segIndex = 0;

        for (int i = 0; i < words.Count; i++)
        {
            var w = words[i];
            currentChunk.Add(w);

            var cleanWord = w.Text.Trim();
            bool isTerminalPunctuation = cleanWord.EndsWith(".") || cleanWord.EndsWith("?") || cleanWord.EndsWith("!") || cleanWord.EndsWith("...");
            if (isTerminalPunctuation && cleanWord.Length <= 4 && char.IsUpper(cleanWord[0]))
            {
                isTerminalPunctuation = false;
            }

            double silenceGap = (i < words.Count - 1) ? (words[i + 1].Start - (w.Start + w.Duration)) : 0;
            bool isNaturalPauseEnd = silenceGap >= 0.70 && currentChunk.Count >= 4;
            bool isLastWord = (i == words.Count - 1);

            if (isTerminalPunctuation || isNaturalPauseEnd || currentChunk.Count >= 18 || isLastWord)
            {
                var start = currentChunk.First().Start;
                var lastW = currentChunk.Last();
                double naturalEnd = lastW.Start + Math.Max(lastW.Duration, 0.45);
                double end = (i < words.Count - 1) ? Math.Min(naturalEnd + 0.35, words[i + 1].Start - 0.05) : naturalEnd + 0.4;
                if (end < naturalEnd) end = naturalEnd + 0.15;

                videoSegments.Add(new VideoSegment
                {
                    Index = segIndex++,
                    StartTime = Math.Round(Math.Max(0, start), 2),
                    EndTime = Math.Round(end, 2),
                    Text = string.Join(" ", currentChunk.Select(c => c.Text.Trim()))
                });
                currentChunk.Clear();
            }
        }
    }

