                                {
                                    <option value="@m.DeviceId">@m.Label</option>
                                }
                            </select>
                            <button class="btn-refresh-devices" @onclick="RefreshMicrophonesList" title="Làm mới danh sách Micro">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                    }

                    <div class="waveform-box">
