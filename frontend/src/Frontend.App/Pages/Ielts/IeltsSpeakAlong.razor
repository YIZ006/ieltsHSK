    private async Task SelectAudioLesson(AudioLessonDto lesson)
    {
        isLoading = true;
        selectedAudioLesson = lesson;
        currentAudioLineIndex = 0;
        ResetToIdle();

        if (selectedAudioLesson.Lines == null || selectedAudioLesson.Lines.Count == 0)
        {
            try
            {
                var source = !string.IsNullOrEmpty(lesson.JsonFile) ? lesson.JsonFile : $"sample-data/{lesson.Id}.json";
                var jsonText = await Http.GetStringAsync(source);
                var parsed = JsonSerializer.Deserialize<AudioLessonDataParsed>(jsonText, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (parsed?.Lines != null && parsed.Lines.Count > 0)
                {
                    selectedAudioLesson.Lines = parsed.Lines;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading audio lesson JSON: {ex.Message}");
            }
        }

        currentAudioLine = selectedAudioLesson.Lines.FirstOrDefault();
        if (currentAudioLine != null)
        {
            PrepareModelTokens(currentAudioLine.Text);
        }

        isLoading = false;
        StateHasChanged();

        await Task.Delay(150);
        await JS.InvokeVoidAsync("initAudioShadowPlayer", "engnovate-main-audio", selectedAudioLesson.AudioUrl);
    }

