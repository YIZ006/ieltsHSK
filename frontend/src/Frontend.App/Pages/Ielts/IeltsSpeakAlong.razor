<!-- Modal Audio & Mic Test -->
@if (showAudioTestModal)
{
    <div class="audio-modal-overlay" @onclick="CloseAudioTestModal">
        <div class="audio-modal-card" @onclick:stopPropagation>
            <div class="audio-modal-header">
                <div class="audio-modal-title">
                    <i class="bi bi-mic-fill text-primary"></i>
                    <div>
                        <h3>Kiểm tra Micro & Âm thanh</h3>
                        <p class="audio-modal-sub">Đảm bảo tai nghe và microphone thu âm rõ nét trước khi luyện nói</p>
                    </div>
                </div>
                <button class="audio-modal-close" @onclick="CloseAudioTestModal">×</button>
            </div>
            <div class="audio-modal-body">
                <!-- Step 1: Chọn & Test Micro -->
                <div class="test-step-card mb-3">
                    <div class="step-badge-title">
                        <i class="bi bi-mic text-primary"></i>
                        <span>Bước 1: Kiểm tra Microphone</span>
                    </div>

