    private async Task StartRecording()
    {
        state = PracticeState.Recording;
        liveTranscript = "";
        userAudioUrl = "";
        recordDurationSec = 0;

        recordTimer?.Dispose();
        recordTimer = new System.Threading.Timer(_ =>
        {
            recordDurationSec++;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

