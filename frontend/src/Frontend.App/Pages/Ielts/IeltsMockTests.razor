@page "/ielts/luyen-de"
@layout Frontend.App.Layout.IeltsLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject MockTestService MockTestService
@inject ExamSubmissionService SubmissionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>IELTS Mock Tests - Luyện Thi Thử</PageTitle>

<div class="mocktests-container">
    <div class="main-content">
        <!-- Mock Test Collection Header -->
        <div class="collection-header">
            <div class="collection-image">
                <img src="/sample-data/mocktest-cover.png" alt="IELTS Mock Test" onerror="this.src='https://placehold.co/400x400/1e1e1e/FFF?text=IELTS+MOCK+TEST'" />
            </div>
            <div class="collection-info">
                <h1>IELTS Mock Test 2025 December</h1>
                <div class="rating">
                    <span class="score">4.8</span>
                    <span class="stars">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-half"></i>
                    </span>
                    <span class="votes">(1,420 votes)</span>
                </div>
                <div class="meta">
                    <p><i class="bi bi-calendar"></i> Xuất bản: <strong>Tháng 12/2025 - 2026</strong></p>
                    <p><i class="bi bi-lightning-charge"></i> Lượt thi: <strong>130,816</strong></p>
                </div>
            </div>
        </div>

        <!-- Tests List -->
        @if (isLoading)
        {
            <div class="loading-spinner">Đang tải danh sách đề thi...</div>
        }
        else if (mockTests.Count == 0)
        {
            <div class="empty-state">Chưa có đề thi nào trong hệ thống.</div>
        }
        else
        {
            <div class="tests-grid">
                @foreach (var test in mockTests)
                {
                    var lSub = GetLatestSub("Listening", test.ListeningUrl, test);
                    var rSub = GetLatestSub("Reading", test.ReadingUrl, test);
                    var wSub = GetLatestSub("Writing", test.WritingUrl, test);
                    var sSub = GetLatestSub("Speaking", test.SpeakingUrl, test);
                    bool hasAnyAttempt = lSub != null || rSub != null || wSub != null || sSub != null;

                    <div class="test-block">
                        <div class="test-block-header">
                            <h2>@test.Title</h2>
                            <button class="btn-summary-link @(hasAnyAttempt ? "has-data" : "")"
                                    @onclick="() => OpenSummary(test)">
                                <i class="bi bi-bar-chart-fill"></i> Tổng hợp kết quả
                            </button>
                        </div>

                        <div class="skills-grid">
                            <!-- Listening -->
                            <div class="skill-card listening @(lSub != null ? "attempted" : "")">
                                <div class="skill-header">
                                    <div class="sh-left">
                                        <i class="bi bi-headphones"></i>
                                        <span>Listening</span>
                                    </div>
                                    @if (lSub != null)
                                    {
                                        @if (lSub.BandScore.HasValue && lSub.BandScore.Value > 0)
                                        {
                                            <span class="skill-score-badge">Band @lSub.BandScore.Value.ToString("0.0")</span>
                                        }
                                        else
                                        {
                                            <span class="skill-score-badge pending"><i class="bi bi-check-circle"></i> Đã làm</span>
                                        }
                                    }
                                </div>
                                <div class="skill-btn-group">
                                    <button class="btn-take-test" 
                                            disabled="@string.IsNullOrEmpty(test.ListeningUrl)"
                                            @onclick="() => TakeListeningTest(test)">
                                        <i class="bi bi-play-circle-fill"></i> @(lSub != null ? "Làm lại" : "Làm bài")
                                    </button>
                                    @if (lSub != null)
                                    {
                                        <button class="btn-review-mini" @onclick="() => ReviewListening(test, lSub)">
                                            <i class="bi bi-search"></i> Xem đáp án
                                        </button>
                                    }
                                </div>
                            </div>
                            
                            <!-- Reading -->
                            <div class="skill-card reading @(rSub != null ? "attempted" : "")">
                                <div class="skill-header">
                                    <div class="sh-left">
                                        <i class="bi bi-file-text"></i>
                                        <span>Reading</span>
                                    </div>
                                    @if (rSub != null)
                                    {
                                        @if (rSub.BandScore.HasValue && rSub.BandScore.Value > 0)
                                        {
                                            <span class="skill-score-badge">Band @rSub.BandScore.Value.ToString("0.0")</span>
                                        }
                                        else
                                        {
                                            <span class="skill-score-badge pending"><i class="bi bi-check-circle"></i> Đã làm</span>
                                        }
                                    }
                                </div>
                                <div class="skill-btn-group">
                                    <button class="btn-take-test" 
                                            disabled="@string.IsNullOrEmpty(test.ReadingUrl)"
                                            @onclick="() => TakeReadingTest(test)">
                                        <i class="bi bi-play-circle-fill"></i> @(rSub != null ? "Làm lại" : "Làm bài")
                                    </button>
                                    @if (rSub != null)
                                    {
                                        <button class="btn-review-mini" @onclick="() => ReviewReading(test, rSub)">
                                            <i class="bi bi-search"></i> Xem đáp án
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Writing -->
                            <div class="skill-card writing @(wSub != null ? "attempted" : "")">
                                <div class="skill-header">
                                    <div class="sh-left">
                                        <i class="bi bi-pen"></i>
                                        <span>Writing</span>
                                    </div>
                                    @if (wSub != null)
                                    {
                                        @if ((wSub.Status == "Graded" || wSub.Status == "Scored") && (wSub.BandScore.HasValue || wSub.Score?.Overall > 0))
                                        {
                                            <span class="skill-score-badge">Band @((wSub.BandScore ?? wSub.Score?.Overall ?? 0).ToString("0.0"))</span>
                                        }
                                        else
                                        {
                                            <span class="skill-score-badge pending"><i class="bi bi-hourglass-split"></i> Chờ chấm</span>
                                        }
                                    }
                                </div>
                                <div class="skill-btn-group">
                                    <button class="btn-take-test" 
                                            disabled="@string.IsNullOrEmpty(test.WritingUrl)"
                                            @onclick="() => TakeWritingTest(test)">
                                        <i class="bi bi-play-circle-fill"></i> @(wSub != null ? "Viết lại" : "Làm bài")
                                    </button>
                                    @if (wSub != null)
                                    {
                                        <button class="btn-review-mini" @onclick="() => ReviewWriting(test, wSub)">
                                            <i class="bi bi-file-text"></i> Xem bài viết
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Speaking -->
                            <div class="skill-card speaking @(sSub != null ? "attempted" : "")">
                                <div class="skill-header">
                                    <div class="sh-left">
                                        <i class="bi bi-mic"></i>
                                        <span>Speaking</span>
                                    </div>
                                    @if (sSub != null)
                                    {
                                        @if ((sSub.Status == "Graded" || sSub.Status == "Scored") && (sSub.BandScore.HasValue || sSub.Score?.Overall > 0))
                                        {
                                            <span class="skill-score-badge">Band @((sSub.BandScore ?? sSub.Score?.Overall ?? 0).ToString("0.0"))</span>
                                        }
                                        else
                                        {
                                            <span class="skill-score-badge pending"><i class="bi bi-hourglass-split"></i> Chờ chấm</span>
                                        }
                                    }
                                </div>
                                <div class="skill-btn-group">
                                    <button class="btn-take-test"
                                            disabled="@string.IsNullOrEmpty(test.SpeakingUrl)"
                                            @onclick="() => TakeSpeakingTest(test)">
                                        <i class="bi bi-play-circle-fill"></i> @(sSub != null ? "Thi lại" : "Làm bài")
                                    </button>
                                    @if (sSub != null)
                                    {
                                        <button class="btn-review-mini" @onclick="() => ReviewSpeaking(test, sSub)">
                                            <i class="bi bi-soundwave"></i> Xem bài nói
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sidebar Banner -->
    <div class="sidebar">
        <div class="ad-banner">
            <h3>Luyện Thi IELTS<br/><span class="highlight">Đạt Target Band</span></h3>
            <p>Hệ thống chấm điểm thông minh 4 kỹ năng chuẩn Cambridge.</p>
            <button class="btn-learn-more" @onclick="@(() => NavigationManager.NavigateTo("/ielts/vocab"))">Học từ vựng IELTS</button>
            <img src="https://placehold.co/300x200/1e1e1e/FFF?text=IELTS+Preparation" alt="IELTS Prep" />
        </div>
    </div>
</div>

@code {
    private List<MockTestDto> mockTests = new();
    private List<IeltsSubmissionRecord> submissions = new();
    private bool isLoading = true;

    private DotNetObjectReference<IeltsMockTests>? _dotNetRef;
    private int? _visibilityHookId;
    private DateTimeOffset _lastLoad = DateTimeOffset.MinValue;

    protected override async Task OnInitializedAsync()
    {
        _lastLoad = DateTimeOffset.UtcNow;
        isLoading = true;
        try
        {
            var allTests = await MockTestService.GetMockTestsAsync();
            mockTests = allTests.Where(t =>
                string.IsNullOrEmpty(t.ToeicUrl) &&
                string.IsNullOrEmpty(t.HskUrl) &&
                !(t.Title != null && t.Title.Contains("HSK", StringComparison.OrdinalIgnoreCase)) &&
                !(t.CollectionName != null && t.CollectionName.Contains("HSK", StringComparison.OrdinalIgnoreCase)) &&
                !(t.Title != null && t.Title.Contains("TOEIC", StringComparison.OrdinalIgnoreCase)) &&
                !(t.CollectionName != null && t.CollectionName.Contains("TOEIC", StringComparison.OrdinalIgnoreCase))
            ).ToList();

            submissions = await SubmissionService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading mock tests: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _visibilityHookId = await JS.InvokeAsync<int>("TabVisibility.register", _dotNetRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[IeltsMockTests] Tab visibility hook: {ex.Message}");
        }
    }

    // Được JS gọi khi người dùng quay lại tab này (VD: sau khi chấm điểm ở tab khác),
    // để badge "Chờ chấm" kịp đổi thành band chính thức mà không cần F5.
    [JSInvokable]
    public async Task OnTabVisibleAsync()
    {
        if (DateTimeOffset.UtcNow - _lastLoad < TimeSpan.FromSeconds(2)) return;
        _lastLoad = DateTimeOffset.UtcNow;
        try
        {
            submissions = await SubmissionService.GetAllAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[IeltsMockTests] Refresh on visible: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_visibilityHookId.HasValue)
        {
            try
            {
                await JS.InvokeVoidAsync("TabVisibility.unregister", _visibilityHookId.Value);
            }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }

    private IeltsSubmissionRecord? GetLatestSub(string skill, string? examUrl, MockTestDto test)
    {
        return submissions
            .Where(s => string.Equals(s.Skill, skill, StringComparison.OrdinalIgnoreCase))
            .Where(s => 
                (s.MockTestId.HasValue && s.MockTestId == test.Id) ||
                ExamSubmissionService.IsUrlMatch(s.ExamUrl, examUrl) ||
                (!string.IsNullOrWhiteSpace(s.TestTitle) && string.Equals(s.TestTitle, test.Title, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(s.ExamTitle) && (
                    string.Equals(s.ExamTitle, test.Title, StringComparison.OrdinalIgnoreCase) ||
                    s.ExamTitle.Contains(test.Title, StringComparison.OrdinalIgnoreCase)
                ))
            )
            .OrderByDescending(s => s.Status == "Graded" || s.Status == "Scored" ? 1 : 0)
            .ThenByDescending(s => s.SubmittedAt)
            .FirstOrDefault();
    }

    private static string NewSessionQuery() => $"Session={Guid.NewGuid():N}";

    private void OpenSummary(MockTestDto test)
    {
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        NavigationManager.NavigateTo($"/ielts/mock-test/summary?MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}");
    }

    private void TakeReadingTest(MockTestDto test)
    {
        if (string.IsNullOrEmpty(test.ReadingUrl)) return;
        var extra = string.IsNullOrWhiteSpace(test.ReadingAnswerUrl) ? "" : $"&AnswerUrl={Uri.EscapeDataString(test.ReadingAnswerUrl)}";
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        NavigationManager.NavigateTo($"/ielts/reading/preview?ExamUrl={Uri.EscapeDataString(test.ReadingUrl)}{extra}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}&{NewSessionQuery()}");
    }

    private void ReviewReading(MockTestDto test, IeltsSubmissionRecord sub)
    {
        var extra = string.IsNullOrWhiteSpace(test.ReadingAnswerUrl) ? "" : $"&AnswerUrl={Uri.EscapeDataString(test.ReadingAnswerUrl)}";
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        var sess = string.IsNullOrWhiteSpace(sub.SessionId) ? "" : $"&Session={Uri.EscapeDataString(sub.SessionId)}";
        var subId = string.IsNullOrWhiteSpace(sub.Id) ? "" : $"&SubmissionId={Uri.EscapeDataString(sub.Id)}";
        NavigationManager.NavigateTo($"/ielts/review?Skill=Reading&ExamUrl={Uri.EscapeDataString(test.ReadingUrl ?? "")}{extra}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}{sess}{subId}");
    }

    private void TakeListeningTest(MockTestDto test)
    {
        if (string.IsNullOrEmpty(test.ListeningUrl)) return;
        var extra = string.IsNullOrWhiteSpace(test.ListeningAnswerUrl) ? "" : $"&AnswerUrl={Uri.EscapeDataString(test.ListeningAnswerUrl)}";
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        NavigationManager.NavigateTo($"/ielts/listening/preview?ExamUrl={Uri.EscapeDataString(test.ListeningUrl)}{extra}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}&{NewSessionQuery()}");
    }

    private void ReviewListening(MockTestDto test, IeltsSubmissionRecord sub)
    {
        var extra = string.IsNullOrWhiteSpace(test.ListeningAnswerUrl) ? "" : $"&AnswerUrl={Uri.EscapeDataString(test.ListeningAnswerUrl)}";
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        var sess = string.IsNullOrWhiteSpace(sub.SessionId) ? "" : $"&Session={Uri.EscapeDataString(sub.SessionId)}";
        var subId = string.IsNullOrWhiteSpace(sub.Id) ? "" : $"&SubmissionId={Uri.EscapeDataString(sub.Id)}";
        NavigationManager.NavigateTo($"/ielts/review?Skill=Listening&ExamUrl={Uri.EscapeDataString(test.ListeningUrl ?? "")}{extra}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}{sess}{subId}");
    }

    private void TakeWritingTest(MockTestDto test)
    {
        if (string.IsNullOrEmpty(test.WritingUrl)) return;
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        NavigationManager.NavigateTo($"/ielts/writing/preview?ExamUrl={Uri.EscapeDataString(test.WritingUrl)}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}&{NewSessionQuery()}");
    }

    private void ReviewWriting(MockTestDto test, IeltsSubmissionRecord sub)
    {
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        var sess = string.IsNullOrWhiteSpace(sub.SessionId) ? "" : $"&Session={Uri.EscapeDataString(sub.SessionId)}";
        var subId = string.IsNullOrWhiteSpace(sub.Id) ? "" : $"&SubmissionId={Uri.EscapeDataString(sub.Id)}";
        NavigationManager.NavigateTo($"/ielts/review?Skill=Writing&ExamUrl={Uri.EscapeDataString(test.WritingUrl ?? "")}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}{sess}{subId}");
    }

    private void TakeSpeakingTest(MockTestDto test)
    {
        if (string.IsNullOrEmpty(test.SpeakingUrl)) return;
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        NavigationManager.NavigateTo($"/ielts/speaking/preview?ExamUrl={Uri.EscapeDataString(test.SpeakingUrl)}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}&{NewSessionQuery()}");
    }

    private void ReviewSpeaking(MockTestDto test, IeltsSubmissionRecord sub)
    {
        var coll = string.IsNullOrWhiteSpace(test.CollectionName) ? "IELTS Mock Test 2025 December" : test.CollectionName;
        var sess = string.IsNullOrWhiteSpace(sub.SessionId) ? "" : $"&Session={Uri.EscapeDataString(sub.SessionId)}";
        var subId = string.IsNullOrWhiteSpace(sub.Id) ? "" : $"&SubmissionId={Uri.EscapeDataString(sub.Id)}";
        NavigationManager.NavigateTo($"/ielts/review?Skill=Speaking&ExamUrl={Uri.EscapeDataString(test.SpeakingUrl ?? "")}&MockTestId={test.Id}&CollectionName={Uri.EscapeDataString(coll)}&Title={Uri.EscapeDataString(test.Title)}{sess}{subId}");
    }
}
