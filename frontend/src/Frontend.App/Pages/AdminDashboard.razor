@page "/admin"
@layout Frontend.App.Layout.AdminLayout

<PageTitle>Admin Dashboard</PageTitle>

<div class="dashboard-welcome">
    <div class="welcome-card">
        <h1>👋 Chào mừng đến với Admin Dashboard</h1>
        <p>Vui lòng chọn một chuyên mục từ thanh công cụ bên trên hoặc menu bên trái để bắt đầu quản lý.</p>
        
        <div class="quick-stats">
            <div class="stat-box">
                <div class="stat-icon ielts-color">🇬🇧</div>
                <div class="stat-info">
                    <h4>IELTS</h4>
                    <p>Quản lý Đề thi, Học viên</p>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-icon hsk-color">🇨🇳</div>
                <div class="stat-info">
                    <h4>HSK</h4>
                    <p>Quản lý Đề thi, Từ vựng</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-welcome {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        height: 100%;
        padding-top: 40px;
    }

    .welcome-card {
        background-color: white;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        text-align: center;
        max-width: 600px;
    }

    .welcome-card h1 {
        font-size: 24px;
        color: #2c3e50;
        margin-bottom: 16px;
    }

    .welcome-card p {
        color: #6c757d;
        font-size: 16px;
        margin-bottom: 40px;
        line-height: 1.5;
    }

    .quick-stats {
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .stat-box {
        display: flex;
        align-items: center;
        gap: 16px;
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 12px;
        flex: 1;
        text-align: left;
        border: 1px solid #e9ecef;
    }

    .stat-icon {
        font-size: 32px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

    .ielts-color {
        background-color: #e6f2ff;
    }

    .hsk-color {
        background-color: #ffe8e8;
    }

    .stat-info h4 {
        margin: 0 0 4px 0;
        font-size: 16px;
        color: #2c3e50;
    }

    .stat-info p {
        margin: 0;
        font-size: 13px;
        color: #6c757d;
    }
</style>
