@code {
    private List<SlangVocabItem>? allItems;
    private List<SlangVocabItem>? items;
    private string selectedCategory = "all";
    private string searchQuery = "";
    private bool hideLearned = false;
    private bool isFlashcardMode = false;
    private bool isLoading = true;

    private int currentCardIndex = 0;
    private bool isCardFlipped = false;

    private int learnedCount = 0;
    private int learnedPercent => (allItems != null && allItems.Count > 0)
        ? (int)Math.Round((double)learnedCount / allItems.Count * 100)
        : 0;

    private int cipherCount => allItems?.Count(x => x.Category.Contains("cipher") || x.Category.Contains("number")) ?? 0;
    private int trendCount => allItems?.Count(x => x.Category.Contains("trend") || x.Category.Contains("slang")) ?? 0;
    private int workCount => allItems?.Count(x => x.Category.Contains("work") || x.Category.Contains("tech")) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            allItems = await SlangService.GetSlangItemsAsync();
            UpdateLearnedStats();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[HskSlangVocab] Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateLearnedStats()
    {
        learnedCount = allItems?.Count(x => x.IsLearned) ?? 0;
    }

    private void ChangeCategory(string cat)
    {
        selectedCategory = cat;
        currentCardIndex = 0;
        isCardFlipped = false;
        ApplyFilter();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFilter();
    }

    private void ResetFilters()
    {
        selectedCategory = "all";
        searchQuery = "";
        hideLearned = false;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allItems == null)
        {
            items = new List<SlangVocabItem>();
            return;
        }

        var filtered = allItems.AsEnumerable();

        if (selectedCategory == "cipher")
        {
            filtered = filtered.Where(x => x.Category.Contains("cipher") || x.Category.Contains("number"));
        }
        else if (selectedCategory == "slang")
        {
            filtered = filtered.Where(x => x.Category.Contains("trend") || x.Category.Contains("slang"));
        }
        else if (selectedCategory == "work_tech")
        {
            filtered = filtered.Where(x => x.Category.Contains("work") || x.Category.Contains("tech"));
        }

        if (hideLearned)
        {
            filtered = filtered.Where(x => !x.IsLearned);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            filtered = filtered.Where(x =>
                x.Term.ToLowerInvariant().Contains(q) ||
                x.Pinyin.ToLowerInvariant().Contains(q) ||
                x.MeaningVi.ToLowerInvariant().Contains(q) ||
                (x.Origin != null && x.Origin.ToLowerInvariant().Contains(q)) ||
                (x.DialogueZh != null && x.DialogueZh.ToLowerInvariant().Contains(q)) ||
                (x.DialogueVi != null && x.DialogueVi.ToLowerInvariant().Contains(q)));
        }

        items = filtered.ToList();
        if (currentCardIndex >= items.Count)
        {
            currentCardIndex = 0;
        }
    }

    private async Task ToggleLearned(SlangVocabItem item)
    {
        var newState = await SlangService.ToggleLearnedAsync(item.Term);
        item.IsLearned = newState;

        var matching = allItems?.FirstOrDefault(x => x.Term == item.Term);
        if (matching != null) matching.IsLearned = newState;

        UpdateLearnedStats();
        if (hideLearned) ApplyFilter();
    }

    private async Task SpeakTerm(string term)
    {
        if (string.IsNullOrWhiteSpace(term)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("speakText", term, "zh-CN");
        }
        catch { }
    }

    private async Task SpeakLine(string rawLine)
    {
        if (string.IsNullOrWhiteSpace(rawLine)) return;
        var clean = rawLine.Replace("A:", "").Replace("B:", "").Replace("A：", "").Replace("B：", "").Trim();
        try
        {
            await JSRuntime.InvokeVoidAsync("speakText", clean, "zh-CN");
        }
        catch { }
    }

    private void FlipCard() => isCardFlipped = !isCardFlipped;
    private void NextCard()
    {
        if (items != null && currentCardIndex < items.Count - 1)
        {
            currentCardIndex++;
            isCardFlipped = false;
        }
    }
    private void PrevCard()
    {
        if (currentCardIndex > 0)
        {
            currentCardIndex--;
            isCardFlipped = false;
        }
    }

    private static string GetCategoryNameVi(string cat)
    {
        var c = cat.ToLowerInvariant();
        if (c.Contains("cipher") || c.Contains("number") || c.Contains("số")) return "Mật mã số mạng";
        if (c.Contains("trend") || c.Contains("slang") || c.Contains("lóng")) return "Hot Trend Douyin/Weibo";
        if (c.Contains("work") || c.Contains("tech") || c.Contains("công sở")) return "Đời sống & Công nghệ";
        return "Tiếng lóng GenZ";
    }

    private static string GetCategoryBadgeClass(string cat)
    {
        var c = cat.ToLowerInvariant();
        if (c.Contains("cipher") || c.Contains("number")) return "badge-cipher";
        if (c.Contains("trend") || c.Contains("slang")) return "badge-trend";
        if (c.Contains("work") || c.Contains("tech")) return "badge-work";
        return "badge-trend";
    }
}
