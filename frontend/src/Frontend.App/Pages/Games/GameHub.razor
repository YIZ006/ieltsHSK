        wordleTimer = new Timer(async _ =>
        {
            if (!isPlayingWordle || isGameOver) return;
            wordleTimerSeconds--;
            if (wordleTimerSeconds <= 0)
            {
                wordleTimerSeconds = 0;
                isGameOver = true;
                isGameWon = false;
                wordleStreak = 0;
                _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.lose()");
                _ = Task.Delay(300).ContinueWith(_ => InvokeAsync(PronounceWord));
                _ = Task.Delay(500).ContinueWith(_ => InvokeAsync(async () =>
                {
                    showResultModal = true;
                    StateHasChanged();
                    await FocusWordle();
                }));
                wordleTimer?.Dispose();
            }
            else
            {
                _ = JS.InvokeVoidAsync("eval", $"window.WordleSfx?.quantumTick({wordleTimerSeconds})");
            }
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void StopWordleTimer()
    {
        wordleTimer?.Dispose();
        wordleTimer = null;
    }

    private string FormatWordleTimer()
    {
        int m = wordleTimerSeconds / 60;
        int s = wordleTimerSeconds % 60;
        return $"{m:D2}:{s:D2}";
    }

    private string GetTimerUrgentClass()
    {
        if (wordleTimerSeconds <= 10 && wordleTimerSeconds > 0) return "urgent-10";
        if (wordleTimerSeconds <= 20 && wordleTimerSeconds > 0) return "urgent-20";
        if (wordleTimerSeconds <= 30 && wordleTimerSeconds > 0) return "urgent-30";
        return "";
    }

    private char? GetLockedLetterAt(int index)
    {
        if (hintLetterIndices.TryGetValue(index, out var hintChar))
            return hintChar;
        for (int r = 0; r < guessEvaluations.Count; r++)
        {
            var evals = guessEvaluations[r];
            if (index < evals.Count && evals[index] == "correct" && index < guesses[r].Length)
            {
                return guesses[r][index];
            }
        }
        return null;
    }

