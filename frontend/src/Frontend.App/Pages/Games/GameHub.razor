@page "/games"
@page "/tro-choi"
@page "/ielts/games"
@page "/ielts/tro-choi"
@page "/toeic/games"
@page "/toeic/tro-choi"
@page "/hsk/games"
@page "/hsk/tro-choi"
@layout Frontend.App.Layout.MainLayout
@using Frontend.App.Models
@using Frontend.App.Services
@inject IeltsService IeltsService
@inject HskService HskSvc
@inject ProfileService ProfileSvc
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Đấu Trường Trò Chơi Học Tập - ieltsHSK</PageTitle>

<div class="game-hub-page">
    <!-- Header Banner -->
    <div class="game-hub-header">
        <div class="header-left">
            <div class="hub-badge">
                <i class="bi bi-controller"></i> ARCADE ZONE
            </div>
            <h1>Đấu Trường Trò Chơi Học Tập</h1>
            <p>Khám phá các trò chơi ngôn ngữ tương tác, thử thách tư duy phản xạ và củng cố vốn từ vựng học thuật một cách cuốn hút nhất.</p>
        </div>

        <div class="hub-quick-stats">
            <div class="quick-stat-item">
                <div class="stat-num">@wordleScore</div>
                <div class="stat-lbl"><i class="bi bi-star-fill"></i> Điểm Wordle</div>
            </div>
            <div class="quick-stat-item">
                <div class="stat-num">@wordleStreak</div>
                <div class="stat-lbl"><i class="bi bi-fire"></i> Chuỗi Thắng</div>
            </div>
            <div class="quick-stat-item">
                <div class="stat-num">@vocabPool.Count</div>
                <div class="stat-lbl"><i class="bi bi-book-half"></i> Kho Từ Vựng</div>
            </div>
        </div>
    </div>

    <!-- Gallery Section -->
    <div class="section-title-row">
        <h2><i class="bi bi-controller me-2"></i>Kho Trò Chơi Học Thuật</h2>
        <span class="text-muted">Bấm vào bất kỳ trò chơi nào để xem luật chơi và khởi động toàn màn hình</span>
    </div>

    <div class="games-gallery">
        <!-- Game 1: IELTS Wordle -->
        <div class="game-card featured" @onclick='() => OpenGameInfo("wordle")'>
            <div class="card-badge">HOT • IELTS & TOEIC</div>
            <div class="card-icon-bubble wordle-bubble">
                <i class="bi bi-puzzle-fill"></i>
            </div>
            <h3>IELTS Wordle: Mật Thư Ngữ Cảnh</h3>
            <p>Đoán từ vựng học thuật trong 6 lượt qua câu ngữ cảnh khuyết từ, nghĩa tiếng Việt và manh mối ký tự theo phong cách Wordle kinh điển.</p>
            <div class="card-tags">
                <span><i class="bi bi-bullseye"></i> 6 lượt đoán</span>
                <span><i class="bi bi-chat-quote"></i> Câu ngữ cảnh</span>
                <span><i class="bi bi-award-fill text-warning"></i> +30 XP</span>
            </div>
            <button class="btn-play-card" @onclick:stopPropagation="true" @onclick='() => OpenGameInfo("wordle")'>
                <i class="bi bi-info-circle-fill"></i> Xem cách chơi & Bắt đầu
            </button>
        </div>

        <!-- Game 2: HSK Vocab Shooter -->
        <div class="game-card hsk-card" @onclick='() => OpenGameInfo("hsk-shooter")'>
            <div class="card-badge hsk-badge">HSK 1-6 • PHẢN XẠ NHANH</div>
            <div class="card-icon-bubble hsk-bubble">
                <i class="bi bi-crosshair"></i>
            </div>
            <h3>Máy Bay Bắn Từ Vựng HSK</h3>
            <p>Gõ pinyin siêu tốc để phóng laser bắn hạ các từ vựng chữ Hán đang rơi từ trên cao xuống trước khi chạm đáy phi thuyền.</p>
            <div class="card-tags">
                <span><i class="bi bi-airplane-fill"></i> Game Arcade</span>
                <span><i class="bi bi-spellcheck"></i> HSK 1 - HSK 6</span>
                <span><i class="bi bi-heart-fill text-danger"></i> 5 Mạng</span>
            </div>
            <button class="btn-play-card hsk-btn-card" @onclick:stopPropagation="true" @onclick='() => OpenGameInfo("hsk-shooter")'>
                <i class="bi bi-info-circle-fill"></i> Xem cách chơi & Bắt đầu
            </button>
        </div>

        <!-- Game 3: Collocation Rush -->
        <div class="game-card coming-soon">
            <div class="card-badge soon-badge">SẮP RA MẮT</div>
            <div class="card-icon-bubble soon-bubble">
                <i class="bi bi-shuffle"></i>
            </div>
            <h3>Collocation Rush: Băng Chuyền Cụm Từ</h3>
            <p>Nối nhanh các cụm từ đi liền với nhau (make / do / take / pay) theo nhịp băng chuyền để nâng band Lexical Resource.</p>
            <div class="card-tags">
                <span><i class="bi bi-hourglass-split"></i> Đang hoàn thiện</span>
                <span><i class="bi bi-book"></i> Collocations</span>
            </div>
            <button class="btn-play-card disabled" disabled>
                <i class="bi bi-lock-fill"></i> Sắp ra mắt
            </button>
        </div>
    </div>
</div>

<!-- =====================================================================
     MODAL 1: GAME INFO & HOW-TO-PLAY (THÔNG TIN & HƯỚNG DẪN CÁCH CHƠI)
     ===================================================================== -->
@if (selectedGameForInfo == "wordle")
{
    <div class="modal-backdrop" @onclick="CloseGameInfo">
        <div class="game-info-modal" @onclick:stopPropagation="true">
            <button class="btn-close-modal-top" @onclick="CloseGameInfo" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="info-header">
                <div class="info-icon-bubble wordle-bubble">
                    <i class="bi bi-puzzle-fill"></i>
                </div>
                <div>
                    <span class="info-tag">IELTS & TOEIC • TRÍ TUỆ</span>
                    <h2>IELTS Wordle: Mật Thư Ngữ Cảnh</h2>
                    <p class="info-sub">Giải mã từ vựng học thuật bằng tư duy phản biện và suy luận ngữ cảnh</p>
                </div>
            </div>

            <div class="how-to-play-section">
                <h4><i class="bi bi-lightbulb text-warning me-2"></i>Hướng Dẫn Cách Chơi</h4>
                
                <div class="rules-grid">
                    <div class="rule-box">
                        <div class="rule-badge">1</div>
                        <div class="rule-content">
                            <strong>Đọc manh mối:</strong> Quan sát <b>Nghĩa tiếng Việt</b>, từ loại, cấp độ CEFR và đặc biệt là <b>Câu ví dụ khuyết từ</b> để phán đoán từ vựng.
                        </div>
                    </div>
                    <div class="rule-box">
                        <div class="rule-badge">2</div>
                        <div class="rule-content">
                            <strong>Đoán từ trong 6 lượt:</strong> Nhập từ có đúng số lượng ô chữ cái từ bàn phím máy tính hoặc bàn phím ảo rồi nhấn <b>ENTER</b>.
                        </div>
                    </div>
                    <div class="rule-box">
                        <div class="rule-badge">3</div>
                        <div class="rule-content">
                            <strong>Nhận biết màu sắc ô chữ:</strong>
                            <div class="color-demo-row mt-2">
                                <span class="demo-cell correct">A</span> Đúng chữ, đúng vị trí
                            </div>
                            <div class="color-demo-row">
                                <span class="demo-cell present">B</span> Có trong từ nhưng sai vị trí
                            </div>
                            <div class="color-demo-row">
                                <span class="demo-cell absent">C</span> Không có trong từ
                            </div>
                        </div>
                    </div>
                    <div class="rule-box">
                        <div class="rule-badge">4</div>
                        <div class="rule-content">
                            <strong>Gợi ý thông minh 💡:</strong> Nếu gặp khó, hãy bấm nút <b>Gợi ý chữ</b>. Hệ thống sẽ chỉ mở những chữ cái bạn <b>CHƯA đoán đúng</b>!
                        </div>
                    </div>
                </div>

                <!-- Difficulty & CEFR selection -->
                <div class="info-options-box">
                    <label class="options-label"><i class="bi bi-bar-chart-steps me-2"></i>Độ Khó CEFR (Kho Từ Import):</label>
                    <div class="cefr-btn-group">
                        <button class="cefr-chip @(selectedCefr == "all" ? "active" : "")" @onclick='() => { selectedCefr = "all"; ApplyDifficultyFilter(); }'>
                            Tất cả (A2 - C1)
                        </button>
                        <button class="cefr-chip @(selectedCefr == "A2" ? "active" : "")" @onclick='() => { selectedCefr = "A2"; ApplyDifficultyFilter(); }'>
                            A2 (Cơ bản)
                        </button>
                        <button class="cefr-chip @(selectedCefr == "B1" ? "active" : "")" @onclick='() => { selectedCefr = "B1"; ApplyDifficultyFilter(); }'>
                            B1 (Tiền trung cấp)
                        </button>
                        <button class="cefr-chip @(selectedCefr == "B2" ? "active" : "")" @onclick='() => { selectedCefr = "B2"; ApplyDifficultyFilter(); }'>
                            B2 (Trung cấp)
                        </button>
                        <button class="cefr-chip @(selectedCefr == "C1" ? "active" : "")" @onclick='() => { selectedCefr = "C1"; ApplyDifficultyFilter(); }'>
                            C1 (Nâng cao)
                        </button>
                    </div>

                    <label class="options-label mt-3"><i class="bi bi-fonts me-2"></i>Số Lượng Chữ Cái Trong Từ (Cố định):</label>
                    <div class="diff-btn-group">
                        <button class="diff-btn @(selectedWordLength == "5" ? "active" : "")" @onclick='() => { selectedWordLength = "5"; ApplyDifficultyFilter(); }'>
                            5 Chữ (Chuẩn Wordle ⭐)
                        </button>
                        <button class="diff-btn @(selectedWordLength == "4" ? "active" : "")" @onclick='() => { selectedWordLength = "4"; ApplyDifficultyFilter(); }'>
                            4 Chữ (Dễ)
                        </button>
                        <button class="diff-btn @(selectedWordLength == "6" ? "active" : "")" @onclick='() => { selectedWordLength = "6"; ApplyDifficultyFilter(); }'>
                            6 Chữ (Vừa)
                        </button>
                        <button class="diff-btn @(selectedWordLength == "7" ? "active" : "")" @onclick='() => { selectedWordLength = "7"; ApplyDifficultyFilter(); }'>
                            7 Chữ (Khó)
                        </button>
                        <button class="diff-btn @(selectedWordLength == "all" ? "active" : "")" @onclick='() => { selectedWordLength = "all"; ApplyDifficultyFilter(); }'>
                            Ngẫu nhiên (4 - 7 chữ)
                        </button>
                    </div>
                </div>
            </div>

            <div class="info-actions">
                <button class="btn-start-game-big" @onclick="StartWordleGame">
                    <i class="bi bi-arrows-fullscreen me-2"></i> CHƠI TOÀN MÀN HÌNH
                </button>
                <button class="btn-cancel-game" @onclick="CloseGameInfo">
                    Quay lại
                </button>
            </div>
        </div>
    </div>
}
else if (selectedGameForInfo == "hsk-shooter")
{
    <div class="modal-backdrop" @onclick="CloseGameInfo">
        <div class="game-info-modal" @onclick:stopPropagation="true">
            <button class="btn-close-modal-top" @onclick="CloseGameInfo" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="info-header">
                <div class="info-icon-bubble hsk-bubble">
                    <i class="bi bi-crosshair"></i>
                </div>
                <div>
                    <span class="info-tag hsk-tag">HSK 1 - 6 • ARCADE</span>
                    <h2>Máy Bay Bắn Từ Vựng HSK</h2>
                    <p class="info-sub">Gõ pinyin thần tốc để bảo vệ phi thuyền trước mưa từ vựng chữ Hán</p>
                </div>
            </div>

            <div class="how-to-play-section">
                <h4><i class="bi bi-lightbulb text-warning me-2"></i>Hướng Dẫn Cách Chơi</h4>
                <div class="rules-grid">
                    <div class="rule-box">
                        <div class="rule-badge">1</div>
                        <div class="rule-content">
                            <strong>Từ vựng rơi xuống:</strong> Các từ chữ Hán kèm pinyin sẽ rơi dần từ đỉnh màn hình xuống căn cứ.
                        </div>
                    </div>
                    <div class="rule-box">
                        <div class="rule-badge">2</div>
                        <div class="rule-content">
                            <strong>Gõ Pinyin:</strong> Gõ đúng chữ cái pinyin (không cần dấu thanh điệu) để kích hoạt pháo laser bắn nổ từ vựng.
                        </div>
                    </div>
                    <div class="rule-box">
                        <div class="rule-badge">3</div>
                        <div class="rule-content">
                            <strong>Bảo toàn mạng sống:</strong> Mỗi từ chạm đáy sẽ làm mất 1 mạng (<span class="text-danger">❤</span>). Bạn có 5 mạng trong mỗi ván!
                        </div>
                    </div>
                </div>

                <!-- Level selection -->
                <div class="info-options-box">
                    <label class="options-label"><i class="bi bi-bar-chart-steps me-2"></i>Chọn Cấp Độ HSK Mục Tiêu:</label>
                    <div class="diff-btn-group">
                        @for (int i = 1; i <= 6; i++)
                        {
                            var lvl = $"HSK{i}";
                            <button class="diff-btn @(hskShooterSelectedLevel == lvl ? "active" : "")" @onclick="() => hskShooterSelectedLevel = lvl">
                                @lvl
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="info-actions">
                <button class="btn-start-game-big hsk-btn" @onclick="StartHskShooterGame">
                    <i class="bi bi-arrows-fullscreen me-2"></i> CHƠI TOÀN MÀN HÌNH
                </button>
                <button class="btn-cancel-game" @onclick="CloseGameInfo">
                    Quay lại
                </button>
            </div>
        </div>
    </div>
}

<!-- =====================================================================
     MODAL 2: FULLSCREEN IELTS WORDLE GAME WINDOW
     ===================================================================== -->
@if (isPlayingWordle)
{
    <div class="fullscreen-game-overlay" @ref="wordleOverlayRef" @onkeydown="HandleKeyDown" tabindex="0" @onclick="FocusWordle">
        <!-- Topbar -->
        <header class="fullscreen-topbar">
            <div class="topbar-left">
                <div class="fs-game-badge">
                    <i class="bi bi-puzzle-fill text-success"></i> IELTS WORDLE
                </div>
                <span class="fs-game-title">Mật Thư Ngữ Cảnh</span>
            </div>

            <div class="topbar-center">
                <span class="fs-stat-pill text-warning"><i class="bi bi-star-fill"></i> Điểm: <b>@wordleScore</b></span>
                <span class="fs-stat-pill text-danger"><i class="bi bi-fire"></i> Chuỗi: <b>@wordleStreak</b> 🔥</span>
                <span class="fs-stat-pill text-info"><i class="bi bi-bullseye"></i> Lượt: <b>@(currentGuessIndex + 1)/@MaxGuesses</b></span>
            </div>

            <div class="topbar-right">
                <button class="btn-fs-tool" @onclick="NextWord" title="Đổi từ vựng khác">
                    <i class="bi bi-arrow-clockwise"></i> Đổi từ
                </button>
                <button class="btn-fs-exit" @onclick="CloseWordleGame" title="Thoát trò chơi">
                    <i class="bi bi-x-lg me-1"></i> Thoát
                </button>
            </div>
        </header>

        <!-- Main Body -->
        <main class="fullscreen-game-body">
            @if (currentWord == null)
            {
                <div class="fs-loading-box">
                    <div class="spinner"></div>
                    <p>Đang chuẩn bị từ vựng...</p>
                </div>
            }
            else
            {
                <div class="wordle-desktop-layout">
                    <!-- Left column: Clues & Context -->
                    <div class="wordle-clue-column">
                        <div class="clue-panel">
                            <div class="clue-tags-row">
                                <span class="badge-pos">@(string.IsNullOrWhiteSpace(currentWord.PartOfSpeech) ? "TỪ VỰNG" : currentWord.PartOfSpeech.ToUpperInvariant())</span>
                                @if (!string.IsNullOrWhiteSpace(currentWord.CefrLevel))
                                {
                                    <span class="badge-cefr">CEFR @currentWord.CefrLevel.ToUpperInvariant()</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(currentWord.Topic))
                                {
                                    <span class="badge-topic"><i class="bi bi-tag-fill"></i> @currentWord.Topic</span>
                                }
                                <span class="badge-len"><i class="bi bi-fonts"></i> @WordLength chữ cái</span>
                            </div>

                            <div class="clue-meaning-card">
                                <div class="meaning-lbl"><i class="bi bi-translate text-success me-2"></i>Nghĩa tiếng Việt:</div>
                                <div class="meaning-txt">@currentWord.Meaning</div>
                            </div>

                            @if (hintLetterIndices.Count > 0)
                            {
                                <div class="hints-active-box">
                                    <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                                    <span>Manh mối đã mở:</span>
                                    @foreach (var kvp in hintLetterIndices.OrderBy(k => k.Key))
                                    {
                                        <span class="hint-char-chip">Ô @(kvp.Key + 1): <b>@kvp.Value</b></span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(ContextSentence))
                            {
                                <div class="clue-sentence-card">
                                    <div class="sent-lbl"><i class="bi bi-chat-quote-fill text-info me-2"></i>Câu ngữ cảnh:</div>
                                    <div class="sent-en-txt">
                                        @((MarkupString)FormattedSentenceHtml)
                                    </div>
                                    @if (showSentenceTranslation && !string.IsNullOrWhiteSpace(currentWord.ExampleMeaning))
                                    {
                                        <div class="sent-vi-txt">
                                            <i class="bi bi-arrow-return-right me-1 text-muted"></i> @currentWord.ExampleMeaning
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(currentWord.ExampleMeaning))
                                    {
                                        <button class="btn-toggle-trans" @onclick="() => showSentenceTranslation = true">
                                            <i class="bi bi-eye"></i> Xem bản dịch câu
                                        </button>
                                    }
                                </div>
                            }

                            <div class="clue-helper-actions">
                                <button class="btn-action-hint" @onclick="UseLetterHint" disabled="@isGameOver" title="Gợi ý chữ cái chưa đoán đúng (Phím tắt: 1)">
                                    <i class="bi bi-lightbulb-fill text-warning"></i> Gợi ý chữ
                                    <span class="kbd-badge-sm">1</span>
                                </button>
                                <button class="btn-action-sound" @onclick="PronounceWord" title="Nghe phát âm (Phím tắt: 2)">
                                    <i class="bi bi-volume-up-fill text-info"></i> Phát âm
                                    <span class="kbd-badge-sm">2</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Right column: Grid & Keyboard -->
                    <div class="wordle-board-column">
                        <!-- Wordle Grid -->
                        <div class="fullscreen-grid-wrapper">
                            <div class="wordle-grid">
                                @for (int r = 0; r < MaxGuesses; r++)
                                {
                                    var rowIndex = r;
                                    var rowGuess = rowIndex < guesses.Count ? guesses[rowIndex] : (rowIndex == currentGuessIndex ? currentInput : "");
                                    var rowEvaluations = rowIndex < guessEvaluations.Count ? guessEvaluations[rowIndex] : null;

                                    <div class="wordle-row @(rowIndex == currentGuessIndex && shakeCurrentRow ? "shake" : "")">
                                        @for (int c = 0; c < WordLength; c++)
                                        {
                                            var colIndex = c;
                                            var letter = colIndex < rowGuess.Length ? rowGuess[colIndex].ToString().ToUpperInvariant() : "";
                                            var evalStatus = rowEvaluations != null && colIndex < rowEvaluations.Count ? rowEvaluations[colIndex] : "empty";

                                            <div class="wordle-cell @evalStatus @(!string.IsNullOrEmpty(letter) && evalStatus == "empty" ? "pop" : "")">
                                                @letter
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Toast Notification -->
                        @if (!string.IsNullOrEmpty(toastMessage))
                        {
                            <div class="fs-toast-alert">
                                @toastMessage
                            </div>
                        }

                        <!-- Virtual Keyboard -->
                        <div class="fullscreen-keyboard">
                            <div class="keyboard-row">
                                @foreach (var key in KeyRow1)
                                {
                                    <button class="key-btn @GetKeyClass(key)" @onclick="() => OnVirtualKeyPress(key)">@key</button>
                                }
                            </div>
                            <div class="keyboard-row">
                                @foreach (var key in KeyRow2)
                                {
                                    <button class="key-btn @GetKeyClass(key)" @onclick="() => OnVirtualKeyPress(key)">@key</button>
                                }
                            </div>
                            <div class="keyboard-row">
                                <button class="key-btn key-enter" @onclick='() => OnVirtualKeyPress("ENTER")'>ENTER</button>
                                @foreach (var key in KeyRow3)
                                {
                                    <button class="key-btn @GetKeyClass(key)" @onclick="() => OnVirtualKeyPress(key)">@key</button>
                                }
                                <button class="key-btn key-backspace" @onclick='() => OnVirtualKeyPress("BACKSPACE")'>
                                    <i class="bi bi-backspace"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Victory / Loss Modal inside Fullscreen -->
            @if (showResultModal && currentWord != null)
            {
                <div class="fs-modal-backdrop" @onclick="() => showResultModal = false" tabindex="0" @onkeydown="HandleKeyDown">
                    <div class="fs-result-card @(isGameWon ? "won" : "lost")" @onclick:stopPropagation="true" tabindex="0" @onkeydown="HandleKeyDown">
                        @if (isGameWon)
                        {
                            <span class="res-trophy">🏆</span>
                            <h2>XUẤT SẮC! BẠN ĐÃ GIẢI MÃ THÀNH CÔNG</h2>
                            <p class="res-subtitle">Đoán đúng ở lượt thứ <b>@(guesses.Count)/@MaxGuesses</b> • Nhận <b>+30 XP</b></p>
                        }
                        else
                        {
                            <span class="res-trophy lost">💡</span>
                            <h2>HẾT LƯỢT ĐOÁN!</h2>
                            <p class="res-subtitle">Từ vựng bí ẩn đã được giải mã bên dưới</p>
                        }

                        <div class="res-summary-box">
                            <div class="res-word-row">
                                <span class="rw-word">@currentWord.Word.ToUpperInvariant()</span>
                                <button class="btn-res-audio" @onclick="PronounceWord" title="Nghe phát âm">
                                    <i class="bi bi-volume-up-fill"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(currentWord.Phonetic))
                            {
                                <div class="rw-phonetic">@currentWord.Phonetic</div>
                            }
                            <div class="rw-meaning">
                                <strong>Nghĩa:</strong> @currentWord.Meaning
                            </div>
                            @if (!string.IsNullOrWhiteSpace(currentWord.Example))
                            {
                                <div class="rw-example">
                                    <div class="ex-en">“@currentWord.Example”</div>
                                    @if (!string.IsNullOrWhiteSpace(currentWord.ExampleMeaning))
                                    {
                                        <div class="ex-vi">@currentWord.ExampleMeaning</div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="res-action-buttons">
                            <button class="btn-res-next-big" @onclick="NextWord" autofocus>
                                Từ tiếp theo <span class="kbd-badge">Enter ↵</span> <i class="bi bi-arrow-right"></i>
                            </button>
                            <button class="btn-res-exit-sub" @onclick="CloseWordleGame">
                                Thoát ra danh sách trò chơi
                            </button>
                        </div>
                    </div>
                </div>
            }
        </main>
    </div>
}

<!-- =====================================================================
     MODAL 3: FULLSCREEN HSK SHOOTER GAME WINDOW (STAGE SYSTEM)
     ===================================================================== -->
@if (isPlayingHskShooter)
{
    <div class="fullscreen-game-overlay hsk-game-overlay @(IsHskGamePaused ? "is-paused" : "")" @ref="hskOverlayRef" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick="FocusHskOnBackgroundClick">
        <!-- Topbar -->
        <header class="fullscreen-topbar hsk-topbar">
            <div class="topbar-left">
                <div class="fs-game-badge hsk-badge-pill">
                    <i class="bi bi-crosshair"></i> HSK SHOOTER
                </div>
                <span class="fs-game-title">Cấp độ: <b>@hskShooterSelectedLevel</b></span>
                @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
                {
                    <button type="button" class="hsk-stage-badge-btn @(_currentStageIndex == _totalStages - 1 ? "boss-stage" : "")" @onclick="OpenStageMap" title="Xem bản đồ tầng (Tạm dừng game)">
                        <span class="topbar-user-avt" style="background: @_userAvatarColor" title="@_userDisplayName">@_userAvatarEmoji</span>
                        <span>Tầng @(_currentStageIndex + 1)/@_totalStages</span>
                    </button>
                }
            </div>

            <div class="topbar-center">
                <span class="fs-stat-pill text-warning"><i class="bi bi-star-fill"></i> Điểm: <b>@hskScore</b></span>
                <span class="fs-stat-pill text-danger"><i class="bi bi-heart-fill"></i> Mạng: <b>@Math.Max(0, hskLives) ❤</b></span>
                <span class="fs-stat-pill text-info"><i class="bi bi-bullseye"></i> Đã bắn: <b>@hskWordsShot</b></span>
                @if (hskCombo >= 2)
                {
                    <span class="fs-stat-pill hsk-combo-pill"><i class="bi bi-fire"></i> Combo <b>x@(hskCombo)</b></span>
                }
            </div>

            <div class="topbar-right">
                <button class="btn-bgm @(_isBgmOn ? "active" : "")" @onclick="ToggleBgm" title="Bật/Tắt Nhạc Nền (Phím 1)">
                    <i class="bi @(_isBgmOn ? "bi-music-note-beamed" : "bi-volume-mute-fill")"></i>
                    @(_isBgmOn ? "Nhạc: BẬT" : "Nhạc: TẮT")
                    <span class="kbd-badge-sm">1</span>
                </button>
                <button class="btn-pinyin-toggle @(!_showPinyin ? "pinyin-off" : "")" @onclick="TogglePinyin" title="Bật/Tắt hiển thị Pinyin gợi ý (Phím 2)">
                    <i class="bi @(_showPinyin ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    @(_showPinyin ? "Ẩn Pinyin" : "Hiện Pinyin")
                    <span class="kbd-badge-sm">2</span>
                </button>
                <button class="btn-fs-tool" @onclick="ToggleHskPause" title="Tạm dừng / Tiếp tục (Phím 3)">
                    <i class="bi @(hskShooterState == HskGameState.Paused ? "bi-play-fill" : "bi-pause-fill")"></i>
                    @(hskShooterState == HskGameState.Paused ? "Tiếp tục" : "Tạm dừng")
                    <span class="kbd-badge-sm">3</span>
                </button>
                <button class="btn-fs-exit" @onclick="CloseHskShooterGame" title="Thoát trò chơi (Phím Esc)">
                    <i class="bi bi-x-lg me-1"></i> Thoát
                    <span class="kbd-badge-sm">Esc</span>
                </button>
            </div>
        </header>

        <!-- Shooter Battlefield -->
        <main class="hsk-battlefield @(IsHskGamePaused ? "is-paused" : "")" @onclick="FocusHskInput">
            <!-- Corner Floating Map Button in Battlefield -->
            @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
            {
                <button type="button" class="hsk-corner-map-fab" @onclick="OpenStageMap" @onclick:stopPropagation="true" title="Xem bản đồ tháp tầng (Tạm dừng game)">
                    <div class="fab-user-avatar" style="background: @_userAvatarColor" title="@_userDisplayName - Tầng @(_currentStageIndex + 1)">
                        <span>@_userAvatarEmoji</span>
                        <span class="fab-avatar-online"></span>
                    </div>
                    <span class="fab-text">
                        <span class="fab-title">BẢN ĐỒ TẦNG</span>
                        <span class="fab-stage">Tầng @(_currentStageIndex + 1)/@_totalStages</span>
                    </span>
                </button>
            }

            <!-- Damage Flash overlay -->
            @if (showDamageFlash)
            {
                <div class="hsk-damage-flash"></div>
            }

            <!-- Floating Flaming Combo Banner -->
            @if (hskCombo >= 2)
            {
                <div class="hsk-combo-banner">
                    <span class="combo-fire">🔥</span>
                    <span class="combo-count">@hskCombo</span>
                    <span class="combo-text">COMBO!</span>
                </div>
            }

            <!-- Stage Progress Bar -->
            @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
            {
                <div class="hsk-stage-progress-bar">
                    <div class="hsk-stage-progress-fill" style="width: @((double)hskWordsShotInStage / Math.Max(1, _currentStageTotalWords) * 100)%"></div>
                </div>
            }

            <!-- Falling Words (Only Hanzi by default) -->
            @foreach (var word in hskActiveWords)
            {
                <div @key="word.Key" class="falling-word @(word.IsDestroyed ? "destroyed" : "") @(IsHskTargeted(word) ? "targeted" : "") @(IsHskGamePaused ? "paused-anim" : "")"
                     style="--fall-duration: @(word.FallDurationCss)s; --x-pos: @(word.XPercentCss)%; @(IsHskGamePaused ? "animation-play-state: paused;" : "")">
                    <span class="word-hanzi">@word.Vocab.Hanzi</span>
                    @if (_showPinyin)
                    {
                        <span class="word-pinyin">@word.Vocab.Pinyin</span>
                    }
                </div>
            }

            <!-- Laser Bullets (Đạn bắn vào từ vựng) -->
            @foreach (var bullet in hskBullets)
            {
                <div class="hsk-bullet @(IsHskGamePaused ? "paused-anim" : "")"
                     style="--start-x: @(bullet.StartXCss)%; --start-y: @(bullet.StartYCss)%; --target-x: @(bullet.TargetXCss)%; --target-y: @(bullet.TargetYCss)%; @(IsHskGamePaused ? "animation-play-state: paused;" : "")">
                    <div class="bullet-bolt"></div>
                </div>
            }

            <!-- Impact Explosions (Va chạm nổ từ vựng) -->
            @foreach (var impact in hskImpacts)
            {
                <div class="hsk-impact-burst @(IsHskGamePaused ? "paused-anim" : "")"
                     style="--target-x: @(impact.XCss)%; --target-y: @(impact.YCss)%; @(IsHskGamePaused ? "animation-play-state: paused;" : "")">
                    <div class="impact-ring"></div>
                    <span class="impact-flash">💥</span>
                </div>
            }

            <!-- Airplane -->
            @if (hskShooterState == HskGameState.Playing || hskShooterState == HskGameState.Paused)
            {
                <div class="hsk-airplane"><i class="bi bi-airplane-fill"></i></div>
            }

            <!-- In-game Realtime Missed Alert Toast (Hiện đáp án từ vừa bỏ lỡ để cải thiện) -->
            @if (_showMissedBanner && _lastMissedVocab != null)
            {
                <div class="hsk-missed-alert-banner">
                    <span class="missed-tag">❌ BỎ LỠ</span>
                    <span class="missed-hanzi">@_lastMissedVocab.Hanzi</span>
                    <span class="missed-pinyin">[@_lastMissedVocab.Pinyin]</span>
                    <span class="missed-meaning">— @_lastMissedVocab.Meaning</span>
                </div>
            }

            <!-- Pinyin Input -->
            @if (hskShooterState == HskGameState.Playing && !_showStageComplete && !_showStageMap)
            {
                <div class="hsk-input-dock" @onclick:stopPropagation="true">
                    <input @ref="hskInputRef" type="text" @bind="hskInputValue" @bind:event="oninput"
                           @onkeydown="HandleInputKeyDown"
                           @onkeydown:stopPropagation="true"
                           placeholder="Gõ pinyin bắn từ vựng rơi..." autocomplete="off" spellcheck="false" autofocus />
                </div>
            }

            <!-- Paused Screen -->
            @if (hskShooterState == HskGameState.Paused && !_showStageMap)
            {
                <div class="hsk-dialog-card">
                    <h2><i class="bi bi-pause-circle-fill text-warning me-2"></i>TẠM DỪNG</h2>
                    <p>Trò chơi đang tạm dừng. Hãy bấm Tiếp tục khi bạn sẵn sàng!</p>
                    <div class="hsk-dialog-btns">
                        <button class="btn-hsk-resume" @onclick="ToggleHskPause">Tiếp tục chơi</button>
                        <button class="btn-hsk-quit" @onclick="CloseHskShooterGame">Thoát ra ngoài</button>
                    </div>
                </div>
            }

            <!-- Game Over Screen -->
            @if (hskShooterState == HskGameState.GameOver)
            {
                <div class="hsk-dialog-card gameover">
                    <h2><i class="bi bi-award-fill text-warning me-2"></i>KẾT THÚC!</h2>
                    <p>Bạn đã để lọt quá nhiều từ vựng.</p>
                    <div class="hsk-score-grid">
                        <div class="hsk-score-box">
                            <div class="val text-warning">@hskScore</div>
                            <div class="lbl">Tổng Điểm</div>
                        </div>
                        <div class="hsk-score-box">
                            <div class="val text-success">@hskWordsShot</div>
                            <div class="lbl">Từ Bắn Được</div>
                        </div>
                        <div class="hsk-score-box">
                            <div class="val text-info">@hskNewLearned</div>
                            <div class="lbl">Từ Thuộc Mới</div>
                        </div>
                    </div>

                    @if (_missedWordsInStage.Count > 0)
                    {
                        <div class="hsk-review-section">
                            <div class="review-header">
                                <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                                <b>Đáp án các từ đã bỏ lỡ (để ôn tập cải thiện):</b>
                            </div>
                            <div class="review-items-scroll">
                                @foreach (var m in _missedWordsInStage.DistinctBy(x => x.Id))
                                {
                                    <div class="review-item">
                                        <b class="review-hanzi">@m.Hanzi</b>
                                        <span class="review-pinyin">[@m.Pinyin]</span>
                                        <span class="review-meaning">— @m.Meaning</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="hsk-dialog-btns">
                        <button class="btn-hsk-resume" @onclick="() => LoadStage(_currentStageIndex)" autofocus>Chơi lại tầng @(_currentStageIndex + 1) <span class="kbd-badge">Enter ↵</span></button>
                        <button class="btn-hsk-quit" @onclick="CloseHskShooterGame">Thoát ra danh sách game</button>
                    </div>
                </div>
            }

            <!-- Stage Complete Overlay -->
            @if (_showStageComplete)
            {
                <div class="hsk-stage-complete-overlay" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick:stopPropagation="true">
                    <div class="hsk-stage-complete-card">
                        <div class="stage-complete-trophy">@(_currentStageIndex == _totalStages - 1 ? "🏆" : "⭐")</div>
                        <h2>🎉 XUẤT SẮC QUA MÀN! HOÀN THÀNH TẦNG @(_currentStageIndex + 1)!</h2>
                        <p>@(_currentStageIndex == _totalStages - 1 ? "Tuyệt vời! Bạn đã chinh phục toàn bộ cấp độ này." : "Chuẩn bị tiến vào tầng tiếp theo với độ khó tăng dần.")</p>
                        
                        <div class="stage-complete-stats">
                            <div class="stage-stat-pill">
                                <div class="val text-success">@hskWordsShotInStage</div>
                                <div class="lbl">Từ đã bắn</div>
                            </div>
                            <div class="stage-stat-pill">
                                <div class="val text-danger">@Math.Max(0, hskLives)</div>
                                <div class="lbl">Mạng còn</div>
                            </div>
                            <div class="stage-stat-pill">
                                <div class="val text-warning">@hskScore</div>
                                <div class="lbl">Tổng điểm</div>
                            </div>
                        </div>

                        @if (_missedWordsInStage.Count > 0)
                        {
                            <div class="hsk-review-section">
                                <div class="review-header">
                                    <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                                    <b>Đáp án các từ đã bỏ lỡ trong tầng này:</b>
                                </div>
                                <div class="review-items-scroll">
                                    @foreach (var m in _missedWordsInStage.DistinctBy(x => x.Id))
                                    {
                                        <div class="review-item">
                                            <b class="review-hanzi">@m.Hanzi</b>
                                            <span class="review-pinyin">[@m.Pinyin]</span>
                                            <span class="review-meaning">— @m.Meaning</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (_currentStageIndex < _totalStages - 1)
                        {
                            <div class="stage-countdown-box">
                                <div class="sc-label">Tự động tiến vào Tầng @(_currentStageIndex + 2) sau:</div>
                                <div class="sc-circle">
                                    <span class="sc-number">@_stageCountdown</span>
                                </div>
                                <div class="sc-sub">Nhấn <b>Enter</b> hoặc bấm nút bên dưới để vào ngay</div>
                            </div>

                            <button class="btn-hsk-resume w-100" @onclick="SkipCountdownAndNextStage" autofocus>
                                Tiến vào Tầng @(_currentStageIndex + 2) ngay <span class="kbd-badge">Enter ↵</span> <i class="bi bi-arrow-right"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn-hsk-resume w-100" @onclick="CloseHskShooterGame" autofocus>
                                Chiến thắng & Thoát <span class="kbd-badge">Enter ↵</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Resume Progress Dialog -->
            @if (_showResumeDialog)
            {
                <div class="hsk-resume-overlay" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick:stopPropagation="true">
                    <div class="hsk-resume-card">
                        <div class="resume-icon">💾</div>
                        <h3>Đã tìm thấy dữ liệu lưu</h3>
                        <p>Bạn đã từng chơi cấp độ <b>@hskShooterSelectedLevel</b> đến <b>Tầng @(_savedStageIndex + 1)</b>. Bạn có muốn tiếp tục hay chơi lại từ đầu?</p>
                        <div class="save-warning-box">
                            Lưu ý: Nếu chọn tiếp tục, các từ ở tầng trước sẽ không xuất hiện lại trong lần chơi này.
                        </div>
                        <div class="hsk-resume-btns">
                            <button class="btn-resume-continue" @onclick="ResumeFromSavedStage" autofocus>Tiếp tục từ Tầng @(_savedStageIndex + 1) <span class="kbd-badge">Enter ↵</span></button>
                            <button class="btn-resume-restart" @onclick="StartFreshFromStage0">Chơi lại từ đầu (Tầng 1)</button>
                        </div>
                    </div>
                </div>
            }

            <!-- Stage Map Modal (Bản đồ tháp tầng) -->
            @if (_showStageMap)
            {
                <div class="stage-map-overlay" tabindex="0" @onkeydown="HandleHskKeyDown" @onclick:stopPropagation="true">
                    <header class="stage-map-header">
                        <div class="header-left">
                            <div class="header-title-group">
                                <h3><i class="bi bi-map-fill me-2"></i> BẢN ĐỒ THÁP TẦNG - @hskShooterSelectedLevel</h3>
                                <span class="header-sub">Dí chuột kéo lên/xuống để xem toàn bộ các tầng</span>
                            </div>
                            <div class="header-user-status" title="@_userDisplayName">
                                <div class="header-user-avt" style="background: @_userAvatarColor">@_userAvatarEmoji</div>
                                <div class="header-user-meta">
                                    <span class="user-meta-name">@_userDisplayName</span>
                                    <span class="user-meta-floor"><i class="bi bi-geo-alt-fill text-danger"></i> Đang ở Tầng @(_currentStageIndex + 1)/@_totalStages</span>
                                </div>
                            </div>
                        </div>
                        <div class="header-right">
                            <button type="button" class="btn-resume-from-map" @onclick="ResumeAndCloseMap" title="Tiếp tục chơi">
                                <i class="bi bi-play-fill"></i> Tiếp tục chơi
                            </button>
                            <button type="button" class="btn-close-map" @onclick="CloseStageMap" title="Đóng bản đồ (Esc)"><i class="bi bi-x-lg"></i></button>
                        </div>
                    </header>
                    <div class="stage-map-scroll" id="hskStageMapScroll">
                        <!-- Summit Banner at Top (Đỉnh tháp - Trùm cuối) -->
                        <div class="stage-map-summit">
                            <div class="summit-crown">👑</div>
                            <div class="summit-content">
                                <div class="summit-title">ĐỈNH THÁP - TRẬN CHIẾN TRÙM CUỐI (Tầng @_totalStages)</div>
                                <div class="summit-sub">Chinh phục toàn bộ @hskVocabPool.Count từ vựng để mở khóa danh hiệu quán quân @hskShooterSelectedLevel!</div>
                            </div>
                        </div>

                        <!-- Reverse list: Summit on top (Tầng N), Base at bottom (Tầng 1) -->
                        @for (int i = _totalStages - 1; i >= 0; i--)
                        {
                            var stageIdx = i;
                            var isBoss = stageIdx == _totalStages - 1;
                            var isCurrent = stageIdx == _currentStageIndex;
                            var isActive = isCurrent && !_showStageComplete;
                            var isDone = stageIdx < _currentStageIndex || stageIdx < _maxUnlockedStageIndex;
                            var isUnlocked = stageIdx <= _maxUnlockedStageIndex;
                            var isLocked = !isUnlocked;

                            var rowClass = "stage-map-row";
                            if (isBoss) rowClass += " stage-boss";
                            if (isDone && !isActive) rowClass += " stage-done";
                            if (isActive) rowClass += " stage-active";
                            if (isLocked) rowClass += " stage-locked";

                            var diffClass = isBoss ? "boss" : (stageIdx < 3 ? "easy" : (stageIdx < 6 ? "medium" : "hard"));
                            var diffText = isBoss ? "Trùm Cuối" : (stageIdx < 3 ? "Dễ" : (stageIdx < 6 ? "Vừa" : "Khó"));

                            <div class="@rowClass" id="@(isCurrent ? "currentActiveStageRow" : null)">
                                <div class="stage-num-circle @(isCurrent ? "has-player-avatar" : "")">
                                    @if (isCurrent)
                                    {
                                        <div class="player-map-avatar-circle" style="background: @_userAvatarColor" title="@_userDisplayName đang ở Tầng @(stageIdx + 1)">
                                            <span class="avatar-icon">@_userAvatarEmoji</span>
                                            <span class="floor-num-badge">T@(stageIdx + 1)</span>
                                            <div class="sonar-wave"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        @(isBoss ? "☠️" : (stageIdx + 1).ToString())
                                    }
                                </div>
                                <div class="stage-map-info">
                                    <div class="stage-map-title">
                                        <span>Tầng @(stageIdx + 1) @(isBoss ? "- Trận chiến cuối cùng" : "")</span>
                                        @if (isActive)
                                        {
                                            <span class="player-location-tag" style="border-color: @_userAvatarColor">
                                                <span class="tag-avt" style="background: @_userAvatarColor">@_userAvatarEmoji</span>
                                                <span class="tag-text">VỊ TRÍ CỦA BẠN</span>
                                                <span class="tag-beacon"></span>
                                            </span>
                                        }
                                        else if (isDone)
                                        {
                                            <span class="done-tag">⭐ ĐÃ QUA</span>
                                        }
                                        else if (isLocked)
                                        {
                                            <span class="locked-tag">🔒 CHƯA MỞ</span>
                                        }
                                    </div>
                                    <div class="stage-map-sub">
                                        <span class="diff-chip @diffClass">@diffText</span>
                                        <span class="stage-word-count">Từ @(stageIdx * WordsPerStage + 1) - @(Math.Min((stageIdx + 1) * WordsPerStage, hskVocabPool.Count))</span>
                                    </div>
                                </div>
                                <div class="stage-action">
                                    @if (isActive)
                                    {
                                        <button type="button" class="btn-stage-play" @onclick="ResumeAndCloseMap">ĐANG CHƠI ▶</button>
                                    }
                                    else if (isUnlocked)
                                    {
                                        <button type="button" class="btn-stage-play replay" @onclick="() => ReplayStage(stageIdx)">Chơi lại ↺</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-stage-play locked" disabled title="Hãy vượt qua các tầng trước để mở khóa"><i class="bi bi-lock-fill"></i> Đã khóa</button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Base Banner at Bottom (Chân tháp - Tầng 1) -->
                        <div class="stage-map-base">
                            <div class="base-flag">🚩</div>
                            <div class="base-content">
                                <div class="base-title">CHÂN THÁP - XUẤT PHÁT (Tầng 1)</div>
                                <div class="base-sub">Khởi đầu hành trình học từ vựng @hskShooterSelectedLevel</div>
