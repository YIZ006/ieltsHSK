    private async Task StartHskShooterGame()
    {
        selectedGameForInfo = null;
        isPlayingHskShooter = true;
        await LoadLevelAndCheckProgress(hskShooterSelectedLevel);
    }

    private async Task LoadLevelAndCheckProgress(string level)
    {
        hskShooterSelectedLevel = level;
        var all = await HskSvc.GetVocabularyAsync(level);
        hskVocabPool = all?.Where(v => v.IsActive && !string.IsNullOrWhiteSpace(v.Pinyin)).ToList() ?? new();
        if (hskVocabPool.Count == 0) return;

        // Shuffle the entire pool once per level load
        for (int i = hskVocabPool.Count - 1; i > 0; i--)
        {
            int j = hskRng.Next(i + 1);
            (hskVocabPool[i], hskVocabPool[j]) = (hskVocabPool[j], hskVocabPool[i]);
        }

        _totalStages = (int)Math.Ceiling(hskVocabPool.Count / (double)WordsPerStage);
        if (_totalStages == 0) _totalStages = 1;

        // Check LocalStorage for saved progress and max unlocked stage
        try
        {
            var savedStageStr = await JS.InvokeAsync<string>("localStorage.getItem", $"hsk_progress_{level}");
            var maxUnlockedStr = await JS.InvokeAsync<string>("localStorage.getItem", $"hsk_max_unlocked_{level}");

            if (int.TryParse(maxUnlockedStr, out var maxUnlocked) && maxUnlocked >= 0)
            {
                _maxUnlockedStageIndex = Math.Min(maxUnlocked, _totalStages - 1);
            }
            else if (int.TryParse(savedStageStr, out var savedFallback) && savedFallback >= 0)
            {
                _maxUnlockedStageIndex = Math.Min(savedFallback, _totalStages - 1);
            }
            else
            {
                _maxUnlockedStageIndex = 0;
            }

            if (int.TryParse(savedStageStr, out var savedStage) && savedStage > 0 && savedStage < _totalStages)
            {
                _savedStageIndex = savedStage;
                _showResumeDialog = true;
                StateHasChanged();
                _ = FocusHskOverlay();
                return;
            }
        }
        catch { /* Ignore JS interop errors during prerendering/initialization */ }

        await StartFreshFromStage0();
    }

