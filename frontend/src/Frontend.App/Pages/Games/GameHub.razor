    private string FormattedSentenceHtml
    {
        get
        {
            if (currentWord == null || string.IsNullOrWhiteSpace(currentWord.Example)) return "";
            var ex = currentWord.Example;
            var w = currentWord.Word.Trim();
            
            var regex = new System.Text.RegularExpressions.Regex(System.Text.RegularExpressions.Regex.Escape(w), System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(ex))
            {
                var replacement = $"<span class='blank-target'>[ {new string('_', Math.Min(w.Length, 8))} ]</span>";
                return regex.Replace(ex, replacement, 1);
            }

            return ex + $" <span class='blank-target'>[ {new string('_', w.Length)} ]</span>";
        }
    }

