    }

    private async Task NextStage()
    {
        if (_currentStageIndex < _totalStages - 1)
        {
            await LoadStage(_currentStageIndex + 1);
        }
    }

    private async Task LoadStage(int stageIndex)
    {
        _countdownTimer?.Dispose();
        _showStageComplete = false;
        _hskPauseStartTime = null;
        _wasPausedByMap = false;
        _currentStageIndex = stageIndex;
        _maxUnlockedStageIndex = Math.Max(_maxUnlockedStageIndex, stageIndex);
        _lastHskSpawnTime = DateTime.MinValue;
        hskBullets.Clear();
        hskImpacts.Clear();
        
        // Save progress & max unlocked
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", $"hsk_progress_{hskShooterSelectedLevel}", _currentStageIndex.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", $"hsk_max_unlocked_{hskShooterSelectedLevel}", _maxUnlockedStageIndex.ToString());
        }
        catch { }

        int skip = stageIndex * WordsPerStage;
        int take = (stageIndex == _totalStages - 1) ? hskVocabPool.Count - skip : WordsPerStage;
        
        _currentStageWords = hskVocabPool.Skip(skip).Take(take).ToList();
        _currentStageTotalWords = _currentStageWords.Count;
        
        hskSpawnIndex = 0;
        hskWordsShotInStage = 0;
        hskActiveWords.Clear();
        hskInputValue = "";
        hskCombo = 0;
        hskLives = HskMaxLives; // Qua mỗi màn luôn reset 5 tim đầy đủ
        _showMissedBanner = false;
        _lastMissedVocab = null;
        _missedWordsInStage.Clear();
        hskShooterState = HskGameState.Playing;

        hskTimer?.Dispose();
        hskTimer = new Timer(OnHskTick, null, 100, 100);

        if (_isBgmOn)
        {
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.startBgm()");
        }

        _ = FocusHskInput();
        StateHasChanged();
    }

    private void TriggerStageComplete()
    {
        hskTimer?.Dispose();
        _showStageComplete = true;
        _stageCountdown = 3;
        _maxUnlockedStageIndex = Math.Max(_maxUnlockedStageIndex, Math.Min(_currentStageIndex + 1, _totalStages - 1));
        try
        {
            _ = JS.InvokeVoidAsync("localStorage.setItem", $"hsk_max_unlocked_{hskShooterSelectedLevel}", _maxUnlockedStageIndex.ToString());
        }
        catch { }
        StateHasChanged();
        _ = FocusHskOverlay();

        // Phát âm thanh đếm ngược 3s chuẩn bị sang màn
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.countdownTick(3)");

        _countdownTimer?.Dispose();
        _countdownTimer = new Timer(OnCountdownTick, null, 1000, 1000);
    }

    private void OnCountdownTick(object? state)
    {
        InvokeAsync(async () =>
        {
            if (!_showStageComplete || !isPlayingHskShooter)
            {
                _countdownTimer?.Dispose();
                return;
            }

            _stageCountdown--;
            if (_stageCountdown > 0)
            {
                _ = JS.InvokeVoidAsync("eval", $"window.WordleSfx?.countdownTick({_stageCountdown})");
                StateHasChanged();
            }
            else
            {
                // Hết 3 giây đếm ngược -> Âm thanh GO và tự động sang màn tiếp theo!
                _countdownTimer?.Dispose();
                _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.countdownGo()");
                if (_currentStageIndex < _totalStages - 1)
                {
                    await NextStage();
                }
                else
                {
                    CloseHskShooterGame();
                }
            }
        });
    }

    private async Task SkipCountdownAndNextStage()
    {
        _countdownTimer?.Dispose();
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.countdownGo()");
        if (_currentStageIndex < _totalStages - 1)
        {
            await NextStage();
        }
        else
        {
            CloseHskShooterGame();
        }
    }

    private void OnHskTick(object? state)
    {
        if (hskShooterState != HskGameState.Playing || _showStageComplete || _showStageMap) return;

        InvokeAsync(() =>
        {
            var now = DateTime.UtcNow;

            for (int i = hskActiveWords.Count - 1; i >= 0; i--)
            {
                var w = hskActiveWords[i];
                if (w.IsDestroyed) continue;
                if ((now - w.SpawnTime).TotalSeconds >= w.FallDurationSec)
                {
                    hskActiveWords.RemoveAt(i);
                    hskLives = Math.Max(0, hskLives - 1);
                    hskCombo = 0;
                    _lastMissedVocab = w.Vocab;
                    _missedWordsInStage.Add(w.Vocab);
                    ShowMissedAlert();
                    _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.damageHit()");
                    TriggerDamageFlash();
                    if (hskLives <= 0)
                    {
                        hskShooterState = HskGameState.GameOver;
                        hskTimer?.Dispose();
                        _countdownTimer?.Dispose();
                        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.lose()");
                        StateHasChanged();
                        _ = FocusHskOverlay();
                        return;
                    }
                }
            }

            // Kiểm tra hoàn thành tầng
            if (hskSpawnIndex >= _currentStageWords.Count && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
            {
                TriggerStageComplete();
                return;
            }

            // =========================================================================
            // TỐC ĐỘ CỰC DỄ VÀ RA LẦN LƯỢT ĐÚNG ĐỘ KHÓ BÀN:
            // Tầng 1 - 2 (Cực dễ): Ra đúng 1 từ duy nhất, rơi cực chậm (15s)
            // Tầng 3 - 4 (Dễ vừa): 1-2 từ (11-13s)
            // Tầng 5 - 6 (Trung bình): 2 từ (9-10s)
            // Tầng 7+ (Khó): 2-3 từ (7-8s)
            // Tầng Boss: 3-4 từ (5.5s)
            // =========================================================================
            bool isBoss = _currentStageIndex == _totalStages - 1;

            int maxConcurrent = _currentStageIndex switch
            {
                0 => 1,       // Tầng 1: Cực dễ - đúng 1 từ lần lượt
                1 => 1,       // Tầng 2: Cực dễ - đúng 1 từ lần lượt
                2 => 1,       // Tầng 3: 1 từ
                3 or 4 => 2,  // Tầng 4 - 5: tối đa 2 từ
                5 or 6 => 2,  // Tầng 6 - 7: tối đa 2 từ
                _ => isBoss ? 4 : 3
            };

            double baseFallSec = _currentStageIndex switch
            {
                0 => 15.0,    // Tầng 1: 15 giây rất chậm và dễ
                1 => 13.5,    // Tầng 2: 13.5 giây
                2 => 12.0,    // Tầng 3: 12 giây
                3 => 10.5,    // Tầng 4: 10.5 giây
                4 => 9.5,     // Tầng 5: 9.5 giây
                5 => 8.5,     // Tầng 6: 8.5 giây
                6 => 7.5,     // Tầng 7: 7.5 giây
                _ => isBoss ? 5.5 : 6.5
            };

            double minSpawnIntervalSec = _currentStageIndex switch
            {
                0 or 1 => 2.5, // Giãn cách 2.5 giây giữa các từ
                2 or 3 => 2.0,
                _ => 1.5
            };

            var activeCount = hskActiveWords.Count(w => !w.IsDestroyed);
            var elapsedSinceLast = (now - _lastHskSpawnTime).TotalSeconds;
            var requiredInterval = activeCount == 0 ? 0.6 : minSpawnIntervalSec;

            if (activeCount < maxConcurrent && hskSpawnIndex < _currentStageWords.Count && elapsedSinceLast >= requiredInterval)
            {
                var vocab = _currentStageWords[hskSpawnIndex];
                hskSpawnIndex++;
                _lastHskSpawnTime = now;
                
                var fallSec = baseFallSec + hskRng.NextDouble() * 2.0;

                hskActiveWords.Add(new FallingWord
                {
                    Vocab = vocab,
                    SpawnTime = now,
                    FallDurationSec = fallSec,
                    XPercent = 14 + hskRng.NextDouble() * 72 // 14% to 86%
                });
            }

            StateHasChanged();
        });
    }

    private async Task FocusHskInput()
    {
        try { await hskInputRef.FocusAsync(); } catch { }
    }

    private async Task FocusHskOverlay()
    {
        try { await hskOverlayRef.FocusAsync(); } catch { }
    }

    private void FocusHskOnBackgroundClick()
    {
        if (hskShooterState == HskGameState.Playing && !_showStageComplete && !_showStageMap && !_showResumeDialog)
        {
            _ = FocusHskInput();
        }
    }

    private async void TriggerDamageFlash()
    {
        showDamageFlash = true;
        StateHasChanged();
        await Task.Delay(350);
        showDamageFlash = false;
        StateHasChanged();
    }

    private void ShowMissedAlert()
    {
        _showMissedBanner = true;
        _missedAlertCts?.Cancel();
        _missedAlertCts = new CancellationTokenSource();
        var token = _missedAlertCts.Token;
        _ = Task.Delay(4000, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _showMissedBanner = false;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        var key = e.Key.ToUpperInvariant();

        // 1. Phím 1: Bật/Tắt Nhạc
        if (key == "1" || e.Code == "Digit1" || e.Code == "Numpad1")
        {
            await ToggleBgm();
            return;
        }

        // 2. Phím 2: Ẩn/Hiện Pinyin
        if (key == "2" || e.Code == "Digit2" || e.Code == "Numpad2")
        {
            TogglePinyin();
            return;
        }

        // 3. Phím 3: Tạm dừng / Tiếp tục
        if (key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
        {
            ToggleHskPause();
            return;
        }

        // Phím Escape: Thoát trò chơi
        if (key == "ESCAPE" || e.Code == "Escape")
        {
            CloseHskShooterGame();
            return;
        }
    }

    private async Task HandleHskKeyDown(KeyboardEventArgs e)
    {
        if (!isPlayingHskShooter) return;

        var key = e.Key.ToUpperInvariant();

        // 0. Bản đồ tầng đang mở -> Esc để đóng, Enter/Space/3 để tiếp tục chơi
        if (_showStageMap)
        {
            if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseStageMap();
                return;
            }
            if (key == "ENTER" || key == " " || key == "SPACE" || key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
            {
                ResumeAndCloseMap();
                return;
            }
            return;
        }

        // 1. Sang màn khi hoàn thành tầng (Next stage hoặc bấm Enter qua màn ngay, Esc để thoát)
        if (_showStageComplete)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                await SkipCountdownAndNextStage();
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
            }
            return;
        }

        // 2. Tiếp tục khi có hộp thoại lưu tiến trình
        if (_showResumeDialog)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                await ResumeFromSavedStage();
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                await StartFreshFromStage0();
            }
            return;
        }

        // 3. Kết thúc game (Game Over) -> Enter chơi lại ngay, Esc thoát
        if (hskShooterState == HskGameState.GameOver)
        {
            if (key == "ENTER" || key == " " || key == "SPACE")
            {
                await LoadStage(_currentStageIndex);
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
            }
            return;
        }

        // 4. Tạm dừng -> 3/Enter/Space tiếp tục, Esc thoát
        if (hskShooterState == HskGameState.Paused)
        {
            if (key == "ENTER" || key == " " || key == "SPACE" || key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
            {
                ToggleHskPause();
            }
            else if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
            }
            return;
        }

        // 5. Đang chơi:
        if (hskShooterState == HskGameState.Playing && !_showStageComplete && !_showStageMap && !_showResumeDialog)
        {
            // Phím 1: Bật/Tắt Nhạc
            if (key == "1" || e.Code == "Digit1" || e.Code == "Numpad1")
            {
                await ToggleBgm();
                return;
            }

            // Phím 2: Ẩn/Hiện Pinyin
            if (key == "2" || e.Code == "Digit2" || e.Code == "Numpad2")
            {
                TogglePinyin();
                return;
            }

            // Phím 3: Tạm dừng
            if (key == "3" || e.Code == "Digit3" || e.Code == "Numpad3")
            {
                ToggleHskPause();
                return;
            }

            // Phím Escape: Thoát trò chơi
            if (key == "ESCAPE" || e.Code == "Escape")
            {
                CloseHskShooterGame();
                return;
            }

            // Phím Backspace khi click chuột ra ngoài chiến trường: Chỉ xóa ký tự trong ô nhập, KHÔNG BAO GIỜ THOÁT GAME
            if (key == "BACKSPACE" || e.Code == "Backspace")
            {
                if (!string.IsNullOrEmpty(hskInputValue))
                {
                    hskInputValue = hskInputValue[..^1];
                    _ = JS.InvokeVoidAsync("eval", "window.focusHskInput?.()");
                    StateHasChanged();
                }
                return;
            }

            // Tự động gõ chữ vào ô nhập kể cả khi click nhầm chuột ra ngoài
            if (e.Key.Length == 1 && char.IsLetter(e.Key[0]))
            {
                hskInputValue += e.Key.ToLowerInvariant();
                _ = JS.InvokeVoidAsync("eval", "window.focusHskInput?.()");
                StateHasChanged();
                return;
            }
        }
    }

    private async Task ToggleBgm()
    {
        try
        {
            _isBgmOn = await JS.InvokeAsync<bool>("eval", "window.WordleSfx?.toggleBgm() ?? false");
            StateHasChanged();
        }
        catch { }
    }

    private void ToggleHskPause()
    {
        if (hskShooterState == HskGameState.Playing)
        {
            hskShooterState = HskGameState.Paused;
            _hskPauseStartTime = DateTime.UtcNow;
            _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm()");
        }
        else if (hskShooterState == HskGameState.Paused)
        {
            hskShooterState = HskGameState.Playing;
            if (_hskPauseStartTime.HasValue)
            {
                var pausedDuration = DateTime.UtcNow - _hskPauseStartTime.Value;
                _hskPauseStartTime = null;
                foreach (var w in hskActiveWords)
                {
                    w.SpawnTime += pausedDuration;
                }
                _lastHskSpawnTime += pausedDuration;
            }

            if (_isBgmOn)
            {
                _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.startBgm()");
            }
            _ = FocusHskInput();
        }
        StateHasChanged();
    }

    private void CloseHskShooterGame()
    {
        hskTimer?.Dispose();
        _countdownTimer?.Dispose();
        _hskPauseStartTime = null;
        _wasPausedByMap = false;
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm()");
        hskShooterState = HskGameState.Menu;
        isPlayingHskShooter = false;
        _showStageMap = false;
        _showStageComplete = false;
        _showResumeDialog = false;
        hskBullets.Clear();
        hskImpacts.Clear();
    }

    private bool IsHskTargeted(FallingWord word)
    {
        if (string.IsNullOrWhiteSpace(hskInputValue)) return false;
        var normalized = NormalizePinyin(hskInputValue);
        return NormalizePinyin(word.Vocab.Pinyin).StartsWith(normalized, StringComparison.Ordinal);
    }

    private void TryMatchHskWord()
    {
        if (string.IsNullOrWhiteSpace(hskInputValue) || hskShooterState != HskGameState.Playing || _showStageComplete || _showStageMap) return;

        var normalized = NormalizePinyin(hskInputValue);
        var match = hskActiveWords.FirstOrDefault(w => !w.IsDestroyed && NormalizePinyin(w.Vocab.Pinyin) == normalized);

        if (match != null)
        {
            _ = HandleHskWordHit(match);
        }
    }

    private async Task HandleHskWordHit(FallingWord match)
    {
        hskInputValue = "";

        // 1. Tọa độ mục tiêu của từ vựng rơi tại thời điểm bắn trúng
        double targetX = match.XPercent;
        double elapsed = (DateTime.UtcNow - match.SpawnTime).TotalSeconds;
        double progress = Math.Clamp(elapsed / match.FallDurationSec, 0.0, 0.95);
        double targetY = Math.Clamp(5.0 + progress * 75.0, 10.0, 80.0);

        // 2. Bắn đạn laser từ máy bay (50%, 86%) hướng thẳng tới từ vựng
        var bullet = new ActiveBullet
        {
            Id = ++_bulletCounter,
            StartX = 50.0,
            StartY = 86.0,
            TargetX = targetX,
            TargetY = targetY
        };
        hskBullets.Add(bullet);

        // Âm thanh bắn laser
        try { await JS.InvokeVoidAsync("eval", "window.WordleSfx?.laserShoot()"); } catch { }
        StateHasChanged();

        // 3. Sau 180ms: Đạn chạm vào từ vựng -> Kích hoạt hiệu ứng va chạm nổ và âm thanh nổ
        await Task.Delay(180);
        hskBullets.Remove(bullet);
        
        // Âm thanh va chạm đạn nổ
        try { await JS.InvokeVoidAsync("eval", "window.WordleSfx?.bulletHit()"); } catch { }

        var impact = new ActiveImpact
        {
            Id = ++_impactCounter,
            X = targetX,
            Y = targetY
        };
        hskImpacts.Add(impact);

        match.IsDestroyed = true;
        hskCombo++;
        int comboBonus = hskCombo >= 2 ? (hskCombo * 5) : 0;
        hskScore += 10 + comboBonus;
        hskWordsShot++;
        hskWordsShotInStage++;

        // Âm thanh combo khi đoán trúng nhiều từ liên tiếp (>= 2)
        if (hskCombo >= 2)
        {
            try { await JS.InvokeVoidAsync("eval", $"window.WordleSfx?.comboSound({hskCombo})"); } catch { }
        }

        _ = HskSvc.UpdateVocabProgressAsync(match.Vocab.Id, true).ContinueWith(t =>
        {
            if (t.Result) hskNewLearned++;
        });

        StateHasChanged();

        // 4. Sau 320ms: Thu hồi hiệu ứng nổ và xóa thẻ từ vựng
        await Task.Delay(320);
        hskImpacts.Remove(impact);
        hskActiveWords.Remove(match);

        if (hskSpawnIndex >= _currentStageWords.Count && hskActiveWords.Count(w => !w.IsDestroyed) == 0)
        {
            TriggerStageComplete();
        }

        StateHasChanged();
    }

    private static string NormalizePinyin(string pinyin)
    {
        if (string.IsNullOrEmpty(pinyin)) return "";
        var decomposed = pinyin.ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in decomposed)
        {
            var uc = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (uc != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                if (c >= 'a' && c <= 'z') sb.Append(c);
            }
        }
        return sb.ToString();
    }

    public void Dispose()
    {
        wordleTimer?.Dispose();
        hskTimer?.Dispose();
        _countdownTimer?.Dispose();
        _ = JS.InvokeVoidAsync("eval", "window.WordleSfx?.stopBgm()");
    }
