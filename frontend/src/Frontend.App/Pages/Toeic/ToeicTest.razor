@page "/toeic/test"
@page "/toeic/test/{*ExamUrl}"
@using Frontend.App.Models
@using Frontend.App.Services
@inject ToeicService ToeicService
@inject MockTestService MockTestService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ExamHeaderService ExamHeader
@implements IDisposable

<PageTitle>@(exam?.Title ?? "TOEIC Test 1 - 2026") - HỆ THỐNG THI TRỰC TUYẾN</PageTitle>

<div class="toeic-exam-root">
@if (isLoading)
{
    <div class="toeic-loading">
        <div class="toeic-loading-inner">
            <div class="loading-spinner"></div>
            <p>Đang tải...</p>
        </div>
    </div>
}
else if (showTestList)
{
    <div class="toeic-test-list-container">
        <div class="header-logo" style="justify-content: center; margin-top: 2rem; margin-bottom: 2rem;">
            <span class="logo-icon">🎓</span>
            <span class="header-title" style="font-size: 2rem;">HỆ THỐNG THI TRỰC TUYẾN</span>
        </div>
        <h2 style="text-align: center; color: #0d1b2a; margin-bottom: 2rem;">Danh sách đề thi TOEIC (@availableTests?.Count đề)</h2>
        
        @if (availableTests == null || !availableTests.Any())
        {
            <p style="text-align:center; color: #aaa;">Chưa có đề thi nào.</p>
        }
        else
        {
            <div class="test-grid">
                @foreach (var t in availableTests)
                {
                    <div class="test-card" @onclick="() => GoToTest(t.ToeicUrl)">
                        <div class="test-collection">@t.CollectionName</div>
                        <div class="test-title">@t.Title</div>
                        <button class="btn-start">Làm bài →</button>
                    </div>
                }
            </div>
        }
    </div>
}
else if (exam == null)
{
    <div class="toeic-error">
        <div class="error-icon">📭</div>
        <h3>Không tải được đề thi</h3>
        <p>Vui lòng thử lại hoặc chọn đề khác.</p>
        <p style="color: gray; font-size: 0.8rem;">URL: @ExamUrl</p>
        <p style="color: gray; font-size: 0.8rem;">Decoded: @DecodeExamUrl(ExamUrl ?? "")</p>
        <p style="color: gray; font-size: 0.8rem;">Resolved: @ToeicService.ResolveUrl(DecodeExamUrl(ExamUrl ?? ""))</p>
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div style="margin-top: 1rem; padding: 1rem; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; text-align: left; border-radius: 6px; font-family: monospace; max-width: 800px;">
                @loadError
            </div>
        }
        <button class="btn-start" style="margin-top: 1.5rem;" @onclick='() => NavManager.NavigateTo("/toeic/test")'>← Về danh sách đề</button>
    </div>
}
else if (showSetup && exam != null)
{
    @* ── SETUP: MÀN HÌNH CHỌN PART ── *@
    <div class="toeic-setup-container">
        <div class="setup-header">
            <h1 class="setup-title">@exam.Title</h1>
            <div class="setup-meta">
                <span><i class="bi bi-clock-history"></i> Thời gian làm bài: <b>@FormatDuration(SelectedTimeSeconds)</b></span>
            </div>
            <div class="setup-structure-label">Cấu trúc đề thi</div>
        </div>

        <div class="setup-card">
            <label class="setup-toggle-row">
                <input type="checkbox" @bind="selectByPart" />
                <span>Chọn từng part</span>
            </label>

            @if (selectByPart)
            {
                <div class="setup-time-row">
                    <label for="setup-time-select">Chọn thời gian làm bài:</label>
                    <select id="setup-time-select" class="setup-time-select" @bind="selectedTimeSeconds">
                        @foreach (var opt in GetTimeOptions())
                        {
                            <option value="@opt.Seconds">@opt.Label</option>
                        }
                    </select>
                </div>
            }

            @* LISTENING *@
            <div class="setup-section-label">LISTENING</div>
            @foreach (var part in SetupListeningParts)
            {
                <label class="setup-part-row">
                    @if (selectByPart)
                    {
                        <input type="checkbox"
                               checked="@selectedPartNumbers.Contains(part.PartNumber)"
                               @onchange="e => TogglePart(part.PartNumber, (bool)e.Value!)" />
                    }
                    else
                    {
                        <span class="part-check-spacer"></span>
                    }
                    <span class="part-label">PART @part.PartNumber</span>
                    <span class="part-count">@CountQuestions(part) câu</span>
                </label>
            }

            @* READING *@
            <div class="setup-section-label">READING</div>
            @foreach (var part in SetupReadingParts)
            {
                <label class="setup-part-row">
                    @if (selectByPart)
                    {
                        <input type="checkbox"
                               checked="@selectedPartNumbers.Contains(part.PartNumber)"
                               @onchange="e => TogglePart(part.PartNumber, (bool)e.Value!)" />
                    }
                    else
                    {
                        <span class="part-check-spacer"></span>
                    }
                    <span class="part-label">PART @part.PartNumber</span>
                    <span class="part-count">@CountQuestions(part) câu</span>
                </label>
            }

            @if (selectByPart && selectedPartNumbers.Count == 0)
            {
                <div class="setup-warning">Vui lòng chọn ít nhất một part.</div>
            }

            <button class="setup-start-btn"
                    disabled="@(selectByPart && selectedPartNumbers.Count == 0)"
                    @onclick="StartExamFromSetup">
                BẮT ĐẦU →
            </button>
            <button class="setup-back-btn" @onclick='() => NavManager.NavigateTo("/toeic/test")'>← Chọn đề khác</button>
        </div>
    </div>
}
else
{
    var activePart = exam.Parts[activePartIndex];
    var pageGroup = CurrentPageGroup;
    int totalAnswered = exam.Parts.Sum(p => p.QuestionGroups.Sum(g => g.Questions.Count(q => q.SelectedOptionId.HasValue)));

    @* ── PART TABS ── *@
    <nav class="part-nav-bar">
        @for (int i = 0; i < exam.Parts.Count; i++)
        {
            var idx  = i;
            var part = exam.Parts[i];
            int partAnswered = part.QuestionGroups.Sum(g => g.Questions.Count(q => q.SelectedOptionId.HasValue));
            int partTotal    = part.QuestionGroups.Sum(g => g.Questions.Count);
            <button class="part-tab @(activePartIndex == idx ? "active" : "")"
                    id="part-tab-@idx"
                    @onclick="() => SwitchPart(idx)">
                <span class="part-tab-label">PART @part.PartNumber</span>
                <span class="part-tab-count @(partAnswered == partTotal && partTotal > 0 ? "all-done" : "")">@partAnswered/@partTotal</span>
            </button>
        }
        <div class="part-tab-spacer"></div>
        <div class="total-score-badge">
            <span class="score-num">@totalAnswered</span>
            <span class="score-sep">/</span>
            <span class="score-total">@exam.TotalQuestions</span>
        </div>
    </nav>

    @* ── MAIN CONTENT AREA ── *@
    <main class="toeic-main">
        @if (!activePart.HasListening || !audioStarted)
        {
            <div class="exam-page-toolbar" style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:16px; padding:12px 16px; border:1px solid #d0d7de; border-radius:10px; background:#f6f8fa; color:#57606a; font-weight:700;">
                @if (!activePart.HasListening)
                {
                    <span>Trang @(activePageIndex + 1) / @PageCount</span>
                }
                @if (activePart.HasListening && !audioStarted && (pageGroup is not null || ShowIntroPage))
                {
                    <button class="audio-start-btn" style="border:0; border-radius:6px; padding:9px 16px; color:#fff; background:linear-gradient(135deg,#ea580c,#f97316); cursor:pointer; font-weight:700;" @onclick="StartCurrentAudio">
                        ▶ Bắt đầu nghe
                    </button>
                }
            </div>
        }
        @if (ShowIntroPage)
        {
            <div class="toeic-intro-block">
                @if (activePart.PartNumber == 1)
                {
                    <h2 class="intro-title">LISTENING TEST</h2>
                    <p class="intro-desc">In the Listening test, you will be asked to demonstrate how well you understand spoken English. The entire Listening test will last approximately 45 minutes. There are four parts, and directions are given for each part. You must mark your answers on the separate answer sheet. Do not write your answers in your test book.</p>
                }
                else if (activePart.PartNumber == 5)
                {
                    <h2 class="intro-title">READING TEST</h2>
                    <p class="intro-desc">In the Reading test, you will read a variety of texts and answer several different types of reading comprehension questions. The entire Reading test will last 75 minutes. There are three parts, and directions are given for each part. You are encouraged to answer as many questions as possible within the time allowed. You must mark your answers on the separate answer sheet. Do not write your answers in your test book.</p>
                }

                <div class="directions-box">
                    <h3 class="part-title">PART @(activePart.PartNumber):</h3>
                    <p class="part-directions">@GetPartDirections(activePart.PartNumber)</p>
                    @if (activePart.PartNumber == 1)
                    {
                        <img src="https://pub-91655bd1442d498b9788d1f8f8575587.r2.dev/Cuongkeng/Part%201.jpg" alt="Sample picture" class="sample-picture" style="display:block; width:280px; max-width:100%; height:auto; margin:0 auto;" />
                        <p class="sample-statement">Statement (C), &ldquo;They&rsquo;re sitting at a table.&rdquo; is the best description of the picture, so you should select answer (C) and mark it on your answer sheet.</p>
                    }
                </div>

                <button class="intro-continue-btn" @onclick="SkipIntro">Tiếp tục →</button>
            </div>
        }
        else if (pageGroup is not null)
        {
            var group = pageGroup;
            @* Part 1: Hình ảnh trái, câu hỏi phải *@
            @if (activePart.PartType == "Photographs")
            {
                <div class="question-group photographs-group">
                    <div class="photo-layout">
                        <div class="photo-left">
                            @if (!string.IsNullOrWhiteSpace(group.ImageUrl))
                            {
                                <div class="photo-container">
                                    <div class="photo-number-badge">Câu hỏi</div>
                                    <img src="@group.ImageUrl" alt="Question photo" class="question-photo" />
                                </div>
                            }
                        </div>
                        <div class="photo-divider"></div>
                        <div class="photo-right">
                            @foreach (var q in CurrentPageQuestions)
                            {
                                <div class="toeic-question-block @(q.SelectedOptionId.HasValue ? "answered" : "") @(q.Id == activeQuestionId ? "active" : "")"
                                     id="tq-@q.Id">
                                    <div class="q-number-label">@q.Id.</div>
                                    <div class="options-list options-horizontal">
                                        @foreach (var opt in q.Options)
                                        {
                                            <button class="@OptionCssClass(q, opt)"
                                                    id="opt-@q.Id-@opt.Id"
                                                    title="Chọn đáp án @opt.Label"
                                                    @onclick="() => SelectAnswer(q, opt.Id)">
                                                <span class="opt-circle">@opt.Label</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            @* Part 2: Không in câu hỏi (nghe từ audio), chỉ có 3 lựa chọn A/B/C *@
            else if (activePart.PartType == "QuestionResponse")
            {
                <div class="question-group qr-group">
                    @foreach (var q in CurrentPageQuestions)
                    {
                        <div class="toeic-question-block @(q.SelectedOptionId.HasValue ? "answered" : "") @(q.Id == activeQuestionId ? "active" : "")"
                             id="tq-@q.Id">
                            <div class="q-header">
                                <span class="q-number-circle">@q.Id</span>
                                <span class="q-listening-note">🎧 Nghe và chọn đáp án</span>
                            </div>
                            <div class="options-list options-horizontal">
                                @foreach (var opt in q.Options)
                                {
                                    <button class="@OptionCssClass(q, opt)"
                                            id="opt-@q.Id-@opt.Id"
                                            title="Chọn đáp án @opt.Label"
                                            @onclick="() => SelectAnswer(q, opt.Id)">
                                        <span class="opt-circle">@opt.Label</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            @* Part 3 & 4: Ảnh bên trái, câu hỏi và đáp án bên phải *@
            else if (activePart.PartType == "Conversations" || activePart.PartType == "Talks")
            {
                <div class="question-group conversation-group">
                    <div class="conversation-split">
                        <div class="conv-image-pane">
                            @if (!string.IsNullOrWhiteSpace(group.ImageUrl))
                            {
                                <img src="@group.ImageUrl" alt="Ảnh minh hoạ đoạn hội thoại" class="conversation-image" />
                            }
                            else
                            {
                                <div class="conv-no-image">🎧</div>
                            }
                            @if (showAnswers && !string.IsNullOrWhiteSpace(group.Transcript))
                            {
                                <section class="conversation-transcript">
                                    <h3>📝 Nội dung audio</h3>
                                    <div>@group.Transcript</div>
                                </section>
                            }
                        </div>
                        <div class="conv-divider"></div>
                        <div class="conv-questions-pane">
                            @if (!string.IsNullOrWhiteSpace(group.PassageTitle))
                            {
                                <div class="conversation-header">
                                    <span class="conv-icon">🎧</span>
                                    <span class="conv-title">@group.PassageTitle</span>
                                    <span class="conv-note">Nghe và trả lời câu hỏi</span>
                                </div>
                            }
                            <div class="conversation-questions">
                                @foreach (var q in CurrentPageQuestions)
                                {
                                    <div class="toeic-question-block @(q.SelectedOptionId.HasValue ? "answered" : "") @(q.Id == activeQuestionId ? "active" : "")"
                                         id="tq-@q.Id">
                                        <div class="q-header">
                                            <span class="q-number-circle">@q.Id</span>
                                            <span class="q-text-content">@q.Text</span>
                                        </div>
                                        <div class="options-list">
                                            @foreach (var opt in q.Options)
                                            {
                                                <button class="@OptionCssClass(q, opt)"
                                                        id="opt-@q.Id-@opt.Id"
                                                        @onclick="() => SelectAnswer(q, opt.Id)">
                                                    <span class="opt-circle">@opt.Label</span>
                                                    <span class="opt-text">@opt.Text</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            @* Part 5: Câu hoàn chỉnh *@
            else if (activePart.PartType == "IncompleteSentences")
            {
                <div class="question-group p5-group">
                    @foreach (var q in CurrentPageQuestions)
                    {
                        <div class="toeic-question-block @(q.SelectedOptionId.HasValue ? "answered" : "") @(q.Id == activeQuestionId ? "active" : "")"
                             id="tq-@q.Id">
                            <div class="q-header">
                                <span class="q-number-circle">@q.Id</span>
                                <span class="q-sentence">@q.Text</span>
                            </div>
                            <div class="options-list options-grid-2">
                                @foreach (var opt in q.Options)
                                {
                                    <button class="@OptionCssClass(q, opt)"
                                            id="opt-@q.Id-@opt.Id"
                                            @onclick="() => SelectAnswer(q, opt.Id)">
                                        <span class="opt-circle">@opt.Label</span>
                                        <span class="opt-text">@opt.Text</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            @* Part 6: Điền đoạn văn - Layout split *@
            else if (activePart.PartType == "TextCompletion")
            {
                <div class="question-group p6-group">
                    <div class="split-layout">
                        <div class="split-passage" id="passage-@group.GroupId">
                            @if (!string.IsNullOrWhiteSpace(group.ImageUrl))
                            {
                                <img src="@group.ImageUrl" alt="Đoạn văn Part 6" class="passage-image" />
                            }
                            else if (!string.IsNullOrWhiteSpace(group.PassageTitle))
                            {
                                <h3 class="passage-title">@group.PassageTitle</h3>
                            }
                            <div class="passage-content">
                                @((MarkupString)group.PassageHtml)
                            </div>
                        </div>
                        <div class="split-divider"></div>
                        <div class="split-questions">
                            @foreach (var q in CurrentPageQuestions)
                            {
                                <div class="toeic-question-block @(q.SelectedOptionId.HasValue ? "answered" : "") @(q.Id == activeQuestionId ? "active" : "")"
                                     id="tq-@q.Id">
                                    <div class="q-header">
                                        <span class="q-number-circle">@q.Id</span>
                                        @if (!string.IsNullOrWhiteSpace(q.Text))
                                        {
                                            <span class="q-text-content">@q.Text</span>
                                        }
                                    </div>
                                    <div class="options-list options-grid-2">
                                        @foreach (var opt in q.Options)
                                        {
                                            <button class="@OptionCssClass(q, opt)"
                                                    id="opt-@q.Id-@opt.Id"
                                                    @onclick="() => SelectAnswer(q, opt.Id)">
                                                <span class="opt-circle">@opt.Label</span>
                                                <span class="opt-text">@opt.Text</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @if (showAnswers && !string.IsNullOrWhiteSpace(group.Translation))
                    {
                        <section class="passage-translation">
                            <h3>DỊCH:</h3>
                            <div>@((MarkupString)FormatTranslation(group.Translation))</div>
                        </section>
                    }
                </div>
            }
            @* Part 7: Đọc hiểu - Layout split *@
            else if (activePart.PartType == "ReadingComprehension")
            {
                <div class="question-group p7-group">
                    <div class="split-layout">
                        <div class="split-passage" id="passage-@group.GroupId">
                            @if (!string.IsNullOrWhiteSpace(group.ImageUrl))
                            {
                                <img src="@group.ImageUrl" alt="Đoạn văn Part 7" class="passage-image" />
                            }
                            else if (!string.IsNullOrWhiteSpace(group.PassageTitle))
                            {
                                <h3 class="passage-title">@group.PassageTitle</h3>
                            }
                            <div class="passage-content">
                                @((MarkupString)group.PassageHtml)
                            </div>
                        </div>
                        <div class="split-divider"></div>
                        <div class="split-questions">
                            @foreach (var q in CurrentPageQuestions)
                            {
                                <div class="toeic-question-block @(q.SelectedOptionId.HasValue ? "answered" : "") @(q.Id == activeQuestionId ? "active" : "")"
                                     id="tq-@q.Id">
                                    <div class="q-header">
                                        <span class="q-number-circle">@q.Id</span>
                                        <span class="q-text-content">@q.Text</span>
                                    </div>
                                    <div class="options-list">
                                        @foreach (var opt in q.Options)
                                        {
                                            <button class="@OptionCssClass(q, opt)"
                                                    id="opt-@q.Id-@opt.Id"
                                                    @onclick="() => SelectAnswer(q, opt.Id)">
                                                <span class="opt-circle">@opt.Label</span>
                                                <span class="opt-text">@opt.Text</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @if (showAnswers && !string.IsNullOrWhiteSpace(group.Translation))
                    {
                        <section class="passage-translation">
                            <h3>DỊCH:</h3>
                            <div>@((MarkupString)FormatTranslation(group.Translation))</div>
                        </section>
                    }
                </div>
            }
        }

        @* Part Navigation Buttons (bài nghe không cho phép quay lại) *@
        <div class="part-footer-nav">
            @if (HasPreviousPage && !activePart.HasListening)
            {
                <button class="nav-btn prev-btn" @onclick="PreviousPage">
                    @PreviousPageLabel
                </button>
            }
            <div class="nav-spacer"></div>
            @if (HasNextPage && !activePart.HasListening)
            {
                <button class="nav-btn next-btn" @onclick="NextPage">
                    @NextPageLabel
                </button>
            }
            else if (!HasNextPage)
            {
                <button class="nav-btn submit-final-btn" @onclick="SubmitExam">
                    NỘP BÀI ✓
                </button>
            }
        </div>
    </main>

    @* ── BOTTOM Q-NAVIGATOR BAR ── *@
    <div class="bottom-qnav">
        <div class="bottom-qnav-inner">
            <span class="bottom-qnav-label">Part @activePart.PartNumber:</span>
            <div class="bottom-qnav-nums">
                @foreach (var group in activePart.QuestionGroups)
                {
                    @foreach (var q in group.Questions)
                    {
                        <button class="qnav-num @(q.SelectedOptionId.HasValue ? "qnav-answered" : "") @(q.Id == activeQuestionId ? "qnav-active" : "")"
                                @onclick="async () => { activeQuestionId = q.Id; await ScrollToQuestion(q.Id); }">
                            @q.Id
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    @* ── CONFIRM SUBMIT MODAL ── *@
    @if (showConfirm)
    {
        <div class="result-overlay">
            <div class="result-modal">
                <div class="result-title">NỘP BÀI</div>
                <p class="confirm-text">Bạn có chắc muốn nộp bài không?</p>
                <p class="confirm-sub">Đã trả lời: <b>@totalAnswered/@exam.TotalQuestions</b> câu</p>
                <div class="confirm-actions">
                    <button class="btn-cancel" @onclick="() => showConfirm = false">Hủy</button>
                    <button class="result-close-btn" @onclick="ConfirmSubmit">Nộp bài</button>
                </div>
            </div>
        </div>
    }

    @* ── RESULT MODAL ── *@
    @if (showResult)
    {
        <div class="result-overlay">
            <div class="result-modal">
                <div class="result-title">🎉 KẾT QUẢ BÀI THI</div>
                <div class="result-score">
                    <span class="result-num">@totalScore</span>
                    <span class="result-sep">/</span>
                    <span class="result-total">990</span>
                </div>
                <div class="score-table">
                    <div class="score-row">
                        <span class="score-row-label">🎧 Listening</span>
                        <span class="score-row-correct">@listenCorrect câu đúng</span>
                        <span class="score-row-points"><b>@listenScore</b>/495</span>
                    </div>
                    <div class="score-row">
                        <span class="score-row-label">📖 Reading</span>
                        <span class="score-row-correct">@readCorrect câu đúng</span>
                        <span class="score-row-points"><b>@readScore</b>/495</span>
                    </div>
                </div>
                <div class="result-time">
                    ⏱ Thời gian đã dùng: @ElapsedTime
                </div>
                <button class="result-close-btn" @onclick="ShowAnswers">Xem đáp án</button>
                <button class="btn-cancel" style="margin-top: 12px;" @onclick="() => showResult = false">Đóng</button>
            </div>
        </div>
    }
}
</div>

@code {
    [Parameter] public string? ExamUrl { get; set; }

    private ToeicExamData? exam;
    private bool isLoading = true;
    private int activePartIndex = 0;
    private int activePageIndex = 0;
    private int activeQuestionId = 0;
    private bool audioStarted = false;
    private bool showConfirm = false;
    private bool showResult = false;
    private bool showAnswers = false;

    // Điểm TOEIC
