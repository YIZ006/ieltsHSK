    /// <summary>
    /// /toeic/test và /toeic/test/{url} dùng chung component nên khi điều hướng nội bộ,
    /// Blazor chỉ đổi Parameter chứ không tạo lại component.
    /// Toàn bộ việc tải dữ liệu phải đặt ở đây để phản ứng theo tham số mới.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadForCurrentRouteAsync();
    }

    private async Task LoadForCurrentRouteAsync()
    {
        if (_isReloadingRoute) return;
        _isReloadingRoute = true;
        try
        {
            var key = string.IsNullOrWhiteSpace(ExamUrl) ? "" : ToeicService.ResolveUrl(DecodeExamUrl(ExamUrl));

            // Đã tải đúng route hiện tại thì bỏ qua
            if (key == _lastLoadKey && (key != "" || availableTests != null)) return;
            _lastLoadKey = key;

            isLoading = true;
            loadError = "";

            try
            {
                if (string.IsNullOrWhiteSpace(key))
                {
                    // Danh sách đề
                    StopTimer();
                    ExamHeader.Hide();
                    showSetup = false;
                    exam = null;
                    _lastLoadKey = null;
                    if (availableTests == null || !availableTests.Any())
                    {
                        var tests = await MockTestService.GetMockTestsAsync();
                        availableTests = tests.Where(t =>
                            !string.IsNullOrEmpty(t.ToeicUrl) &&
                            t.CollectionName.Contains("TOEIC", StringComparison.OrdinalIgnoreCase)
                        ).ToList();
                    }
                }
                else
                {
                    ExamHeader.Hide();
                    string url = DecodeExamUrl(ExamUrl);
                    if (string.IsNullOrWhiteSpace(url))
                    {
                        throw new Exception("URL đề thi rỗng sau khi giải mã!");
                    }

                    var loaded = await ToeicService.LoadExamAsync(url);
                    if (loaded?.Parts?.Count > 0)
                    {
                        exam = loaded;
                        EnterSetupState();
                    }
                    else
                    {
                        throw new Exception("Đề thi tải được nhưng không có phần thi nào (parts trống).");
                    }
                }
            }
            catch (Exception ex)
            {
                loadError = ex.ToString();
            }

            isLoading = false;
        }
        finally
        {
            _isReloadingRoute = false;
        }
    }

    private void ResetExamState()
    {
        audioStarted = false;
        _introAudioTriggered = false;
        _lastPlayedAudioUrl = null;
        showConfirm = false;
        showResult = false;
        showAnswers = false;
        activePartIndex = 0;
        activePageIndex = 0;
        secondsLeft = exam!.TotalTimeSeconds;
        ExamHeader.Show(TimerDisplay);
        activeQuestionId = exam.Parts[0].QuestionGroups
            .FirstOrDefault()?.Questions.FirstOrDefault()?.Id ?? 0;
        _ = JS.InvokeVoidAsync("toeicAudio.stop");
        RestartTimer();
    }

    private void RestartTimer()
    {
        StopTimer();
        StartTimer();
    }

    /// <summary>
    /// Sau khi tải đề: hiển thị màn hình chọn part/thời gian thay vì vào thi ngay.
    /// </summary>
    private void EnterSetupState()
    {
        audioStarted = false;
        showConfirm = false;
        showResult = false;
        showAnswers = false;
        activePartIndex = 0;
        activePageIndex = 0;
        StopTimer();
        ExamHeader.Hide();
        _ = JS.InvokeVoidAsync("toeicAudio.stop");

        showSetup = true;
        selectByPart = false;
        selectedPartNumbers = new HashSet<int>(exam!.Parts.Select(p => p.PartNumber));
        standardTimeSeconds = exam.TotalTimeSeconds;
        selectedTimeSeconds = exam.TotalTimeSeconds;
    }

    private IEnumerable<ToeicPart> SetupListeningParts =>
        exam!.Parts.Where(p => p.HasListening || p.PartNumber <= 4);

    private IEnumerable<ToeicPart> SetupReadingParts =>
        exam!.Parts.Where(p => !p.HasListening && p.PartNumber > 4);

    private int SelectedTimeSeconds => selectedTimeSeconds;

    private static int CountQuestions(ToeicPart part) =>
        part.QuestionGroups.Sum(g => g.Questions.Count);

    private void TogglePart(int partNumber, bool isChecked)
    {
        if (isChecked) selectedPartNumbers.Add(partNumber);
        else selectedPartNumbers.Remove(partNumber);
    }

    private List<(int Seconds, string Label)> GetTimeOptions()
    {
        var options = new List<(int Seconds, string Label)>
        {
            (standardTimeSeconds, $"Thời gian chuẩn ({FormatDuration(standardTimeSeconds)})")
        };
        foreach (var minutes in new[] { 120, 105, 90, 75, 60, 45, 30 })
        {
            int seconds = minutes * 60;
            if (seconds == standardTimeSeconds) continue;
            options.Add((seconds, FormatDuration(seconds)));
        }
        return options;
    }

    private static string FormatDuration(int seconds)
    {
        int h = seconds / 3600;
        int m = seconds % 3600 / 60;
        return h > 0
            ? (m > 0 ? $"{h} giờ {m} phút" : $"{h} giờ")
            : $"{m} phút";
    }

    /// <summary>
    /// BẮT ĐẦU: lọc part theo lựa chọn, áp thời gian tuỳ chỉnh rồi vào bài thi.
    /// </summary>
    private void StartExamFromSetup()
    {
        if (exam == null) return;

        if (selectByPart)
        {
            var chosen = exam.Parts.Where(p => selectedPartNumbers.Contains(p.PartNumber)).ToList();
            if (chosen.Count == 0) return;
            exam.Parts = chosen;
            exam.TotalQuestions = chosen.Sum(CountQuestions);
        }
        exam.TotalTimeSeconds = selectedTimeSeconds;

        showSetup = false;
        ResetExamState();
    }

    private void StartTimer()
    {
        StopTimer();
        _timer = new System.Threading.Timer(_ =>
        {
            if (secondsLeft > 0)
            {
                secondsLeft--;
                InvokeAsync(() =>
                {
                    ExamHeader.UpdateTimer(TimerDisplay, secondsLeft < 600);
                    StateHasChanged();
                });
            }
            else
            {
                _timer?.Dispose();
                InvokeAsync(AutoSubmit);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    private void SwitchPart(int idx)
    {
        activePartIndex = idx;
        activePageIndex = 0;
        activeQuestionId = exam!.Parts[idx].QuestionGroups
            .FirstOrDefault()?.Questions.FirstOrDefault()?.Id ?? 0;
        _ = JS.InvokeVoidAsync("toeicAudio.stop");
    }

