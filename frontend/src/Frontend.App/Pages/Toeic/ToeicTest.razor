    /// <summary>
    /// Class của nút đáp án: selected khi đang chọn;
    /// ở chế độ xem đáp án: correct (đáp án đúng), wrong (user chọn sai).
    /// </summary>
    private string OptionCssClass(ToeicQuestion q, ToeicOption opt)
    {
        var cls = "option-btn";
        if (q.SelectedOptionId == opt.Id) cls += " selected";
        if (showAnswers && q.CorrectOptionId > 0)
        {
            if (opt.Id == q.CorrectOptionId) cls += " correct";
            else if (q.SelectedOptionId == opt.Id) cls += " wrong";
        }
        return cls;
    }

