    /// <summary>
    /// Quy đổi điểm Listening theo bảng ETS:
    /// 0 câu = 5đ, 1 câu = 15đ (câu đầu +10), 2–75 câu = 5đ/câu + 10,
    /// 76–95 câu = 5đ/câu + 15, từ 96 câu trỏ lên = 495.
    /// </summary>
    private static int ConvertListenScore(int correct)
    {
        if (correct <= 0) return 5;
        if (correct == 1) return 15;
        if (correct <= 75) return correct * 5 + 10;
        if (correct <= 95) return correct * 5 + 15;
        return 495;
    }

    private void CalculateResult()
    {
        int lCorrect = 0, rCorrect = 0;
        foreach (var part in exam!.Parts)
        {
            var isListening = part.HasListening || part.PartNumber <= 4;
            foreach (var g in part.QuestionGroups)
            {
                foreach (var q in g.Questions)
                {
                    if (!q.SelectedOptionId.HasValue) continue;
                    var isCorrect = q.CorrectOptionId > 0 && q.SelectedOptionId.Value == q.CorrectOptionId;
                    if (!isCorrect) continue;
                    if (isListening) lCorrect++; else rCorrect++;
                }
            }
        }

        listenCorrect = lCorrect;
        readCorrect = rCorrect;
        listenScore = ConvertListenScore(lCorrect);
        // Reading: mỗi câu 5đ, trần 495; 0 câu vẫn được 5đ
        readScore = rCorrect == 0 ? 5 : Math.Min(rCorrect * 5, 495);
        totalScore = listenScore + readScore;
    }

    private void GoToTest(string? toeicUrl)
    {
        if (!string.IsNullOrEmpty(toeicUrl))
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(toeicUrl);
            // Base64 URL-safe: tránh các ký tự '+', '/', '=' bị hỏng trong đường dẫn
            string base64 = Convert.ToBase64String(bytes)
                .TrimEnd('=')
                .Replace('+', '-')
                .Replace('/', '_');
            NavManager.NavigateTo($"/toeic/test/{base64}");
        }
    }

    /// <summary>
    /// Giải mã tham số ExamUrl: hỗ trợ base64 URL-safe, base64 chuẩn,
    /// hoặc URL http(s) được paste trực tiếp.
    /// </summary>
    private static string DecodeExamUrl(string encoded)
    {
        if (string.IsNullOrWhiteSpace(encoded)) return "";

        var s = Uri.UnescapeDataString(encoded).Trim();

        if (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            s.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return s;
        }

        // Chuẩn hoá base64 URL-safe về dạng chuẩn
        var b64 = s.Replace('-', '+').Replace('_', '/');
        b64 = (b64.Length % 4) switch
        {
            2 => b64 + "==",
            3 => b64 + "=",
            _ => b64
        };

        try
        {
            return System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(b64));
        }
        catch
        {
            return s;
        }
    }

    private void ShowAnswers()
    {
        showAnswers = true;
        showResult = false;
    }

    private string FormatTranslation(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        return input.Replace("<red>", "<span class=\"text-red\">")
                    .Replace("</red>", "</span>")
                    .Replace("<green>", "<span class=\"text-green\">")
                    .Replace("</green>", "</span>")
                    .Replace("<blue>", "<span class=\"text-blue\">")
                    .Replace("</blue>", "</span>")
                    .Replace("<orange>", "<span class=\"text-orange\">")
                    .Replace("</orange>", "</span>")
                    .Replace("<purple>", "<span class=\"text-purple\">")
                    .Replace("</purple>", "</span>")
                    .Replace("\n", "<br/>");
    }

    public void Dispose()
    {
        _isDisposing = true;
        ExamHeader.SubmitRequested -= OnHeaderSubmitRequested;
        ExamHeader.Hide();
        _timer?.Dispose();
    }
