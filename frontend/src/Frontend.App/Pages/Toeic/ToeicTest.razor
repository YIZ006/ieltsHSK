    private async Task StartCurrentAudio()
    {
        string? audioUrl;
        if (ShowIntroPage)
        {
            // Trang giới thiệu: Part 1 dùng file riêng,
            // các part nghe khác phát audio nhóm câu hỏi đầu tiên (có lời đọc hướng dẫn)
            audioUrl = ActivePart.PartNumber == 1
                ? Part1IntroAudioUrl
                : ActivePart.QuestionGroups.FirstOrDefault()?.AudioUrl;
            if (string.IsNullOrWhiteSpace(audioUrl)) return;
        }
        else
        {
            audioUrl = CurrentPageGroup?.AudioUrl;
            if (string.IsNullOrWhiteSpace(audioUrl)) return;
        }

        try
        {
            await JS.InvokeVoidAsync("toeicAudio.play", audioUrl, DotNetObjectReference.Create(this));
            _lastPlayedAudioUrl = audioUrl;
            audioStarted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ToeicTest] Audio error: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Vào thẳng trang giới thiệu (sau khi bấm BẮT ĐẦU): tự phát audio
        if (exam != null && !showSetup && !showResult && ShowIntroPage
            && !_introAudioTriggered && !audioStarted)
        {
            _introAudioTriggered = true;
            await StartCurrentAudio();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnToeicAudioEnded() => InvokeAsync(() =>
    {
        if (!audioStarted || exam == null || showResult || _isDisposing) return;
        NextPage();
        StateHasChanged();
    });

    private void NextPage()
    {
        if (activePageIndex < PageCount - 1)
        {
            activePageIndex++;
            SetCurrentQuestion();
            PlayNextAudioIfStarted();
            return;
        }

        if (activePartIndex < exam!.Parts.Count - 1)
        {
            SwitchPart(activePartIndex + 1);
            PlayNextAudioIfStarted();
        }
    }

    private void PreviousPage()
    {
        if (activePageIndex > 0)
        {
            activePageIndex--;
            SetCurrentQuestion();
            PlayNextAudioIfStarted();
            return;
        }

        if (activePartIndex > 0)
        {
            SwitchPart(activePartIndex - 1);
            activePageIndex = PageCount - 1;
            SetCurrentQuestion();
            PlayNextAudioIfStarted();
        }
    }

    private void SetCurrentQuestion() => activeQuestionId = CurrentPageQuestions.FirstOrDefault()?.Id ?? 0;

    private void PlayNextAudioIfStarted()
    {
        var url = CurrentPageGroup?.AudioUrl;
        // Bỏ qua nếu audio nhóm này vừa phát xong (vd: chuyển từ trang giới thiệu sang câu 1)
        if (audioStarted && !string.IsNullOrWhiteSpace(url) && url != _lastPlayedAudioUrl)
            _ = StartCurrentAudio();
    }

