                </div>
                <div class="summary-card">
                    <div class="summary-row"><span>Bộ đề:</span><strong>@collectionName</strong></div>
                    <div class="summary-row"><span>Tên bài:</span><strong>@examTitle</strong></div>
                    <div class="summary-row"><span>Thời gian:</span><strong>@examTimeMins phút</strong></div>
                    <div class="summary-divider"></div>
                    <div class="summary-row"><span>Part 1:</span><strong>@part1Groups.Count(g => !string.IsNullOrEmpty(g.ImageUrl) && !string.IsNullOrEmpty(g.AudioUrl)) / @part1Groups.Count câu đủ dữ liệu</strong></div>
                    <div class="summary-row"><span>Part 2:</span><strong>@part2Groups.Count(g => !string.IsNullOrEmpty(g.AudioUrl)) / @part2Groups.Count câu đủ audio</strong></div>
                    <div class="summary-row"><span>Part 3:</span><strong>@part3Groups.Count(g => !string.IsNullOrEmpty(g.AudioUrl)) / @part3Groups.Count nhóm đủ audio</strong></div>
                    <div class="summary-row"><span>Part 4:</span><strong>@part4Groups.Count(g => !string.IsNullOrEmpty(g.AudioUrl)) / @part4Groups.Count nhóm đủ audio</strong></div>
                    <div class="summary-row"><span>Part 5:</span><strong>@part5Questions.Count câu</strong></div>
                    <div class="summary-row"><span>Part 6:</span><strong>@part6Groups.Count bài / @part6Groups.Sum(g => g.Questions.Count) câu</strong></div>
                    <div class="summary-row"><span>Part 7:</span><strong>@part7Groups.Count bài / @Part7QuestionCount/@MaxPart7Questions câu</strong></div>
                </div>

                @if (!string.IsNullOrEmpty(saveError))
                {
                    <div class="alert-error">⚠️ @saveError</div>
