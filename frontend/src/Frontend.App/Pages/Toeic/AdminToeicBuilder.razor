    public class MediaGroup
    {
        public string GroupId { get; set; } = "";
        public string? ImageUrl { get; set; }
        public string? AudioUrl { get; set; }
        public string QuestionText { get; set; } = "";
        public string CorrectAnswer { get; set; } = "";
