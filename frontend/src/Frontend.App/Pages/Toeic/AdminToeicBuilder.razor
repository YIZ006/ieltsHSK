                @if (!string.IsNullOrEmpty(saveSuccess))
                {
                    <div class="alert-success">✅ @saveSuccess</div>
                }

                <div class="submit-actions">
                    <button class="btn-prev" @onclick="() => GoStep(7)">← Quay lại</button>
                    <button class="btn-submit" @onclick="SubmitExam" disabled="@isSaving">
