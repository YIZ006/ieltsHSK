                g.GroupId, ImageUrl=g.ImageUrl??"", AudioUrl="", PassageHtml="", PassageTitle="", Translation=g.Translation??"", Instructions="",
                Questions=g.Questions.Select(q=>new{
                    Id=qId++, q.Text,
                    Options=q.Options.Select((o,oi)=>new{Id=oi+1,o.Label,o.Text}).ToArray(),
                    CorrectOptionId=LabelToId(q.CorrectOptionLabel),
                    SelectedOptionId=(int?)null,
