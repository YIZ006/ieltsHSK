    private async Task HandleJsonImport(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var jsonContent = await reader.ReadToEndAsync();
            
            PopulateFormFromJson(jsonContent);
            
            ShowDraftToast("✨ Đã điền form từ file JSON!", "toast-ok");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            saveError = "Lỗi đọc file JSON: $($ex.Message)";
            ShowDraftToast("⚠️ Lỗi định dạng JSON", "toast-err");
            StateHasChanged();
        }
    }

    private string IdToLabel(int id) => id switch { 1=>"A", 2=>"B", 3=>"C", 4=>"D", _=>"A" };

    private void PopulateFormFromJson(string json)
    {
        var doc = System.Text.Json.JsonDocument.Parse(json);
        var root = doc.RootElement;

        examTitle = root.TryGetProperty("Title", out var titleProp) ? titleProp.GetString() ?? "" : "";
        examDescription = root.TryGetProperty("Description", out var descProp) ? descProp.GetString() ?? "" : "";
        if (root.TryGetProperty("TotalTimeSeconds", out var timeProp)) examTimeMins = timeProp.GetInt32() / 60;

        if (root.TryGetProperty("Parts", out var parts))
        {
            foreach (var part in parts.EnumerateArray())
            {
                int pNum = part.GetProperty("PartNumber").GetInt32();
                if (!part.TryGetProperty("QuestionGroups", out var groups)) continue;

                switch (pNum)
                {
                    case 1:
                        int p1Idx = 0;
                        foreach(var g in groups.EnumerateArray())
                        {
                            if (p1Idx >= part1Groups.Count) break;
                            var q = g.GetProperty("Questions")[0];
                            var mg = part1Groups[p1Idx];
                            mg.ImageUrl = g.TryGetProperty("ImageUrl", out var iu) ? iu.GetString() : null;
                            mg.AudioUrl = g.TryGetProperty("AudioUrl", out var au) ? au.GetString() : null;
                            mg.CorrectAnswer = IdToLabel(q.GetProperty("CorrectOptionId").GetInt32());
                            mg.Explanation = q.TryGetProperty("Explanation", out var expl) ? expl.GetString() ?? "" : "";
                            if (q.TryGetProperty("Options", out var opts))
                            {
                                int i = 0;
                                foreach (var opt in opts.EnumerateArray()) { if (i < 4) mg.Options[i++].Text = opt.GetProperty("Text").GetString() ?? ""; }
                                mg.BulkOptionText = string.Join("\n", mg.Options.Select(o => o.Text));
                            }
                            p1Idx++;
                        }
                        break;
                    case 2:
                        int p2Idx = 0;
                        foreach(var g in groups.EnumerateArray())
                        {
                            if (p2Idx >= part2Groups.Count) break;
                            var q = g.GetProperty("Questions")[0];
                            var mg = part2Groups[p2Idx];
                            mg.AudioUrl = g.TryGetProperty("AudioUrl", out var au) ? au.GetString() : null;
                            mg.QuestionText = q.TryGetProperty("Text", out var qt) ? qt.GetString() ?? "" : "";
                            mg.CorrectAnswer = IdToLabel(q.GetProperty("CorrectOptionId").GetInt32());
                            mg.Explanation = q.TryGetProperty("Explanation", out var expl) ? expl.GetString() ?? "" : "";
                            if (q.TryGetProperty("Options", out var opts))
                            {
                                int i = 0;
                                foreach (var opt in opts.EnumerateArray()) { if (i < 3) mg.Options[i++].Text = opt.GetProperty("Text").GetString() ?? ""; }
                                mg.BulkOptionText = string.Join("\n", mg.Options.Take(3).Select(o => o.Text));
                            }
                            p2Idx++;
                        }
                        break;
                    case 3:
                    case 4:
                        var targetList = pNum == 3 ? part3Groups : part4Groups;
                        int p34Idx = 0;
                        foreach(var g in groups.EnumerateArray())
                        {
                            if (p34Idx >= targetList.Count) break;
                            var cg = targetList[p34Idx];
                            cg.Title = g.TryGetProperty("PassageTitle", out var t2) ? t2.GetString() ?? "" : "";
                            cg.Transcript = g.TryGetProperty("Transcript", out var tr) ? tr.GetString() ?? (g.TryGetProperty("PassageHtml", out var h2) ? h2.GetString() ?? "" : "") : "";
                            cg.AudioUrl = g.TryGetProperty("AudioUrl", out var au) ? au.GetString() : null;
                            cg.ImageUrl = g.TryGetProperty("ImageUrl", out var iu) ? iu.GetString() : null;
                            
                            int qIdx = 0;
                            foreach(var q in g.GetProperty("Questions").EnumerateArray())
                            {
                                if (qIdx >= cg.Questions.Count) break;
                                var cq = cg.Questions[qIdx];
                                cq.Text = q.TryGetProperty("Text", out var qt) ? qt.GetString() ?? "" : "";
                                cq.CorrectOptionLabel = IdToLabel(q.GetProperty("CorrectOptionId").GetInt32());
                                cq.Explanation = q.TryGetProperty("Explanation", out var expl) ? expl.GetString() ?? "" : "";
                                if (q.TryGetProperty("Options", out var opts))
                                {
                                    int i = 0;
                                    foreach (var opt in opts.EnumerateArray()) { if (i < 4) cq.Options[i++].Text = opt.GetProperty("Text").GetString() ?? ""; }
                                    cq.BulkOptionText = string.Join("\n", cq.Options.Select(o => o.Text));
                                }
                                qIdx++;
                            }
                            p34Idx++;
                        }
                        break;
                    case 5:
                        int p5Idx = 0;
                        foreach(var g in groups.EnumerateArray())
                        {
                            if (p5Idx >= part5Questions.Count) break;
                            var q = g.GetProperty("Questions")[0];
                            var tq = part5Questions[p5Idx];
                            tq.Text = q.TryGetProperty("Text", out var qt) ? qt.GetString() ?? "" : "";
                            tq.CorrectOptionLabel = IdToLabel(q.GetProperty("CorrectOptionId").GetInt32());
                            tq.Explanation = q.TryGetProperty("Explanation", out var expl) ? expl.GetString() ?? "" : "";
                            if (q.TryGetProperty("Options", out var opts))
                            {
                                int i = 0;
                                foreach (var opt in opts.EnumerateArray()) { if (i < 4) tq.Options[i++].Text = opt.GetProperty("Text").GetString() ?? ""; }
                                tq.BulkOptionText = string.Join("\n", tq.Options.Select(o => o.Text));
                            }
                            p5Idx++;
                        }
                        break;
                    case 6:
                        int p6Idx = 0;
                        foreach(var g in groups.EnumerateArray())
                        {
                            if (p6Idx >= part6Groups.Count) break;
                            var pg = part6Groups[p6Idx];
                            pg.PassageTitle = g.TryGetProperty("PassageTitle", out var pt) ? pt.GetString() ?? "" : "";
                            pg.PassageHtml = g.TryGetProperty("PassageHtml", out var ph) ? ph.GetString() ?? "" : "";
                            pg.Translation = g.TryGetProperty("Translation", out var tr6) ? tr6.GetString() ?? "" : "";
                            pg.ImageUrl = g.TryGetProperty("ImageUrl", out var iu) ? iu.GetString() : null;
                            
                            int qIdx = 0;
                            foreach(var q in g.GetProperty("Questions").EnumerateArray())
                            {
                                if (qIdx >= pg.Questions.Count) break;
                                var tq = pg.Questions[qIdx];
                                tq.Text = q.TryGetProperty("Text", out var qt) ? qt.GetString() ?? "" : "";
                                tq.CorrectOptionLabel = IdToLabel(q.GetProperty("CorrectOptionId").GetInt32());
                                tq.Explanation = q.TryGetProperty("Explanation", out var expl) ? expl.GetString() ?? "" : "";
                                if (q.TryGetProperty("Options", out var opts))
                                {
                                    int i = 0;
                                    foreach (var opt in opts.EnumerateArray()) { if (i < 4) tq.Options[i++].Text = opt.GetProperty("Text").GetString() ?? ""; }
                                    tq.BulkOptionText = string.Join("\n", tq.Options.Select(o => o.Text));
                                }
                                qIdx++;
                            }
                            p6Idx++;
                        }
                        break;
                    case 7:
                        part7Groups.Clear();
                        foreach(var g in groups.EnumerateArray())
                        {
                            var p7 = new Part7Group {
                                GroupId = g.GetProperty("GroupId").GetString() ?? "",
                                PassageTitle = g.TryGetProperty("PassageTitle", out var pt2) ? pt2.GetString() ?? "" : "",
                                PassageHtml = g.TryGetProperty("PassageHtml", out var ph2) ? ph2.GetString() ?? "" : "",
                                Translation = g.TryGetProperty("Translation", out var tr7) ? tr7.GetString() ?? "" : "",
                                ImageUrl = g.TryGetProperty("ImageUrl", out var iu2) ? iu2.GetString() : null,
                                AudioUrl = g.TryGetProperty("AudioUrl", out var au2) ? au2.GetString() : null,
                            };
                            p7.Questions.Clear();
                            foreach(var q in g.GetProperty("Questions").EnumerateArray())
                            {
                                var tq = new TextQuestion {
                                    Id = q.GetProperty("Id").GetInt32(),
                                    Text = q.TryGetProperty("Text", out var qt2) ? qt2.GetString() ?? "" : "",
                                    CorrectOptionLabel = IdToLabel(q.GetProperty("CorrectOptionId").GetInt32()),
                                    Explanation = q.TryGetProperty("Explanation", out var expl2) ? expl2.GetString() ?? "" : ""
                                };
                                if (q.TryGetProperty("Options", out var opts))
                                {
                                    int i = 0;
                                    foreach (var opt in opts.EnumerateArray()) { if (i < 4) tq.Options[i++].Text = opt.GetProperty("Text").GetString() ?? ""; }
                                    tq.BulkOptionText = string.Join("\n", tq.Options.Select(o => o.Text));
                                }
                                p7.Questions.Add(tq);
                            }
                            p7.QuestionCount = p7.Questions.Count;
                            part7Groups.Add(p7);
                        }
                        break;
                }
            }
        }
        NormalizePart7Groups();
    }
