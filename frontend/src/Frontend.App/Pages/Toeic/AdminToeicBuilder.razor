@page "/admin/toeic-builder"
@layout Frontend.App.Layout.AdminLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Text.Json.Serialization
@inject ToeicBuilderService BuilderService
@inject MockTestService MockTestService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Admin — Tạo đề TOEIC</PageTitle>

@* ��� EXAM LIST PANEL ��� *@
@if (showExamList)
{
    <div class="exam-list-overlay">
        <div class="exam-list-panel">
            <div class="exam-list-header">
                <h2>📋 Danh sách đề TOEIC</h2>
                <button class="btn-close-list" @onclick="() => showExamList = false">✕</button>
            </div>

            @if (hasDraft)
            {
                <div style="background-color: #2b2b2b; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #ff9800; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <h3 style="color: #ff9800; margin: 0 0 5px 0;">📝 Bản nháp chưa lưu</h3>
                        <p style="margin: 0; font-size: 0.9em; color: #ccc;">Bạn có một bản nháp đang làm dở cục bộ.</p>
                    </div>
                    <div>
                        <button class="btn-edit-exam" style="background-color: #ff9800; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold;" @onclick="async () => { await LoadDraft(); showExamList = false; }">Khôi phục nháp</button>
                        <button class="btn-clear-draft" style="width: auto; margin-top: 0; background-color: #dc3545; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; margin-left: 10px;" @onclick="async () => { await ClearDraft(); showExamList = false; }">Xóa nháp</button>
                    </div>
                </div>
            }

            @if (examList == null)
            {
                <div class="exam-list-loading"><span class="spinner-inline"></span> Đang tải...</div>
            }
            else if (!examList.Any())
            {
                <div class="exam-list-empty">Chưa có đề thi nào.</div>
            }
            else
            {
                <table class="exam-table">
                    <thead><tr><th>Bộ đề</th><th>Tên bài</th><th>Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var exam in examList)
                    {
                        var e = exam;
                        <tr>
                            <td>@e.CollectionName</td>
                            <td>@e.Title</td>
                            <td>
                                @if (!string.IsNullOrEmpty(e.ToeicUrl))
                                {
                                    <button class="btn-edit-exam" @onclick="() => LoadExamForEdit(e)">✏️ Sửa</button>
                                }
                                else
                                {
                                    <span style="color:#888;font-size:0.85em">(Không có link TOEIC)</span>
                                }
                                <button class="btn-clear-draft" style="width: auto; margin-top: 0; background-color: #dc3545; color: white; padding: 4px 10px; border: none; border-radius: 4px; margin-left: 8px; cursor: pointer;" @onclick="() => DeleteExam(e)">🗑️ Xóa</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="toeic-builder-topbar">
    <button class="btn-show-list" @onclick="OpenExamList">📋 Xem & Sửa đề cũ</button>
    
    <InputFile OnChange="HandleJsonImport" accept=".json" class="d-none" id="import-json" />
    <label for="import-json" class="btn-fast-import">📁 Upload JSON</label>

    @if (editingMockTestId.HasValue)
    {
        <span class="editing-badge">✏️ Đang sửa: @editingTitle</span>
        <button class="btn-new-exam" @onclick="ResetToNew">+ Tạo đề mới</button>
    }
</div>

<div class="builder-root">
    @* ─── SIDEBAR STEPS ─── *@
    <aside class="builder-sidebar">
        <div class="sidebar-logo">
            <span class="logo-dot"></span>
            <span>TOEIC Builder</span>
        </div>
        <nav class="step-nav">
            @for (int s = 0; s < steps.Length; s++)
            {
                var si = s;
                <button class="step-item @(currentStep == si ? "active" : si < currentStep ? "done" : "")"
                        @onclick="() => GoStep(si)">
                    <span class="step-num">@(si < currentStep ? "✓" : (si + 1).ToString())</span>
                    <span class="step-label">@steps[si]</span>
                </button>
            }
        </nav>
        <div class="sidebar-footer">
            <button class="btn-save-draft" @onclick="SaveDraft" disabled="@isSavingDraft">
                @if (isSavingDraft)
                {
                    <span class="spinner-inline" style="width:12px;height:12px"></span>
                }
                else
                {
                    <span>💾</span>
                }
                Lưu nháp
            </button>
            @if (hasDraft)
            {
                <button class="btn-clear-draft" @onclick="ClearDraft">🗑️ Xóa nháp</button>
            }
            @if (!string.IsNullOrEmpty(draftToast))
            {
                <div class="draft-toast @draftToastClass">@draftToast</div>
            }
        </div>
    </aside>

    @* ─── MAIN PANEL ─── *@
    <main class="builder-main" id="builder-main">

        @* ────── STEP 0: Thông tin đề ────── *@
        @if (currentStep == 0)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>📋 Thông tin đề thi</h2>
                    <p>Điền các thông tin cơ bản cho bộ đề TOEIC</p>
                </div>
                <div class="form-grid">
                    <div class="form-group full">
                        <label>Tên bộ đề <span class="req">*</span></label>
                        <input @bind="collectionName" class="form-input" placeholder="VD: TOEIC ETS 2024 Volume 1" />
                    </div>
                    <div class="form-group full">
                        <label>Tên bài thi <span class="req">*</span></label>
                        <input @bind="examTitle" class="form-input" placeholder="VD: Test 1" />
                    </div>
                    <div class="form-group full">
                        <label>Mô tả</label>
                        <textarea @bind="examDescription" class="form-input" rows="3" placeholder="Mô tả ngắn gọn về đề thi..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Thời gian thi (phút)</label>
                        <input type="number" @bind="examTimeMins" class="form-input" min="30" max="180" />
                    </div>
                </div>
                
                @* ─── Autofill Tool ─── *@
                <div class="autofill-section">
                    <h3 class="autofill-title">⚡ Điền nhanh Link R2 (Tự động điền theo câu hỏi)</h3>
                    <p class="autofill-desc">Nhập thư mục gốc chứa file trên R2. Hệ thống sẽ tự động ghép với <code>{ID}.jpg</code> (câu đơn) hoặc <code>{StartID}-{EndID}.mp3</code> (nhóm câu) tương ứng (VD: <code>/1.mp3</code>, <code>/32-34.mp3</code>).</p>
                    <div class="form-grid">
                        <div class="form-group full">
                            <label>Base URL Ảnh</label>
                            <input @bind="autofillBaseImageUrl" class="form-input" placeholder="VD: https://pub-xxx.r2.dev/ETS 2026 Test 1/Ảnh" />
                        </div>
                        <div class="form-group full">
                            <label>Base URL Audio</label>
                            <input @bind="autofillBaseAudioUrl" class="form-input" placeholder="VD: https://pub-xxx.r2.dev/ETS 2026 Test 1/Audio" />
                        </div>
                    </div>
                    <button class="btn-autofill" @onclick="AutofillMediaLinks">🔄 Tự động điền cho tất cả các Part</button>
                </div>

                <div class="section-footer">
                    <button class="btn-next" @onclick="() => GoStep(1)">Tiếp theo: Part 1 →</button>
                </div>
            </section>
        }

        @* ────── STEP 1: Part 1 — Photographs ────── *@
        else if (currentStep == 1)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>📸 Part 1 — Photographs <span class="q-badge">6 câu</span></h2>
                    <p>Mỗi câu gồm 1 ảnh + 1 file audio. Đáp án A/B/C/D đọc trong audio.</p>
                </div>
                @for (int i = 0; i < part1Groups.Count; i++)
                {
                    var gi = i;
                    var g = part1Groups[gi];
                    <div class="q-card">
                        <div class="q-card-header">
                            <span class="q-badge-num">Câu @(gi + 1)</span>
                            @if (!string.IsNullOrEmpty(g.CorrectAnswer))
                            {
                                <span class="ans-tag">Đáp án: @g.CorrectAnswer</span>
                            }
                        </div>
                        <div class="q-card-body two-col">
                            @* Ảnh: dán link R2 *@
                            <div class="link-input-group">
                                <label class="link-label">🖼️ Link ảnh (R2)</label>
                                <input @bind="g.ImageUrl" @bind:event="oninput" class="form-input link-url-input"
                                       placeholder="https://r2.example.com/exams/p1-q1.jpg" />
                                @if (!string.IsNullOrWhiteSpace(g.ImageUrl))
                                {
                                    <img src="@g.ImageUrl" class="preview-img" alt="preview"
                                         onerror="this.style.display='none'" />
                                    <span class="link-ok">✅ Ảnh</span>
                                }
                            </div>
                            @* Audio: dán link R2 *@
                            <div class="link-input-group">
                                <label class="link-label">🎵 Link audio (R2)</label>
                                <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                       placeholder="https://r2.example.com/exams/p1-q1.mp3" />
                                @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                                {
                                    <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                                }
                            </div>
                        </div>
                        <div class="q-card-answer">
                            <label>Đáp án đúng:</label>
                            @foreach (var opt in new[] { "A", "B", "C", "D" })
                            {
                                var o = opt;
                                <button class="ans-btn @(g.CorrectAnswer == o ? "selected" : "")"
                                        @onclick="() => g.CorrectAnswer = o">@o</button>
                            }
                        </div>
                        @* Nội dung từng đáp án *@
                        <div class="opts-detail">
                            <div class="opts-detail-title">📝 Nội dung đáp án (ghi lại nội dung trong audio)</div>
                            <textarea class="form-input bulk-answer-input" rows="4"
                                      value="@g.BulkOptionText"
                                      @oninput="(e) => ApplyBulkOptions(g, e.Value?.ToString(), 4)"
                                      placeholder="Dán đáp án theo mẫu: A. Nội dung A&#10;B. Nội dung B&#10;C. Nội dung C&#10;D. Nội dung D"></textarea>
                            <span class="bulk-answer-hint">Dán một lần, hệ thống sẽ tự điền vào các ô A–D.</span>
                            <div class="options-grid">
                                @foreach (var opt in g.Options)
                                {
                                    var o = opt;
                                    <div class="option-row @(g.CorrectAnswer == o.Label ? "correct-opt" : "")">
                                        <span class="opt-label">@o.Label</span>
                                        <input @bind="o.Text" class="form-input" placeholder="Nội dung đáp án @o.Label..." />
                                        <button class="mark-correct @(g.CorrectAnswer == o.Label ? "active" : "")"
                                                @onclick="() => g.CorrectAnswer = o.Label">✓</button>
                                    </div>
                                }
                            </div>
                        </div>
                        @* Giải thích *@
                        <div class="expl-section">
                            <div class="expl-title">💡 Giải thích đáp án</div>
                            <textarea @bind="g.Explanation" class="form-input" rows="2"
                                      placeholder="VD: Đáp án B đúng vì trong audio người nói... Đáp án A sai vì..."></textarea>
                        </div>
                    </div>
                }
                <div class="step-footer">
                    <button class="btn-prev" @onclick="() => GoStep(0)">← Trước</button>
                    <button class="btn-next" @onclick="() => GoStep(2)">Tiếp: Part 2 →</button>
                </div>
            </section>
        }

        @* ────── STEP 2: Part 2 — Question Response ────── *@
        else if (currentStep == 2)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>🎧 Part 2 — Question-Response <span class="q-badge">25 câu</span></h2>
                    <p>Mỗi câu chỉ gồm 1 file audio. Đáp án là A/B/C.</p>
                </div>
                <div class="p2-list">
                    @for (int i = 0; i < part2Groups.Count; i++)
                    {
                        var gi = i;
                        var g = part2Groups[gi];
                        <div class="q-card">
                            <div class="q-card-header">
                                <span class="q-badge-num">Câu @(gi + 7)</span>
                                @if (!string.IsNullOrEmpty(g.CorrectAnswer))
                                {
                                    <span class="ans-tag">Đáp án: @g.CorrectAnswer</span>
                                }
                            </div>
                            @* Audio: dán link R2 *@
                            <div class="link-input-group">
                                <label class="link-label">🎵 Link audio câu hỏi (R2)</label>
                                <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                       placeholder="https://r2.example.com/exams/p2-q7.mp3" />
                                @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                                {
                                    <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                                }
                            </div>
                            <div class="form-group full">
                                <label>Nội dung câu hỏi</label>
                                <input @bind="g.QuestionText" class="form-input"
                                       placeholder="VD: Where will the meeting be held?" />
                            </div>
                            @* Nội dung đáp án A/B/C *@
                            <div class="opts-detail">
                                <div class="opts-detail-title">📝 Nội dung đáp án (ghi lại nội dung trong audio)</div>
                                <textarea class="form-input bulk-answer-input" rows="3"
                                          value="@g.BulkOptionText"
                                          @oninput="(e) => ApplyBulkOptions(g, e.Value?.ToString(), 3)"
                                          placeholder="Dán đáp án theo mẫu: A. Nội dung A&#10;B. Nội dung B&#10;C. Nội dung C"></textarea>
                                <span class="bulk-answer-hint">Dán một lần, hệ thống sẽ tự điền vào các ô A–C.</span>
                                <div class="options-grid">
                                    @foreach (var opt in g.Options.Take(3))
                                    {
                                        var o = opt;
                                        <div class="option-row @(g.CorrectAnswer == o.Label ? "correct-opt" : "")">
                                            <span class="opt-label">@o.Label</span>
                                            <input @bind="o.Text" class="form-input" placeholder="Nội dung đáp án @o.Label..." />
                                            <button class="mark-correct @(g.CorrectAnswer == o.Label ? "active" : "")"
                                                    @onclick="() => g.CorrectAnswer = o.Label">✓</button>
                                        </div>
                                    }
                                </div>
                            </div>
                            @* Giải thích *@
                            <div class="expl-section">
                                <div class="expl-title">💡 Giải thích đáp án</div>
                                <textarea @bind="g.Explanation" class="form-input" rows="2"
                                          placeholder="VD: Đáp án B đúng vì..."></textarea>
                            </div>
                        </div>
                    }
                </div>
                <div class="step-footer">
                    <button class="btn-prev" @onclick="() => GoStep(1)">← Trước</button>
                    <button class="btn-next" @onclick="() => GoStep(3)">Tiếp: Part 3 →</button>
                </div>
            </section>
        }

        @* ────── STEP 3: Part 3 — Conversations ────── *@
        else if (currentStep == 3)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>💬 Part 3 — Conversations <span class="q-badge">13 nhóm × 3 câu = 39 câu</span></h2>
                    <p>Mỗi nhóm có 1 audio và 3 câu hỏi cố định.</p>
                </div>
                @{ int p3StartQ = 32; }
                @for (int gi = 0; gi < part3Groups.Count; gi++)
                {
                    var gidx = gi;
                    var g = part3Groups[gidx];
                    int gStartQ = p3StartQ + gidx * 3;
                    <div class="passage-card">
                        <div class="passage-card-header">
                            <span class="q-badge-num">Nhóm @(gidx+1) — Câu @gStartQ–@(gStartQ+2)</span>
                        </div>
                        <div class="link-input-group">
                            <label class="link-label">🎵 Link audio hội thoại (R2)</label>
                            <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                   placeholder="https://r2.example.com/exams/p3-g1.mp3" />
                            @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                            {
                                <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                            }
                        </div>
                        <div class="link-input-group">
                            <label class="link-label">🖼️ Link ảnh minh hoạ (R2, nếu có)</label>
                            <input @bind="g.ImageUrl" @bind:event="oninput" class="form-input link-url-input"
                                   placeholder="https://r2.example.com/exams/p3-g1.jpg" />
                            @if (!string.IsNullOrWhiteSpace(g.ImageUrl))
                            {
                                <img src="@g.ImageUrl" class="preview-img" alt="Ảnh minh hoạ" onerror="this.style.display='none'" />
                            }
                        </div>
                        <div class="form-group full">
                            <label>📝 Transcript hội thoại (chỉ hiện khi xem đáp án)</label>
                            <textarea @bind="g.Transcript" class="form-input" rows="6"
                                      placeholder="Dán nội dung hội thoại người nói ở đây..."></textarea>
                        </div>
                        @for (int qi = 0; qi < g.Questions.Count; qi++)
                        {
                            var qidx = qi;
                            var q = g.Questions[qidx];
                            <div class="q-card-text nested">
                                <div class="q-card-header"><span class="q-badge-num-sm">Câu @(gStartQ + qidx)</span></div>
                                <div class="form-group full">
                                    <label>Câu hỏi</label>
                                    <input @bind="q.Text" class="form-input" placeholder="VD: What are the speakers discussing?" />
                                </div>
                                <textarea class="form-input bulk-answer-input" rows="4"
                                          value="@q.BulkOptionText"
                                          @oninput="(e) => ApplyBulkOptions(q, e.Value?.ToString())"
                                          placeholder="Dán đáp án: A. Nội dung A&#10;B. Nội dung B&#10;C. Nội dung C&#10;D. Nội dung D"></textarea>
                                <span class="bulk-answer-hint">Dán một lần để tự động điền vào các ô A–D.</span>
                                <div class="options-grid">
                                    @foreach (var opt in q.Options)
                                    {
                                        var o = opt;
                                        <div class="option-row @(q.CorrectOptionLabel == o.Label ? "correct-opt" : "")">
                                            <span class="opt-label">@o.Label</span>
                                            <input @bind="o.Text" class="form-input" placeholder="Nội dung đáp án @o.Label" />
                                            <button class="mark-correct @(q.CorrectOptionLabel == o.Label ? "active" : "")"
                                                    @onclick="() => q.CorrectOptionLabel = o.Label">✓</button>
                                        </div>
                                    }
                                </div>
                                <div class="expl-section">
                                    <div class="expl-title">💡 Giải thích đáp án</div>
                                    <textarea @bind="q.Explanation" class="form-input" rows="2"
                                              placeholder="VD: Đáp án B đúng vì trong hội thoại người nói..."></textarea>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="step-footer">
                    <button class="btn-prev" @onclick="() => GoStep(2)">← Trước</button>
                    <button class="btn-next" @onclick="() => GoStep(4)">Tiếp: Part 4 →</button>
                </div>
            </section>
        }

        @* ────── STEP 4: Part 4 — Short Talks ────── *@
        else if (currentStep == 4)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>🎙️ Part 4 — Short Talks <span class="q-badge">10 nhóm × 3 câu = 30 câu</span></h2>
                    <p>Mỗi nhóm có 1 audio và 3 câu hỏi cố định.</p>
                </div>
                @{ int p4StartQ = 71; }
                @for (int gi = 0; gi < part4Groups.Count; gi++)
                {
                    var gidx = gi;
                    var g = part4Groups[gidx];
                    int gStartQ = p4StartQ + gidx * 3;
                    <div class="passage-card">
                        <div class="passage-card-header">
                            <span class="q-badge-num">Nhóm @(gidx+1) — Câu @gStartQ–@(gStartQ+2)</span>
                        </div>
                        <div class="link-input-group">
                            <label class="link-label">🎵 Link audio độc thoại (R2)</label>
                            <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                   placeholder="https://r2.example.com/exams/p4-g1.mp3" />
                            @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                            {
                                <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                            }
                        </div>
                        <div class="link-input-group">
                            <label class="link-label">🖼️ Link ảnh minh hoạ (R2, nếu có)</label>
                            <input @bind="g.ImageUrl" @bind:event="oninput" class="form-input link-url-input"
                                   placeholder="https://r2.example.com/exams/p4-g1.jpg" />
                            @if (!string.IsNullOrWhiteSpace(g.ImageUrl))
                            {
                                <img src="@g.ImageUrl" class="preview-img" alt="Ảnh minh hoạ" onerror="this.style.display='none'" />
                            }
                        </div>
                        <div class="form-group full">
                            <label>📝 Transcript bài nói (chỉ hiện khi xem đáp án)</label>
                            <textarea @bind="g.Transcript" class="form-input" rows="6"
                                      placeholder="Dán nội dung bài nói ở đây..."></textarea>
                        </div>
                        @for (int qi = 0; qi < g.Questions.Count; qi++)
                        {
                            var qidx = qi;
                            var q = g.Questions[qidx];
                            <div class="q-card-text nested">
                                <div class="q-card-header"><span class="q-badge-num-sm">Câu @(gStartQ + qidx)</span></div>
                                <div class="form-group full">
                                    <label>Câu hỏi</label>
                                    <input @bind="q.Text" class="form-input" placeholder="VD: What is the talk mainly about?" />
                                </div>
                                <textarea class="form-input bulk-answer-input" rows="4"
                                          value="@q.BulkOptionText"
                                          @oninput="(e) => ApplyBulkOptions(q, e.Value?.ToString())"
