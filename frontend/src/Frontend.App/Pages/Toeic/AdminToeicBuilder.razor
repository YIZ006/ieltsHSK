                        <textarea class="form-input bulk-answer-input" rows="4"
                                  value="@q.BulkOptionText"
                                  @oninput="(e) => ApplyBulkOptions(q, e.Value?.ToString())"
                                  placeholder="Dán đáp án: A. Nội dung A&#10;B. Nội dung B&#10;C. Nội dung C&#10;D. Nội dung D"></textarea>
                        <span class="bulk-answer-hint">Dán một lần để tự động điền vào các ô A–D.</span>
                        <div class="options-grid">
                            @foreach (var opt in q.Options)
                            {
                                var o = opt;
                                <div class="option-row @(q.CorrectOptionLabel == o.Label ? "correct-opt" : "")">
                                    <span class="opt-label">@o.Label</span>
