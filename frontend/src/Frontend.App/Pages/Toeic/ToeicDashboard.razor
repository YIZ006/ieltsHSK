    private int GetPodiumXp(string name)
    {
        return (leaderboardTab, name) switch
        {
            ("week", "Minh Tuấn") => 2840,
            ("week", "Thu Hà") => 2610,
            ("week", "Hữu Nam") => 2200,

            ("month", "Minh Tuấn") => 8920,
            ("month", "Thu Hà") => 7850,
            ("month", "Hữu Nam") => 6940,

            ("all", "Minh Tuấn") => 24500,
            ("all", "Thu Hà") => 21300,
            ("all", "Hữu Nam") => 18700,

            _ => 1000
        };
    }

    private List<LeaderboardUser> CurrentLeaderboardRankings
    {
        get
        {
            var multiplier = leaderboardTab switch
            {
                "month" => 3,
                "all" => 10,
                _ => 1
            };

            var userXp = (1240 + bonusXp) * (leaderboardTab == "week" ? 1 : (leaderboardTab == "month" ? 3 : 9));

            return new List<LeaderboardUser>
            {
                new(4, "Lan Anh", 1980 * multiplier, false),
                new(5, "Bạn", userXp, true),
                new(6, "Quốc Bảo", 1100 * multiplier, false),
                new(7, "Ngọc Mai", 980 * multiplier, false),
                new(8, "Văn Hùng", 860 * multiplier, false),
                new(9, "Phương Linh", 720 * multiplier, false),
                new(10, "Tuấn Anh", 640 * multiplier, false),
            };
        }
    }

    // Quiz Handler
    private void StartQuiz(QuickQuiz quiz)
    {
        activeQuiz = quiz;
        quizQuestionIndex = 0;
        quizSelectedOption = null;
        quizAnswered = false;
        quizScore = 0;
        quizFinished = false;
    }

    private void SelectOption(int optIndex)
    {
        if (quizAnswered || activeQuiz == null) return;
        quizSelectedOption = optIndex;
        quizAnswered = true;
        if (optIndex == activeQuiz.Questions[quizQuestionIndex].CorrectIndex)
        {
            quizScore++;
        }
    }

    private async Task NextQuizQuestion()
    {
        if (activeQuiz == null) return;
        if (quizQuestionIndex + 1 < activeQuiz.Questions.Count)
        {
            quizQuestionIndex++;
            quizSelectedOption = null;
            quizAnswered = false;
        }
        else
        {
            quizFinished = true;
            bonusXp += (quizScore * 10 + 10);
            try
            {
                await LocalStorage.SetItemAsync("toeic_quiz_bonus_xp", bonusXp);
            }
            catch { }
        }
    }

    private void RetryQuiz()
    {
        if (activeQuiz == null) return;
        quizQuestionIndex = 0;
        quizSelectedOption = null;
        quizAnswered = false;
        quizScore = 0;
        quizFinished = false;
    }

    private void CloseQuiz()
    {
        activeQuiz = null;
    }

    private static string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "—";
        return $"{seconds / 60} phút {seconds % 60}s";
    }

    private static string ScoreClass(int? score) => score switch
    {
        >= 780 => "td-score-high",
        >= 500 => "td-score-mid",
        _ => "td-score-low"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                    function scrollToTarget() {
                        var hash = window.location.hash;
                        if (hash) {
                            var el = document.querySelector(hash);
                            if (el) {
                                setTimeout(function() { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 150);
                            }
                        }
                    }
                    scrollToTarget();
                    window.addEventListener('hashchange', scrollToTarget);
                ");
            }
            catch { }
        }
    }
