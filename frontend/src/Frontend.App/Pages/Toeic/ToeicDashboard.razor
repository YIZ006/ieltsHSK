@page "/toeic"
@page "/toeic/dashboard"
@using Frontend.App.Models
@using Frontend.App.Services
@using Blazored.LocalStorage
@inject MockTestService MockTestService
@inject ExamSubmissionService Submissions
@inject ToeicAchievementService Achievements
@inject IJSRuntime JS
@inject ILocalStorageService LocalStorage

<PageTitle>TOEIC Dashboard - ieltsHSK</PageTitle>

<div class="td-page">
    @* ===== HERO ===== *@
    <div class="td-hero td-anim-up">
        <div class="td-hero-title">Chào mừng đến với <span>ieltsHSK TOEIC</span></div>
        <div class="td-hero-sub">Luyện thi TOEIC Listening &amp; Reading với đề thi chuẩn format, chấm điểm tự động và xem lại đáp án chi tiết.</div>
        <div class="td-hero-actions">
            <a href="/toeic/test" class="td-btn td-btn-primary"><i class="bi bi-play-fill"></i> Làm bài thi ngay</a>
            <a href="/toeic/flashcards" class="td-btn td-btn-outline"><i class="bi bi-layers"></i> Flashcard &amp; Từ vựng</a>
            <a href="/toeic/test" class="td-btn td-btn-outline"><i class="bi bi-journal-text"></i> Danh sách @toeicTests.Count đề</a>
        </div>
    </div>

    @* ===== STATS ===== *@
    <div class="td-grid-3 td-mb">
        <div class="td-stat td-anim-up td-delay-1">
            <div class="td-stat-icon purple"><i class="bi bi-journal-check"></i></div>
            <div class="td-stat-info">
                <div class="td-stat-value">@toeicTests.Count</div>
                <div class="td-stat-label">Đề thi khả dụng</div>
                <div class="td-stat-change up"><i class="bi bi-check-circle"></i> Sẵn sàng làm ngay</div>
            </div>
        </div>
        <div class="td-stat amber td-anim-up td-delay-2">
            <div class="td-stat-icon amber"><i class="bi bi-clipboard-data"></i></div>
            <div class="td-stat-info">
                <div class="td-stat-value">@recentSubmissions.Count</div>
                <div class="td-stat-label">Bài đã làm</div>
                <div class="td-stat-change @(recentSubmissions.Count > 0 ? "up" : "")">
                    @(recentSubmissions.Count > 0 ? "Tiếp tục duy trì nhé!" : "Bắt đầu bài đầu tiên")
                </div>
            </div>
        </div>
        <div class="td-stat green td-anim-up td-delay-3">
            <div class="td-stat-icon green"><i class="bi bi-list-check"></i></div>
            <div class="td-stat-info">
                <div class="td-stat-value">200</div>
                <div class="td-stat-label">Câu hỏi mỗi đề</div>
                <div class="td-stat-change up"><i class="bi bi-clock-history"></i> 120 phút</div>
            </div>
        </div>
    </div>

    @* ===== SKILLS + VOCAB & RECENT EXAMS ===== *@
    <div class="td-grid-2 td-mb">
        <div>
            <div class="td-section-header">
                <div class="td-section-title">Kỹ năng luyện tập</div>
                <a href="/toeic/test" class="td-section-link">Vào phòng thi <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="td-grid-2 td-grid-tight">
                <a href="/toeic/test" class="td-skill td-anim-up td-delay-1">
                    <div class="td-skill-top">
                        <div class="td-skill-icon" style="background:rgba(59,130,246,0.14);color:#3b82f6;"><i class="bi bi-headphones"></i></div>
                        <i class="bi bi-arrow-up-right td-skill-arrow"></i>
                    </div>
                    <div class="td-skill-name">Listening</div>
                    <div class="td-skill-desc">Part 1–4 · Ảnh, hỏi - đáp, hội thoại, bài nói</div>
                    <div class="td-progress-wrap">
                        <div class="td-progress-info"><span>45 phút · 100 câu</span><span style="color:#3b82f6">4 parts</span></div>
                        <div class="td-progress-bar"><div class="td-progress-fill blue" style="width:100%"></div></div>
                    </div>
                </a>
                <a href="/toeic/test" class="td-skill td-anim-up td-delay-2">
                    <div class="td-skill-top">
                        <div class="td-skill-icon" style="background:rgba(108,99,255,0.14);color:#6c63ff;"><i class="bi bi-file-earmark-text"></i></div>
                        <i class="bi bi-arrow-up-right td-skill-arrow"></i>
                    </div>
                    <div class="td-skill-name">Reading</div>
                    <div class="td-skill-desc">Part 5–7 · Điền từ, điền đoạn, đọc hiểu</div>
                    <div class="td-progress-wrap">
                        <div class="td-progress-info"><span>75 phút · 100 câu</span><span style="color:#6c63ff">3 parts</span></div>
                        <div class="td-progress-bar"><div class="td-progress-fill purple" style="width:100%"></div></div>
                    </div>
                </a>
                <a href="/toeic/test" class="td-skill td-anim-up td-delay-3">
                    <div class="td-skill-top">
                        <div class="td-skill-icon" style="background:rgba(245,158,11,0.16);color:#f59e0b;"><i class="bi bi-stopwatch"></i></div>
                        <i class="bi bi-arrow-up-right td-skill-arrow"></i>
                    </div>
                    <div class="td-skill-name">Full Test</div>
                    <div class="td-skill-desc">Đề đầy đủ 7 part, hẹn giờ chuẩn thật</div>
                    <div class="td-progress-wrap">
                        <div class="td-progress-info"><span>120 phút · 200 câu</span><span style="color:#f59e0b">7 parts</span></div>
                        <div class="td-progress-bar"><div class="td-progress-fill amber" style="width:100%"></div></div>
                    </div>
                </a>
                <a href="/toeic/flashcards" class="td-skill td-anim-up td-delay-4">
                    <div class="td-skill-top">
                        <div class="td-skill-icon" style="background:rgba(16,185,129,0.14);color:#10b981;"><i class="bi bi-layers"></i></div>
                        <i class="bi bi-arrow-up-right td-skill-arrow"></i>
                    </div>
                    <div class="td-skill-name">Flashcard &amp; Từ vựng</div>
                    <div class="td-skill-desc">Lật thẻ 3D, bảng từ vựng, thêm từ mới</div>
                    <div class="td-progress-wrap">
                        <div class="td-progress-info"><span>70+ từ theo chủ đề</span><span style="color:#10b981">Học ngay</span></div>
                        <div class="td-progress-bar"><div class="td-progress-fill green" style="width:100%"></div></div>
                    </div>
                </a>
                <a href="/toeic/test" class="td-skill td-anim-up td-delay-4">
                    <div class="td-skill-top">
                        <div class="td-skill-icon" style="background:rgba(16,185,129,0.14);color:#10b981;"><i class="bi bi-check2-square"></i></div>
                        <i class="bi bi-arrow-up-right td-skill-arrow"></i>
                    </div>
                    <div class="td-skill-name">Xem lại &amp; đáp án</div>
                    <div class="td-skill-desc">Chấm điểm, transcript, dịch chi tiết</div>
                    <div class="td-progress-wrap">
                        <div class="td-progress-info"><span>Review sau khi thi</span><span style="color:#10b981">Miễn phí</span></div>
                        <div class="td-progress-bar"><div class="td-progress-fill green" style="width:100%"></div></div>
                    </div>
                </a>
            </div>
        </div>

        <div class="td-side-col">
            @* Word of the day with Audio & Bookmark *@
            <div class="td-word td-anim-up td-delay-2">
                <div class="td-word-header">
                    <div class="td-word-label"><i class="bi bi-brightness-high"></i> TỪ VỰNG TOEIC TRONG NGÀY</div>
                    <div class="td-word-actions">
                        <button class="td-word-btn" @onclick="() => SpeakAsync(wordOfDay.Word)" title="Nghe phát âm">
                            <i class="bi bi-volume-up-fill"></i> Nghe
                        </button>
                        <button class="td-word-btn @(isBookmarked ? "bookmarked" : "")" @onclick="ToggleBookmarkAsync" title="Lưu vào sổ từ vựng">
                            <i class="bi @(isBookmarked ? "bi-bookmark-fill" : "bi-bookmark")"></i> @(isBookmarked ? "Đã lưu" : "Lưu")
                        </button>
                    </div>
                </div>
                <div class="td-word-en">@wordOfDay.Word</div>
                <div class="td-word-ipa">@wordOfDay.Ipa</div>
                <div class="td-word-vi">@wordOfDay.Meaning</div>
                <div class="td-word-example">"@wordOfDay.Example"</div>
            </div>

            @* Recent Submissions *@
            <div class="td-card td-anim-up td-delay-3">
                <div class="td-section-header">
                    <div class="td-section-title">Bài thi gần đây</div>
                    <a href="/toeic/test" class="td-section-link">Làm bài <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (recentSubmissions.Count == 0)
                {
                    <div class="td-empty">
                        <div class="td-empty-icon">📝</div>
                        <div class="td-empty-title">Chưa có bài thi nào</div>
                        <div class="td-empty-sub">Làm bài thi đầu tiên để xem lịch sử và tiến độ tại đây.</div>
                        <a href="/toeic/test" class="td-btn td-btn-primary td-btn-sm"><i class="bi bi-play-fill"></i> Bắt đầu ngay</a>
                    </div>
                }
                else
                {
                    <div class="td-lesson-list">
                        @foreach (var s in recentSubmissions.Take(5))
                        {
                            <div class="td-lesson">
                                <div class="td-lesson-thumb">📘</div>
                                <div class="td-lesson-body">
                                    <div class="td-lesson-title">@s.ExamTitle</div>
                                    <div class="td-lesson-meta">
                                        @s.SubmittedAt.ToString("d MMM yyyy, HH:mm", Vi) · @FormatDuration(s.DurationSeconds)@(s.CorrectCount.HasValue && s.TotalQuestions.HasValue ? $" · Đúng {s.CorrectCount}/{s.TotalQuestions} câu" : "")
                                    </div>
                                </div>
                                @if (s.TotalScore.HasValue)
                                {
                                    <div class="td-score-badge @ScoreClass(s.TotalScore)">@s.TotalScore.Value<span>/990</span></div>
                                }
                                else
                                {
                                    <div class="td-lesson-badge @(s.TimedOut ? "td-badge-ongoing" : "td-badge-done")">@(s.TimedOut ? "Hết giờ" : "Đã nộp")</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ===== QUICK TOPIC QUIZZES & EXAM STRUCTURE ===== *@
    <div class="td-grid-2 td-mb">
        @* Quick Quizzes *@
        <div id="quizzes" class="td-card td-anim-up td-delay-2">
            <div class="td-section-header">
                <div>
                    <div class="td-section-title"><i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i> Quiz nhanh theo chủ đề</div>
                    <div class="td-section-subtitle">Kiểm tra 4 câu hỏi thực chiến, nhận thưởng ngay +50 XP</div>
                </div>
                <span class="td-total-badge">5 chủ đề</span>
            </div>
            <div class="td-quiz-list">
                @foreach (var quiz in QuickQuizzes)
                {
                    <div class="td-quiz-item">
                        <div class="td-quiz-icon" style="background:@quiz.BgColor;color:@quiz.Color;">@quiz.Icon</div>
                        <div class="td-quiz-info">
                            <div class="td-quiz-title">@quiz.Title</div>
                            <div class="td-quiz-meta">@quiz.Questions.Count câu hỏi · @quiz.Difficulty · Thưởng +50 XP</div>
                        </div>
                        <button class="td-btn td-btn-outline td-btn-sm" @onclick="() => StartQuiz(quiz)">
                            <i class="bi bi-play-fill"></i> Bắt đầu
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Exam Structure *@
        <div class="td-card td-anim-up td-delay-3">
            <div class="td-section-header">
                <div class="td-section-title">Cấu trúc đề thi TOEIC chuẩn Quốc Tế</div>
                <span class="td-total-badge">200 câu · 120 phút</span>
            </div>
            <div class="td-lesson-list">
                @foreach (var p in ExamStructure)
                {
                    <div class="td-lesson">
                        <div class="td-part-num">@p.Number</div>
                        <div class="td-lesson-body">
                            <div class="td-lesson-title">@p.Name</div>
                            <div class="td-lesson-meta">@p.Desc</div>
                        </div>
                        <div class="td-part-count">@p.Questions câu</div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ===== LEADERBOARD ===== *@
    <div id="leaderboard" class="td-card td-mb td-anim-up td-delay-2">
        <div class="td-section-header">
            <div>
                <div class="td-section-title">🏆 Bảng Xếp Hạng Học Viên TOEIC</div>
                <div class="td-section-subtitle">Cạnh tranh cùng cộng đồng hàng nghìn học viên TOEIC trên toàn quốc</div>
            </div>
            <div class="td-tabs">
                <button class="td-tab @(leaderboardTab == "week" ? "active" : "")" @onclick='() => SetLeaderboardTab("week")'>Tuần này</button>
                <button class="td-tab @(leaderboardTab == "month" ? "active" : "")" @onclick='() => SetLeaderboardTab("month")'>Tháng này</button>
                <button class="td-tab @(leaderboardTab == "all" ? "active" : "")" @onclick='() => SetLeaderboardTab("all")'>Tất cả</button>
            </div>
        </div>

        @* Top 3 Podium *@
        <div class="td-podium">
            <!-- Rank 2 (Silver) -->
            <div class="td-podium-col rank-2">
                <div class="td-podium-medal">🥈</div>
                <div class="td-podium-avatar avatar-silver">T</div>
                <div class="td-podium-name">Thu Hà</div>
                <div class="td-podium-xp">@GetPodiumXp("Thu Hà").ToString("N0") XP</div>
                <div class="td-podium-pedestal pedestal-silver">
                    <span class="pedestal-num">2</span>
                </div>
            </div>

            <!-- Rank 1 (Gold) -->
            <div class="td-podium-col rank-1">
                <div class="td-podium-crown">👑</div>
                <div class="td-podium-medal">🥇</div>
                <div class="td-podium-avatar avatar-gold">M</div>
                <div class="td-podium-name">Minh Tuấn</div>
                <div class="td-podium-xp">@GetPodiumXp("Minh Tuấn").ToString("N0") XP</div>
                <div class="td-podium-pedestal pedestal-gold">
                    <span class="pedestal-num">1</span>
                </div>
            </div>

            <!-- Rank 3 (Bronze) -->
            <div class="td-podium-col rank-3">
                <div class="td-podium-medal">🥉</div>
                <div class="td-podium-avatar avatar-bronze">H</div>
                <div class="td-podium-name">Hữu Nam</div>
                <div class="td-podium-xp">@GetPodiumXp("Hữu Nam").ToString("N0") XP</div>
                <div class="td-podium-pedestal pedestal-bronze">
                    <span class="pedestal-num">3</span>
                </div>
            </div>
        </div>

        @* Ranks 4 to 10 List *@
        <div class="td-rankings-list">
            @foreach (var user in CurrentLeaderboardRankings)
            {
                <div class="td-rank-row @(user.IsSelf ? "self" : "")">
                    <div class="td-rank-num">#@user.Rank</div>
                    <div class="td-rank-avatar">@user.Name.Substring(0, 1)</div>
                    <div class="td-rank-info">
                        <div class="td-rank-name">@user.Name @(user.IsSelf ? " (Bạn)" : "")</div>
                        <div class="td-rank-xp">@user.Xp.ToString("N0") XP</div>
                    </div>
                    @if (user.IsSelf)
                    {
                        <span class="td-badge-self"><i class="bi bi-star-fill"></i> Vị trí của bạn</span>
                    }
                </div>
            }
        </div>
    </div>



    @* ===== ACHIEVEMENTS ===== *@
    @if (achievements.Count > 0)
    {
        <div class="td-card td-anim-up td-delay-2">
            <div class="td-section-header">
                <div class="td-section-title">🏅 Thành tích đạt được</div>
                <span class="td-total-badge">Đã đạt @achUnlocked/@achTotal</span>
            </div>
            <div class="td-grid-4 td-grid-tight">
                @foreach (var a in achievements)
                {
                    <div class="td-ach @(a.Unlocked ? "unlocked" : "locked")">
                        @if (a.Unlocked)
                        {
                            <span class="td-ach-check"><i class="bi bi-check-lg"></i></span>
                        }
                        <div class="td-ach-icon">@a.Icon</div>
                        <div class="td-ach-title">@a.Title</div>
                        <div class="td-ach-desc">@a.Description</div>
                        <div class="td-progress-bar"><div class="td-progress-fill @(a.Unlocked ? "green" : "purple")" style="width:@a.ProgressPercent%"></div></div>
                        <span class="td-ach-progress-text">@a.ProgressText</span>
                    </div>
                }
            </div>
        </div>
    }

    @* ===== INTERACTIVE QUIZ MODAL ===== *@
    @if (activeQuiz != null)
    {
        <div class="td-modal-backdrop" @onclick="CloseQuiz">
            <div class="td-modal" @onclick:stopPropagation="true">
                <div class="td-modal-header">
                    <div class="td-modal-title">
                        <span>@activeQuiz.Icon</span> @activeQuiz.Title
                    </div>
                    <button class="td-modal-close" @onclick="CloseQuiz"><i class="bi bi-x-lg"></i></button>
                </div>

                @if (!quizFinished)
                {
                    var currentQ = activeQuiz.Questions[quizQuestionIndex];
                    <div class="td-modal-progress">
                        <div class="td-modal-progress-bar">
                            <div class="td-modal-progress-fill" style="width:@((quizQuestionIndex + 1) * 100 / activeQuiz.Questions.Count)%"></div>
                        </div>
                        <div class="td-modal-progress-text">Câu @(quizQuestionIndex + 1) / @activeQuiz.Questions.Count · Điểm: @quizScore/@activeQuiz.Questions.Count</div>
                    </div>

                    <div class="td-modal-body">
                        <div class="td-quiz-question-box">
                            <span class="td-quiz-qnum">Q@(quizQuestionIndex + 1)</span>
                            <div class="td-quiz-qtext">@currentQ.QuestionText</div>
                        </div>

                        <div class="td-quiz-options">
                            @for (var i = 0; i < currentQ.Options.Count; i++)
                            {
                                var optIndex = i;
                                var opt = currentQ.Options[i];
                                var isChosen = quizSelectedOption == optIndex;
                                var isCorrect = optIndex == currentQ.CorrectIndex;
                                var btnClass = "";
                                if (quizAnswered)
                                {
                                    if (isCorrect) btnClass = "correct";
                                    else if (isChosen) btnClass = "incorrect";
                                }
                                else if (isChosen)
                                {
                                    btnClass = "selected";
                                }

                                <button class="td-quiz-opt-btn @btnClass" disabled="@quizAnswered" @onclick="() => SelectOption(optIndex)">
                                    <span class="td-opt-letter">@((char)('A' + optIndex))</span>
                                    <span class="td-opt-text">@opt</span>
                                    @if (quizAnswered && isCorrect)
                                    {
                                        <i class="bi bi-check-circle-fill td-opt-icon check"></i>
                                    }
                                    else if (quizAnswered && isChosen && !isCorrect)
                                    {
                                        <i class="bi bi-x-circle-fill td-opt-icon times"></i>
                                    }
                                </button>
                            }
                        </div>

                        @if (quizAnswered)
                        {
                            <div class="td-quiz-explanation @(quizSelectedOption == currentQ.CorrectIndex ? "correct" : "incorrect")">
                                <div class="td-quiz-exp-title">
                                    <i class="bi @(quizSelectedOption == currentQ.CorrectIndex ? "bi-check-circle-fill" : "bi-info-circle-fill")"></i>
                                    @(quizSelectedOption == currentQ.CorrectIndex ? "Chính xác! +10 XP" : "Chưa chính xác!")
                                </div>
                                <div class="td-quiz-exp-text">@currentQ.Explanation</div>
                            </div>
                        }
                    </div>

                    <div class="td-modal-footer">
                        @if (quizAnswered)
                        {
                            <button class="td-btn td-btn-primary" @onclick="NextQuizQuestion">
                                @(quizQuestionIndex + 1 < activeQuiz.Questions.Count ? "Câu tiếp theo" : "Xem tổng kết") <i class="bi bi-arrow-right"></i>
                            </button>
                        }
                        else
                        {
                            <span class="td-quiz-tip"><i class="bi bi-lightbulb"></i> Hãy chọn một phương án</span>
                        }
                    </div>
                }
                else
                {
                    <div class="td-modal-body td-quiz-result">
                        <div class="td-result-icon">🎉</div>
                        <div class="td-result-title">Hoàn thành bài Quiz!</div>
                        <div class="td-result-score">Bạn trả lời đúng <strong>@quizScore / @activeQuiz.Questions.Count</strong> câu</div>
                        <div class="td-result-xp"><i class="bi bi-lightning-charge-fill"></i> +@(quizScore * 10 + 10) XP kinh nghiệm TOEIC</div>
                        <div class="td-result-msg">
                            @if (quizScore == activeQuiz.Questions.Count)
                            {
                                <text>Xuất sắc! Bạn đã nắm rất vững kiến thức phần này.</text>
                            }
                            else if (quizScore >= activeQuiz.Questions.Count / 2)
                            {
                                <text>Khá tốt! Hãy ôn lại các câu chưa đúng để đạt điểm tuyệt đối nhé.</text>
                            }
                            else
                            {
                                <text>Hãy tiếp tục luyện tập thêm để nâng cao phản xạ bài thi nhé!</text>
                            }
                        </div>
                    </div>
                    <div class="td-modal-footer" style="justify-content:center;gap:12px;">
                        <button class="td-btn td-btn-outline" @onclick="RetryQuiz"><i class="bi bi-arrow-repeat"></i> Làm lại</button>
                        <button class="td-btn td-btn-primary" @onclick="CloseQuiz"><i class="bi bi-check-lg"></i> Đóng &amp; Nhận XP</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed record ToeicWord(string Word, string Ipa, string Meaning, string Example);
    private sealed record ToeicPartInfo(string Number, string Name, string Desc, int Questions);
    private sealed record LeaderboardUser(int Rank, string Name, int Xp, bool IsSelf);

    public sealed class QuizQuestion
    {
        public string QuestionText { get; set; } = "";
        public List<string> Options { get; set; } = new();
        public int CorrectIndex { get; set; }
        public string Explanation { get; set; } = "";
    }

