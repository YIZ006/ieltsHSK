@page "/hsk"
<PageTitle>HSK Master - Demo</PageTitle>

<div class="demo-container">
    <h1>Welcome to the HSK Demo Page</h1>
    <p>This is a placeholder for the dedicated Chinese (HSK) learning system.</p>
    <p>In the future, clicking "Explore HSK" will redirect you to a separate HSK web application.</p>
    
    <div class="demo-card">
        <h3>Available Features (Coming Soon):</h3>
        <ul>
            <li>HSK 1-6 Vocabulary Flashcards</li>
            <li>Character Writing Practice</li>
            <li>Grammar Explanations</li>
            <li>Listening Comprehension Tests</li>
        </ul>
    </div>
</div>

<style>
    .demo-container {
        padding: 40px;
        color: #fff;
        text-align: center;
        background-color: #111;
        min-height: calc(100vh - 150px);
        border-radius: 12px;
        margin-top: 20px;
    }
    
    .demo-card {
        background-color: #222;
        padding: 30px;
        border-radius: 12px;
        border-top: 4px solid #ff3333;
        max-width: 600px;
        margin: 40px auto 0;
        text-align: left;
    }
    
    .demo-card h3 {
        color: #ff3333;
        margin-bottom: 20px;
    }
    
    .demo-card ul {
        list-style-type: none;
        padding: 0;
    }
    
    .demo-card ul li {
        padding: 10px 0;
        border-bottom: 1px solid #333;
        font-size: 1.1rem;
    }
</style>
