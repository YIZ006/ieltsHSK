@page "/ielts"
@using Frontend.App.Models
@using Frontend.App.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IeltsService IeltsService
@inject NavigationManager NavigationManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>IELTS Master - Resources</PageTitle>

<div class="demo-container">
    <h1>IELTS Learning Hub</h1>
    <p>Directory of resources and courses for your IELTS preparation.</p>
    
    @if (!isLevelSelected)
    {
        <div class="level-selection-container">
            <h2>Học tập của bạn</h2>
            <p>Chọn trình độ hiện tại của bạn để nhận lộ trình phù hợp.</p>
            
            <div class="form-group">
                <label>Bạn đang ở trình độ nào?</label>
                <div class="input-group">
                    <select @bind="selectedLevel" class="form-control">
                        <option value="">-- Chọn trình độ --</option>
                        <option value="Beginner">Người mới bắt đầu (Beginner)</option>
                        <option value="IELTS 4.0 - 5.0">IELTS 4.0 - 5.0</option>
                        <option value="IELTS 5.0 - 6.0">IELTS 5.0 - 6.0</option>
                        <option value="IELTS 6.0 - 7.0">IELTS 6.0 - 7.0</option>
                        <option value="IELTS 7.0+">IELTS 7.0+</option>
                    </select>
                    <button class="btn-action" style="width: auto; padding: 10px 24px;" @onclick="StartLearning" disabled="@string.IsNullOrEmpty(selectedLevel)">Bắt đầu học</button>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (isLoading)
        {
            <div class="loading-spinner">Loading resources...</div>
        }
        else
        {
            @if (courses.Any())
            {
                <h2 class="section-title">Recommended Courses for @selectedLevel</h2>
                <div class="card-grid">
                    @foreach (var course in courses)
                    {
                        <div class="resource-card">
                            <div class="card-badge">@course.Level</div>
                            <h3>@course.Title</h3>
                            <p>@course.Description</p>
                            <div class="card-meta">
                                <span><i class="bi bi-clock"></i> @(course.DurationMinutes / 60)h @(course.DurationMinutes % 60)m</span>
                                <span class="category-tag">@course.Category</span>
                            </div>
                            <button class="btn-action">View Course</button>
                        </div>
                    }
                </div>
            }

            @if (websites.Any())
            {
                <h2 class="section-title" style="margin-top: 40px;">Learning Websites</h2>
                <div class="card-grid">
                    @foreach (var web in websites)
                    {
                        <div class="resource-card">
                            @if (web.IsFree)
                            {
                                <div class="card-badge free-badge">Free</div>
                            }
                            else
                            {
                                <div class="card-badge premium-badge">Premium</div>
                            }
                            
                            <h3>@web.Title</h3>
                            <p>@web.Description</p>
                            
                            @if (!string.IsNullOrEmpty(web.RecommendedLevel))
                            {
                                <div class="card-meta">
                                    <span><i class="bi bi-bar-chart"></i> Level: @web.RecommendedLevel</span>
                                </div>
                            }
                            <a href="@web.Url" target="_blank" class="btn-action btn-outline">Visit Website</a>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<CourseDto> courses = new();
    private List<WebsiteDto> websites = new();
    private bool isLoading = false;
    private bool isLevelSelected = false;
    private string selectedLevel = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var levelClaim = user.FindFirst("level")?.Value;
            var localLevel = await LocalStorage.GetItemAsync<string>("ielts_level");
            
            if ((!string.IsNullOrEmpty(levelClaim) && levelClaim != "A1") || !string.IsNullOrEmpty(localLevel))
            {
                if (string.IsNullOrEmpty(localLevel))
                {
                    await LocalStorage.SetItemAsync("ielts_level", levelClaim);
                }
                NavigationManager.NavigateTo("/ielts/dashboard");
                return;
            }
        }
    }

    private async Task StartLearning()
    {
        if (string.IsNullOrEmpty(selectedLevel)) return;
        
        await LocalStorage.SetItemAsync("ielts_level", selectedLevel);
        
        var authState = await AuthState;
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            await IeltsService.UpdateUserLevelAsync(selectedLevel);
        }

        NavigationManager.NavigateTo("/ielts/dashboard");
    }
}

<style>
    .demo-container {
        padding: 40px;
        color: var(--ig-text);
        background-color: var(--ig-bg);
        min-height: calc(100vh - 150px);
        border-radius: 12px;
        margin-top: 20px;
    }
    
    .demo-container h1, .demo-container p {
        text-align: center;
    }

    .level-selection-container {
        background-color: var(--ig-card-bg);
        padding: 40px;
        border-radius: 12px;
        max-width: 600px;
        margin: 40px auto;
        border: 1px solid var(--ig-border);
        text-align: left;
    }

    .level-selection-container h2 {
        color: var(--ig-text);
        margin-top: 0;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .level-selection-container p {
        color: var(--ig-text-secondary);
        margin-bottom: 30px;
        text-align: left;
        font-size: 1.05rem;
    }

    .form-group label {
        display: block;
        color: var(--ig-text);
        margin-bottom: 10px;
        font-weight: 600;
    }

    .input-group {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .form-control {
        flex: 1;
        padding: 12px 15px;
        border-radius: 8px;
        background: var(--ig-bg);
        color: var(--ig-text);
        border: 1px solid var(--ig-border);
        font-size: 1rem;
        transition: border-color 0.2s;
    }
    
    .form-control:focus {
        outline: none;
        border-color: var(--ig-primary);
    }

    .section-title {
        color: #ff3333;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #333;
        font-size: 1.5rem;
    }
    
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    
    .resource-card {
        background-color: #222;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #333;
        position: relative;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
    }
    
    .resource-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        border-color: #ff3333;
    }
    
    .card-badge {
        position: absolute;
        top: -10px;
        right: 20px;
        background-color: #ff3333;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .free-badge {
        background-color: #28a745;
    }
    
    .premium-badge {
        background-color: #ffc107;
        color: #000;
    }
    
    .resource-card h3 {
        margin-top: 10px;
        font-size: 1.2rem;
        color: #fff;
    }
    
    .resource-card p {
        color: #aaa;
        font-size: 0.9rem;
        flex-grow: 1;
        text-align: left;
    }
    
    .card-meta {
        display: flex;
        justify-content: space-between;
        margin: 15px 0;
        font-size: 0.85rem;
        color: #888;
    }
    
    .category-tag {
        background: #333;
        padding: 2px 8px;
        border-radius: 4px;
        text-transform: capitalize;
    }
    
    .btn-action {
        width: 100%;
        padding: 10px;
        background-color: var(--ig-primary);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: background-color 0.2s;
    }
    
    .btn-action:hover {
        background-color: var(--ig-primary-hover);
        color: white;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #ff3333;
        color: #ff3333;
    }

    .btn-outline:hover {
        background-color: #ff3333;
        color: white;
    }

    .loading-spinner {
        text-align: center;
        padding: 50px;
        color: #ff3333;
        font-weight: bold;
    }
</style>
