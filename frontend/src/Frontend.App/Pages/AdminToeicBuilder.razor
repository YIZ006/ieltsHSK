                    new {
                        Id=qId++, q.Text,
                        Options=q.Options.Select((o,oi)=>new{Id=oi+1,o.Label,o.Text}).ToArray(),
                        CorrectOptionId=LabelToId(q.CorrectOptionLabel),
                        SelectedOptionId=(int?)null,
                        Explanation=q.Explanation
                    }
                }
            }).ToList()
        });

        // Part 6
        qId = 131;
        parts.Add(new {
            PartNumber=6, PartName="Text Completion", PartType="TextCompletion", HasListening=false,
            Instructions="Directions: Read the texts that follow. A word, phrase, or sentence is missing.",
            QuestionGroups = part6Groups.Select(g => (object)new {
                g.GroupId, ImageUrl=g.ImageUrl??"", AudioUrl="", PassageHtml="", PassageTitle="", Translation=g.Translation??"", Instructions="",
                Questions=g.Questions.Select(q=>new{
                    Id=qId++, q.Text,
                    Options=q.Options.Select((o,oi)=>new{Id=oi+1,o.Label,o.Text}).ToArray(),
                    CorrectOptionId=LabelToId(q.CorrectOptionLabel),
                    SelectedOptionId=(int?)null,
                    Explanation=q.Explanation
                }).ToList()
            }).ToList()
        });

        // Part 7
        qId = 147;
        parts.Add(new {
            PartNumber=7, PartName="Reading Comprehension", PartType="ReadingComprehension", HasListening=false,
            Instructions="Directions: In this part you will read a selection of texts.",
            QuestionGroups = part7Groups.Select(g => (object)new {
                g.GroupId,
                ImageUrl=g.ImageUrl??"",
                AudioUrl="",
                PassageHtml="",
                PassageTitle="",
                Translation=g.Translation??"",
                Instructions="",
                Questions=g.Questions.Select(q=>new{
                    Id=qId++, q.Text,
                    Options=q.Options.Select((o,oi)=>new{Id=oi+1,o.Label,o.Text}).ToArray(),
                    CorrectOptionId=LabelToId(q.CorrectOptionLabel),
