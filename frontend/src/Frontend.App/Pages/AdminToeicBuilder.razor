                if (confirm)
                    await LoadDraft();
            }
        }
    }

    private async Task GoStep(int s)
    {
        currentStep = Math.Clamp(s, 0, steps.Length - 1);
        // Auto-save nh├íp mß╗ùi khi chuyß╗ân b╞░ß╗¢c
        await AutoSaveDraft();
        await InvokeAsync(StateHasChanged);
