    private async Task SubmitExam()
    {
        isSaving = true; saveError = ""; saveSuccess = "";
        StateHasChanged();
        try
        {
            var examData = BuildExamJson();
            var resultUrl = await BuilderService.SaveExamAsync(collectionName, examTitle, examData, editingMockTestId);
            if (!string.IsNullOrEmpty(resultUrl))
            {
                saveSuccess = editingMockTestId.HasValue
                    ? $"Đề thi đã cập nhật thành công! URL: {resultUrl}"
                    : $"Đề thi đã lưu thành công! URL: {resultUrl}";
                editingMockTestId = null;
                editingTitle = "";
            }
            else
                saveError = "Lưu thất bại. Kiểm tra lại kết nối backend và cấu hình R2.";
        }
        catch (Exception ex)
        {
            saveError = $"Lỗi: {ex.Message}";
        }
        isSaving = false;
    }

