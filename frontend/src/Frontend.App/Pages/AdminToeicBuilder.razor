    private object BuildConvPartObj(int pNum, string pName, string pType, List<ConvGroup> groups, ref int qId, string instr)
    {
        var localQ = qId;
        var obj = new {
            PartNumber=pNum, PartName=pName, PartType=pType, HasListening=true, Instructions=instr,
            QuestionGroups = groups.Select(g => (object)new {
                g.GroupId, ImageUrl=g.ImageUrl??"", AudioUrl=g.AudioUrl??"", PassageHtml="", PassageTitle=g.Title, Transcript=g.Transcript??"", Instructions="",
                Questions=g.Questions.Select(q=>(object)new{
                    Id=localQ++, q.Text,
                    Options=q.Options.Select((o,oi)=>new{Id=oi+1,o.Label,o.Text}).ToArray(),
                    CorrectOptionId=LabelToId(q.CorrectOptionLabel),
                    SelectedOptionId=(int?)null,
                    Explanation=q.Explanation
                }).ToList()
            }).ToList()
        };
        qId = localQ;
        return obj;
    }

    private static int LabelToId(string? label) => label switch { "A"=>1, "B"=>2, "C"=>3, "D"=>4, _=>1 };

    private static void ApplyBulkOptions(MediaGroup group, string? rawValue, int optionCount)
    {
        group.BulkOptionText = rawValue ?? string.Empty;
        var input = group.BulkOptionText.Trim();
        if (string.IsNullOrEmpty(input)) return;

        // Accept common copied formats: "A. ...", "A) ...", "A: ...", including all answers on one line.
        var matches = System.Text.RegularExpressions.Regex.Matches(
            input,
            @"(?im)(?<!\S)(?:\(\s*)?([A-D])\s*(?:\)\s*(?:[\.:\-]\s*)?|[\.:\-]\s*)");

        if (matches.Count > 0)
        {
            for (var i = 0; i < matches.Count; i++)
            {
                var label = matches[i].Groups[1].Value.ToUpperInvariant();
                var textStart = matches[i].Index + matches[i].Length;
                var textEnd = i + 1 < matches.Count ? matches[i + 1].Index : input.Length;
                var option = group.Options.FirstOrDefault(o => o.Label == label);
                if (option != null && Array.IndexOf(new[] { "A", "B", "C", "D" }, label) < optionCount)
                    option.Text = input[textStart..textEnd].Trim();
            }
            return;
        }

        // Also allow one answer per line when the copied text has no A/B/C/D prefixes.
        var answers = input.Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < Math.Min(optionCount, answers.Length); i++)
            group.Options[i].Text = answers[i].Trim();
    }

    private static void ApplyBulkOptions(ConvQuestion question, string? rawValue)
    {
        question.BulkOptionText = rawValue ?? string.Empty;
        ApplyBulkOptions(question.Options, question.BulkOptionText);
    }

    private static void ApplyBulkOptions(TextQuestion question, string? rawValue)
    {
        question.BulkOptionText = rawValue ?? string.Empty;
        ApplyBulkOptions(question.Options, question.BulkOptionText);
    }

    private static void ApplyBulkOptions(List<OptionItem> options, string rawValue)
    {
        var input = rawValue.Trim();
        if (string.IsNullOrEmpty(input)) return;

        var matches = System.Text.RegularExpressions.Regex.Matches(
            input, @"(?im)(?<!\S)(?:\(\s*)?([A-D])\s*(?:\)\s*(?:[\.:\-]\s*)?|[\.:\-]\s*)");

        if (matches.Count > 0)
        {
            for (var i = 0; i < matches.Count; i++)
            {
                var label = matches[i].Groups[1].Value.ToUpperInvariant();
                var textStart = matches[i].Index + matches[i].Length;
                var textEnd = i + 1 < matches.Count ? matches[i + 1].Index : input.Length;
                var option = options.FirstOrDefault(o => o.Label == label);
                if (option != null) option.Text = input[textStart..textEnd].Trim();
            }
            return;
        }

        var answers = input.Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < Math.Min(options.Count, answers.Length); i++)
            options[i].Text = answers[i].Trim();
    }

    private static List<ConvQuestion> MakeConvQs(int n) => Enumerable.Range(0, n).Select(_ => new ConvQuestion { Options = new[]{ "A","B","C","D" }.Select(l => new OptionItem { Label = l }).ToList() }).ToList();
    private static List<TextQuestion> MakeTextQs(int n, int startId) => Enumerable.Range(0, n).Select(i => new TextQuestion { Id=startId+i }).ToList();

