                                }
                            </div>
                            @* Audio: d├ín link R2 *@
                            <div class="link-input-group">
                                <label class="link-label">≡ƒÄ╡ Link audio (R2)</label>
                                <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                       placeholder="https://r2.example.com/exams/p1-q1.mp3" />
                                @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                                {
                                    <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                                }
                            </div>
                        </div>
                        <div class="q-card-answer">
                            <label>─É├íp ├ín ─æ├║ng:</label>
                            @foreach (var opt in new[] { "A", "B", "C", "D" })
                            {
                                var o = opt;
                                <button class="ans-btn @(g.CorrectAnswer == o ? "selected" : "")"
                                        @onclick="() => g.CorrectAnswer = o">@o</button>
                            }
                        </div>
                        @* Nß╗Öi dung tß╗½ng ─æ├íp ├ín *@
                        <div class="opts-detail">
                            <div class="opts-detail-title">≡ƒô¥ Nß╗Öi dung ─æ├íp ├ín (ghi lß║íi nß╗Öi dung trong audio)</div>
                            <textarea class="form-input bulk-answer-input" rows="4"
                                      value="@g.BulkOptionText"
                                      @oninput="(e) => ApplyBulkOptions(g, e.Value?.ToString(), 4)"
                                      placeholder="D├ín ─æ├íp ├ín theo mß║½u: A. Nß╗Öi dung A&#10;B. Nß╗Öi dung B&#10;C. Nß╗Öi dung C&#10;D. Nß╗Öi dung D"></textarea>
                            <span class="bulk-answer-hint">D├ín mß╗Öt lß║ºn, hß╗ç thß╗æng sß║╜ tß╗▒ ─æiß╗ün v├áo c├íc ├┤ AΓÇôD.</span>
                            <div class="options-grid">
                                @foreach (var opt in g.Options)
                                {
                                    var o = opt;
                                    <div class="option-row @(g.CorrectAnswer == o.Label ? "correct-opt" : "")">
                                        <span class="opt-label">@o.Label</span>
                                        <input @bind="o.Text" class="form-input" placeholder="Nß╗Öi dung ─æ├íp ├ín @o.Label..." />
                                        <button class="mark-correct @(g.CorrectAnswer == o.Label ? "active" : "")"
                                                @onclick="() => g.CorrectAnswer = o.Label">Γ£ô</button>
                                    </div>
                                }
                            </div>
                        </div>
                        @* Giß║úi th├¡ch *@
                        <div class="expl-section">
                            <div class="expl-title">≡ƒÆí Giß║úi th├¡ch ─æ├íp ├ín</div>
                            <textarea @bind="g.Explanation" class="form-input" rows="2"
                                      placeholder="VD: ─É├íp ├ín B ─æ├║ng v├¼ trong audio ng╞░ß╗¥i n├│i... ─É├íp ├ín A sai v├¼..."></textarea>
                        </div>
                    </div>
                }
                <div class="step-footer">
                    <button class="btn-prev" @onclick="() => GoStep(0)">ΓåÉ Tr╞░ß╗¢c</button>
                    <button class="btn-next" @onclick="() => GoStep(2)">Tiß║┐p: Part 2 ΓåÆ</button>
                </div>
            </section>
        }

        @* ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ STEP 2: Part 2 ΓÇö Question Response ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ *@
        else if (currentStep == 2)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>≡ƒÄº Part 2 ΓÇö Question-Response <span class="q-badge">25 c├óu</span></h2>
                    <p>Mß╗ùi c├óu chß╗ë gß╗ôm 1 file audio. ─É├íp ├ín l├á A/B/C.</p>
                </div>
                <div class="p2-list">
                    @for (int i = 0; i < part2Groups.Count; i++)
                    {
                        var gi = i;
                        var g = part2Groups[gi];
                        <div class="q-card">
                            <div class="q-card-header">
                                <span class="q-badge-num">C├óu @(gi + 7)</span>
                                @if (!string.IsNullOrEmpty(g.CorrectAnswer))
                                {
                                    <span class="ans-tag">─É├íp ├ín: @g.CorrectAnswer</span>
                                }
                            </div>
                            @* Audio: d├ín link R2 *@
                            <div class="link-input-group">
                                <label class="link-label">≡ƒÄ╡ Link audio c├óu hß╗Åi (R2)</label>
                                <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                       placeholder="https://r2.example.com/exams/p2-q7.mp3" />
                                @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                                {
                                    <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                                }
                            </div>
                            <div class="form-group full">
                                <label>Nß╗Öi dung c├óu hß╗Åi</label>
                                <input @bind="g.QuestionText" class="form-input"
                                       placeholder="VD: Where will the meeting be held?" />
                            </div>
                            @* Nß╗Öi dung ─æ├íp ├ín A/B/C *@
                            <div class="opts-detail">
                                <div class="opts-detail-title">≡ƒô¥ Nß╗Öi dung ─æ├íp ├ín (ghi lß║íi nß╗Öi dung trong audio)</div>
                                <textarea class="form-input bulk-answer-input" rows="3"
                                          value="@g.BulkOptionText"
                                          @oninput="(e) => ApplyBulkOptions(g, e.Value?.ToString(), 3)"
                                          placeholder="D├ín ─æ├íp ├ín theo mß║½u: A. Nß╗Öi dung A&#10;B. Nß╗Öi dung B&#10;C. Nß╗Öi dung C"></textarea>
                                <span class="bulk-answer-hint">D├ín mß╗Öt lß║ºn, hß╗ç thß╗æng sß║╜ tß╗▒ ─æiß╗ün v├áo c├íc ├┤ AΓÇôC.</span>
                                <div class="options-grid">
                                    @foreach (var opt in g.Options.Take(3))
                                    {
                                        var o = opt;
                                        <div class="option-row @(g.CorrectAnswer == o.Label ? "correct-opt" : "")">
                                            <span class="opt-label">@o.Label</span>
                                            <input @bind="o.Text" class="form-input" placeholder="Nß╗Öi dung ─æ├íp ├ín @o.Label..." />
                                            <button class="mark-correct @(g.CorrectAnswer == o.Label ? "active" : "")"
                                                    @onclick="() => g.CorrectAnswer = o.Label">Γ£ô</button>
                                        </div>
                                    }
                                </div>
                            </div>
                            @* Giß║úi th├¡ch *@
                            <div class="expl-section">
                                <div class="expl-title">≡ƒÆí Giß║úi th├¡ch ─æ├íp ├ín</div>
                                <textarea @bind="g.Explanation" class="form-input" rows="2"
                                          placeholder="VD: ─É├íp ├ín B ─æ├║ng v├¼..."></textarea>
                            </div>
                        </div>
                    }
                </div>
                <div class="step-footer">
                    <button class="btn-prev" @onclick="() => GoStep(1)">ΓåÉ Tr╞░ß╗¢c</button>
                    <button class="btn-next" @onclick="() => GoStep(3)">Tiß║┐p: Part 3 ΓåÆ</button>
                </div>
            </section>
        }

        @* ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ STEP 3: Part 3 ΓÇö Conversations ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ *@
        else if (currentStep == 3)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>≡ƒÆ¼ Part 3 ΓÇö Conversations <span class="q-badge">13 nh├│m ├ù 3 c├óu = 39 c├óu</span></h2>
                    <p>Mß╗ùi nh├│m c├│ 1 audio v├á 3 c├óu hß╗Åi cß╗æ ─æß╗ïnh.</p>
                </div>
                @{ int p3StartQ = 32; }
                @for (int gi = 0; gi < part3Groups.Count; gi++)
                {
                    var gidx = gi;
                    var g = part3Groups[gidx];
                    int gStartQ = p3StartQ + gidx * 3;
                    <div class="passage-card">
                        <div class="passage-card-header">
                            <span class="q-badge-num">Nh├│m @(gidx+1) ΓÇö C├óu @gStartQΓÇô@(gStartQ+2)</span>
                        </div>
                        <div class="link-input-group">
                            <label class="link-label">≡ƒÄ╡ Link audio hß╗Öi thoß║íi (R2)</label>
                            <input @bind="g.AudioUrl" @bind:event="oninput" class="form-input link-url-input"
                                   placeholder="https://r2.example.com/exams/p3-g1.mp3" />
                            @if (!string.IsNullOrWhiteSpace(g.AudioUrl))
                            {
                                <audio controls src="@g.AudioUrl" class="preview-audio"></audio>
                            }
                        </div>
                        <div class="link-input-group">
                            <label class="link-label">≡ƒû╝∩╕Å Link ß║únh minh hoß║í (R2, nß║┐u c├│)</label>
                            <input @bind="g.ImageUrl" @bind:event="oninput" class="form-input link-url-input"
                                   placeholder="https://r2.example.com/exams/p3-g1.jpg" />
                            @if (!string.IsNullOrWhiteSpace(g.ImageUrl))
                            {
                                <img src="@g.ImageUrl" class="preview-img" alt="ß║ónh minh hoß║í" onerror="this.style.display='none'" />
                            }
                        </div>
                        <div class="form-group full">
                            <label>≡ƒô¥ Transcript hß╗Öi thoß║íi (chß╗ë hiß╗çn khi xem ─æ├íp ├ín)</label>
                            <textarea @bind="g.Transcript" class="form-input" rows="6"
                                      placeholder="D├ín nß╗Öi dung hß╗Öi thoß║íi ng╞░ß╗¥i n├│i ß╗ƒ ─æ├óy..."></textarea>
                        </div>
                        @for (int qi = 0; qi < g.Questions.Count; qi++)
                        {
                            var qidx = qi;
                            var q = g.Questions[qidx];
                            <div class="q-card-text nested">
                                <div class="q-card-header"><span class="q-badge-num-sm">C├óu @(gStartQ + qidx)</span></div>
                                <div class="form-group full">
                                    <label>C├óu hß╗Åi</label>
                                    <input @bind="q.Text" class="form-input" placeholder="VD: What are the speakers discussing?" />
                                </div>
                                <textarea class="form-input bulk-answer-input" rows="4"
                                          value="@q.BulkOptionText"
                                          @oninput="(e) => ApplyBulkOptions(q, e.Value?.ToString())"
                                          placeholder="D├ín ─æ├íp ├ín: A. Nß╗Öi dung A&#10;B. Nß╗Öi dung B&#10;C. Nß╗Öi dung C&#10;D. Nß╗Öi dung D"></textarea>
                                <span class="bulk-answer-hint">D├ín mß╗Öt lß║ºn ─æß╗â tß╗▒ ─æß╗Öng ─æiß╗ün v├áo c├íc ├┤ AΓÇôD.</span>
                                <div class="options-grid">
                                    @foreach (var opt in q.Options)
                                    {
                                        var o = opt;
                                        <div class="option-row @(q.CorrectOptionLabel == o.Label ? "correct-opt" : "")">
                                            <span class="opt-label">@o.Label</span>
                                            <input @bind="o.Text" class="form-input" placeholder="Nß╗Öi dung ─æ├íp ├ín @o.Label" />
                                            <button class="mark-correct @(q.CorrectOptionLabel == o.Label ? "active" : "")"
                                                    @onclick="() => q.CorrectOptionLabel = o.Label">Γ£ô</button>
                                        </div>
                                    }
                                </div>
                                <div class="expl-section">
                                    <div class="expl-title">≡ƒÆí Giß║úi th├¡ch ─æ├íp ├ín</div>
                                    <textarea @bind="q.Explanation" class="form-input" rows="2"
                                              placeholder="VD: ─É├íp ├ín B ─æ├║ng v├¼ trong hß╗Öi thoß║íi ng╞░ß╗¥i n├│i..."></textarea>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="step-footer">
                    <button class="btn-prev" @onclick="() => GoStep(2)">ΓåÉ Tr╞░ß╗¢c</button>
                    <button class="btn-next" @onclick="() => GoStep(4)">Tiß║┐p: Part 4 ΓåÆ</button>
                </div>
            </section>
        }

        @* ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ STEP 4: Part 4 ΓÇö Short Talks ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ *@
        else if (currentStep == 4)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>≡ƒÄÖ∩╕Å Part 4 ΓÇö Short Talks <span class="q-badge">10 nh├│m ├ù 3 c├óu = 30 c├óu</span></h2>
                    <p>Mß╗ùi nh├│m c├│ 1 audio v├á 3 c├óu hß╗Åi cß╗æ ─æß╗ïnh.</p>
                </div>
                @{ int p4StartQ = 71; }
                @for (int gi = 0; gi < part4Groups.Count; gi++)
                {
                    var gidx = gi;
                    var g = part4Groups[gidx];
                    int gStartQ = p4StartQ + gidx * 3;
                    <div class="passage-card">
