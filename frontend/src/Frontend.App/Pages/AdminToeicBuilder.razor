@page "/admin/toeic-builder"
@layout Frontend.App.Layout.AdminLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Text.Json.Serialization
@inject ToeicBuilderService BuilderService
@inject MockTestService MockTestService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Admin ΓÇö Tß║ío ─æß╗ü TOEIC</PageTitle>

@* ─── EXAM LIST PANEL ─── *@
@if (showExamList)
{
    <div class="exam-list-overlay">
        <div class="exam-list-panel">
            <div class="exam-list-header">
                <h2>📋 Danh sách đề TOEIC</h2>
                <button class="btn-close-list" @onclick="() => showExamList = false">✕</button>
            </div>
            @if (examList == null)
            {
                <div class="exam-list-loading"><span class="spinner-inline"></span> Đang tải...</div>
            }
            else if (!examList.Any())
            {
                <div class="exam-list-empty">Chưa có đề thi nào.</div>
            }
            else
            {
                <table class="exam-table">
                    <thead><tr><th>Bộ đề</th><th>Tên bài</th><th>Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var exam in examList)
                    {
                        var e = exam;
                        <tr>
                            <td>@e.CollectionName</td>
                            <td>@e.Title</td>
                            <td>
                                @if (!string.IsNullOrEmpty(e.ToeicUrl))
                                {
                                    <button class="btn-edit-exam" @onclick="() => LoadExamForEdit(e)">✏️ Sửa</button>
                                }
                                else
                                {
                                    <span style="color:#888;font-size:0.85em">(Không có link TOEIC)</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="toeic-builder-topbar">
    <button class="btn-show-list" @onclick="OpenExamList">📋 Xem & Sửa đề cũ</button>
    @if (editingMockTestId.HasValue)
    {
        <span class="editing-badge">✏️ Đang sửa: @editingTitle</span>
        <button class="btn-new-exam" @onclick="ResetToNew">+ Tạo đề mới</button>
    }
</div>

<div class="builder-root">
    @* ΓöÇΓöÇΓöÇ SIDEBAR STEPS ΓöÇΓöÇΓöÇ *@
    <aside class="builder-sidebar">
        <div class="sidebar-logo">
            <span class="logo-dot"></span>
            <span>TOEIC Builder</span>
        </div>
        <nav class="step-nav">
            @for (int s = 0; s < steps.Length; s++)
            {
                var si = s;
                <button class="step-item @(currentStep == si ? "active" : si < currentStep ? "done" : "")"
                        @onclick="() => GoStep(si)">
                    <span class="step-num">@(si < currentStep ? "Γ£ô" : (si + 1).ToString())</span>
                    <span class="step-label">@steps[si]</span>
                </button>
            }
        </nav>
        <div class="sidebar-footer">
            <button class="btn-save-draft" @onclick="SaveDraft" disabled="@isSavingDraft">
                @if (isSavingDraft)
                {
                    <span class="spinner-inline" style="width:12px;height:12px"></span>
                }
                else
                {
                    <span>≡ƒÆ╛</span>
                }
                L╞░u nh├íp
            </button>
            @if (hasDraft)
            {
                <button class="btn-clear-draft" @onclick="ClearDraft">≡ƒùæ∩╕Å X├│a nh├íp</button>
            }
            @if (!string.IsNullOrEmpty(draftToast))
            {
                <div class="draft-toast @draftToastClass">@draftToast</div>
            }
        </div>
    </aside>

    @* ΓöÇΓöÇΓöÇ MAIN PANEL ΓöÇΓöÇΓöÇ *@
    <main class="builder-main" id="builder-main">

        @* ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ STEP 0: Th├┤ng tin ─æß╗ü ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ *@
        @if (currentStep == 0)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>≡ƒôï Th├┤ng tin ─æß╗ü thi</h2>
                    <p>─Éiß╗ün c├íc th├┤ng tin c╞í bß║ún cho bß╗Ö ─æß╗ü TOEIC</p>
                </div>
                <div class="form-grid">
                    <div class="form-group full">
                        <label>T├¬n bß╗Ö ─æß╗ü <span class="req">*</span></label>
                        <input @bind="collectionName" class="form-input" placeholder="VD: TOEIC ETS 2024 Volume 1" />
                    </div>
                    <div class="form-group full">
                        <label>T├¬n b├ái thi <span class="req">*</span></label>
                        <input @bind="examTitle" class="form-input" placeholder="VD: Test 1" />
                    </div>
                    <div class="form-group full">
                        <label>M├┤ tß║ú</label>
                        <textarea @bind="examDescription" class="form-input" rows="3" placeholder="M├┤ tß║ú ngß║»n gß╗ìn vß╗ü ─æß╗ü thi..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Thß╗¥i gian thi (ph├║t)</label>
                        <input type="number" @bind="examTimeMins" class="form-input" min="30" max="180" />
                    </div>
                </div>
                
                @* ΓöÇΓöÇΓöÇ Autofill Tool ΓöÇΓöÇΓöÇ *@
                <div class="autofill-section">
                    <h3 class="autofill-title">ΓÜí ─Éiß╗ün nhanh Link R2 (Tß╗▒ ─æß╗Öng ─æiß╗ün theo c├óu hß╗Åi)</h3>
                    <p class="autofill-desc">Nhß║¡p th╞░ mß╗Ñc gß╗æc chß╗⌐a file tr├¬n R2. Hß╗ç thß╗æng sß║╜ tß╗▒ ─æß╗Öng gh├⌐p vß╗¢i <code>{ID}.jpg</code> (c├óu ─æ╞ín) hoß║╖c <code>{StartID}-{EndID}.mp3</code> (nh├│m c├óu) t╞░╞íng ß╗⌐ng (VD: <code>/1.mp3</code>, <code>/32-34.mp3</code>).</p>
                    <div class="form-grid">
                        <div class="form-group full">
                            <label>Base URL ß║ónh</label>
                            <input @bind="autofillBaseImageUrl" class="form-input" placeholder="VD: https://pub-xxx.r2.dev/ETS 2026 Test 1/ß║ónh" />
                        </div>
                        <div class="form-group full">
                            <label>Base URL Audio</label>
                            <input @bind="autofillBaseAudioUrl" class="form-input" placeholder="VD: https://pub-xxx.r2.dev/ETS 2026 Test 1/Audio" />
                        </div>
                    </div>
                    <button class="btn-autofill" @onclick="AutofillMediaLinks">≡ƒöä Tß╗▒ ─æß╗Öng ─æiß╗ün cho tß║Ñt cß║ú c├íc Part</button>
                </div>

                <div class="section-footer">
                    <button class="btn-next" @onclick="() => GoStep(1)">Tiß║┐p theo: Part 1 ΓåÆ</button>
                </div>
            </section>
        }

        @* ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ STEP 1: Part 1 ΓÇö Photographs ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ *@
        else if (currentStep == 1)
        {
            <section class="builder-section">
                <div class="section-header">
                    <h2>≡ƒô╕ Part 1 ΓÇö Photographs <span class="q-badge">6 c├óu</span></h2>
                    <p>Mß╗ùi c├óu gß╗ôm 1 ß║únh + 1 file audio. ─É├íp ├ín A/B/C/D ─æß╗ìc trong audio.</p>
                </div>
                @for (int i = 0; i < part1Groups.Count; i++)
                {
                    var gi = i;
                    var g = part1Groups[gi];
                    <div class="q-card">
                        <div class="q-card-header">
                            <span class="q-badge-num">C├óu @(gi + 1)</span>
                            @if (!string.IsNullOrEmpty(g.CorrectAnswer))
                            {
                                <span class="ans-tag">─É├íp ├ín: @g.CorrectAnswer</span>
                            }
                        </div>
                        <div class="q-card-body two-col">
                            @* ß║ónh: d├ín link R2 *@
                            <div class="link-input-group">
                                <label class="link-label">≡ƒû╝∩╕Å Link ß║únh (R2)</label>
                                <input @bind="g.ImageUrl" @bind:event="oninput" class="form-input link-url-input"
                                       placeholder="https://r2.example.com/exams/p1-q1.jpg" />
                                @if (!string.IsNullOrWhiteSpace(g.ImageUrl))
                                {
                                    <img src="@g.ImageUrl" class="preview-img" alt="preview"
                                         onerror="this.style.display='none'" />
