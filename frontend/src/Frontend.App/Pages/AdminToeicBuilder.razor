    private async Task LoadExamForEdit(MockTestDto exam)
    {
        if (string.IsNullOrEmpty(exam.ToeicUrl)) return;
        showExamList = false;
        editingMockTestId = exam.Id;
        editingTitle = exam.Title;
        collectionName = exam.CollectionName;
        examTitle = exam.Title;
        currentStep = 0;
        saveError = ""; saveSuccess = "";
        // Load JSON từ R2 và điền vào form
        try
        {
            using var http = new HttpClient();
            var json = await http.GetStringAsync(exam.ToeicUrl);
            var doc = JsonDocument.Parse(json).RootElement;
            if (doc.TryGetProperty("TotalTimeSeconds", out var t)) examTimeMins = t.GetInt32() / 60;
            if (doc.TryGetProperty("Description", out var desc)) examDescription = desc.GetString() ?? "";
            saveSuccess = "Đã tải đề thi lên. Hãy chỉnh sửa và bấm 'Upload & Lưu' để cập nhật.";
        }
        catch (Exception ex) { saveError = $"Không thể tải đề: {ex.Message}"; }
    }

    private void ResetToNew()
    {
        editingMockTestId = null;
        editingTitle = "";
        collectionName = ""; examTitle = ""; examDescription = "";
        examTimeMins = 120; currentStep = 0;
        saveError = ""; saveSuccess = "";
    }

