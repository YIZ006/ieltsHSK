    // ΓöÇΓöÇΓöÇ Autofill Links ΓöÇΓöÇΓöÇ
    private string autofillBaseImageUrl = "";
    private string autofillBaseAudioUrl = "";

    private void AutofillMediaLinks()
    {
        // Part 1 (Q1-Q6)
        for (int i = 0; i < part1Groups.Count; i++)
        {
            if (!string.IsNullOrWhiteSpace(autofillBaseImageUrl)) part1Groups[i].ImageUrl = $"{autofillBaseImageUrl.TrimEnd('/')}/{i + 1}.jpg";
            if (!string.IsNullOrWhiteSpace(autofillBaseAudioUrl)) part1Groups[i].AudioUrl = $"{autofillBaseAudioUrl.TrimEnd('/')}/{i + 1}.mp3";
        }

        // Part 2 (Q7-Q31)
        for (int i = 0; i < part2Groups.Count; i++)
        {
            if (!string.IsNullOrWhiteSpace(autofillBaseAudioUrl)) part2Groups[i].AudioUrl = $"{autofillBaseAudioUrl.TrimEnd('/')}/{i + 7}.mp3";
        }

        // Part 3 (Q32-Q70)
        int p3q = 32;
        foreach (var g in part3Groups)
        {
            int endQ = p3q + g.Questions.Count - 1;
            if (!string.IsNullOrWhiteSpace(autofillBaseAudioUrl)) g.AudioUrl = $"{autofillBaseAudioUrl.TrimEnd('/')}/{p3q}-{endQ}.mp3";
            p3q += g.Questions.Count;
        }

        // Part 4 (Q71-Q100)
        int p4q = 71;
        foreach (var g in part4Groups)
        {
            int endQ = p4q + g.Questions.Count - 1;
            if (!string.IsNullOrWhiteSpace(autofillBaseAudioUrl)) g.AudioUrl = $"{autofillBaseAudioUrl.TrimEnd('/')}/{p4q}-{endQ}.mp3";
            p4q += g.Questions.Count;
        }

        // Part 7 (Q147-Q200)
        int p7q = 147;
        foreach (var g in part7Groups)
        {
            int endQ = p7q + g.Questions.Count - 1;
            if (!string.IsNullOrWhiteSpace(autofillBaseImageUrl))
            {
                g.ImageUrl = $"{autofillBaseImageUrl.TrimEnd('/')}/{p7q}-{endQ}.jpg";
            }
            if (!string.IsNullOrWhiteSpace(autofillBaseAudioUrl)) 
            {
                g.AudioUrl = $"{autofillBaseAudioUrl.TrimEnd('/')}/{p7q}-{endQ}.mp3";
            }
            p7q += g.Questions.Count;
        }

        ShowDraftToast("Γ£¿ ─É├ú tß╗▒ ─æß╗Öng ─æiß╗ün link R2!", "toast-ok");
    }


    private void AddPart7Group()
    {
        var remaining = MaxPart7Questions - Part7QuestionCount;
        if (remaining < 2) return;

        var g = new Part7Group { GroupId = $"p7g{part7Groups.Count + 1}", QuestionCount = Math.Min(3, remaining), ContentType = "image" };
        SyncPart7Questions(g);
        part7Groups.Add(g);
    }

    private IEnumerable<int> AvailablePart7QuestionCounts(Part7Group group)
    {
        var otherQuestions = Part7QuestionCount - group.Questions.Count;
        return Enumerable.Range(2, 4).Where(count => otherQuestions + count <= MaxPart7Questions);
    }

    private void ChangePart7QuestionCount(Part7Group group, int count)
    {
        if (!AvailablePart7QuestionCounts(group).Contains(count)) return;
        group.QuestionCount = count;
        SyncPart7Questions(group);
    }

    private void NormalizePart7Groups()
    {
        var used = 0;
        for (var i = 0; i < part7Groups.Count; i++)
        {
            var remaining = MaxPart7Questions - used;
            if (remaining < 2)
            {
                part7Groups.RemoveRange(i, part7Groups.Count - i);
                break;
            }

            var group = part7Groups[i];
            group.QuestionCount = Math.Clamp(group.QuestionCount, 2, Math.Min(5, remaining));
            SyncPart7Questions(group);
            used += group.Questions.Count;
        }
    }

    private void SyncPart7Questions(Part7Group g)
    {
        while (g.Questions.Count < g.QuestionCount)
            g.Questions.Add(new TextQuestion { Id = g.Questions.Count + 1 });
        while (g.Questions.Count > g.QuestionCount)
            g.Questions.RemoveAt(g.Questions.Count - 1);
    }

    // ΓöÇΓöÇΓöÇ Draft: Save ΓöÇΓöÇΓöÇ
    private async Task SaveDraft()
    {
        isSavingDraft = true;
        StateHasChanged();
        try
        {
            var draft = BuildDraftPayload();
            await LocalStorage.SetItemAsync(DraftKey, draft);
            hasDraft = true;
            ShowDraftToast("Γ£à ─É├ú l╞░u nh├íp!", "toast-ok");
        }
        catch (Exception ex)
        {
            ShowDraftToast($"ΓÜá∩╕Å Lß╗ùi: {ex.Message}", "toast-err");
        }
        isSavingDraft = false;
        StateHasChanged();
    }

    // Auto-save nhß║╣ khi chuyß╗ân b╞░ß╗¢c (kh├┤ng show toast)
    private async Task AutoSaveDraft()
    {
        try
        {
            var draft = BuildDraftPayload();
            await LocalStorage.SetItemAsync(DraftKey, draft);
            hasDraft = true;
        }
        catch { /* silent */ }
    }

    // ΓöÇΓöÇΓöÇ Draft: Load ΓöÇΓöÇΓöÇ
    private async Task LoadDraft()
    {
        try
        {
            var draft = await LocalStorage.GetItemAsync<BuilderDraft>(DraftKey);
            if (draft == null) return;

            collectionName  = draft.CollectionName ?? "";
            examTitle       = draft.ExamTitle ?? "";
            examDescription = draft.ExamDescription ?? "";
            examTimeMins    = draft.ExamTimeMins;
            currentStep     = draft.CurrentStep;

            if (draft.Part1 != null)  part1Groups    = draft.Part1;
            if (draft.Part2 != null)  part2Groups    = draft.Part2;
            if (draft.Part3 != null)  part3Groups    = draft.Part3;
            if (draft.Part4 != null)  part4Groups    = draft.Part4;
            if (draft.Part5 != null)  part5Questions = draft.Part5;
            if (draft.Part6 != null)  part6Groups    = draft.Part6;
            if (draft.Part7 != null && draft.Part7.Count > 0)
            {
                part7Groups = draft.Part7;
                NormalizePart7Groups();
            }

            ShowDraftToast("Γ£à ─É├ú kh├┤i phß╗Ñc bß║ún nh├íp!", "toast-ok");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowDraftToast($"ΓÜá∩╕Å Kh├┤ng thß╗â ─æß╗ìc nh├íp: {ex.Message}", "toast-err");
        }
    }

    // ΓöÇΓöÇΓöÇ Draft: Clear ΓöÇΓöÇΓöÇ
    private async Task ClearDraft()
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "X├│a bß║ún nh├íp n├áy?");
        if (!confirm) return;
        await LocalStorage.RemoveItemAsync(DraftKey);
        hasDraft = false;
        ShowDraftToast("≡ƒùæ∩╕Å ─É├ú x├│a nh├íp", "toast-warn");
        StateHasChanged();
    }

    // ΓöÇΓöÇΓöÇ Toast helper ΓöÇΓöÇΓöÇ
    private System.Timers.Timer? _toastTimer;
    private void ShowDraftToast(string msg, string cls)
    {
        draftToast = msg; draftToastClass = cls;
        _toastTimer?.Stop();
        _toastTimer = new System.Timers.Timer(3000);
        _toastTimer.Elapsed += async (_, _) =>
        {
            draftToast = "";
            await InvokeAsync(StateHasChanged);
            _toastTimer?.Stop();
        };
        _toastTimer.Start();
    }

