@code {
    private List<ExamScheduleItem>? allSchedules;
    private List<ExamScheduleItem>? filteredSchedules;
    private ExamFeeMatrix? feeMatrix;
    private ExamRegulations? regulations;

    private string selectedTab = "ALL"; // "ALL", "HSK", "IELTS"
    private string selectedCity = "All";
    private string selectedFormat = "All";
    private string selectedStatus = "All";
    private string searchQuery = "";
    private bool isLoading = true;

    private int hskCount => allSchedules?.Count(s => s.CertificateType.StartsWith("HSK", StringComparison.OrdinalIgnoreCase)) ?? 0;
    private int ieltsCount => allSchedules?.Count(s => s.CertificateType.StartsWith("IELTS", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private bool HasActiveFilters =>
        selectedCity != "All" ||
        selectedFormat != "All" ||
        selectedStatus != "All" ||
        !string.IsNullOrEmpty(searchQuery);

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var relative = NavManager.ToBaseRelativePath(NavManager.Uri).ToLowerInvariant();
        if (relative.StartsWith("hsk"))
        {
            selectedTab = "HSK";
        }
        else if (relative.StartsWith("ielts"))
        {
            selectedTab = "IELTS";
        }
        else if (!string.IsNullOrWhiteSpace(TypeQuery))
        {
            var t = TypeQuery.Trim().ToUpperInvariant();
            if (t == "HSK") selectedTab = "HSK";
            else if (t == "IELTS") selectedTab = "IELTS";
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            allSchedules = await ExamService.GetSchedulesAsync();
            feeMatrix = await ExamService.GetFeeMatrixAsync();
            regulations = await ExamService.GetRegulationsAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ExamHub] Error loading schedules: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ChangeTab(string tab)
    {
        selectedTab = tab;
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFilters();
    }

    private void ResetFilters()
    {
        selectedCity = "All";
        selectedFormat = "All";
        selectedStatus = "All";
        searchQuery = "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allSchedules == null)
        {
            filteredSchedules = new List<ExamScheduleItem>();
            return;
        }

        var query = allSchedules.AsEnumerable();

        // 1. Tab filter
        if (selectedTab == "HSK")
        {
            query = query.Where(s => s.CertificateType.StartsWith("HSK", StringComparison.OrdinalIgnoreCase));
        }
        else if (selectedTab == "IELTS")
        {
            query = query.Where(s => s.CertificateType.StartsWith("IELTS", StringComparison.OrdinalIgnoreCase));
        }

        // 2. City filter
        if (selectedCity != "All")
        {
            var cNorm = selectedCity.Trim().ToLowerInvariant();
            query = query.Where(s => s.City.ToLowerInvariant().Contains(cNorm));
        }

        // 3. Format filter
        if (selectedFormat != "All")
        {
            var fNorm = selectedFormat.Trim().ToLowerInvariant();
            query = query.Where(s => s.Format.ToLowerInvariant().Contains(fNorm));
        }

        // 4. Status filter (Evaluates dynamic real-time status)
        if (selectedStatus != "All")
        {
            query = query.Where(s => string.Equals(s.EffectiveStatus, selectedStatus, StringComparison.OrdinalIgnoreCase));
        }

        // 5. Search text filter
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(s =>
                s.TestCenter.ToLowerInvariant().Contains(q) ||
                s.City.ToLowerInvariant().Contains(q) ||
                s.Organizer.ToLowerInvariant().Contains(q) ||
                (s.Level != null && s.Level.ToLowerInvariant().Contains(q)) ||
                (s.LocationAddress != null && s.LocationAddress.ToLowerInvariant().Contains(q)));
        }

        filteredSchedules = query.OrderBy(s => s.ExamDate).ToList();
    }

    private static string GetDayOfWeekVietnamese(DateTime dt)
    {
        return dt.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ Hai",
            DayOfWeek.Tuesday => "Thứ Ba",
            DayOfWeek.Wednesday => "Thứ Tư",
            DayOfWeek.Thursday => "Thứ Năm",
            DayOfWeek.Friday => "Thứ Sáu",
            DayOfWeek.Saturday => "Thứ Bảy",
            DayOfWeek.Sunday => "Chủ Nhật",
            _ => ""
        };
    }
}
