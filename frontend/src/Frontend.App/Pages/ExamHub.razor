@page "/exam-hub"
@page "/lich-thi"
@using Frontend.App.Services
@inject ExamScheduleService ExamService
@inject NavigationManager NavManager

<PageTitle>Cổng Tra Cứu Lịch Thi IELTS &amp; HSK 2026 Toàn Quốc | ieltsHSK</PageTitle>

<div class="exam-hub-container">
    @* ── HERO SECTION ── *@
    <div class="exam-hub-hero">
        <div class="hero-badge">
            <span class="badge-dot-live"></span>
            <span>Cập nhật Lịch Thi Khảo Thí Chính Thức 2026</span>
        </div>
        <h1 class="hero-title">
            Cổng Tra Cứu Lịch Thi IELTS &amp; HSK Toàn Quốc
        </h1>
        <p class="hero-desc">
            Tra cứu đầy đủ các đợt thi IELTS (IDP / British Council) và HSK &amp; HSKK (Hanban CTI).
            Theo dõi thời hạn đăng ký, lệ phí thi niêm yết, địa điểm thi ủy quyền và quy chế phòng thi chuẩn quốc tế.
        </p>

        @* Quick Highlights Row *@
        <div class="hero-highlights">
            <div class="highlight-chip">
                <i class="bi bi-calendar2-week-fill text-danger"></i>
                <span><strong>24+</strong> Đợt thi đã lên lịch 2026</span>
            </div>
            <div class="highlight-chip">
                <i class="bi bi-geo-alt-fill text-primary"></i>
                <span><strong>5+</strong> Cụm thi lớn toàn quốc</span>
            </div>
            <div class="highlight-chip">
                <i class="bi bi-laptop-fill text-success"></i>
                <span><strong>Thi Máy &amp; Thi Giấy</strong> Đầy đủ chỉ tiêu</span>
            </div>
        </div>
    </div>

    @* ── CERTIFICATE SELECTION TABS ── *@
    <div class="exam-type-nav">
        <button type="button"
                class="type-tab-btn @(selectedTab == "ALL" ? "active" : "")"
                @onclick='() => ChangeTab("ALL")'>
            <i class="bi bi-grid-fill"></i>
            <span>Tất cả Kỳ thi (@(allSchedules?.Count ?? 0))</span>
        </button>

        <button type="button"
                class="type-tab-btn tab-hsk @(selectedTab == "HSK" ? "active" : "")"
                @onclick='() => ChangeTab("HSK")'>
            <i class="bi bi-translate text-danger"></i>
            <span>Lịch thi HSK &amp; HSKK (@hskCount)</span>
        </button>

        <button type="button"
                class="type-tab-btn tab-ielts @(selectedTab == "IELTS" ? "active" : "")"
                @onclick='() => ChangeTab("IELTS")'>
            <i class="bi bi-award-fill text-primary"></i>
            <span>Lịch thi IELTS (IDP / BC) (@ieltsCount)</span>
        </button>
    </div>

    @* ── SMART MULTI-FILTER TOOLBAR ── *@
    <div class="filter-panel">
        <div class="filter-grid">
            @* Search input *@
            <div class="filter-col filter-search">
                <label class="filter-label"><i class="bi bi-search me-1"></i>Tìm kiếm</label>
                <div class="search-input-wrap">
                    <input type="text"
                           class="form-control"
                           placeholder="Địa điểm, điểm thi, đơn vị tổ chức..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @bind:after="ApplyFilters" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button type="button" class="btn-clear" @onclick="ClearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>

            @* City / Region *@
            <div class="filter-col">
                <label class="filter-label"><i class="bi bi-geo-alt me-1"></i>Khu vực / Tỉnh thành</label>
                <select class="form-select" @bind="selectedCity" @bind:after="ApplyFilters">
                    <option value="All">Toàn quốc (Tất cả)</option>
                    <option value="Hà Nội">Hà Nội</option>
                    <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                    <option value="Đà Nẵng">Đà Nẵng</option>
                    <option value="Huế">Huế</option>
                    <option value="Thái Nguyên">Thái Nguyên</option>
                </select>
            </div>

            @* Format *@
            <div class="filter-col">
                <label class="filter-label"><i class="bi bi-display me-1"></i>Hình thức thi</label>
                <select class="form-select" @bind="selectedFormat" @bind:after="ApplyFilters">
                    <option value="All">Tất cả hình thức</option>
                    <option value="Computer">Thi trên máy tính (Computer)</option>
                    <option value="Paper">Thi trên giấy (Paper-based)</option>
                </select>
            </div>

            @* Status filter *@
            <div class="filter-col">
                <label class="filter-label"><i class="bi bi-funnel me-1"></i>Trạng thái đăng ký</label>
                <select class="form-select" @bind="selectedStatus" @bind:after="ApplyFilters">
                    <option value="All">Tất cả các đợt</option>
                    <option value="Open">Đang mở đăng ký</option>
                    <option value="ClosingSoon">Sắp hết hạn</option>
                    <option value="Closed">Đã đóng đăng ký</option>
                </select>
            </div>
        </div>

        @* Active Filter Summary *@
        <div class="filter-footer-row">
            <span class="results-count">
                Hiển thị <strong>@(filteredSchedules?.Count ?? 0)</strong> đợt thi phù hợp
            </span>
            @if (HasActiveFilters)
            {
                <button type="button" class="btn-reset-filters" @onclick="ResetFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                </button>
            }
        </div>
    </div>

    @* ── SCHEDULE CARDS GRID ── *@
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-danger" role="status"></div>
            <p>Đang tải dữ liệu lịch thi 2026...</p>
        </div>
    }
    else if (filteredSchedules == null || filteredSchedules.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📅</div>
            <h3>Không tìm thấy đợt thi phù hợp</h3>
            <p>Vui lòng thử mở rộng bộ lọc khu vực, hình thức thi hoặc đổi từ khóa tìm kiếm.</p>
            <button type="button" class="btn btn-outline-danger btn-sm mt-3" @onclick="ResetFilters">
                <i class="bi bi-arrow-counterclockwise"></i> Xem tất cả lịch thi
            </button>
        </div>
    }
    else
    {
        <div class="schedules-grid">
            @foreach (var sched in filteredSchedules)
            {
                var isIelts = sched.CertificateType.StartsWith("IELTS", StringComparison.OrdinalIgnoreCase);
                var isClosed = sched.IsClosed;
                var isClosingSoon = sched.IsClosingSoon;

                <div class="sched-card @(isIelts ? "card-ielts" : "card-hsk") @(isClosed ? "sched-closed" : "")">
                    @* Card Top Ribbon *@
                    <div class="sched-top-bar">
                        <div class="cert-badge @(isIelts ? "badge-ielts" : "badge-hsk")">
                            <i class="bi @(isIelts ? "bi-award-fill" : "bi-translate") me-1"></i>
                            @sched.CertificateType
                        </div>

                        <div class="format-badge @(sched.Format == "Computer" ? "badge-computer" : "badge-paper")">
                            <i class="bi @(sched.Format == "Computer" ? "bi-laptop" : "bi-pencil-square") me-1"></i>
                            @(sched.Format == "Computer" ? "Máy tính" : "Trên giấy")
                        </div>

                        <div class="status-badge @(isClosed ? "status-closed" : (isClosingSoon ? "status-closing" : "status-open"))">
                            <i class="bi @(isClosed ? "bi-x-circle-fill" : (isClosingSoon ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")) me-1"></i>
                            @(isClosed ? "Đã đóng" : (isClosingSoon ? "Sắp hết hạn" : "Đang mở"))
                        </div>
                    </div>

                    @* Date Focus *@
                    <div class="sched-date-box">
                        <div class="date-calendar">
                            <span class="cal-month">Tháng @sched.ExamDate.Month</span>
                            <span class="cal-day">@sched.ExamDate.Day.ToString("00")</span>
                            <span class="cal-year">@sched.ExamDate.Year</span>
                        </div>

                        <div class="date-info">
                            <div class="date-weekday">@GetDayOfWeekVietnamese(sched.ExamDate)</div>
                            <div class="sched-level">@(sched.Level ?? "Tiêu chuẩn quốc tế")</div>
                            <div class="deadline-note @(isClosed ? "deadline-closed" : (isClosingSoon ? "deadline-closing" : ""))">
                                <i class="bi @(isClosed ? "bi-calendar-x" : (isClosingSoon ? "bi-clock-history text-warning" : "bi-alarm")) me-1"></i>
                                Hạn nộp: <strong>@sched.RegistrationDeadline.ToString("dd/MM/yyyy")</strong>
                                @if (isClosed)
                                {
                                    <span class="badge-closed-tag ms-1">Đã kết thúc</span>
                                }
                                else if (isClosingSoon)
                                {
                                    var daysLeft = (int)Math.Max(0, (sched.RegistrationDeadline.Date - DateTime.Today).TotalDays);
                                    <span class="badge-closing-tag ms-1">Còn @(daysLeft == 0 ? "hôm nay" : $"{daysLeft} ngày")</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* Center Details *@
                    <div class="sched-center-details">
                        <div class="center-name">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            <strong>@sched.TestCenter</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(sched.LocationAddress) && sched.LocationAddress != sched.TestCenter)
                        {
                            <div class="center-addr">@sched.LocationAddress</div>
                        }
                        <div class="center-city-org">
                            <span class="city-tag"><i class="bi bi-building me-1"></i>@sched.City</span>
                            <span class="org-tag"><i class="bi bi-shield-check me-1"></i>@sched.Organizer</span>
                        </div>
                    </div>

                    @* Fee Box *@
                    <div class="sched-fee-row">
                        <div class="fee-label">Lệ phí niêm yết:</div>
                        <div class="fee-amount">
                            @(string.IsNullOrEmpty(sched.FeeFormatted) ? $"{sched.FeeVnd:N0} VNĐ" : sched.FeeFormatted)
                        </div>
                    </div>

                    @* Notes / Description *@
                    @if (!string.IsNullOrEmpty(sched.Notes) || !string.IsNullOrEmpty(sched.Description))
                    {
                        <div class="sched-notes">
                            <i class="bi bi-info-circle me-1"></i>
                            <span>@(sched.Notes ?? sched.Description)</span>
                        </div>
                    }

                    @* Action Footer *@
                    <div class="sched-actions">
                        @if (isClosed)
                        {
                            <button type="button" class="btn-register-now btn-disabled-closed" disabled>
                                <i class="bi bi-lock-fill me-1"></i>
                                <span>Đã Hết Hạn Đăng Ký</span>
                            </button>
                        }
                        else if (!string.IsNullOrEmpty(sched.RegistrationUrl))
                        {
                            <a href="@sched.RegistrationUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-register-now">
                                <span>Đăng Ký Dự Thi Chính Thức</span>
                                <i class="bi bi-box-arrow-up-right ms-1"></i>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn-register-now btn-disabled-closed" disabled>
                                <span>Liên hệ điểm thi</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* ── OFFICIAL 2026 FEE MATRIX TABLE ── *@
    <div class="fee-matrix-section">
        <div class="section-header">
            <div class="sec-badge"><i class="bi bi-cash-stack me-1"></i>Bảng Giá Khảo Thí Niêm Yết</div>
            <h2 class="sec-title">Biểu Phí Khảo Thí Chính Thức Năm 2026</h2>
            <p class="sec-desc">
                Bảng lệ phí thi chuẩn do Ủy ban Khảo thí Tiếng Trung Quốc tế (CTI Hanban),
                IDP Education và British Council ban hành cho khu vực Việt Nam.
            </p>
        </div>

        <div class="tables-dual-grid">
            @* HSK Fees Table *@
            <div class="fee-card">
                <div class="fee-card-header hsk-header">
                    <i class="bi bi-translate text-danger fs-5"></i>
                    <div>
                        <h4 class="mb-0">Lệ Phí Thi HSK &amp; HSKK 3.0</h4>
                        <small>Kỳ thi kết hợp Nghe - Đọc - Viết &amp; Khẩu ngữ</small>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table fee-table">
                        <thead>
                            <tr>
                                <th>Cấp độ thi</th>
                                <th class="text-end">Lệ phí (VNĐ)</th>
                                <th>Ghi chú điều kiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (feeMatrix?.HskFees != null && feeMatrix.HskFees.Count > 0)
                            {
                                @foreach (var f in feeMatrix.HskFees)
                                {
                                    <tr>
                                        <td><strong>@f.LevelOrType</strong></td>
                                        <td class="text-end text-danger fw-bold">@f.FormattedVnd</td>
                                        <td class="fee-note-cell">@f.Note</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td>HSK 1 - HSK 2</td><td class="text-end text-danger fw-bold">550.000 VNĐ</td><td>Dành cho người mới học</td></tr>
                                <tr><td>HSK 3 + HSKK Sơ cấp</td><td class="text-end text-danger fw-bold">1.280.000 VNĐ</td><td>Bắt buộc thi kết hợp</td></tr>
                                <tr><td>HSK 4 + HSKK Trung cấp</td><td class="text-end text-danger fw-bold">1.600.000 VNĐ</td><td>Chuẩn đầu ra đại học</td></tr>
                                <tr><td>HSK 5 + HSKK Cao cấp</td><td class="text-end text-danger fw-bold">1.850.000 VNĐ</td><td>Phục vụ du học &amp; học bổng</td></tr>
                                <tr><td>HSK 6 + HSKK Cao cấp</td><td class="text-end text-danger fw-bold">2.150.000 VNĐ</td><td>Trình độ chuyên gia</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* IELTS Fees Table *@
            <div class="fee-card">
                <div class="fee-card-header ielts-header">
                    <i class="bi bi-award-fill text-primary fs-5"></i>
                    <div>
                        <h4 class="mb-0">Lệ Phí Thi IELTS (IDP / British Council)</h4>
                        <small>Học thuật, Tổng quát và Visa UK</small>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table fee-table">
                        <thead>
                            <tr>
                                <th>Loại hình thi</th>
                                <th class="text-end">Lệ phí (VNĐ)</th>
                                <th>Ghi chú điều kiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (feeMatrix?.IeltsFees != null && feeMatrix.IeltsFees.Count > 0)
                            {
                                @foreach (var f in feeMatrix.IeltsFees)
                                {
                                    <tr>
                                        <td><strong>@f.LevelOrType</strong></td>
                                        <td class="text-end text-primary fw-bold">@f.FormattedVnd</td>
                                        <td class="fee-note-cell">@f.Note</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td>IELTS Academic / General</td><td class="text-end text-primary fw-bold">4.664.000 VNĐ</td><td>Đã bao gồm thuế VAT ưu đãi 8%</td></tr>
                                <tr><td>IELTS for UKVI</td><td class="text-end text-primary fw-bold">5.250.000 VNĐ</td><td>Phục vụ hồ sơ visa Anh quốc</td></tr>
                                <tr><td>IELTS Life Skills (A1/B1)</td><td class="text-end text-primary fw-bold">4.414.000 VNĐ</td><td>Định cư &amp; bảo lãnh gia đình</td></tr>
                                <tr><td>IELTS One Skill Retake</td><td class="text-end text-primary fw-bold">2.900.000 VNĐ</td><td>Thi lại 1 kỹ năng trong 60 ngày</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ── TEST DAY REGULATIONS & GUIDELINES ── *@
    <div class="regulations-section">
        <div class="section-header">
            <div class="sec-badge"><i class="bi bi-shield-lock-fill me-1"></i>Cẩm Nang Khảo Thí</div>
            <h2 class="sec-title">Quy Chế Phòng Thi &amp; Vật Dụng Được Mang Vào</h2>
            <p class="sec-desc">
                Thí sinh bắt buộc tuân thủ nghiêm ngặt để tránh bị đình chỉ thi và hủy kết quả.
            </p>
        </div>

        <div class="regulations-grid">
            <div class="reg-box box-required">
                <div class="reg-box-title">
                    <i class="bi bi-person-badge-fill text-primary"></i>
                    <span>Giấy tờ tùy thân bắt buộc</span>
                </div>
                <ul class="reg-list">
                    <li>Bản gốc CCCD gắn chip hoặc Hộ chiếu còn hạn sử dụng (trùng khớp 100% hồ sơ đăng ký).</li>
                    <li>Email xác nhận số báo danh và thời gian ca thi chính thức.</li>
                    <li>Ảnh thẻ chuẩn 3x4 hoặc 4x6 chụp trong vòng 6 tháng (nếu điểm thi trên giấy yêu cầu).</li>
                    <li><strong>Lưu ý:</strong> Không chấp nhận bản sao công chứng, hình chụp điện thoại hay bằng lái xe.</li>
                </ul>
            </div>

            <div class="reg-box box-permitted">
                <div class="reg-box-title">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span>Vật dụng được phép mang vào</span>
                </div>
                <ul class="reg-list">
                    <li>Giấy tờ tùy thân hợp lệ theo quy định.</li>
                    <li>Chai nước suối nhựa trong suốt đã bóc sạch 100% nhãn mác bao bì.</li>
                    <li>Áo khoác đơn giản không mũ (phải cởi ra để giám thị kiểm tra trước khi vào phòng).</li>
                    <li>Thuốc đặc trị cá nhân có giấy chỉ định của bác sĩ (cần báo trước giám thị).</li>
                </ul>
            </div>

            <div class="reg-box box-prohibited">
                <div class="reg-box-title">
                    <i class="bi bi-slash-circle-fill text-danger"></i>
                    <span>Vật dụng bị cấm tuyệt đối</span>
                </div>
                <ul class="reg-list">
                    <li>Mọi loại đồng hồ: đồng hồ thông minh, đồng hồ điện tử và cả đồng hồ cơ truyền thống.</li>
                    <li>Thiết bị điện tử: điện thoại di động, tai nghe Bluetooth, máy ghi âm, bút camera.</li>
                    <li>Bút viết riêng, gôm tẩy riêng, giấy nháp (Hội đồng thi phát đồng bộ tại phòng).</li>
                    <li>Ví tiền, tư trang kim loại kích thước lớn, chìa khóa có điều khiển từ xa.</li>
                </ul>
            </div>

            <div class="reg-box box-timeline">
                <div class="reg-box-title">
                    <i class="bi bi-stopwatch-fill text-warning"></i>
                    <span>Quy trình &amp; Mốc thời gian</span>
                </div>
                <ul class="reg-list">
                    <li>Có mặt tại điểm thi trước giờ làm bài tối thiểu <strong>45 - 60 phút</strong> để gửi đồ và chụp ảnh nhận diện.</li>
                    <li>Cửa phòng thi đóng chính xác <strong>15 phút</strong> trước giờ làm bài. Đến muộn sẽ bị hủy thi và mất lệ phí.</li>
                    <li>Phần thi Khẩu ngữ (Speaking / HSKK): có mặt trước giờ hẹn tối thiểu <strong>30 phút</strong> tại phòng chờ.</li>
                    <li>Kết quả thi máy trả sau 10 - 14 ngày; thi trên giấy trả sau khoảng 30 ngày.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
/* ── EXAM HUB STYLES (Compatible with --ig-* tokens) ── */
.exam-hub-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 16px 64px;
    color: var(--ig-text, #0f172a);
}

/* ── HERO ── */
.exam-hub-hero {
    text-align: center;
    padding: 36px 20px 28px;
    margin-bottom: 28px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.08) 0%, rgba(220, 38, 38, 0.08) 100%);
    border: 1px solid var(--ig-border, #e2e8f0);
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #0284c7;
    margin-bottom: 12px;
}

.badge-dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
    animation: pulseDot 2s infinite;
}

@@keyframes pulseDot {
    0% { transform: scale(0.95); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.8; }
    100% { transform: scale(0.95); opacity: 1; }
}

.hero-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    background: linear-gradient(135deg, var(--ig-text, #0f172a) 40%, #0284c7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-desc {
