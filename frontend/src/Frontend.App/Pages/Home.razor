    <!-- 5. FAQ Section -->
    <section id="homeFaqSection" class="home-section faq-section">
        <div class="section-container">
            <div class="section-header">
                <span class="section-badge">Hỏi &amp; Đáp</span>
                <h2 class="section-title">Câu Hỏi Thường Gặp</h2>
                <p class="section-subtitle">Mọi giải đáp về hệ thống ôn luyện và kỳ thi chuẩn hóa quốc tế.</p>
