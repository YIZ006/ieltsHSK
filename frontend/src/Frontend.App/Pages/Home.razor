                    <div class="stat-desc">Phân tích chi tiết ngữ pháp, phát âm và từ vựng</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon stat-emerald"><i class="bi bi-fire"></i></div>
                    <div class="stat-number">98.6%</div>
                    <div class="stat-label">Học viên đạt mục tiêu</div>
