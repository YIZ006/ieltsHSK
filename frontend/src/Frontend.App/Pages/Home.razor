                </div>
            </div>
        </div>
    </section>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    (function() {
                        const container = document.getElementById('homeLandingContainer') || document.querySelector('.landing-container');
                        if (!container) return;

                        if (window._homeMouseMoveHandler) {
                            window.removeEventListener('mousemove', window._homeMouseMoveHandler);
                        }

                        window._homeMouseMoveHandler = function(e) {
                            const rect = container.getBoundingClientRect();
                            if (!rect.width || !rect.height) return;

                            const mouseX = e.clientX - rect.left;
                            const mouseY = e.clientY - rect.top;
                            const pctX = Math.max(0, Math.min(100, (mouseX / rect.width) * 100));
                            const pctY = Math.max(0, Math.min(100, (mouseY / rect.height) * 100));

                            const normX = (mouseX - rect.width / 2) / (rect.width / 2);
                            const normY = (mouseY - rect.height / 2) / (rect.height / 2);

                            // Clamped 3D tilt angles between -14deg and 14deg
                            const rotX = Math.max(Math.min(-normY * 14, 14), -14);
                            const rotY = Math.max(Math.min(normX * 14, 14), -14);

                            container.style.setProperty('--rot-x', rotX.toFixed(2) + 'deg');
                            container.style.setProperty('--rot-y', rotY.toFixed(2) + 'deg');
                            container.style.setProperty('--mouse-x', (normX * 36).toFixed(2) + 'px');
                            container.style.setProperty('--mouse-y', (normY * 36).toFixed(2) + 'px');
                            container.style.setProperty('--mouse-x-pct', pctX.toFixed(1) + '%');
                            container.style.setProperty('--mouse-y-pct', pctY.toFixed(1) + '%');
                        };

                        window.addEventListener('mousemove', window._homeMouseMoveHandler, { passive: true });
                    })();
                ");
            }
            catch { }
        }
    }

    private async Task ScrollDownAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToElementId", "homeFeaturesSection");
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (window._homeMouseMoveHandler) {
                    window.removeEventListener('mousemove', window._homeMouseMoveHandler);
                    window._homeMouseMoveHandler = null;
                }
            ");
        }
        catch { }
    }
}
