@page "/"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@implements IAsyncDisposable

<PageTitle>Master Your Languages - IELTS & HSK</PageTitle>

<HomeDocNav />

<div id="homeLandingContainer" class="landing-container" style="--rot-x: 0deg; --rot-y: 0deg; --mouse-x: 0px; --mouse-y: 0px; --mouse-x-pct: 50%; --mouse-y-pct: 45%;">
    <!-- Ambient Volumetric Lights -->
    <div class="ambient-beam beam-1"></div>
    <div class="ambient-beam beam-2"></div>

    <div class="header">
        <h1 class="main-title">Master Your Languages</h1>
        <p class="subtitle">Your ultimate platform for IELTS and HSK preparation. Choose your path and start learning today.</p>
    </div>

    <!-- 3D Perspective Stage -->
    <div class="cards-stage">
        <!-- Ambient Stage Grid (Faint grid visible through the frosted glass) -->
        <div class="stage-ambient-grid"></div>

        <div class="cards-tilt-rig">
            <!-- IELTS Monolith Card Rig -->
            <div class="card-rig-item">
                <!-- Glowing Aurora Orb behind the glass -->
                <div class="card-backdrop-orb ielts-backdrop-orb"></div>

                <a href="/ielts/dashboard" class="monolith-card ielts-card" @onclick='() => NavManager.NavigateTo("/ielts/dashboard")'>
                    <div class="card-glass-specular"></div>
                    <div class="card-dynamic-spotlight"></div>
                    <div class="card-mirror-flare"></div>
                    <div class="card-glow-overlay"></div>
                    <div class="card-content">
                        <div class="card-badge ielts-badge">
                            <i class="bi bi-patch-check-fill me-1"></i> ENGLISH (IELTS)
                        </div>
                        <div class="icon-orb ielts-orb">
                            <i class="bi bi-book"></i>
                        </div>
                        <h2>English (IELTS)</h2>
                        <p>Comprehensive resources, practice tests, and vocabulary for IELTS preparation.</p>
                        <div class="explore-btn ielts-btn">
                            <span>Explore IELTS</span>
                            <span class="btn-arrow">→</span>
                        </div>
                    </div>
                </a>

                <!-- Ground Light Cast & Dynamic Shadow (Exact from user React code) -->
                <div class="ground-light-cast ielts-ground-glow"></div>
                <div class="ground-shadow"></div>
            </div>

            <!-- HSK Monolith Card Rig -->
            <div class="card-rig-item">
                <!-- Glowing Aurora Orb behind the glass -->
                <div class="card-backdrop-orb hsk-backdrop-orb"></div>

                <a href="/hsk" class="monolith-card hsk-card" @onclick='() => NavManager.NavigateTo("/hsk")'>
                    <div class="card-glass-specular"></div>
                    <div class="card-dynamic-spotlight"></div>
                    <div class="card-mirror-flare"></div>
                    <div class="card-glow-overlay"></div>
                    <div class="card-content">
                        <div class="card-badge hsk-badge">
                            <i class="bi bi-translate me-1"></i> CHINESE (HSK)
                        </div>
                        <div class="icon-orb hsk-orb">
                            <i class="bi bi-translate"></i>
                        </div>
                        <h2>Chinese (HSK)</h2>
                        <p>HSK 3.0 (1-9 levels) full practice tests, vocabulary lists, and learning tools for your Chinese journey.</p>
                        <div class="explore-btn hsk-btn">
                            <span>Explore HSK</span>
                            <span class="btn-arrow">→</span>
                        </div>
                    </div>
                </a>

                <!-- Ground Light Cast & Dynamic Shadow (Exact from user React code) -->
                <div class="ground-light-cast hsk-ground-glow"></div>
                <div class="ground-shadow"></div>
            </div>
        </div>
    </div>

    <!-- Liquid Water Droplet Scroll Down Indicator (Thanh kéo cuộn giọt nước di chuyển xuống dần) -->
    <div class="water-drop-scroll-indicator" @onclick="ScrollDownAsync" role="button" tabindex="0" title="Cuộn xuống khám phá" @onkeydown="@(async e => { if (e.Key == "Enter" || e.Key == " ") await ScrollDownAsync(); })">
        <div class="water-drop-capsule">
            <div class="water-drop-groove"></div>
            <div class="water-droplet"></div>
            <div class="water-drop-splash"></div>
        </div>
        <div class="water-drop-label">
            <span>Cuộn xuống</span>
            <i class="bi bi-chevron-down"></i>
        </div>
    </div>
</div>

<!-- CÁC SECTION DỮ LIỆU MẪU DÀI ĐỂ REVIEW THANH CUỘN GIỌT NƯỚC (DROPLET SCROLLBAR) -->
