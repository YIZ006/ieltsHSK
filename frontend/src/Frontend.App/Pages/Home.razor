@page "/"
<PageTitle>Master Your Languages - IELTS & HSK</PageTitle>

<div class="landing-container">
    <div class="header">
        <h1 class="main-title">Master Your Languages</h1>
        <p class="subtitle">Your ultimate platform for IELTS and HSK preparation. Choose your path and start learning today.</p>
    </div>

    <div class="cards-wrapper">
        <!-- IELTS Card -->
        <a href="/ielts" class="path-card ielts-card">
            <div class="card-content">
                <div class="icon-wrapper ielts-icon">
                    <i class="bi bi-book"></i>
                </div>
                <h2>English (IELTS)</h2>
                <p>Comprehensive resources, practice tests, and vocabulary for IELTS preparation.</p>
                <div class="explore-btn">Explore IELTS</div>
            </div>
        </a>

        <!-- TOEIC Card -->
        <a href="/toeic" class="path-card toeic-card">
            <div class="card-content">
                <div class="icon-wrapper toeic-icon">
                    <i class="bi bi-headset"></i>
                </div>
                <h2>English (TOEIC)</h2>
                <p>Prepare for TOEIC Listening & Reading with full practice tests and immediate scoring.</p>
                <div class="explore-btn">Explore TOEIC</div>
            </div>
        </a>

        <!-- HSK Card -->
        <a href="/hsk" class="path-card hsk-card">
            <div class="card-content">
                <div class="icon-wrapper hsk-icon">
                    <i class="bi bi-translate"></i>
                </div>
                <h2>Chinese (HSK)</h2>
                <p>HSK 3.0 (1-9 levels) full practice tests, vocabulary lists, and learning tools for your Chinese journey.</p>
                <div class="explore-btn">Explore HSK</div>
            </div>
        </a>
    </div>
</div>
