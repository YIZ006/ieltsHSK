    private async Task LoadSavedVoicePrefsAsync()
    {
        try
        {
            var savedLeft = await JS.InvokeAsync<string?>("localStorage.getItem", "hsk_chengyu_voice_left");
            var savedRight = await JS.InvokeAsync<string?>("localStorage.getItem", "hsk_chengyu_voice_right");
            if (int.TryParse(savedLeft, out var lId) && lId >= 1 && lId <= 10) leftVoiceId = lId;
            if (int.TryParse(savedRight, out var rId) && rId >= 1 && rId <= 10) rightVoiceId = rId;
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            allItems = await ChengyuService.GetAllIdiomsAsync();
            CalculateStats();
            ApplyFilter();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStats()
    {
        learnedCount = allItems.Count(x => x.IsLearned);
        learnedPercent = allItems.Count > 0 ? (int)Math.Round((double)learnedCount * 100 / allItems.Count) : 0;
        hsk4Count = allItems.Count(x => x.HskLevel.Contains("4"));
        hsk5Count = allItems.Count(x => x.HskLevel.Contains("5"));
        hsk6Count = allItems.Count(x => x.HskLevel.Contains("6"));
    }

    private void ApplyFilter()
    {
        var query = allItems.AsEnumerable();

        if (selectedLevel != "all")
        {
            query = query.Where(x => x.HskLevel.Equals(selectedLevel, StringComparison.OrdinalIgnoreCase) ||
                                     x.HskLevel.Replace(" ", "").Equals(selectedLevel.Replace(" ", ""), StringComparison.OrdinalIgnoreCase));
        }

        if (hideLearned)
        {
            query = query.Where(x => !x.IsLearned);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var s = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(x =>
                x.Hanzi.ToLowerInvariant().Contains(s) ||
                x.Pinyin.ToLowerInvariant().Contains(s) ||
                x.HanViet.ToLowerInvariant().Contains(s) ||
                x.ShortMeaningVi.ToLowerInvariant().Contains(s) ||
                x.MeaningVi.ToLowerInvariant().Contains(s) ||
                (x.OriginStory != null && x.OriginStory.ToLowerInvariant().Contains(s)) ||
                (x.WechatChat != null && x.WechatChat.Messages.Any(m => m.Zh.ToLowerInvariant().Contains(s) || m.Vi.ToLowerInvariant().Contains(s))));
        }

        filteredItems = query.ToList();
        if (selectedStudioIndex >= filteredItems.Count) selectedStudioIndex = 0;
        if (currentCardIndex >= filteredItems.Count) currentCardIndex = 0;
        ResetSimToFull();
    }

