                <div class="vd-pair-card pair-left">
                    <div class="vd-pair-avatar-wrap">
                        <img src="/images/avatar-wet-cat.jpg" alt="Left" class="vd-pair-avatar" />
                        <span class="vd-side-tag tag-left">Bạn Trái (小雨)</span>
                    </div>
                    <div class="vd-pair-info">
                        <div class="vd-pair-label">GIỌNG ĐANG CHỌN CHO NGƯỜI BÊN TRÁI:</div>
                        <div class="vd-pair-name">@leftPreset.Name</div>
                        <div class="vd-pair-meta">@leftPreset.TechSpec</div>
                    </div>
                    <button type="button" class="btn-vd-test-side" @onclick="() => SpeakWithPresetId(leftVoiceId, demoSampleSentence1)">
                        <i class="bi bi-volume-up-fill"></i> Nghe Bạn Trái
                    </button>
                </div>

                <div class="vd-pair-card pair-right">
                    <div class="vd-pair-avatar-wrap">
                        <img src="/images/avatar-crying-cat.jpg" alt="Right" class="vd-pair-avatar" />
                        <span class="vd-side-tag tag-right">Bạn Phải (阿明)</span>
                    </div>
                    <div class="vd-pair-info">
                        <div class="vd-pair-label">GIỌNG ĐANG CHỌN CHO NGƯỜI BÊN PHẢI (MÈO ÁO ĐỎ):</div>
                        <div class="vd-pair-name">@rightPreset.Name</div>
                        <div class="vd-pair-meta">@rightPreset.TechSpec</div>
                    </div>
                    <button type="button" class="btn-vd-test-side btn-rose" @onclick="() => SpeakWithPresetId(rightVoiceId, demoSampleSentence2)">
                        <i class="bi bi-volume-up-fill"></i> Nghe Bạn Phải
                    </button>
                </div>
            </div>

            @* Custom Sample Sentence Bar *@
            <div class="vd-custom-input-bar">
                <span class="vd-input-lbl"><i class="bi bi-chat-square-text-fill text-danger"></i> Câu mẫu thử giọng:</span>
                <input type="text" class="vd-custom-input" @bind="demoCustomText" placeholder="Nhập câu tiếng Trung bất kỳ để thử..." />
                <button type="button" class="btn-vd-sample-chip" @onclick='() => demoCustomText = "听说你们部门下个月取消双休，这简直不可思议！"'>
                    Mẫu 1 (Ngạc nhiên)
                </button>
                <button type="button" class="btn-vd-sample-chip" @onclick='() => demoCustomText = "别听他们胡说八道！经理刚开会说今年福利增加呢。"'>
                    Mẫu 2 (Phản bác)
                </button>
                <button type="button" class="btn-vd-sample-chip" @onclick='() => demoCustomText = "只要我们一心一意，水滴石穿，就一定能心想事成！"'>
                    Mẫu 3 (Thành ngữ)
                </button>
            </div>

            @* 10 Female Voices Grid *@
            <div class="vd-grid-10">
                @foreach (var vp in femaleVoicePresets)
                {
                    var isLeftSel = (vp.Id == leftVoiceId);
                    var isRightSel = (vp.Id == rightVoiceId);
                    var isTestingNow = (activeTestingPresetId == vp.Id);

                    <div class="vd-voice-card @(isLeftSel || isRightSel ? "vd-card-selected" : "") @(isTestingNow ? "vd-card-playing" : "")">
                        <div class="vd-card-top">
                            <div class="vd-num-badge">#@vp.Id.ToString("D2")</div>
                            <div class="vd-card-title-group">
                                <h3 class="vd-card-name">@vp.Name</h3>
                                <span class="vd-style-pill">@vp.StyleTag</span>
                            </div>
                        </div>

                        <p class="vd-card-desc">@vp.Description</p>
                        <div class="vd-tech-spec">
                            <i class="bi bi-sliders"></i> @vp.TechSpec
                        </div>

                        <div class="vd-test-btns-row">
                            <button type="button"
                                    class="btn-vd-listen"
                                    @onclick="() => SpeakWithPresetId(vp.Id, demoCustomText)">
                                <i class="bi bi-volume-up-fill"></i> Nghe câu thử
                            </button>
                            <button type="button"
                                    class="btn-vd-listen-alt"
                                    @onclick="() => SpeakWithPresetId(vp.Id, vp.SampleZh)"
                                    title="@vp.SampleZh">
                                <i class="bi bi-chat-dots-fill"></i> Nghe câu riêng
                            </button>
                        </div>

                        <div class="vd-sample-quote">
                            “@vp.SampleZh”
                        </div>

                        <div class="vd-assign-row">
                            <button type="button"
                                    class="btn-vd-assign @(isLeftSel ? "assigned-left" : "")"
                                    @onclick="() => SelectVoiceForSide(vp.Id, true)">
                                <i class="bi @(isLeftSel ? "bi-check-circle-fill" : "bi-arrow-left-circle")"></i>
                                @(isLeftSel ? "Đang dùng: Bạn Trái" : "Chọn cho Bạn Trái")
                            </button>
                            <button type="button"
                                    class="btn-vd-assign @(isRightSel ? "assigned-right" : "")"
                                    @onclick="() => SelectVoiceForSide(vp.Id, false)">
                                <i class="bi @(isRightSel ? "bi-check-circle-fill" : "bi-arrow-right-circle")"></i>
                                @(isRightSel ? "Đang dùng: Bạn Phải" : "Chọn cho Bạn Phải")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (viewMode == "flashcard")
    {
        @* ── FLASHCARD REVIEW MODE ── *@
        <div class="flashcard-container">
            <div class="flashcard-header">
                <span>Thẻ @(currentCardIndex + 1) / @filteredItems.Count</span>
                <span class="badge bg-danger">@CurrentCard.HskLevel</span>
            </div>

            <div class="flashcard-box @(isCardFlipped ? "flipped" : "")" @onclick="FlipCard">
                @if (!isCardFlipped)
                {
                    <div class="card-face front">
                        <div class="fc-hanzi">@CurrentCard.Hanzi</div>
                        <div class="fc-hint">Chạm vào thẻ để lật xem chiết tự, nghĩa &amp; hội thoại</div>
                    </div>
                }
                else
                {
                    <div class="card-face back">
                        <div class="fc-hanzi-sm">@CurrentCard.Hanzi</div>
                        <div class="fc-pinyin">@CurrentCard.Pinyin</div>
                        <div class="fc-hanviet">[@CurrentCard.HanViet] — @GetShortVi(CurrentCard)</div>
                        <div class="fc-meaning">@CurrentCard.MeaningVi</div>
                        <button class="btn btn-sm btn-outline-danger mt-2" @onclick:stopPropagation="true" @onclick='() => SpeakYouthText(CurrentCard.Hanzi, "left")'>
                            <i class="bi bi-volume-up-fill"></i> Nghe phát âm thanh niên
                        </button>
                    </div>
                }
            </div>

            <div class="flashcard-nav">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="PrevCard" disabled="@(currentCardIndex == 0)">
                    <i class="bi bi-chevron-left"></i> Câu trước
                </button>
                <button type="button" class="btn btn-success btn-sm" @onclick="() => ToggleLearned(CurrentCard)">
                    <i class="bi @(CurrentCard.IsLearned ? "bi-check-circle-fill" : "bi-check-circle")"></i>
                    @(CurrentCard.IsLearned ? "Đã thuộc" : "Đánh dấu đã thuộc")
                </button>
                <button type="button" class="btn btn-danger btn-sm" @onclick="NextCard" disabled="@(currentCardIndex >= filteredItems.Count - 1)">
                    Câu sau <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        @* ── FULL CARDS STACK MODE ── *@
        <div class="chengyu-cards-stack">
            @foreach (var item in filteredItems)
            {
                <div class="chengyu-card" id="@item.Id">
                    <div class="card-top-bar">
                        <div class="card-meta">
                            <span class="level-badge @GetLevelBadgeClass(item.HskLevel)">@item.HskLevel</span>
                            @if (!string.IsNullOrWhiteSpace(item.CategoryVi))
                            {
                                <span class="cat-badge">@item.CategoryVi</span>
                            }
                            <span class="hot-badge"><i class="bi bi-star-fill text-warning"></i> @item.PopularityScore% Đề thi</span>
                        </div>

                        <div class="card-actions">
                            <button type="button"
                                    class="action-btn audio-btn"
                                    @onclick='() => SpeakYouthText(item.Hanzi, "left")'
                                    title="Nghe phát âm chuẩn">
                                <i class="bi bi-volume-up-fill"></i>
                            </button>
                            <button type="button"
                                    class="action-btn fav-btn @(item.IsFavorite ? "active" : "")"
                                    @onclick="() => ToggleFavorite(item)"
                                    title="Lưu yêu thích">
                                <i class="bi @(item.IsFavorite ? "bi-star-fill text-warning" : "bi-star")"></i>
                            </button>
                            <button type="button"
                                    class="action-btn-check @(item.IsLearned ? "learned" : "")"
                                    @onclick="() => ToggleLearned(item)">
                                <i class="bi @(item.IsLearned ? "bi-check2-circle" : "bi-circle")"></i>
                                <span>@(item.IsLearned ? "Đã thuộc" : "Đánh dấu đã thuộc")</span>
                            </button>
                        </div>
                    </div>

                    <div class="card-heading-row">
                        <h2 class="card-hanzi">@item.Hanzi</h2>
                        <div class="card-phonetic">
                            @if (showPinyin)
                            {
                                <span class="card-pinyin">@item.Pinyin</span>
                            }
                            <span class="card-hanviet">[@item.HanViet] — @GetShortVi(item)</span>
                        </div>
                    </div>

                    <div class="card-split-grid">
                        <div class="col-details">
                            <div class="char-grid-4 mb-2">
                                @foreach (var ch in GetCharBreakdown(item))
                                {
                                    <div class="char-card" @onclick='() => SpeakYouthText(ch.Char, "left")'>
                                        @if (showPinyin)
                                        {
                                            <div class="char-py">@ch.Pinyin</div>
                                        }
                                        <div class="char-hz">@ch.Char</div>
                                        <div class="char-hv">@ch.HanViet</div>
                                        <div class="char-vi">@ch.MeaningVi</div>
                                    </div>
                                }
                            </div>

                            <div class="section-box meaning-box">
                                <div class="sec-title text-danger">
                                    <span class="sec-num bg-danger">1</span> Ý Nghĩa &amp; Ngữ Cảnh Sử Dụng
                                </div>
                                <div class="meaning-text">
                                    ▸ <strong>@item.MeaningVi</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.OriginStory))
                                {
                                    <div class="origin-story-box">
                                        <div class="origin-label"><i class="bi bi-book-half"></i> Nguồn gốc điển cố lịch sử (典故):</div>
                                        <p class="origin-desc">@item.OriginStory</p>
                                    </div>
                                }
                            </div>

                            @if (item.HskExamples != null && item.HskExamples.Count > 0)
                            {
                                <div class="section-box examples-box">
                                    <div class="sec-title text-primary">
                                        <span class="sec-num bg-primary">2</span> Ví Dụ Bài Học Chuẩn Đề Thi HSK
                                    </div>
                                    <div class="examples-list">
                                        @foreach (var ex in item.HskExamples)
                                        {
                                            <div class="example-item">
                                                <div class="ex-zh-row">
                                                    <span class="ex-zh">@ex.Zh</span>
                                                    <button type="button" class="btn-play-sm" @onclick='() => SpeakYouthText(ex.Zh, "right")'>
                                                        <i class="bi bi-volume-up-fill"></i>
                                                    </button>
                                                </div>
                                                @if (showPinyin)
                                                {
                                                    <div class="ex-pinyin">@ex.Pinyin</div>
                                                }
                                                <div class="ex-vi"><strong class="ex-vi-lbl">Dịch nghĩa:</strong> @ex.Vi</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-wechat">
                            <div class="wechat-header-meta">
                                <div class="sec-title text-success">
                                    <span class="sec-num bg-success">3</span> Hội Thoại WeChat Thực Tế
                                </div>
                                <span class="badge-wechat-hint">Bấm từ để nghe • Bấm câu để dịch</span>
                            </div>

                            @if (item.WechatChat != null && item.WechatChat.Messages.Count > 0)
                            {
                                <div class="wechat-phone-frame">
                                    <div class="wechat-topbar">
                                        <div class="wb-back"><i class="bi bi-chevron-left"></i></div>
                                        <div class="wb-contact">@item.WechatChat.ContactName</div>
                                        <div class="wb-more">•••</div>
                                    </div>

                                    <div class="wechat-chat-body">
                                        <div class="wechat-timestamp">@item.WechatChat.Timestamp</div>

                                        @foreach (var msg in item.WechatChat.Messages)
                                        {
                                            var isLeft = msg.Sender.Equals("left", StringComparison.OrdinalIgnoreCase);
                                            var avatar = isLeft ? item.WechatChat.AvatarLeft : item.WechatChat.AvatarRight;

                                            <div class="wechat-msg-row @(isLeft ? "row-left" : "row-right")">
                                                <img src="@avatar" alt="Avatar" class="msg-avatar" @onclick="() => SpeakWechatSingleMessage(msg)" />

                                                <div class="msg-bubble-wrap">
                                                    <div class="wechat-bubble @(isLeft ? "bubble-white" : "bubble-green")"
                                                         @onclick="() => ToggleMessageDropdown(msg)">
                                                        @if (wordByWordMode && msg.Words != null && msg.Words.Count > 0)
                                                        {
                                                            <div class="word-chips-container">
                                                                @foreach (var w in msg.Words)
                                                                {
                                                                    <span class="wechat-word-chip @(w.IsIdiom ? "chip-idiom" : "")"
                                                                          @onclick:stopPropagation="true"
                                                                          @onclick="() => SpeakYouthText(w.Word, msg.Sender)">
                                                                        @if (showPinyin)
                                                                        {
                                                                            <span class="chip-py">@w.Pinyin</span>
                                                                        }
                                                                        <span class="chip-hz">@w.Word</span>
                                                                        <span class="chip-vi">@w.MeaningVi</span>
                                                                    </span>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span>@RenderHighlightedSentence(msg.Zh, msg.HighlightIdiom ?? item.Hanzi)</span>
                                                        }
                                                    </div>

                                                    @if (msg.IsTranslationOpen || globalShowTrans)
                                                    {
                                                        <div class="wechat-dropdown-trans animate-slide-down">
                                                            <div class="drop-vi">💬 @msg.Vi</div>
                                                            <div class="drop-actions">
                                                                <button type="button" class="btn-drop-speak" @onclick:stopPropagation="true" @onclick="() => SpeakWechatSingleMessage(msg)">
                                                                    <i class="bi bi-volume-up-fill"></i> Nghe câu này
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="wechat-card-footer">
                                        <button type="button" class="btn-chat-tool" @onclick="() => SpeakFullDialogueWithYouthVoices(item.WechatChat)">
                                            <i class="bi bi-play-circle-fill text-success"></i> Nghe 2 thanh niên chat
                                        </button>
                                        <button type="button" class="btn-chat-tool" @onclick="() => ToggleCardTranslations(item)">
                                            <i class="bi bi-translate text-primary"></i> @(IsAnyTransOpen(item) ? "Thu gọn dịch" : "Xổ tất cả dịch")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
