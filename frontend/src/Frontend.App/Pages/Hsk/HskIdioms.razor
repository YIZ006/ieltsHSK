    }

    // Helper functions
    private string GetShortVi(ChengyuItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.ShortMeaningVi)) return item.ShortMeaningVi;
        if (string.IsNullOrWhiteSpace(item.MeaningVi)) return "";
        var colonIdx = item.MeaningVi.IndexOf(':');
        if (colonIdx > 0 && colonIdx <= 35) return item.MeaningVi[..colonIdx].Trim();
        return item.MeaningVi.Length > 28 ? item.MeaningVi[..28] + "..." : item.MeaningVi;
    }

    private List<ChengyuCharItem> GetCharBreakdown(ChengyuItem item)
    {
        if (item.CharBreakdown != null && item.CharBreakdown.Count > 0)
            return item.CharBreakdown;

        var chars = item.Hanzi.ToCharArray();
        var pys = (item.Pinyin ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var hvs = (item.HanViet ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var list = new List<ChengyuCharItem>();
        for (int i = 0; i < chars.Length; i++)
        {
            list.Add(new ChengyuCharItem
            {
                Char = chars[i].ToString(),
                Pinyin = i < pys.Length ? pys[i] : "",
                HanViet = i < hvs.Length ? hvs[i] : "",
                MeaningVi = "Chữ thành phần"
            });
        }
        return list;
    }

    private MarkupString RenderHighlightedSentence(string sentence, string idiom)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(sentence);
        var encodedIdiom = System.Net.WebUtility.HtmlEncode(idiom);
        if (!string.IsNullOrWhiteSpace(encodedIdiom) && encoded.Contains(encodedIdiom))
        {
            encoded = encoded.Replace(encodedIdiom, $"<span class=\"idiom-inline-highlight\">{encodedIdiom}</span>");
        }
        return new MarkupString(encoded);
    }

    private string TruncateText(string text, int maxLen)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLen ? text : text[..maxLen] + "...";
    }

    // Flashcard functions
    private void FlipCard() => isCardFlipped = !isCardFlipped;
    private void PrevCard()
    {
        if (currentCardIndex > 0)
        {
            currentCardIndex--;
            isCardFlipped = false;
        }
    }
    private void NextCard()
    {
        if (currentCardIndex < filteredItems.Count - 1)
        {
            currentCardIndex++;
            isCardFlipped = false;
        }
    }

    private string GetLevelBadgeClass(string lvl)
    {
        if (lvl.Contains("4")) return "badge-hsk4";
        if (lvl.Contains("5")) return "badge-hsk5";
        if (lvl.Contains("6")) return "badge-hsk6";
        return "badge-hsk-other";
    }

    public void Dispose()
    {
        StopLiveSimulation();
    }
}
