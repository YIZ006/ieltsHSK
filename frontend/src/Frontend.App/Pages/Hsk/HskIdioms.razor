    // ── LIVE WECHAT SIMULATION (TYPING + DUAL YOUTH VOICE) ──
    private async Task StartLiveSimulation(ChengyuItem item)
    {
        if (item.WechatChat == null || item.WechatChat.Messages.Count == 0) return;

        StopLiveSimulation();
        simCts = new CancellationTokenSource();
        var token = simCts.Token;

        isSimPlaying = true;
        simVisibleCount = 0;
        StateHasChanged();

        try
        {
            var msgs = item.WechatChat.Messages;
            for (int i = 0; i < msgs.Count; i++)
            {
                token.ThrowIfCancellationRequested();

                // 1. Show "对方正在输入..." typing indicator
                isTypingIndicatorVisible = true;
                activeSpeakingMsgId = null;
                StateHasChanged();

                await Task.Delay(700, token);
                token.ThrowIfCancellationRequested();

                // 2. Pop message in & speak with that youth speaker's voice
                isTypingIndicatorVisible = false;
                simVisibleCount = i + 1;
                var msg = msgs[i];
                msg.IsTranslationOpen = true;
                activeSpeakingMsgId = msg.Id;
                StateHasChanged();

                await SpeakYouthText(msg.Zh, msg.Sender);

                // Estimate reading time based on Chinese character count (~210ms per char + 600ms buffer)
                var cleanLen = Math.Max(4, msg.Zh.Length);
                var waitMs = Math.Clamp(cleanLen * 210 + 550, 1800, 5200);
                await Task.Delay(waitMs, token);
            }
        }
        catch (TaskCanceledException)
        {
            // Stopped by user
        }
        finally
        {
            isTypingIndicatorVisible = false;
            activeSpeakingMsgId = null;
            isSimPlaying = false;
            StateHasChanged();
        }
    }

    private void StopLiveSimulation()
    {
        if (simCts != null)
        {
            simCts.Cancel();
            simCts.Dispose();
            simCts = null;
        }
        isSimPlaying = false;
        isTypingIndicatorVisible = false;
        activeSpeakingMsgId = null;
        _ = CancelSpeechAsync();
    }

    private async Task StepNextSimMessage(WechatChatModel chat)
    {
        StopLiveSimulation();
        if (simVisibleCount >= chat.Messages.Count)
        {
            simVisibleCount = 1;
        }
        else
        {
            simVisibleCount++;
        }
        var currentMsg = chat.Messages[simVisibleCount - 1];
        currentMsg.IsTranslationOpen = true;
        activeSpeakingMsgId = currentMsg.Id;
        await SpeakYouthText(currentMsg.Zh, currentMsg.Sender);
    }

