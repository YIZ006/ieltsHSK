    private async Task SpeakWithPresetId(int presetId, string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        activeTestingPresetId = presetId;
        try
        {
            var preset = GetVoicePreset(presetId);
            var rawJson = System.Text.Json.JsonSerializer.Serialize(text);
            var prefJson = System.Text.Json.JsonSerializer.Serialize(preset.EnginePref);
            var pitchStr = preset.Pitch.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var rateStr = preset.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture);

            var jsCode = $@"
                (function() {{
                    if (!('speechSynthesis' in window)) return;
                    if (window._chengyuSpeakTimer) clearTimeout(window._chengyuSpeakTimer);
                    window.speechSynthesis.cancel();

                    var raw = {rawJson};
                    var clean = raw.replace(/[\u{{1F300}}-\u{{1FAFF}}\u{{2600}}-\u{{27BF}}]/gu, '').trim();
                    if (!clean) return;

                    var pref = {prefJson};
                    var targetPitch = {pitchStr};
                    var targetRate = {rateStr};

                    window._chengyuSpeakTimer = setTimeout(function() {{
                        var allVoices = window.speechSynthesis.getVoices() || [];
                        // Chỉ lấy giọng Quan Thoại (zh-CN / zh-TW), tuyệt đối loại bỏ tiếng Quảng Đông (zh-HK / Cantonese)
                        var mandarinVoices = allVoices.filter(function(v) {{
                            if (!v.lang) return false;
                            var l = v.lang.toLowerCase();
                            if (l.indexOf('hk') !== -1 || l.indexOf('yue') !== -1 || /粤|Cantonese|Sin-ji|Tracy/i.test(v.name)) return false;
                            return l.indexOf('zh') === 0 || l.indexOf('cmn') === 0;
                        }});

                        var chosen = null;
                        if (pref === 'google_cn') {{
                            chosen = mandarinVoices.find(function(v) {{ return /Google.*普通话|Xiaoxiao|Xiaoyi|Natural/i.test(v.name); }})
                                  || mandarinVoices.find(function(v) {{ return v.lang.toLowerCase().indexOf('cn') !== -1 && !/Kangkang|Yunxi|Yunjian|Male/i.test(v.name); }})
                                  || mandarinVoices[0];
                        }} else if (pref === 'tw') {{
                            chosen = mandarinVoices.find(function(v) {{ return /Google.*國語|Taiwan|zh-TW|Hanhan|Yating|HsiaoChen/i.test(v.name + ' ' + v.lang); }})
                                  || mandarinVoices.find(function(v) {{ return /Google.*普通话|Xiaoyi/i.test(v.name); }})
                                  || mandarinVoices[0];
                        }} else if (pref === 'yaoyao') {{
                            chosen = mandarinVoices.find(function(v) {{ return /Yaoyao|Xiaoyi/i.test(v.name); }})
                                  || mandarinVoices.find(function(v) {{ return /Google.*普通话/i.test(v.name); }})
                                  || mandarinVoices[0];
                        }} else if (pref === 'huihui') {{
                            chosen = mandarinVoices.find(function(v) {{ return /Huihui|Xiaoxiao/i.test(v.name); }})
                                  || mandarinVoices.find(function(v) {{ return /Google.*普通话/i.test(v.name); }})
                                  || mandarinVoices[0];
                        }} else {{
                            chosen = mandarinVoices[0];
                        }}

                        var u = new SpeechSynthesisUtterance(clean);
                        u.lang = (pref === 'tw') ? 'zh-TW' : 'zh-CN';
                        if (chosen) {{
                            u.voice = chosen;
                            u.lang = chosen.lang || u.lang;
                        }}
                        u.pitch = targetPitch;
                        u.rate = targetRate;

                        // Giữ tham chiếu toàn cục chống lỗi Chrome V8 Garbage Collector ngắt giọng giữa chừng
                        window._activeChengyuUtterance = u;
                        window.speechSynthesis.speak(u);
                    }}, 55);
                }})();";
            await JS.InvokeVoidAsync("eval", jsCode);
        }
        catch { }
    }

    private async Task SpeakFullDialogueWithYouthVoices(WechatChatModel chat)
    {
        if (chat == null || chat.Messages.Count == 0) return;
        try
        {
            var leftP = GetVoicePreset(leftVoiceId);
            var rightP = GetVoicePreset(rightVoiceId);

            var payload = chat.Messages.Select(m =>
            {
                var isL = m.Sender.Equals("left", StringComparison.OrdinalIgnoreCase);
                var p = isL ? leftP : rightP;
                return new
                {
                    text = m.Zh,
                    pref = p.EnginePref,
                    pitch = p.Pitch,
                    rate = p.Rate
                };
            }).ToList();

            var json = System.Text.Json.JsonSerializer.Serialize(payload);

            var jsCode = $@"
                (function() {{
                    if (!('speechSynthesis' in window)) return;
                    if (window._chengyuSpeakTimer) clearTimeout(window._chengyuSpeakTimer);
                    window.speechSynthesis.cancel();

                    var items = {json};
                    var allVoices = window.speechSynthesis.getVoices() || [];
                    var mandarinVoices = allVoices.filter(function(v) {{
                        if (!v.lang) return false;
                        var l = v.lang.toLowerCase();
                        if (l.indexOf('hk') !== -1 || l.indexOf('yue') !== -1 || /粤|Cantonese|Sin-ji|Tracy/i.test(v.name)) return false;
                        return l.indexOf('zh') === 0 || l.indexOf('cmn') === 0;
                    }});

                    function pickVoice(pref) {{
                        if (pref === 'google_cn') {{
                            return mandarinVoices.find(function(v) {{ return /Google.*普通话|Xiaoxiao|Xiaoyi|Natural/i.test(v.name); }})
                                || mandarinVoices.find(function(v) {{ return v.lang.toLowerCase().indexOf('cn') !== -1 && !/Kangkang|Yunxi|Yunjian|Male/i.test(v.name); }})
                                || mandarinVoices[0];
                        }}
                        if (pref === 'tw') {{
                            return mandarinVoices.find(function(v) {{ return /Google.*國語|Taiwan|zh-TW|Hanhan|Yating|HsiaoChen/i.test(v.name + ' ' + v.lang); }})
                                || mandarinVoices.find(function(v) {{ return /Google.*普通话|Xiaoyi/i.test(v.name); }})
                                || mandarinVoices[0];
                        }}
                        if (pref === 'yaoyao') {{
                            return mandarinVoices.find(function(v) {{ return /Yaoyao|Xiaoyi/i.test(v.name); }})
                                || mandarinVoices.find(function(v) {{ return /Google.*普通话/i.test(v.name); }})
                                || mandarinVoices[0];
                        }}
                        if (pref === 'huihui') {{
                            return mandarinVoices.find(function(v) {{ return /Huihui|Xiaoxiao/i.test(v.name); }})
                                || mandarinVoices.find(function(v) {{ return /Google.*普通话/i.test(v.name); }})
                                || mandarinVoices[0];
                        }}
                        return mandarinVoices[0];
                    }}

                    var i = 0;
                    function playNext() {{
                        if (i >= items.length) return;
                        var item = items[i];
                        var clean = item.text.replace(/[\u{{1F300}}-\u{{1FAFF}}\u{{2600}}-\u{{27BF}}]/gu, '').trim();
                        var u = new SpeechSynthesisUtterance(clean);
                        var chosen = pickVoice(item.pref);
                        u.lang = (item.pref === 'tw') ? 'zh-TW' : 'zh-CN';
                        if (chosen) {{
                            u.voice = chosen;
                            u.lang = chosen.lang || u.lang;
                        }}
                        u.pitch = item.pitch;
                        u.rate = item.rate;

                        u.onend = function() {{
                            i++;
                            window._chengyuSpeakTimer = setTimeout(playNext, 380);
                        }};
                        window._activeChengyuUtterance = u;
                        window.speechSynthesis.speak(u);
                    }}
                    window._chengyuSpeakTimer = setTimeout(playNext, 65);
                }})();";
            await JS.InvokeVoidAsync("eval", jsCode);
        }
        catch { }
    }

