@page "/portal-hub/hsk-mock-tests"
@page "/admin/hsk-mock-tests"
@layout Frontend.App.Layout.AdminLayout
@using Frontend.App.Models
@using Frontend.App.Services
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@inject HskService HskService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Quản lý Đề thi HSK - Admin Hub</PageTitle>

<div class="admin-hsk-tests-page">
    <!-- Top Header -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon-badge">
                <i class="bi bi-journal-check"></i>
            </div>
            <div>
                <h1 class="page-title">Quản lý Đề thi HSK</h1>
                <p class="page-subtitle">Ngân hàng đề thi thử mô phỏng chuẩn HSK 3.0 (HSK 1 – HSK 6) kèm file âm thanh & đáp án tự động.</p>
            </div>
        </div>
        <div class="header-right">
            <button class="btn-primary-action" @onclick="() => ShowCreateModal()">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Tạo Đề thi HSK mới</span>
            </button>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="toolbar-card">
        <div class="filter-group">
            <label><i class="bi bi-funnel-fill"></i> Cấp độ:</label>
            <select class="form-select-filter" @bind="filterLevel" @bind:after="LoadTests">
                <option value="">Tất cả cấp độ (All)</option>
                <option value="HSK1">HSK 1 - Sơ cấp 1</option>
                <option value="HSK2">HSK 2 - Sơ cấp 2</option>
                <option value="HSK3">HSK 3 - Trung cấp 1</option>
                <option value="HSK4">HSK 4 - Trung cấp 2</option>
                <option value="HSK5">HSK 5 - Cao cấp 1</option>
                <option value="HSK6">HSK 6 - Cao cấp 2</option>
            </select>
        </div>

        <div class="search-box-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" placeholder="Tìm kiếm theo tiêu đề, bộ đề HSK..." @bind="searchTerm" @bind:event="oninput" @onkeyup="LoadTests" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn-clear-search" @onclick='async () => { searchTerm = ""; await LoadTests(); }'><i class="bi bi-x-lg"></i></button>
            }
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="table-card">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="custom-spinner"></div>
                <p>Đang tải danh sách đề thi HSK...</p>
            </div>
        }
        else if (tests == null || !tests.Any())
        {
            <div class="empty-state">
                <i class="bi bi-journal-x"></i>
                <h4>Chưa tìm thấy đề thi HSK nào</h4>
                <p>Thử đổi bộ lọc cấp độ hoặc bấm nút "Tạo Đề thi HSK mới" ở góc trên.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th style="width: 110px;">Cấp độ</th>
                            <th>Tiêu đề đề thi</th>
                            <th>Bộ sưu tập</th>
                            <th>Kỹ năng</th>
                            <th class="text-end" style="width: 260px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var test in tests)
                        {
                            var lvl = ExtractLevel(test.Title);
                            <tr>
                                <td><span class="id-tag">#@test.Id</span></td>
                                <td>
                                    <span class="hsk-badge hsk-badge-@GetLevelNumber(lvl)">@lvl</span>
                                </td>
                                <td>
                                    <strong class="test-title-text">@test.Title</strong>
                                </td>
                                <td>
                                    <span class="collection-tag"><i class="bi bi-collection"></i> @(string.IsNullOrEmpty(test.CollectionName) ? "Chung" : test.CollectionName)</span>
                                </td>
                                <td>
                                    <span class="skill-pill">@(test.HskUrl != null ? GetSkillFromUrl(test.HskUrl) : "Đầy đủ 4 kỹ năng")</span>
                                </td>
                                <td class="text-end">
                                    <div class="action-buttons-group">
                                        <button class="action-btn btn-edit" @onclick="() => EditTest(test)" title="Chỉnh sửa đề thi">
                                            <i class="bi bi-pencil-fill"></i> Sửa
                                        </button>
                                        @if (!string.IsNullOrEmpty(test.HskUrl))
                                        {
                                            <a href="@(test.HskUrl)" target="_blank" class="action-btn btn-view" title="Xem cấu trúc JSON">
                                                <i class="bi bi-code-slash"></i> JSON
                                            </a>
                                        }
                                        <button class="action-btn btn-delete" @onclick="() => DeleteTest(test.Id)" title="Xóa đề thi">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <span>Tổng cộng: <b>@totalCount</b> đề thi HSK</span>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- CREATE / EDIT MODAL                                                       -->
<!-- ========================================================================= -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-journal-plus text-danger fs-4"></i>
                    <h3>@(editingTest == null ? "Tạo Đề thi HSK mới" : "Chỉnh sửa Đề thi #" + editingTest.Id)</h3>
                </div>
                <button class="btn-close-modal" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Tiêu đề đề thi <span class="req">*</span></label>
                    <input type="text" class="form-input" @bind="form.Title" placeholder="VD: HSK 3 - Đề số 01 (Nghe & Đọc)" />
                </div>
                
                <div class="row g-3">
                    <div class="col-6">
                        <div class="form-group">
                            <label>Cấp độ HSK</label>
                            <select class="form-input" @bind="form.DisplayLevel">
                                <option value="HSK1">HSK 1 - Sơ cấp 1</option>
                                <option value="HSK2">HSK 2 - Sơ cấp 2</option>
                                <option value="HSK3">HSK 3 - Trung cấp 1</option>
                                <option value="HSK4">HSK 4 - Trung cấp 2</option>
                                <option value="HSK5">HSK 5 - Cao cấp 1</option>
                                <option value="HSK6">HSK 6 - Cao cấp 2</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label>Tên bộ sưu tập</label>
                            <input type="text" class="form-input" @bind="form.CollectionName" placeholder="VD: HSK 3 Chuẩn 2026" />
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <label>Đường dẫn file JSON Đề thi (Exam JSON URL)</label>
                    <input type="text" class="form-input" @bind="form.HskUrl" placeholder="/sample-data/HSK3-Sample-Reading.json hoặc R2 URL" />
                </div>

                <div class="upload-box-hsk mt-2">
                    <label class="d-block fw-bold mb-1 text-danger"><i class="bi bi-cloud-arrow-up"></i> Hoặc tải lên file JSON trực tiếp</label>
                    <InputFile OnChange="HandleFileSelected" accept=".json" class="file-input-clean" />
                    @if (!string.IsNullOrEmpty(uploadStatus))
                    {
                        <div class="mt-1 small @(uploadStatus.StartsWith("Lỗi") ? "text-danger" : "text-success")">
                            @uploadStatus
                        </div>
                    }
                    @if (isUploading)
                    {
                        <div class="mt-1 small text-muted"><span class="custom-spinner mini"></span> Đang tải lên Cloudflare R2...</div>
                    }
                </div>

                <div class="row g-2 mt-3">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="small text-muted">Listening URL (tùy chọn)</label>
                            <input type="text" class="form-input" @bind="form.ListeningUrl" placeholder="Link audio/đề nghe..." />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="small text-muted">Listening Answer Key</label>
                            <input type="text" class="form-input" @bind="form.ListeningAnswerUrl" placeholder="Link file đáp án nghe..." />
                        </div>
                    </div>
                </div>

                <div class="row g-2 mt-2">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="small text-muted">Reading URL (tùy chọn)</label>
                            <input type="text" class="form-input" @bind="form.ReadingUrl" placeholder="Link đề đọc..." />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="small text-muted">Reading Answer Key</label>
                            <input type="text" class="form-input" @bind="form.ReadingAnswerUrl" placeholder="Link file đáp án đọc..." />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                @if (editingTest != null)
                {
                    <button class="btn-modal-delete me-auto" @onclick="DeleteFromModal">
                        <i class="bi bi-trash"></i> Xóa đề này
                    </button>
                }
                <button class="btn-modal-cancel" @onclick="CloseModal">Hủy bỏ</button>
                <button class="btn-modal-save" @onclick="SaveTest">
                    <i class="bi bi-check2"></i>
                    <span>Lưu đề thi</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<MockTestDto> tests = new();
    private bool isLoading = true;
    private string filterLevel = "";
    private string searchTerm = "";
    private int totalCount = 0;

    private bool showModal = false;
    private MockTestDto? editingTest = null;
    private HskTestForm form = new();
    private bool isUploading = false;
    private string uploadStatus = "";
    private string? uploadedFileUrl = null;

    private string GetApiUrl(string path)
    {
        var baseUrl = Configuration["BackendApi:BaseUrl"] ?? "http://localhost:5101/";
        return $"{baseUrl.TrimEnd('/')}/{path.TrimStart('/')}";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTests();
    }

    private async Task LoadTests()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var apiUrl = GetApiUrl("api/hsk-mock-tests");
            var all = await Http.GetFromJsonAsync<List<MockTestDto>>(apiUrl);
            var hskTests = all ?? new();

            if (!string.IsNullOrEmpty(filterLevel))
                hskTests = hskTests.Where(t => t.Title != null && t.Title.Contains(filterLevel, StringComparison.OrdinalIgnoreCase)).ToList();

            if (!string.IsNullOrWhiteSpace(searchTerm))
                hskTests = hskTests.Where(t => (t.Title != null && t.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                               (t.CollectionName != null && t.CollectionName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))).ToList();

            tests = hskTests;
            totalCount = tests.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminHskMockTests] Load error: {ex.Message}");
        }

        isLoading = false;
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        editingTest = null;
        form = new HskTestForm();
        ResetUploadState();
        showModal = true;
    }

    private void EditTest(MockTestDto test)
    {
        editingTest = test;
        form = new HskTestForm
        {
            Title = test.Title,
            CollectionName = test.CollectionName,
            DisplayLevel = ExtractLevel(test.Title),
            HskUrl = test.HskUrl,
            ListeningUrl = test.ListeningUrl,
            ReadingUrl = test.ReadingUrl,
            WritingUrl = test.WritingUrl,
            SpeakingUrl = test.SpeakingUrl,
            ListeningAnswerUrl = test.ListeningAnswerUrl,
            ReadingAnswerUrl = test.ReadingAnswerUrl,
            WritingAnswerUrl = test.WritingAnswerUrl,
            SpeakingAnswerUrl = test.SpeakingAnswerUrl
        };
        ResetUploadState();
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingTest = null;
        ResetUploadState();
    }

    private void ResetUploadState()
    {
        isUploading = false;
        uploadStatus = "";
        uploadedFileUrl = null;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploading = true;
        uploadStatus = "Đang đọc và tải file lên...";
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var jsonContent = await reader.ReadToEndAsync();

            JsonDocument.Parse(jsonContent);

            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(System.Text.Encoding.UTF8.GetBytes(jsonContent));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
            content.Add(fileContent, "file", file.Name);

            var uploadUrl = GetApiUrl("api/hsk/upload-json");
            var response = await Http.PostAsync(uploadUrl, content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (result?.Url != null)
                {
                    uploadedFileUrl = result.Url;
                    form.HskUrl = result.Url;
                    uploadStatus = "Tải lên Cloudflare R2 thành công!";
                }
            }
            else
            {
                form.HskUrl = $"/sample-data/{file.Name}";
                uploadStatus = $"Sử dụng đường dẫn cục bộ: /sample-data/{file.Name}";
            }
        }
        catch (Exception ex)
        {
            uploadStatus = $"Lỗi: {ex.Message}";
        }

        isUploading = false;
        StateHasChanged();
    }

    private async Task SaveTest()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng nhập Tiêu đề đề thi.");
            return;
        }

        try
        {
            if (editingTest == null)
            {
                var createDto = new
                {
                    Title = form.Title,
                    CollectionName = string.IsNullOrEmpty(form.CollectionName) ? form.DisplayLevel : form.CollectionName,
                    LanguageId = 2,
                    HskUrl = form.HskUrl,
                    ListeningUrl = form.ListeningUrl,
                    ReadingUrl = form.ReadingUrl,
                    WritingUrl = form.WritingUrl,
                    SpeakingUrl = form.SpeakingUrl,
                    ListeningAnswerUrl = form.ListeningAnswerUrl,
                    ReadingAnswerUrl = form.ReadingAnswerUrl,
                    WritingAnswerUrl = form.WritingAnswerUrl,
                    SpeakingAnswerUrl = form.SpeakingAnswerUrl
                };

                var createUrl = GetApiUrl("api/hsk-mock-tests");
                var response = await Http.PostAsJsonAsync(createUrl, createDto);
                if (response.IsSuccessStatusCode)
                {
                    CloseModal();
                    await LoadTests();
                    await JS.InvokeVoidAsync("alert", "Tạo đề thi HSK thành công!");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Có lỗi xảy ra khi tạo đề thi.");
                }
            }
            else
            {
                var updateDto = new
                {
                    Title = form.Title,
                    CollectionName = form.CollectionName,
                    LanguageId = 2,
                    HskUrl = form.HskUrl,
                    ListeningUrl = form.ListeningUrl,
                    ReadingUrl = form.ReadingUrl,
                    WritingUrl = form.WritingUrl,
                    SpeakingUrl = form.SpeakingUrl,
                    ListeningAnswerUrl = form.ListeningAnswerUrl,
                    ReadingAnswerUrl = form.ReadingAnswerUrl,
                    WritingAnswerUrl = form.WritingAnswerUrl,
                    SpeakingAnswerUrl = form.SpeakingAnswerUrl
                };

                var updateUrl = GetApiUrl($"api/hsk-mock-tests/{editingTest.Id}");
                var response = await Http.PutAsJsonAsync(updateUrl, updateDto);
                if (response.IsSuccessStatusCode)
                {
                    CloseModal();
                    await LoadTests();
                    await JS.InvokeVoidAsync("alert", "Cập nhật đề thi HSK thành công!");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Có lỗi xảy ra khi lưu đề thi.");
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi kết nối: {ex.Message}");
        }
    }

    private async Task DeleteTest(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa đề thi HSK này?");
        if (!confirm) return;

        try
        {
            var delUrl = GetApiUrl($"api/hsk-mock-tests/{id}");
            var response = await Http.DeleteAsync(delUrl);
            if (response.IsSuccessStatusCode)
            {
                await LoadTests();
                await JS.InvokeVoidAsync("alert", "Đã xóa đề thi.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi xóa: {ex.Message}");
        }
    }

    private async Task DeleteFromModal()
    {
        if (editingTest == null) return;
        await DeleteTest(editingTest.Id);
        CloseModal();
    }

    private static string ExtractLevel(string title)
    {
        if (string.IsNullOrEmpty(title)) return "HSK1";
        for (int i = 9; i >= 1; i--)
        {
            if (title.Contains($"HSK{i}", StringComparison.OrdinalIgnoreCase) ||
                title.Contains($"HSK {i}", StringComparison.OrdinalIgnoreCase))
                return $"HSK{i}";
        }
        return "HSK1";
    }

    private static int GetLevelNumber(string levelStr)
    {
        if (levelStr.StartsWith("HSK", StringComparison.OrdinalIgnoreCase) && int.TryParse(levelStr[3..], out int num))
        {
            return num;
        }
        return 1;
    }

    private static string GetSkillFromUrl(string url)
    {
        var lower = url.ToLowerInvariant();
        if (lower.Contains("listen")) return "Nghe (Listening)";
        if (lower.Contains("read")) return "Đọc (Reading)";
        if (lower.Contains("writ")) return "Viết (Writing)";
        if (lower.Contains("speak")) return "Nói (Speaking)";
        return "Đề thi Tổng hợp";
    }

    public class HskTestForm
    {
        public string Title { get; set; } = "";
        public string CollectionName { get; set; } = "";
        public string DisplayLevel { get; set; } = "HSK1";
        public string? HskUrl { get; set; }
        public string? ListeningUrl { get; set; }
        public string? ReadingUrl { get; set; }
        public string? WritingUrl { get; set; }
        public string? SpeakingUrl { get; set; }
        public string? ListeningAnswerUrl { get; set; }
        public string? ReadingAnswerUrl { get; set; }
        public string? WritingAnswerUrl { get; set; }
        public string? SpeakingAnswerUrl { get; set; }
    }

    public class UploadResult
    {
        public string? Url { get; set; }
    }
}