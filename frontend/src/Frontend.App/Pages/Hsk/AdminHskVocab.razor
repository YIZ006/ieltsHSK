@code {
    private List<HskVocabularyItem> vocabItems = new();
    private bool isLoading = true;
    private string filterLevel = "";
    private string searchTerm = "";
    private int totalCount = 0;

    private bool showModal = false;
    private HskVocabularyItem? editingItem = null;
    private HskVocabularyItem form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        var items = await HskService.GetVocabularyAsync(filterLevel);
        if (!string.IsNullOrEmpty(searchTerm))
        {
            items = items.Where(x => x.Hanzi.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                    x.Pinyin.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                    x.Meaning.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        vocabItems = items;
        totalCount = items.Count;
        isLoading = false;
        StateHasChanged();
    }

    private void ShowAddModal()
    {
        editingItem = null;
        form = new HskVocabularyItem { HskLevel = "HSK1", IsActive = true, DisplayOrder = 0 };
        showModal = true;
    }

    private void ShowEditModal(HskVocabularyItem item)
    {
        editingItem = item;
        form = new HskVocabularyItem
        {
            Id = item.Id,
            HskLevel = item.HskLevel,
            Hanzi = item.Hanzi,
            Pinyin = item.Pinyin,
            Meaning = item.Meaning,
            WordType = item.WordType,
            ExampleSentence = item.ExampleSentence,
            ExamplePinyin = item.ExamplePinyin,
            ExampleMeaning = item.ExampleMeaning,
            AudioUrl = item.AudioUrl,
            DisplayOrder = item.DisplayOrder,
            IsActive = item.IsActive
        };
        showModal = true;
    }

    private async Task SaveItem()
    {
        if (editingItem == null)
        {
            await HskService.CreateVocabularyAsync(form);
        }
        else
        {
            await HskService.UpdateVocabularyAsync(form.Id, form);
        }
        showModal = false;
        await LoadData();
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task DeleteItem(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa từ vựng này?");
        if (!confirm) return;
        await HskService.DeleteVocabularyAsync(id);
        await LoadData();
    }

    private async Task SpeakChinese(string text)
    {
        await JS.InvokeVoidAsync("eval", $"if ('speechSynthesis' in window) {{ const u = new SpeechSynthesisUtterance('{text}'); u.lang = 'zh-CN'; window.speechSynthesis.speak(u); }}");
    }

    private static int GetLevelNumber(string levelStr)
    {
        if (levelStr.StartsWith("HSK", StringComparison.OrdinalIgnoreCase) && int.TryParse(levelStr[3..], out int num))
        {
            return num;
        }
        return 1;
    }

    private async Task ImportExcel()
    {
        await JS.InvokeVoidAsync("alert", "Tính năng Import Excel sẽ được mở trong bản cập nhật kế tiếp.");
    }

    private async Task DownloadTemplate()
    {
        var url = "/api/hsk/vocab/template-excel";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}