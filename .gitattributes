# Auto detect text files and perform LF normalization
* text=auto

# Do not count data and documentation in repo language stats
frontend/src/Frontend.App/wwwroot/sample-data/* linguist-vendored
frontend/src/Frontend.App/wwwroot/data/* linguist-vendored
docs/* linguist-documentation

# Map Blazor .razor components to C# so the repo shows as C# instead of HTML
*.razor linguist-language=C#
*.cs linguist-language=C#
*.html linguist-detectable=false
*.json linguist-detectable=false
*.js linguist-detectable=false
